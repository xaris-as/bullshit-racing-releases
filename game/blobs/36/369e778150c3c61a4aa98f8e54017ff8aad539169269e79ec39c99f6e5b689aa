// ---------------- Portraits (Blender-rendered, inked 2D; see assets/pipeline/portraits.py) ----------------
const Portraits = {
  ok: {},
  cache: {},
  // kind: idle | blink | pick ; size: '' (large) or 'sm'
  url(id, kind = 'idle', size = '') {
    const key = id + '_' + kind + (size ? '_' + size : '');
    if (this.ok[key] === false) return this.fallback(id);
    return 'portraits/' + key + '.webp';
  },
  css(id, kind, size) {
    return 'url("' + this.url(id, kind, size) + '")';
  },
  preload() {
    for (const r of RACERS) {
      for (const kind of ['idle', 'blink', 'pick']) {
        for (const size of ['', 'sm']) {
          const key = r.id + '_' + kind + (size ? '_' + size : '');
          const img = new Image();
          let tries = 0;
          img.onload = () => (this.ok[key] = true);
          // two retries (busy static hosts can drop a burst of requests) before falling back to the letter badge
          img.onerror = () => {
            if (tries++ < 2) setTimeout(() => (img.src = 'portraits/' + key + '.webp?r=' + tries), 600 * tries);
            else this.ok[key] = false;
          };
          img.src = 'portraits/' + key + '.webp';
        }
      }
    }
  },
  fallback(id) {
    if (this.cache[id]) return this.cache[id];
    const r = RACERS.find((x) => x.id === id) || RACERS[0];
    const c = document.createElement('canvas');
    c.width = 256;
    c.height = 320;
    const g = c.getContext('2d');
    g.fillStyle = '#17161b';
    g.fillRect(0, 0, 256, 320);
    g.fillStyle = accentOf(r);
    g.font = '400 220px ' + DISPLAY_FONT;
    g.textAlign = 'center';
    g.textBaseline = 'middle';
    g.fillText(r.name[0], 128, 170);
    this.cache[id] = c.toDataURL();
    return this.cache[id];
  },
};

