// ---------- extras ----------
function buildWorldExtras(track, terrain, theme, Q, scene, statics, U) {
  const set = track.def.set || {};
  const rng = mulberry32(track.def.seed * 41 + 11);
  const F = {};
  const L = track.finishS;
  const updaters = [];
  const disposables = [];
  // a clear spot beside the road (same rule as the decor placer)
  const beside = (s, dist, side = 0) => {
    track.frameInto(s, F);
    const sides = side ? [side] : rng() < 0.5 ? [1, -1] : [-1, 1];
    for (const sg of sides) {
      const x = F.x + F.rx * sg * dist;
      const z = F.z + F.rz * sg * dist;
      const k = terrain.idx(x, z);
      if (terrain.minD[k] > dist * 0.82 - 4 && Math.abs(terrain.nearS[k] - s) < dist * 2.5 + 30) return { x, z, y: terrain.heightAt(x, z), side: sg, psi: F.psi };
    }
    return null;
  };
  const quad = (out, uvs, cx, cy, cz, ry, w, h, u0, v0, u1, v1) => {
    const c = Math.cos(ry);
    const sn = Math.sin(ry);
    const pts = [[-w / 2, 0], [w / 2, 0], [w / 2, h], [-w / 2, h]];
    const base = out.length / 3;
    for (const [px, py] of pts) out.push(cx + px * c, cy + py, cz - px * sn);
    uvs.push(u0, v0, u1, v0, u1, v1, u0, v1);
    return base;
  };
  const texQuads = (list, tex, opts = {}) => {
    if (!list.length) return;
    const pos = [];
    const uv = [];
    const idx = [];
    for (const q of list) {
      const b = quad(pos, uv, ...q);
      idx.push(b, b + 1, b + 2, b, b + 2, b + 3);
      if (opts.double) idx.push(b, b + 2, b + 1, b, b + 3, b + 2);
    }
    const g = new THREE.BufferGeometry();
    g.setAttribute('position', new THREE.Float32BufferAttribute(pos, 3));
    g.setAttribute('uv', new THREE.Float32BufferAttribute(uv, 2));
    g.setIndex(idx);
    g.computeVertexNormals();
    const m = new THREE.MeshBasicMaterial({ map: tex, side: THREE.DoubleSide, toneMapped: opts.toneMapped ?? true });
    if (opts.boost) m.color.setScalar(opts.boost);
    const mesh = new THREE.Mesh(g, m);
    scene.add(mesh);
    return mesh;
  };
  // neon signs (one mesh, atlas)
  if (set.neon) {
    const list = [];
    const poles = [];
    set.neon.forEach((f, i) => {
      const p = beside(f * L, 15 + rng() * 6);
      if (!p) return;
      const ry = -p.psi + (p.side > 0 ? -Math.PI / 2 : Math.PI / 2);
      const k = (i + Math.floor(rng() * 3)) % NEON_SIGNS.length;
      const u0 = (k % 2) * 0.5;
      const v1 = 1 - Math.floor(k / 2) * 0.25;
      list.push([p.x, p.y + 6.5, p.z, ry, 12, 6, u0, v1 - 0.25, u0 + 0.5, v1]);
      poles.push(xpart(GEO.cylLo, 0x2a2a30, C_METAL, p.x - Math.cos(ry) * 4, p.y + 3.4, p.z + Math.sin(ry) * 4, 0, 0, 0, 0.25, 6.8, 0.25));
      poles.push(xpart(GEO.cylLo, 0x2a2a30, C_METAL, p.x + Math.cos(ry) * 4, p.y + 3.4, p.z - Math.sin(ry) * 4, 0, 0, 0, 0.25, 6.8, 0.25));
    });
    texQuads(list, neonAtlas(), { boost: 1.15 });
    if (poles.length) scene.add(new THREE.Mesh(xmerge(poles), MAT.propx));
  }
  // Taurus billboards
  if (set.billboards || set.banners) {
    const list = [];
    const poles = [];
    const at = set.billboards || [0.2, 0.5, 0.8];
    at.forEach((f, i) => {
      const p = beside(f * L, 19 + rng() * 6);
      if (!p) return;
      const ry = -p.psi + (p.side > 0 ? -Math.PI / 2 : Math.PI / 2);
      const k = (i + Math.floor(rng() * 4)) % BILLBOARDS.length;
      list.push([p.x, p.y + 5, p.z, ry, 16, 4, 0, 1 - (k + 1) * 0.25, 1, 1 - k * 0.25]);
      for (const o of [-6, 6]) poles.push(xpart(GEO.box, 0x3a3d45, C_METAL, p.x + Math.cos(ry) * o, p.y + 2.6, p.z - Math.sin(ry) * o, 0, ry, 0, 0.4, 5.2, 0.4));
    });
    texQuads(list, billboardAtlas(), { boost: theme.night ? 1.3 : 1.0 });
    if (poles.length) scene.add(new THREE.Mesh(xmerge(poles), MAT.propx));
  }
  // hero chimneys with smoke columns
  const smokeAt = [];
  if (set.chimneys) {
    const parts = [];
    for (let i = 0; i < 6; i++) {
      const p = beside(((i + 0.5) / 6) * L, 34 + rng() * 20);
      if (!p) continue;
      parts.push(xpart(GEO.cyl, 0x5a4a44, C_PAINT, p.x, p.y + 15, p.z, 0, 0, 0, 2.2, 30, 2.2));
      parts.push(xpart(GEO.cyl, 0xd01f1f, C_PAINT, p.x, p.y + 22, p.z, 0, 0, 0, 2.28, 1.6, 2.28));
      parts.push(xpart(GEO.cyl, 0xff7a1a, C_GLOW, p.x, p.y + 30.1, p.z, 0, 0, 0, 1.9, 0.3, 1.9));
      smokeAt.push([p.x, p.y + 30.5, p.z]);
    }
    if (parts.length) scene.add(new THREE.Mesh(xmerge(parts), MAT.propx));
  }
  if (set.pipes) {
    const parts = [];
    for (let i = 0; i < 8; i++) {
      const p = beside(((i + rng()) / 8) * L, 16 + rng() * 6);
      if (!p) continue;
      const ry = -p.psi;
      parts.push(xpart(GEO.cylLo, 0x6a6a72, C_METAL, p.x, p.y + 1.6, p.z, Math.PI / 2, ry, 0, 0.6, 14, 0.6));
      for (const o of [-5, 0, 5]) parts.push(xpart(GEO.box, 0xffc21a, C_PAINT, p.x + Math.sin(ry) * o, p.y + 0.8, p.z + Math.cos(ry) * o, 0, ry, 0, 0.3, 1.6, 0.9));
    }
    if (parts.length) scene.add(new THREE.Mesh(xmerge(parts), MAT.propx));
  }
  // lava falls: glowing sheets down the cliffs
  if (set.lavafalls) {
    const lm = new THREE.ShaderMaterial({
      uniforms: { uTime: U.uTime },
      vertexShader: 'varying vec2 vUv; void main(){ vUv = uv; gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0); }',
      fragmentShader: 'uniform float uTime; varying vec2 vUv; void main(){ float n = 0.5 + 0.5 * sin(vUv.x * 23.0 + sin(vUv.y * 7.0 + uTime) * 2.0) * sin(vUv.y * 9.0 + uTime * 3.0); vec3 c = mix(vec3(1.0, 0.25, 0.02), vec3(1.0, 0.85, 0.35), n * n); gl_FragColor = vec4(c * 2.2, 1.0); }',
      side: THREE.DoubleSide,
    });
    const list = [];
    for (const f of set.lavafalls) {
      const p = beside(f * L, 40 + rng() * 15);
      if (!p) continue;
      list.push([p.x, p.y - 1, p.z, -p.psi + Math.PI / 2, 10, 26, 0, 0, 1, 1]);
    }
    if (list.length) {
      const mesh = texQuads(list, null);
      mesh.material.dispose();
      mesh.material = lm;
    }
  }
  // lily pads on the water runs
  if (set.lilypads) {
    const items = [];
    for (let k = 0; k < track.segS.length; k++) {
      if (track.segMode[k] !== M_WATER) continue;
      for (let s = track.segS[k]; s < track.segE[k]; s += 3) {
        if (rng() < 0.55) continue;
        const d = (rng() < 0.5 ? -1 : 1) * (4 + rng() * (WATER_HW + 6));
        const p = track.toWorld(s, d, {});
        items.push([p.x, track.groundHeight(s, d) + 0.06, p.z, 0.6 + rng() * 0.9, rng() * TAU, 0.85 + rng() * 0.3]);
      }
    }
    if (items.length) {
      const g = new THREE.CircleGeometry(1, 10, 0.4, TAU - 0.8);
      g.rotateX(-Math.PI / 2);
      const pg = xmerge([xpart(g, 0x4a7a2a, C_MATTE, 0, 0, 0), xpart(GEO.sphereLo, 0xff8ad0, C_PAINT, 0.45, 0.1, 0.2, 0, 0, 0, 0.14, 0.1, 0.14)]);
      g.dispose();
      addInstanced(statics, pg, MAT.propx, items, { chunk: 400 });
    }
  }
  // fireflies / embers (Points, animated in the shader)
  const pts = (n, colA, colB, mode) => {
    if (Q.id === 'low' || !n) return;
    const pos = new Float32Array(n * 3);
    const seed = new Float32Array(n);
    for (let i = 0; i < n; i++) {
      const s = START_S + rng() * (L - START_S);
      const d = (rng() < 0.5 ? -1 : 1) * (6 + rng() * 34);
      const p = track.toWorld(s, d, {});
      pos[i * 3] = p.x;
      pos[i * 3 + 1] = (mode === 1 ? terrain.heightAt(p.x, p.z) : track.heightAt(s)) + 0.6 + rng() * (mode === 1 ? 3.5 : 12);
      pos[i * 3 + 2] = p.z;
      seed[i] = rng() * 100;
    }
    const g = new THREE.BufferGeometry();
    g.setAttribute('position', new THREE.BufferAttribute(pos, 3));
    g.setAttribute('seed', new THREE.BufferAttribute(seed, 1));
    const m = new THREE.ShaderMaterial({
      uniforms: { uTime: U.uTime, uMap: { value: glowTexture() }, uA: { value: new THREE.Color(colA) }, uB: { value: new THREE.Color(colB) }, uScale: { value: 600 }, uMode: { value: mode } },
      vertexShader: `attribute float seed; uniform float uTime; uniform float uScale; uniform float uMode; varying float vB; varying float vK;
        void main(){ vec3 p = position;
          if (uMode < 1.5) { p += vec3(sin(uTime * 0.7 + seed) * 1.2, sin(uTime * 1.1 + seed * 1.7) * 0.6, cos(uTime * 0.6 + seed * 0.9) * 1.2); }
          else { p.y += mod(uTime * (1.2 + fract(seed) * 1.6) + seed, 14.0); p.x += sin(uTime + seed) * 0.8; }
          vB = uMode < 1.5 ? smoothstep(0.55, 1.0, sin(uTime * (1.3 + fract(seed * 7.0)) + seed)) : 1.0 - mod(uTime * 0.3 + seed, 1.0);
          vK = fract(seed * 3.7);
          vec4 mv = modelViewMatrix * vec4(p, 1.0); gl_Position = projectionMatrix * mv; gl_PointSize = uScale * 0.22 / max(1.0, -mv.z); }`,
      fragmentShader: `uniform sampler2D uMap; uniform vec3 uA; uniform vec3 uB; varying float vB; varying float vK;
        void main(){ float a = texture2D(uMap, gl_PointCoord).a; gl_FragColor = vec4(mix(uA, uB, vK) * 2.0, a * vB); }`,
      transparent: true,
      depthWrite: false,
      blending: THREE.AdditiveBlending,
    });
    const P = new THREE.Points(g, m);
    P.frustumCulled = false;
    scene.add(P);
    updaters.push(() => {
      m.uniforms.uScale.value = renderer.domElement.height;
    });
  };
  if (theme.fireflies) pts(Q.id === 'high' ? 420 : 220, 0xd8ff6a, 0xffe14a, 1);
  if (theme.ash || set.chimneys) pts(Q.id === 'high' ? 500 : 260, 0xff6a1a, 0xffb03a, 2);
  // chimney smoke (soft dark puffs rising)
  if (smokeAt.length && Q.id !== 'low') {
    const per = 26;
    const n = smokeAt.length * per;
    const pos = new Float32Array(n * 3);
    const seed = new Float32Array(n);
    for (let i = 0; i < n; i++) {
      const c = smokeAt[Math.floor(i / per)];
      pos[i * 3] = c[0];
      pos[i * 3 + 1] = c[1];
      pos[i * 3 + 2] = c[2];
      seed[i] = (i % per) / per + rng() * 0.02;
    }
    const g = new THREE.BufferGeometry();
    g.setAttribute('position', new THREE.BufferAttribute(pos, 3));
    g.setAttribute('seed', new THREE.BufferAttribute(seed, 1));
    const m = new THREE.ShaderMaterial({
      uniforms: { uTime: U.uTime, uMap: { value: blobTexture() }, uScale: { value: 700 } },
      vertexShader: `attribute float seed; uniform float uTime; uniform float uScale; varying float vA;
        void main(){ float k = fract(seed + uTime * 0.05); vec3 p = position + vec3(sin(k * 6.0 + seed * 20.0) * 3.0 * k + k * 10.0, k * 34.0, cos(k * 5.0 + seed * 13.0) * 3.0 * k);
          vA = (1.0 - k) * smoothstep(0.0, 0.08, k);
          vec4 mv = modelViewMatrix * vec4(p, 1.0); gl_Position = projectionMatrix * mv; gl_PointSize = uScale * (3.0 + k * 14.0) / max(1.0, -mv.z); }`,
      fragmentShader: 'uniform sampler2D uMap; varying float vA; void main(){ float a = texture2D(uMap, gl_PointCoord).a; gl_FragColor = vec4(vec3(0.09, 0.08, 0.085), a * vA * 0.9); }',
      transparent: true,
      depthWrite: false,
    });
    const P = new THREE.Points(g, m);
    P.frustumCulled = false;
    scene.add(P);
    updaters.push(() => {
      m.uniforms.uScale.value = renderer.domElement.height;
    });
  }
  // the golden bull at the finish
  for (const f of set.bullstatue || []) {
    const p = beside(f * L, 38, 0);
    if (!p) continue;
    const mesh = new THREE.Mesh(bullStatueGeo(), MAT.propx);
    mesh.position.set(p.x, p.y - 0.5, p.z);
    mesh.rotation.y = -p.psi + (p.side > 0 ? -Math.PI / 2 : Math.PI / 2) + Math.PI;
    mesh.scale.setScalar(1.6);
    mesh.castShadow = Q.shadows > 0;
    scene.add(mesh);
  }
  return {
    update(dt) {
      for (const u of updaters) u(dt);
    },
    dispose() {
      for (const d of disposables) d.dispose();
    },
  };
}

// ============================================================
// Race simulation v3 (pure, no three.js): arcade rigid-body karts in track space, OBB impulse contact
// (PIT spins), drafting, drifting, signature abilities with a charge meter, real glider flight (pitch / energy /
// thermals / cables / 3D rings / landing skill check), boats on world-space waves, AI.
// Events go out through hooks.emit(type, ...): overtake, overtaken, nearMiss, airTrick, ability, abilityEnd,
// charge, gate, thermal, launch, landing, wipeout, decoy, decoyHit, scorch, ram + the v2 set.
// ============================================================
const NOHOOK = { emit() {} };
// world-space swell shared with the water shader (35_world.js WAVE_GLSL): dir.x, dir.z, k, amp, omega
const WAVES = [
  [0.8, 0.6, 0.21, 0.3, 1.3],
  [-0.5, 0.866, 0.37, 0.19, 1.9],
  [0.2, -0.98, 0.53, 0.11, 2.4],
  [0.95, -0.31, 0.9, 0.055, 3.1],
];
function waveHeight(x, z, t) {
  let h = 0;
  for (let i = 0; i < 4; i++) {
    const w = WAVES[i];
    h += w[3] * Math.sin((w[0] * x + w[1] * z) * w[2] + w[4] * t);
  }
  return h;
}

class Racer {
  constructor(def, idx, isPlayer, build, upgrades) {
    this.def = def;
    this.idx = idx;
    this.isPlayer = isPlayer;
    this.name = def.name;
    this.build = build || def.build;
    const st = kartStats(def, this.build, isPlayer ? upgrades : null);
    this.stats = st;
    this.vTop = st.vTop;
    this.accel = st.accel;
    this.handling = st.handling;
    this.gripK = st.grip;
    this.mass = st.mass;
    this.inertia = st.mass * 0.8;
    this.driftRate = st.driftRate;
    this.turboMul = st.turboMul;
    this.offroadRes = st.offroad;
    // v5: motorcycles are narrower (contact box) and better at ramp tricks
    this.bike = !!st.bike;
    this.halfW = this.bike ? BIKE_HW : KART_HW;
    this.halfL = this.bike ? BIKE_HL : KART_HL;
    this.trickBonus = st.trick || 0;
    this.assist = false;
    this.manualDrift = false;
    this.autoDrift = false;
    this.abilityId = def.ability;
    this.ai = { targetD: 0, bias: 0, biasGoal: 0, biasT: 0, itemDelay: 1, skill: 1, padPick: 0.7, orbPick: 0.8, driftPick: 0.8, aggro: 0.2, delay: 0, leanT: 0, abilHold: 0, abilPatience: 6, route: 'high', trickLeft: 0, trickAt: 0 };
    this.drift = { on: false, dir: 0, t: 0, level: 0, auto: false, rel: 0 };
    this.reset(0, 0, 0, 0);
  }
  reset(s, d, y, psi) {
    this.s = s;
    this.d = d;
    this.y = y;
    this.vy = 0;
    this.grounded = true;
    this.gPrev = y;
    this.hw = psi;
    this.om = 0;
    this.vx = 0;
    this.vz = 0;
    this.v = 0;
    this.spd = 0;
    this.slip = 0;
    this.steer = 0;
    this.steerTarget = 0;
    this.brake = false;
    this.driftHeld = false;
    this.steerHoldT = 0;
    this.steerHoldDir = 0;
    const D = this.drift;
    D.on = false;
    D.t = 0;
    D.level = 0;
    D.rel = 0;
    this.draft = 0;
    this.draftT = 0;
    this.spinning = false;
    this.spinT = 0;
    this.boostT = 0;
    this.boostPow = 1;
    this.invulnT = 0;
    this.shieldT = 0;
    this.honeyT = 0;
    this.wallT = 0;
    this.bumpT = 0;
    this.item = null;
    this.pendingItem = null;
    this.rouletteT = 0;
    this.itemHeld = 0;
    this.finished = false;
    this.finishTime = 0;
    this.place = 1;
    this.speedMul = 1;
    this.airT = 0;
    this.lastPad = -1;
    this.lastRing = -1;
    this.lastGate = -1;
    this.offroad = false;
    this.ice = false;
    this.coins = 0;
    this.hits = 0;
    this.wallHits = 0;
    this.spins = 0;
    this.respawns = 0;
    this.sdot = 0;
    this.ddot = 0;
    this.hopT = 0;
    this.spinCool = 0;
    this.recover = false;
    this.mode = M_ROAD;
    this.form = 0;
    this.formT = 1;
    // abilities
    this.charge = 0;
    this.abilT = 0;
    this.abilUses = 0;
    this.ramT = 0;
    this.lineT = 0;
    this.silkT = 0;
    this.burnT = 0;
    this.scorchT = 0;
    this.bigAir = false;
    this.trickDone = false;
    // ramp tricks: rampAir = airborne off a ramp lip; trickT = time left in the trick being performed;
    // trickN started / trickOK completed this jump; trickSeq counts every trick (visuals detect new ones)
    this.rampAir = false;
    this.trickT = 0;
    this.trickK = 0;
    this.trickN = 0;
    this.trickOK = 0;
    this.trickBuf = 0;
    this.trickSeq = this.trickSeq || 0;
    this.tricks = 0;
    this.nearCool = 0;
    // glider
    this.gamma = 0;
    this.pitchCmd = 0;
    this.thermalT = 0;
    this.ringsHit = 0;
    this.ringsSeen = 0;
    this.ai.targetD = d;
    this.ai.delay = 0;
    this.ai.abilHold = 0;
  }
  get abilityReady() {
    return this.charge >= 1 && this.abilT <= 0;
  }
}

const _A = [0, 0, 0, 0, 0, 0, 0, 0];
const _B = [0, 0, 0, 0, 0, 0, 0, 0];

class Race {
  constructor(track, racers, opts = {}) {
    this.track = track;
    this.racers = racers;
    this.hooks = opts.hooks || NOHOOK;
    this.rng = mulberry32(opts.seed ?? 1234);
    this.aiBoost = opts.aiBoost ?? 1;
    this.player = racers.find((r) => r.isPlayer) || null;
    this.rockets = [];
    this.puddles = [];
    this.decoys = [];
    this.time = 0;
    this.running = false;
    this.uid = 0;
    this.input = { steer: 0, brake: false, drift: false, ability: false, trick: false };
    this.autopilot = false;
    this._f = {};
    this._g = {};
    this._w = {};
    this.sorted = racers.slice();
    this.passCool = new Map();
    for (const r of racers) {
      if (r.isPlayer) continue;
      r.ai.skill = 0.975 + this.rng() * 0.04;
      r.ai.padPick = 0.5 + this.rng() * 0.4;
      r.ai.orbPick = 0.6 + this.rng() * 0.35;
      r.ai.driftPick = 0.55 + this.rng() * 0.4;
      r.ai.aggro = [0.15, 0.55, 0.25, 0.35, 0.2, 0.7][r.idx % 6];
    }
    for (const r of racers) {
      r.ai.route = this.rng() < 0.5 ? 'high' : 'low';
      r.ai.abilPatience = 5 + this.rng() * 5;
    }
  }

  // water surface offset at track position (s, d): world-space swell so the water shader matches exactly
  wave(s, d) {
    const p = this.track.toWorld(s, d, this._w);
    return waveHeight(p.x, p.z, this.time);
  }

  placeOnGrid(playerSlot = 4) {
    const others = this.racers.filter((r) => r !== this.player);
    for (let i = others.length - 1; i > 0; i--) {
      const j = Math.floor(this.rng() * (i + 1));
      const t = others[i];
      others[i] = others[j];
      others[j] = t;
    }
    let k = 0;
    const n = this.racers.length;
    const pSlot = Math.min(playerSlot, n - 1);
    for (let slot = 0; slot < n; slot++) {
      const r = this.player && slot === pSlot ? this.player : others[k++];
      const row = slot >> 1;
      const col = slot & 1;
      const s = START_S - 8 - row * 7 - col * 2.5;
      const d = col === 0 ? -3.4 : 3.4;
      r.reset(s, d, this.track.groundHeight(s, d), this.track.psiAt(s));
      r.gridSlot = slot;
    }
    this.rockets.length = 0;
    this.puddles.length = 0;
    this.decoys.length = 0;
    this.passCool.clear();
    for (const t of this.track.tumble) t.ph = this.rng() * TAU;
    this.time = 0;
    this.running = false;
    this.updatePlaces(true);
  }

  start() {
    this.running = true;
    for (const r of this.racers) {
      if (r.isPlayer) continue;
      r.ai.delay = this.rng() * 0.3;
      if (this.rng() < 0.3 * r.ai.skill) this.giveBoost(r, 0.9, 1.0);
    }
  }

  giveBoost(r, t, pow) {
    if (r.boostT <= 0) r.boostPow = pow;
    else r.boostPow = Math.max(r.boostPow, pow);
    r.boostT = Math.max(r.boostT, t);
  }

  addCharge(r, amt, why) {
    if (r.finished || r.abilT > 0 || r.charge >= 1 || !this.running) return;
    const ab = ABILITIES[r.abilityId];
    const before = r.charge;
    r.charge = Math.min(1, r.charge + amt * (ab ? ab.rate : 1));
    if (before < 1 && r.charge >= 1) {
      r.ai.abilHold = 0;
      this.hooks.emit('abilityReady', r);
    } else if (why) this.hooks.emit('charge', r, why, amt);
  }

  yawCapacity(r, u = r.v, mode = r.mode) {
    const sp = Math.abs(u);
    let k = r.handling * (1 - 0.28 * clamp(sp / 36, 0, 1)) * clamp(sp / 5, 0.35, 1);
    if (mode === M_AIR) k *= 0.92;
    else if (mode === M_WATER) k *= 1.1;
    return k;
  }

  placeFrac(r) {
    const n = this.racers.length;
    return n > 1 ? (r.place - 1) / (n - 1) : 0;
  }

  nextAhead(r) {
    let best = null;
    let bd = Infinity;
    for (const o of this.racers) {
      if (o === r || o.finished) continue;
      const ds = o.s - r.s;
      if (ds > 0 && ds < bd) {
        bd = ds;
        best = o;
      }
    }
    return best;
  }

  step(h) {
    if (this.running) this.time += h;
    for (const r of this.racers) {
      if (r.remote) continue; // online: driven by the network, not simulated here
      if (!this.running) {
        r.steerTarget = 0;
        continue;
      }
      if (r.isPlayer && !r.finished && !this.autopilot) {
        r.steerTarget = clamp(this.input.steer, -1, 1);
        r.brake = !!this.input.brake;
        r.driftHeld = !!this.input.drift;
        if (this.input.trick) {
          this.input.trick = false;
          this.trickInput(r);
        }
        if (this.input.ability) {
          this.input.ability = false;
          this.useAbility(r);
        }
      } else {
        r.brake = false;
        this.aiThink(r, h);
      }
    }
    for (const r of this.racers) if (!r.remote) this.physics(r, h);
    if (this.running) {
      this.collideRacers();
      this.updateTumble(h);
      for (const r of this.racers) if (!r.remote) this.collideStatic(r, h);
      this.drafting(h);
      for (const r of this.racers) if (!r.remote) this.interact(r);
      this.updateAbilities(h);
      this.updateDecoys(h);
      this.updateBooms(h);
      if (ITEMS_ON) {
        this.updateRockets(h);
        this.updatePuddles(h);
        this.updateOrbs(h);
      }
    }
    this.updatePlaces();
  }

  // ---------------------------------------------------------------- physics
  physics(r, h) {
    const tr = this.track;
    const F = tr.frameInto(r.s, this._f);
    if (!this.running) {
      r.vx = 0;
      r.vz = 0;
      r.v = 0;
      r.spd = 0;
      r.om = 0;
      r.hw = F.psi;
      r.y = tr.groundHeight(r.s, r.d);
      r.vy = 0;
      r.grounded = true;
      r.sdot = 0;
      r.ddot = 0;
      return;
    }
    if (r.boostT > 0) r.boostT = Math.max(0, r.boostT - h);
    if (r.invulnT > 0) r.invulnT = Math.max(0, r.invulnT - h);
    if (r.honeyT > 0) r.honeyT = Math.max(0, r.honeyT - h);
    if (r.scorchT > 0) r.scorchT = Math.max(0, r.scorchT - h);
    if (r.wallT > 0) r.wallT -= h;
    if (r.bumpT > 0) r.bumpT -= h;
    if (r.hopT > 0) r.hopT = Math.max(0, r.hopT - h);
    if (r.trickBuf > 0) r.trickBuf = Math.max(0, r.trickBuf - h);
    if (r.nearCool > 0) r.nearCool -= h;
    if (r.shieldT > 0) {
      r.shieldT -= h;
      if (r.shieldT <= 0) {
        r.shieldT = 0;
        this.hooks.emit('shieldEnd', r);
      }
    }
    if (ITEMS_ON) {
      if (r.rouletteT > 0) {
        r.rouletteT -= h;
        if (r.rouletteT <= 0) {
          r.rouletteT = 0;
          r.item = r.pendingItem;
          r.pendingItem = null;
          r.itemHeld = 0;
          if (!r.isPlayer) r.ai.itemDelay = 0.5 + this.rng() * 2.5;
          this.hooks.emit('gotItem', r, r.item);
        }
      } else if (r.item) r.itemHeld += h;
    }

    const mode = tr.modeAt(r.s);
    if (mode !== r.mode) this.modeChange(r, r.mode, mode);
    r.formT = Math.min(1, r.formT + h * 2.2);
    const air = mode === M_AIR;
    const water = mode === M_WATER;
    let delayed = false;
    if (r.ai.delay > 0) {
      r.ai.delay -= h;
      delayed = true;
    }
    const stunned = r.spinning;
    const tgt = stunned ? 0 : r.steerTarget;
    const rate = Math.abs(tgt) > Math.abs(r.steer) && tgt * r.steer >= 0 ? 5.0 : 8.0;
    r.steer = approach(r.steer, tgt, rate * h);

    this.updateDrift(r, h, mode);

    const flying = !air && !water && !r.grounded;
    const psiRel0 = wrapPi(r.hw - F.psi);
    r.recover = !r.finished && !air && ((Math.abs(psiRel0) > 1.1 && r.spd < 10) || (Math.abs(psiRel0) > 1.75 && r.spd < 14)) && (!r.spinning || r.spinT > 0.6);
    if (r.recover) r.spinning = false;
    const line = r.lineT > 0;
    const surfGrip = line ? 1 : tr.gripAt(r.s);
    r.ice = surfGrip < 1;
    r.offroad = !water && !air && r.grounded && Math.abs(r.d) > ROAD_HW + 0.4;
    const slipMag = Math.abs(r.slip);
    const sat = r.drift.on ? smoothstep(0.8, 1.3, slipMag) : smoothstep(0.45, 1.0, slipMag);
    let grip = water ? 2.6 : air ? 3.2 : 9.5 * r.gripK * tr.grip * surfGrip;
    if (r.offroad && !line) grip *= 0.85 + 0.15 * r.offroadRes;
    if (r.drift.on) grip = water ? 1.5 : r.ice ? 1.3 : 2.3;
    if (line) grip *= ABILITIES.perfectline.grip;
    grip *= 1 - 0.5 * sat;
    if (stunned) grip = Math.min(grip, 1.1);
    if (r.recover) grip = 4;
    if (flying) grip *= 0.15;

    let fx = Math.sin(r.hw);
    let fz = -Math.cos(r.hw);
    const u0 = r.vx * fx + r.vz * fz;
    const cap = this.yawCapacity(r, u0, mode) * (line ? 1.12 : 1);
    const psiRel = wrapPi(r.hw - F.psi);
    let omT = r.steer * cap;
    if (r.drift.on) {
      if (r.drift.auto) omT = r.drift.dir * cap * 0.5 - (psiRel - r.drift.dir * 0.34) * 1.7 + F.kappa * Math.max(0, u0) * 0.6;
      else omT = r.drift.dir * cap * (0.62 + 0.38 * clamp(r.steer * r.drift.dir, -1, 1)) * 1.12;
    } else if (r.assist && !stunned && !flying && Math.abs(r.steerTarget) < 0.05) omT -= psiRel * ALIGN;
    if (flying) omT *= 0.3;
    if (r.recover) omT = clamp(-psiRel * 2.8, -3.0, 3.0);
    let kYaw = r.recover ? 7 : stunned ? 0.8 : flying ? 1.2 : 9 * (1 - 0.75 * sat) + 0.8;
    if (air) kYaw = 3.2; // banking: yaw follows the bank with some lag
    r.om += (omT - r.om) * (1 - Math.exp(-kYaw * h));
    r.hw += r.om * h;

    fx = Math.sin(r.hw);
    fz = -Math.cos(r.hw);
    const rxh = Math.cos(r.hw);
    const rzh = Math.sin(r.hw);
    let u = r.vx * fx + r.vz * fz;
    let w = r.vx * rxh + r.vz * rzh;
    let vTop = r.vTop * r.speedMul * (1 + 0.085 * r.draft) * (water ? 0.96 : air ? 1.05 : 1);
    if (r.offroad && !line) vTop *= 0.74 + 0.26 * r.offroadRes;
    if (r.honeyT > 0) vTop *= 0.65;
    if (r.scorchT > 0) vTop *= ABILITIES.overdrive.scorchSlow;
    if (line) vTop *= ABILITIES.perfectline.speed;
    const boosting = r.boostT > 0;
    let acc = r.accel;
    if (boosting) {
      vTop += BOOST_DV * r.boostPow;
      acc += 26;
    }
    let a;
    if (r.finished) a = u > 9 ? -7 : u < 8 ? 3 : 0;
    else if (delayed) a = 0;
    else if (u < vTop) a = acc * (1 - u / vTop);
    else a = -(u - vTop) * (r.offroad ? 1.8 : boosting ? 0.8 : 0.28);
    if (!r.finished && !delayed) {
      if (r.grounded && !water && !air) a -= SLOPE_G * F.grade * Math.cos(psiRel);
      else if (air) {
        // glider energy: dive (gamma < 0) trades height for speed, climbing bleeds it
        a = (u < vTop ? acc * 0.32 * (1 - u / vTop) : -(u - vTop) * (boosting ? 0.5 : 0.18)) - SLOPE_G * 1.05 * Math.sin(r.gamma);
      }
    }
    if (stunned || r.recover) a -= 5;
    if (r.brake && !stunned && !air) a -= 20;
    if (flying) a *= 0.2;
    u = clamp(u + a * h, -6, V_MAX);
    if (air) u = Math.max(u, 14);
    const wOld = w;
    if (air) {
      // banked turn: lift swings the velocity round with the heading, so turning costs little energy
      const vm = Math.hypot(u, w);
      w *= Math.exp(-6.5 * h);
      u = Math.sqrt(Math.max(0, vm * vm - w * w)) * (1 - 0.025 * Math.abs(r.om) * h);
    } else w *= Math.exp(-grip * h);
    if (r.drift.on) u += Math.abs(wOld - w) * 0.35;
    r.vx = u * fx + w * rxh;
    r.vz = u * fz + w * rzh;
    r.v = u;
    r.spd = Math.hypot(r.vx, r.vz);
    r.slip = Math.atan2(w, Math.max(2, Math.abs(u)));

    const vs = r.vx * F.tx + r.vz * F.tz;
    const vd = r.vx * F.rx + r.vz * F.rz;
    const denom = Math.max(0.35, 1 - F.kappa * r.d);
    r.sdot = vs / denom;
    r.ddot = vd;
    r.s += r.sdot * h;
    r.d += vd * h;
    if (r.s > tr.length - 8) {
      r.s = tr.length - 8;
      r.vx *= 0.5;
      r.vz *= 0.5;
    }
    if (r.s < 0) r.s = 0;

    // walls (barriers / buoy lines / wind walls)
    const lim = tr.wallAt(r.s) - r.halfW;
    if (r.d > lim || r.d < -lim) {
      const side = r.d > 0 ? 1 : -1;
      r.d = side * lim;
      const nx = F.rx * side;
      const nz = F.rz * side;
      const vn = r.vx * nx + r.vz * nz;
      if (vn > 0) {
        const e = water ? 0.25 : air ? 0.1 : 0.12;
        r.vx -= (1 + e) * vn * nx;
        r.vz -= (1 + e) * vn * nz;
        const fr = Math.min(0.25, vn * 0.02);
        r.vx *= 1 - fr;
        r.vz *= 1 - fr;
        const into = side * wrapPi(r.hw - F.psi);
        if (into > 0) {
          r.hw -= side * into * Math.min(1, vn * 0.08) * (air ? 0.8 : 0.5);
          r.om -= side * Math.min(2.0, vn * 0.15);
        }
        if (vn > 2.5 && r.wallT <= 0) {
          r.wallHits++;
          this.hooks.emit('wall', r, vn, side);
          r.wallT = 0.3;
        }
        if (r.drift.on && vn > 4) this.finishDrift(r, false);
      }
      if (!air && !water && Math.abs(r.om) < 3 && r.spd > 14) this.hooks.emit('scrape', r, side);
    }

    // vertical
    if (air) this.glide(r, h, F, u);
    else {
      let g = tr.groundHeight(r.s, r.d);
      if (water) g += this.wave(r.s, r.d);
      if (r.grounded) {
        const yBall = r.y + r.vy * h - GV * h * h;
        if (yBall > g + 0.04) {
          r.grounded = false;
          r.y = yBall;
          r.vy -= GV * h;
          r.airT = 0;
          r.trickDone = false;
          this.takeoff(r, mode);
        } else {
          r.vy = water ? clamp((g - r.gPrev) / h, -8, 8) : tr.groundVel(r.s, r.d, r.sdot, r.ddot);
          r.y = g;
        }
      } else {
        r.vy -= GV * h * (r.bigAir && r.vy > 0 ? 0.82 : 1);
        r.y += r.vy * h;
        r.airT += h;
        if (r.airT > 0.55 && !r.trickDone && !r.finished && !r.rampAir) {
          r.trickDone = true;
          this.addCharge(r, CHARGE.trick, 'trick');
          this.hooks.emit('airTrick', r);
        }
        if (r.trickT > 0) {
          r.trickT -= h;
          if (r.trickT <= 0) {
            r.trickT = 0;
            r.trickOK++;
          }
        }
        const tai = r.ai;
        if (tai.trickLeft > 0 && (!r.isPlayer || this.autopilot)) {
          tai.trickAt -= h;
          if (tai.trickAt <= 0 && r.trickT <= 0) {
            if (this.tryTrick(r, 1 + Math.floor(this.rng() * 4))) {
              tai.trickLeft--;
              tai.trickAt = 0.02 + this.rng() * 0.05;
            } else tai.trickLeft = 0;
          }
        }
        if (r.y <= g) {
          const impact = -r.vy;
          r.y = g;
          r.grounded = true;
          if (r.rampAir) this.landTricks(r);
          r.vy = water ? 0 : tr.groundVel(r.s, r.d, r.sdot, r.ddot);
          if (impact > 3 || water) this.hooks.emit(water ? 'splash' : 'land', r, impact);
          if (r.airT > 0.45 && !r.spinning && !r.finished) this.addCharge(r, CHARGE.land, 'land');
          if (r.bigAir) {
            r.bigAir = false;
            const ab = ABILITIES.bigair;
            this.giveBoost(r, ab.landBoost * r.turboMul, ab.landPow);
            if (r.isPlayer) r.coins += ab.coins;
            this.hooks.emit('bigAirLand', r, ab.coins);
          }
        }
      }
      r.gPrev = g;
      if (mode === M_GAP && r.y < tr.heightAt(r.s) - 7) this.respawn(r);
      // fell into the lake / off the world: only when actually below the local surface (some roads run below the
      // lake level after the lake, e.g. Horn Peak, and used to respawn racers every frame there)
      else if (r.y < tr.waterY - 9 && (mode === M_WATER || r.y < g - 2.5)) this.respawn(r);
    }

    // spin-out detection
    if (r.spinCool > 0) r.spinCool -= h;
    if (!r.spinning && !r.recover && !air && r.spinCool <= 0 && r.spd > 8 && !r.finished && (Math.abs(r.om) > 3.6 || slipMag > 1.2)) {
      r.spinning = true;
      r.spinT = 0;
      r.spins++;
      if (r.drift.on) this.finishDrift(r, false);
      this.hooks.emit('spinout', r);
    }
    if (r.spinning) {
      r.spinT += h;
      if ((Math.abs(r.om) < 1.1 && slipMag < 0.4) || r.spinT > 2.4) {
        r.spinning = false;
        r.spinCool = 0.8;
      }
    }

    if (!r.finished && r.s >= tr.finishS) {
      r.finished = true;
      const over = r.s - tr.finishS;
      r.finishTime = Math.max(0, this.time - over / Math.max(1, r.sdot));
      r.item = null;
      r.rouletteT = 0;
      r.boostT = 0;
      if (r.drift.on) this.finishDrift(r, false);
      this.hooks.emit('finish', r);
    }
    if (!r.isPlayer) {
      const p = this.player;
      let rb = 1;
      if (p && !p.finished) rb = 1 + clamp((p.s - r.s) / 450, -0.07, 0.08);
      r.speedMul = this.track.def.ai * r.ai.skill * this.aiBoost * rb;
    } else r.speedMul = 1;
  }

  // glider flight: steering banks, auto-pitch toward the ring line, dive on brake, thermals lift, soft floor/ceiling
  glide(r, h, F, u) {
    const tr = this.track;
    const base = tr.heightAt(r.s) + 0.6;
    let yT = base;
    const ring = this.nextRing(r);
    if (ring) yT = ring.y;
    // AI threads the cables (over or under); the player has to read them
    if (!r.isPlayer || this.autopilot) {
      for (const c of tr.cables) {
        const ds = c.s - r.s;
        if (ds < 2 || ds > 38) continue;
        if (Math.abs(yT - c.y) < 2.2 && hash01(r.idx * 3 + 1, Math.floor(c.s)) < 0.85) yT = c.y + (r.y > c.y ? 2.6 : -2.6);
      }
    }
    let cmd = clamp((yT - r.y) / Math.max(10, u * 0.85), -0.32, 0.3);
    if (r.brake) cmd = -0.42; // dive for speed
    const ceiling = base + 15;
    const floorY = tr.waterY + 1.6;
    if (r.y > ceiling) cmd = Math.min(cmd, -0.15);
    if (r.y < floorY + 2) cmd = Math.max(cmd, 0.12);
    r.pitchCmd = cmd;
    r.gamma += (cmd - r.gamma) * (1 - Math.exp(-2.6 * h));
    let vy = u * Math.sin(r.gamma);
    // thermals: rising air columns
    let lift = 0;
    for (const t of tr.thermals) {
      if (Math.abs(r.s - t.s) > t.r + 1) continue;
      const dd = r.d - t.d;
      const ds = r.s - t.s;
      if (ds * ds + dd * dd < t.r * t.r && r.y > t.y0 && r.y < t.y1 + 4) lift = Math.max(lift, t.lift);
    }
    if (lift > 0) {
      if (r.thermalT <= 0) {
        this.addCharge(r, 0.06, 'thermal');
        this.hooks.emit('thermal', r);
      }
      r.thermalT = 0.6;
      r.gamma = Math.max(r.gamma, 0.05);
    } else if (r.thermalT > 0) r.thermalT -= h;
    vy += lift;
    r.vy = vy;
    r.y += vy * h;
    if (r.y < floorY) {
      // skimming the sea: spray and drag, no crash
      r.y = floorY;
      r.vy = Math.max(0, r.vy);
      r.gamma = Math.max(r.gamma, 0);
      r.vx *= 1 - 0.6 * h;
      r.vz *= 1 - 0.6 * h;
      if (r.wallT <= 0) {
        this.hooks.emit('skim', r);
        r.wallT = 0.4;
      }
    }
    r.grounded = false;
    r.airT = 0;
  }
  nextRing(r) {
    const tr = this.track;
    const nb = tr.buckets.length;
    let best = null;
    let bs = 1e9;
    for (let b = Math.max(0, Math.floor(r.s / BUCKET)); b <= Math.min(nb - 1, Math.floor((r.s + 90) / BUCKET)); b++) {
      for (const f of tr.buckets[b]) {
        if (f.type !== 'ring' || r.lastRing === f.id) continue;
        const ds = f.s - r.s;
        if (ds < 2 || ds > 90) continue;
        // prefer the ring the racer is lined up with (lets the player pick high/low by steering)
        const score = ds + Math.abs(f.d - r.d) * 4 + (r.isPlayer || f.route === 'main' || f.route === r.ai.route ? 0 : 40);
        if (score < bs) {
          bs = score;
          best = f;
        }
      }
    }
    return best;
  }

  modeChange(r, from, to) {
    r.mode = to;
    const form = to === M_AIR ? 1 : to === M_WATER ? 2 : 0;
    if (to === M_AIR || from === M_AIR) {
      if (r.drift.on) this.finishDrift(r, false);
    }
    // a trick still running when the track turns into a glide section is dropped (the visual just finishes it)
    if (to === M_AIR) this.clearTricks(r);
    if (to === M_AIR) {
      r.gamma = 0.12;
      r.y = Math.max(r.y, this.track.heightAt(r.s) - 1);
      this.hooks.emit('launch', r);
    }
    if (from === M_AIR && to !== M_AIR && !r.finished) {
      // landing / splashdown skill check: level = boost, nose-down = wipeout
      const ang = Math.atan2(r.vy, Math.max(8, r.v));
      if (ang > -0.2 && Math.abs(r.om) < 1.4) {
        this.giveBoost(r, 1.3 * r.turboMul, 1.16);
        this.addCharge(r, 0.12, 'landing');
        this.hooks.emit('landing', r, 'perfect');
      } else if (ang < -0.36) {
        r.vx *= 0.55;
        r.vz *= 0.55;
        r.om += (this.rng() < 0.5 ? -1 : 1) * 4.5;
        r.spinning = true;
        r.spinT = 0;
        r.spins++;
        this.hooks.emit('wipeout', r);
      } else this.hooks.emit('landing', r, 'ok');
    }
    if (form !== r.form) {
      r.form = form;
      r.formT = 0;
      this.hooks.emit('transform', r, form);
    }
    if (to === M_WATER) {
      const g = this.track.waterY + this.wave(r.s, r.d);
      r.gPrev = g;
      if (from === M_ROAD) r.grounded = r.y <= g + 0.3;
    }
    if (from === M_AIR && to !== M_AIR) {
      r.grounded = false;
      r.airT = 0;
    }
  }

  respawn(r) {
    this.clearTricks(r);
    const tr = this.track;
    const s = tr.safeAfter(r.s + 6);
    const F = tr.frameInto(s, this._g);
    r.s = s;
    r.d = clamp(r.d * 0.3, -3, 3);
    r.mode = tr.modeAt(s);
    r.form = r.mode === M_WATER ? 2 : 0;
    r.formT = 1;
    r.y = tr.groundHeight(s, r.d) + (r.mode === M_WATER ? this.wave(s, r.d) : 0);
    r.gPrev = r.y;
    r.vy = 0;
    r.grounded = true;
    r.hw = F.psi;
    r.om = 0;
    r.vx = F.tx * 16;
    r.vz = F.tz * 16;
    r.v = 16;
    r.spinning = false;
    r.bigAir = false;
    if (r.drift.on) r.drift.on = false;
    r.invulnT = 1.6;
    r.respawns++;
    this.hooks.emit('respawn', r);
  }

  // ---------------------------------------------------------------- drifting
  updateDrift(r, h, mode) {
    const D = r.drift;
    const canStart = !r.finished && !r.spinning && r.v > 13 && (mode === M_WATER || (mode !== M_AIR && r.grounded));
    const st = r.steerTarget;
    const mag = Math.abs(st);
    const dir = st > 0 ? 1 : st < 0 ? -1 : 0;
    if (!D.on) {
      if (!canStart) {
        r.steerHoldT = 0;
        return;
      }
      if (r.manualDrift) {
        if (r.driftHeld && mag > 0.3) this.startDrift(r, dir, false, mode);
      } else if (r.autoDrift) {
        if (mag > 0.5 && dir === r.steerHoldDir) r.steerHoldT += h;
        else {
          r.steerHoldDir = dir;
          r.steerHoldT = mag > 0.5 ? h : 0;
        }
        if (r.steerHoldT > 0.32 && r.v > 18) this.startDrift(r, dir, true, mode);
      } else if (r.driftHeld && mag > 0.25) this.startDrift(r, dir, false, mode);
      return;
    }
    const silk = r.silkT > 0 ? ABILITIES.silkdrift.chargeMul : 1;
    D.t += h * r.driftRate * silk;
    if (r.lineT > 0 && D.t < 2.25) D.t = 2.25;
    this.addCharge(r, CHARGE.drift * h * (1 + D.level * 0.25));
    const lvl = D.t > 2.2 ? 3 : D.t > 1.25 ? 2 : D.t > 0.55 ? 1 : 0;
    if (lvl !== D.level) {
      D.level = lvl;
      if (lvl > 0) this.addCharge(r, CHARGE.driftLevel, 'drift');
      this.hooks.emit('driftLevel', r, lvl);
    }
    let end = r.finished || r.spinning || r.v < 9 || mode === M_AIR || (!r.grounded && mode !== M_WATER && r.airT > 0.5);
    if (D.auto) {
      if (mag < 0.2 || dir === -D.dir) D.rel += h;
      else D.rel = 0;
      if (D.rel > 0.12) end = true;
    } else if (!r.driftHeld) end = true;
    if (end) this.finishDrift(r, true);
  }
  startDrift(r, dir, auto, mode) {
    const D = r.drift;
    D.on = true;
    D.dir = dir;
    D.t = r.lineT > 0 ? 2.25 : 0;
    D.level = 0;
    D.auto = auto;
    D.rel = 0;
    r.hopT = 0.28;
    this.hooks.emit('driftStart', r);
  }
  // ---------------------------------------------------------------- ramp tricks (v5)
  takeoff(r, mode) {
    const rp = mode === M_AIR ? null : this.track.rampLipNear(r.s, r.d);
    // no tricks off glider kickers, or off a ramp that throws you straight into a glide section
    r.rampAir = !!(rp && rp.kind !== 'kick' && this.track.modeAt(r.s + 12) !== M_AIR);
    r.trickN = 0;
    r.trickOK = 0;
    r.trickT = 0;
    r.ai.trickLeft = 0;
    this.hooks.emit('air', r);
    if (!r.rampAir) return;
    this.hooks.emit('rampAir', r);
    if (r.trickBuf > 0) {
      r.trickBuf = 0;
      this.tryTrick(r);
    }
    if (!r.isPlayer || this.autopilot) this.planTricks(r);
  }
  // player pressed trick: in the air it starts one; on the last part of a ramp it is buffered for the take-off
  trickInput(r) {
    if (!r.grounded) {
      this.tryTrick(r);
      return;
    }
    const rp = this.track.rampAt(r.s, r.d);
    if (rp && rp.kind !== 'kick' && r.s > rp.s0 + rp.len * 0.35) r.trickBuf = 0.35;
  }
  tryTrick(r, kind) {
    if (r.grounded || !r.rampAir || r.trickT > 0 || r.trickN >= TRICK_MAX || r.spinning || r.finished) return false;
    r.trickN++;
    r.trickT = TRICK_T;
    r.trickSeq++;
    // 1 front flip, 2 / 3 barrel roll left / right, 4 back flip (brake); AI passes a kind
    const st = r.steerTarget;
    r.trickK = kind || (r.brake ? 4 : st < -0.35 ? 2 : st > 0.35 ? 3 : 1);
    this.hooks.emit('trick', r, r.trickK, r.trickN);
    return true;
  }
  // AI: how many tricks fit before landing (ballistic arc over the ground ahead), and whether it goes for them
  planTricks(r) {
    let land = 1.2;
    for (let k = 1; k <= 64; k++) {
      const t = k * 0.04;
      const y = r.y + r.vy * t - 0.5 * GV * t * t;
      if (y <= this.track.groundHeight(r.s + r.sdot * t, r.d)) {
        land = t;
        break;
      }
    }
    const fit = Math.min(TRICK_MAX, Math.floor((land - 0.08) / (TRICK_T + 0.05)));
    let n = 0;
    for (let i = 0; i < fit; i++) {
      if (this.rng() < 0.8 + (r.ai.skill - 1) * 4 - i * 0.2) n++;
      else break;
    }
    r.ai.trickLeft = n;
    r.ai.trickAt = 0.04 + this.rng() * 0.1;
  }
  clearTricks(r) {
    r.rampAir = false;
    r.trickT = 0;
    r.trickN = 0;
    r.trickOK = 0;
    r.trickBuf = 0;
    r.ai.trickLeft = 0;
  }
  landTricks(r) {
    let ok = r.trickOK;
    let sloppy = false;
    if (r.trickT > 0) {
      if (1 - r.trickT / TRICK_T >= TRICK_OK) ok++;
      else sloppy = true;
      r.trickT = 0;
    }
    r.rampAir = false;
    r.ai.trickLeft = 0;
    const n = Math.min(TRICK_MAX, ok);
    if (sloppy) {
      // greedy combo that did not finish: no boost and a little speed lost
      r.vx *= 0.9;
      r.vz *= 0.9;
      this.hooks.emit('trickFail', r);
    } else if (n > 0 && !r.spinning && !r.finished) {
      r.tricks += n;
      this.giveBoost(r, TRICK_BOOST[n] * r.turboMul * (1 + r.trickBonus), TRICK_POW[n]);
      this.addCharge(r, CHARGE.trick * n, 'trick');
      this.hooks.emit('trickLand', r, n);
    }
    r.trickN = 0;
    r.trickOK = 0;
  }
  finishDrift(r, reward) {
    const D = r.drift;
    const lvl = D.level;
    D.on = false;
    D.t = 0;
    D.level = 0;
    r.steerHoldT = 0;
    if (reward && lvl >= 1 && !r.spinning) {
      const silk = r.silkT > 0;
      const k = silk ? ABILITIES.silkdrift.boostMul : 1;
      this.giveBoost(r, [0, 0.55, 0.95, 1.4][lvl] * r.turboMul * k, [1, 1.0, 1.08, 1.16][lvl] + (silk ? 0.08 : 0));
      this.hooks.emit('driftBoost', r, lvl);
    }
    this.hooks.emit('driftEnd', r);
  }

  // ---------------------------------------------------------------- drafting
  drafting(h) {
    const R = this.racers;
    for (const a of R) {
      let best = 0;
      if (a.v > 15 && !a.finished) {
        for (const b of R) {
          if (b === a || b.v < 12) continue;
          const ds = b.s - a.s;
          if (ds < 2.5 || ds > 30) continue;
          if (Math.abs(b.y - a.y) > 2.5) continue;
          const lim = 2.2 + ds * 0.04;
          const dd = Math.abs(b.d - a.d);
          if (dd > lim) continue;
          best = Math.max(best, (1 - ds / 30) * (1 - (dd / lim) * 0.6));
        }
      }
      a.draft = damp(a.draft, best, best > a.draft ? 2.5 : 4, h);
      if (a.draft > 0.3) {
        a.draftT += h;
        this.addCharge(a, CHARGE.draft * h * a.draft);
      } else a.draftT = 0;
    }
  }

  // ---------------------------------------------------------------- contact
  collideRacers() {
    const R = this.racers;
    const tr = this.track;
    for (let i = 0; i < R.length; i++) {
      const a = R[i];
      for (let j = i + 1; j < R.length; j++) {
        const b = R[j];
        const ds = b.s - a.s;
        if (ds > 4 || ds < -4) continue;
        const dd = b.d - a.d;
        if (Math.abs(dd) > 4) continue;
        if (Math.abs(a.y - b.y) > 1.4) continue;
        const psi = tr.psiAt((a.s + b.s) * 0.5);
        this.obbContact(a, b, ds, dd, wrapPi(a.hw - psi), wrapPi(b.hw - psi), psi);
      }
    }
  }
  obbContact(a, b, ds, dd, pa, pb, psi) {
    const faS = Math.cos(pa), faD = Math.sin(pa);
    const fbS = Math.cos(pb), fbD = Math.sin(pb);
    const axes = [faS, faD, -faD, faS, fbS, fbD, -fbD, fbS];
    const cornersOf = (out, cs, cd, fS, fD, hl, hw) => {
      const rS = -fD;
      const rD = fS;
      let k = 0;
      for (const sl of [1, -1]) {
        for (const sw of [1, -1]) {
          out[k++] = cs + fS * hl * sl + rS * hw * sw;
          out[k++] = cd + fD * hl * sl + rD * hw * sw;
        }
      }
    };
    cornersOf(_A, 0, 0, faS, faD, a.halfL, a.halfW);
    cornersOf(_B, ds, dd, fbS, fbD, b.halfL, b.halfW);
    let minO = Infinity;
    let nS = 0;
    let nD = 0;
    let fromA = true;
    for (let k = 0; k < 4; k++) {
      const ax = axes[k * 2];
      const ay = axes[k * 2 + 1];
      let a0 = Infinity, a1 = -Infinity, b0 = Infinity, b1 = -Infinity;
      for (let q = 0; q < 4; q++) {
        const pA = _A[q * 2] * ax + _A[q * 2 + 1] * ay;
        const pB = _B[q * 2] * ax + _B[q * 2 + 1] * ay;
        if (pA < a0) a0 = pA;
        if (pA > a1) a1 = pA;
        if (pB < b0) b0 = pB;
        if (pB > b1) b1 = pB;
      }
      const o = Math.min(a1, b1) - Math.max(a0, b0);
      if (o <= 0) return;
      if (o < minO) {
        minO = o;
        nS = ax;
        nD = ay;
        fromA = k < 2;
      }
    }
    if (ds * nS + dd * nD < 0) {
      nS = -nS;
      nD = -nD;
    }
    let cS = 0;
    let cD = 0;
    {
      const C = fromA ? _B : _A;
      const sg = fromA ? 1 : -1;
      let best = Infinity;
      for (let q = 0; q < 4; q++) best = Math.min(best, sg * (C[q * 2] * nS + C[q * 2 + 1] * nD));
      let cnt = 0;
      for (let q = 0; q < 4; q++) {
        if (sg * (C[q * 2] * nS + C[q * 2 + 1] * nD) <= best + 0.12) {
          cS += C[q * 2];
          cD += C[q * 2 + 1];
          cnt++;
        }
      }
      cS /= cnt;
      cD /= cnt;
    }
    const raS = cS;
    const raD = cD;
    const rbS = cS - ds;
    const rbD = cD - dd;
    const tS = Math.sin(psi);
    const tZ = -Math.cos(psi);
    const rX = Math.cos(psi);
    const rZ = Math.sin(psi);
    const vaS = a.vx * tS + a.vz * tZ;
    const vaD = a.vx * rX + a.vz * rZ;
    const vbS = b.vx * tS + b.vz * tZ;
    const vbD = b.vx * rX + b.vz * rZ;
    const pvaS = vaS - a.om * raD;
    const pvaD = vaD + a.om * raS;
    const pvbS = vbS - b.om * rbD;
    const pvbD = vbD + b.om * rbS;
    const vrS = pvbS - pvaS;
    const vrD = pvbD - pvaD;
    const vn = vrS * nS + vrD * nD;
    const shA = a.shieldT > 0;
    const shB = b.shieldT > 0;
    const ramA = a.ramT > 0;
    const ramB = b.ramT > 0;
    const RM = ABILITIES.ramplate.mass;
    const ma = a.mass * (shA ? 3 : 1) * (ramA ? RM : 1);
    const mb = b.mass * (shB ? 3 : 1) * (ramB ? RM : 1);
    const Ia = a.inertia * (shA ? 3 : 1) * (ramA ? RM : 1);
    const Ib = b.inertia * (shB ? 3 : 1) * (ramB ? RM : 1);
    const corr = Math.min(0.6, minO + 0.01);
    const wa = mb / (ma + mb);
    const wb = ma / (ma + mb);
    a.s -= nS * corr * wa;
    a.d -= nD * corr * wa;
    b.s += nS * corr * wb;
    b.d += nD * corr * wb;
    if (vn >= 0) return;
    const raxn = raS * nD - raD * nS;
    const rbxn = rbS * nD - rbD * nS;
    const den = 1 / ma + 1 / mb + (raxn * raxn) / Ia + (rbxn * rbxn) / Ib;
    const jn = (-(1 + 0.25) * vn) / den;
    const tSv = -nD;
    const tDv = nS;
    const vt = vrS * tSv + vrD * tDv;
    const raxt = raS * tDv - raD * tSv;
    const rbxt = rbS * tDv - rbD * tSv;
    const denT = 1 / ma + 1 / mb + (raxt * raxt) / Ia + (rbxt * rbxt) / Ib;
    const jt = clamp(-vt / denT, -0.35 * jn, 0.35 * jn);
    const PS = jn * nS + jt * tSv;
    const PD = jn * nD + jt * tDv;
    let dOmA = -(raS * PD - raD * PS) / Ia;
    let dOmB = (rbS * PD - rbD * PS) / Ib;
    const behindB = rbS * fbS + rbD * fbD;
    const behindA = raS * faS + raD * faD;
    const pit = -vn > 3 ? 2.0 : 1.0;
    if (behindB < -0.35 * b.halfL && Math.abs(nS * fbS + nD * fbD) < 0.6) dOmB *= pit;
    if (behindA < -0.35 * a.halfL && Math.abs(nS * faS + nD * faD) < 0.6) dOmA *= pit;
    if (shA) dOmB *= 1.4;
    if (shB) dOmA *= 1.4;
    const dvaS = -PS / ma;
    const dvaD = -PD / ma;
    const dvbS = PS / mb;
    const dvbD = PD / mb;
    const ka = ramA ? 0.1 : 1;
    const kb = ramB ? 0.1 : 1;
    a.vx += (dvaS * tS + dvaD * rX) * ka;
    a.vz += (dvaS * tZ + dvaD * rZ) * ka;
    b.vx += (dvbS * tS + dvbD * rX) * kb;
    b.vz += (dvbS * tZ + dvbD * rZ) * kb;
    a.om = clamp(a.om + dOmA * ka, -9, 9);
    b.om = clamp(b.om + dOmB * kb, -9, 9);
    if (-vn > 1.2 && (a.bumpT <= 0 || b.bumpT <= 0)) {
      a.bumpT = b.bumpT = 0.25;
      this.hooks.emit('bump', a, b, -vn);
      // the kart that took less knockback "won" the contact
      const dva = Math.hypot(dvaS, dvaD) * ka;
      const dvb = Math.hypot(dvbS, dvbD) * kb;
      if (-vn > 2.2) this.addCharge(dva < dvb ? a : b, CHARGE.bumpWin, 'bump');
    }
    if (ramA && !ramB && -vn > 1.2) {
      if (this.hit(b, 'ram', a)) this.hooks.emit('ram', a, b);
    }
    if (ramB && !ramA && -vn > 1.2) {
      if (this.hit(a, 'ram', b)) this.hooks.emit('ram', b, a);
    }
    if (shA && !shB && -vn > 2) this.hit(b, 'bump', a);
    if (shB && !shA && -vn > 2) this.hit(a, 'bump', b);
  }

  collideStatic(r, h) {
    const tr = this.track;
    const nb = tr.buckets.length;
    const b0 = Math.max(0, Math.floor((r.s - 6) / BUCKET));
    const b1 = Math.min(nb - 1, Math.floor((r.s + 6) / BUCKET));
    const hopping = r.bigAir && !r.grounded;
    for (let b = b0; b <= b1; b++) {
      for (const o of tr.buckets[b]) {
        if (o.type !== 'obs') continue;
        if (o.y1 !== undefined) {
          if (r.y < o.y0 - 1 || r.y > o.y1 + 0.8) continue;
        } else if (Math.abs(r.y - o.y) > o.r + 1.6) continue;
        if (hopping && o.kind === 'reef' && r.y > o.y + 0.9) continue;
        this.pushCircle(r, o.s, o.d, o.r + 0.9, 0.3, 'obstacle', o);
      }
    }
    for (const t of tr.tumble) {
      if (Math.abs(r.s - t.s) > 3 || hopping) continue;
      if (this.pushCircle(r, t.s, t.d, t.r + 0.9, 0.5, 'tumble', t)) t.ph += 0.9;
    }
    // glide cables + gondolas
    if (r.mode === M_AIR) {
      for (const c of tr.cables) {
        const ds = r.s - c.s;
        if (Math.abs(ds) > 3) continue;
        const prevS = r.s - r.sdot * h;
        if ((prevS - c.s) * ds <= 0 && Math.abs(r.y - c.y) < 0.75 && r.invulnT <= 0) {
          r.vx *= 0.7;
          r.vz *= 0.7;
          r.om += (this.rng() < 0.5 ? -1 : 1) * 2.2;
          r.invulnT = 0.8;
          this.hooks.emit('cable', r, c);
        }
        if (c.gond) {
          const gd = Math.sin(this.time * c.w + c.ph) * 9;
          const gy = c.y - 1.7;
          if (Math.abs(r.y - gy) < 1.6) this.pushCircle(r, c.s, gd, 2.1, 0.3, 'obstacle', c);
        }
      }
    }
  }
  pushCircle(r, cs, cd, rad, e, kind, obj) {
    const ds = r.s - cs;
    const dd = r.d - cd;
    const d2 = ds * ds + dd * dd;
    if (d2 > rad * rad) return false;
    const dist = Math.sqrt(d2) || 0.01;
    const nS = ds / dist;
    const nD = dd / dist;
    r.s = cs + nS * rad;
    r.d = cd + nD * rad;
    const psi = this.track.psiAt(r.s);
    const tS = Math.sin(psi);
    const tZ = -Math.cos(psi);
    const rX = Math.cos(psi);
    const rZ = Math.sin(psi);
    const vS = r.vx * tS + r.vz * tZ;
    const vD = r.vx * rX + r.vz * rZ;
    const vn = vS * nS + vD * nD;
    if (vn < 0) {
      const dS = -(1 + e) * vn * nS;
      const dD = -(1 + e) * vn * nD;
      r.vx += dS * tS + dD * rX;
      r.vz += dS * tZ + dD * rZ;
      r.vx *= kind === 'tumble' ? 0.9 : 0.85;
      r.vz *= kind === 'tumble' ? 0.9 : 0.85;
      r.om += clamp((vS * nD - vD * nS) * 0.12, -2.5, 2.5) * (kind === 'tumble' ? 0.6 : 1);
      if (-vn > 2 && r.wallT <= 0) {
        r.wallT = 0.3;
        this.hooks.emit(kind, r, -vn, obj);
      }
    }
    return true;
  }

  updateTumble(h) {
    for (const t of this.track.tumble) {
      const prev = t.d;
      t.d = Math.sin(this.time * t.w + t.ph) * t.amp;
      t.roll += (t.d - prev) / 0.8;
    }
  }

  // ---------------------------------------------------------------- pickups
  interact(r) {
    const tr = this.track;
    const s = r.s;
    const nb = tr.buckets.length;
    const b0 = Math.max(0, Math.floor((s - 4) / BUCKET));
    const b1 = Math.min(nb - 1, Math.floor((s + 4) / BUCKET));
    const cy = r.y + 0.7;
    for (let b = b0; b <= b1; b++) {
      const list = tr.buckets[b];
      for (let q = 0; q < list.length; q++) {
        const f = list[q];
        const ds = s - f.s;
        const dd = r.d - f.d;
        switch (f.type) {
          case 'pad':
            if ((r.grounded || r.mode === M_WATER) && Math.abs(ds) < f.len / 2 && Math.abs(dd) < f.w / 2 + 0.5 && !r.finished && Math.abs(r.y - tr.surfaceY(f.s, f.d)) < 1.5) {
              if (r.lastPad !== f.id) {
                r.lastPad = f.id;
                this.addCharge(r, CHARGE.pad);
                this.hooks.emit('pad', r, f);
              }
              this.giveBoost(r, 1.05 * r.turboMul, 1.0);
            }
            break;
          case 'ring':
            if (r.lastRing !== f.id && Math.abs(ds) < 1.8 && dd * dd + (cy - 0.7 - f.y) ** 2 < (f.r - 0.4) ** 2 && !r.finished) {
              r.lastRing = f.id;
              r.ringsHit++;
              this.giveBoost(r, 0.85 * r.turboMul, 1.05);
              this.addCharge(r, CHARGE.ring, 'ring');
              this.hooks.emit('ring', r, f);
            }
            break;
          case 'gate':
            if (r.lastGate !== f.id && Math.abs(ds) < 1.2 && Math.abs(dd) < f.w - 0.4 && !r.finished) {
              r.lastGate = f.id;
              this.giveBoost(r, 0.6 * r.turboMul, 1.04);
              this.addCharge(r, CHARGE.gate, 'gate');
              this.hooks.emit('gate', r, f);
            }
            break;
          case 'orb':
            if (ITEMS_ON && f.active && ds * ds + dd * dd < 1.9 * 1.9 && Math.abs(cy - f.y) < 2.2) {
              f.active = false;
              f.t = 2.5;
              this.hooks.emit('orb', r, f);
              if (!r.item && r.rouletteT <= 0 && !r.finished) {
                r.rouletteT = r.isPlayer ? 1.1 : 1.0;
                r.pendingItem = rollItem(this.rng, this.placeFrac(r));
                this.hooks.emit('roulette', r);
              }
            }
            break;
          case 'coin':
            if (r.isPlayer && !f.taken && ds * ds + dd * dd < 1.8 * 1.8 && Math.abs(cy - f.y) < 1.7) {
              f.taken = true;
              r.coins++;
              this.hooks.emit('coin', r, f);
            }
            break;
          case 'tape':
            if (!f.taken && r.isPlayer && Math.abs(ds) < 1.7 && Math.abs(dd) < 1.9 && Math.abs(r.y + 0.7 - f.y) < 2.2) {
              f.taken = true;
              this.hooks.emit('tape', r, f);
            }
            break;
          case 'boom':
            if (f.alive && f.fuse < 0 && Math.abs(ds) < f.r + 1.0 && Math.abs(dd) < f.r + r.halfW && r.y - f.y < 1.7 && r.mode !== M_AIR) this.detonate(f, r);
            break;
          case 'crate':
            if (f.alive && Math.abs(ds) < 1.45 && Math.abs(dd) < 1.5 && r.y < f.y + 1.25) {
              f.alive = false;
              if (r.boostT <= 0 && r.shieldT <= 0 && r.ramT <= 0) {
                r.vx *= 0.62;
                r.vz *= 0.62;
              }
              r.om += (dd >= 0 ? 1 : -1) * 0.8 * (r.ramT > 0 ? 0.2 : 1);
              this.hooks.emit('crate', r, f);
            } else if (f.alive && r.nearCool <= 0 && r.spd > 20 && Math.abs(ds) < 1.0 && Math.abs(dd) < 2.6 && Math.abs(dd) >= 1.5 && r.y < f.y + 1.25) {
              r.nearCool = 1.2;
              this.addCharge(r, CHARGE.nearMiss * 0.6, 'nearMiss');
              this.hooks.emit('nearMiss', r, f);
            }
            break;
        }
      }
    }
    if (ITEMS_ON) {
      for (const p of this.puddles) {
        if (!p.alive) continue;
        if (p.owner === r && p.age < 1.2) continue;
        if (Math.abs(s - p.s) < 1.9 && Math.abs(r.d - p.d) < 1.9 && Math.abs(r.y - p.y) < 1.6) {
          p.alive = false;
          this.hooks.emit('puddleHit', p, r);
          this.hit(r, 'honey', p.owner);
        }
      }
    }
  }

  hit(r, cause, by) {
    if (r.finished) return false;
    if (r.shieldT > 0) {
      r.shieldT = 0;
      r.invulnT = Math.max(r.invulnT, 0.6);
      this.hooks.emit('shieldPop', r, cause, by);
      return false;
    }
    if (r.ramT > 0 && cause !== 'decoy') return false;
    if (r.invulnT > 0) return false;
    const k = cause === 'honey' ? 0.6 : cause === 'bump' || cause === 'ram' ? 0.75 : cause === 'decoy' ? 0.62 : 0.5;
    r.vx *= k;
    r.vz *= k;
    r.om += (this.rng() < 0.5 ? -1 : 1) * (cause === 'honey' ? 5.5 : cause === 'bump' || cause === 'ram' ? 5 : 7.5);
    r.spinning = true;
    r.spinT = 0;
    r.spins++;
    if (r.drift.on) this.finishDrift(r, false);
    r.boostT = 0;
    r.invulnT = 2.3;
    r.hits++;
    if (cause === 'honey') r.honeyT = 1.6;
    this.hooks.emit('spin', r, cause, by);
    return true;
  }

  // ---------------------------------------------------------------- chaos: explosive barrels
  // Fun, not punishing: the blast pops karts into the air (air time + trick charge), shoves them sideways and only
  // spins out rivals right next to it. Nearby barrels go off in a short chain.
  detonate(f, by) {
    if (!f.alive) return;
    f.alive = false;
    f.fuse = -1;
    f.t = BOOM_RESPAWN;
    const F = this.track.frameInto(f.s, this._g);
    this.hooks.emit('explode', f, by);
    let blasted = 0;
    for (const r of this.racers) {
      if (r.finished || r.mode === M_AIR) continue;
      const ds = r.s - f.s;
      const dd = r.d - f.d;
      const dist = Math.hypot(ds, dd);
      if (dist > BOOM_R) continue;
      const k = 1 - dist / BOOM_R;
      const guard = r.shieldT > 0 || r.ramT > 0 ? 0.45 : 1;
      const self = r === by;
      if (r.mode !== M_WATER) {
        r.vy = Math.max(r.vy, (self ? 8.4 : 2.5 + 6 * k) * guard);
        r.grounded = false;
        r.airT = 0;
        r.trickDone = false;
      }
      const dir = dd >= 0 ? 1 : -1;
      const push = (self ? 2.2 : 7 * k) * guard;
      r.vx += F.rx * dir * push;
      r.vz += F.rz * dir * push;
      const keep = self ? 0.94 : 1 - 0.08 * k * guard;
      r.vx *= keep;
      r.vz *= keep;
      r.om += (this.rng() < 0.5 ? -1 : 1) * (self ? 1.2 : 3 * k) * guard;
      if (!self && k > 0.86 && guard === 1 && this.hit(r, 'boom', by)) blasted++;
      else if (!self) this.hooks.emit('blasted', r, f, k);
    }
    if (by && blasted) this.addCharge(by, CHARGE.boom * blasted, 'boom');
    // chain reaction
    let j = 0;
    for (const o of this.track.booms) {
      if (!o.alive || o.fuse >= 0) continue;
      if (Math.hypot(o.s - f.s, o.d - f.d) < 5.6) {
        o.fuse = 0.14 + 0.09 * j++;
        o.by = by;
      }
    }
  }

  updateBooms(h) {
    for (const f of this.track.booms) {
      if (f.fuse >= 0) {
        f.fuse -= h;
        if (f.fuse <= 0) this.detonate(f, f.by);
      } else if (!f.alive) {
        f.t -= h;
        if (f.t <= 0) {
          let clear = true;
          for (const r of this.racers) if (Math.abs(r.s - f.s) < 14) clear = false;
          if (clear) {
            f.alive = true;
            this.hooks.emit('boomBack', f);
          }
        }
      }
    }
  }

  // ---------------------------------------------------------------- abilities
  useAbility(r) {
    if (ITEMS_ON) return this.useItem(r);
    if ((!r.abilityReady && !r.remote) || r.finished || !this.running) return false;
    const id = r.abilityId;
    const ab = ABILITIES[id];
    if (!ab) return false;
    r.charge = 0;
    r.abilUses++;
    r.abilT = ab.dur;
    switch (id) {
      case 'afterimage': {
        this.giveBoost(r, ab.dur * r.turboMul, ab.dashPow);
        this.decoys.push({ id: ++this.uid, s: Math.max(0, r.s - 1.2), d: r.d, y: r.y, hw: r.hw, life: ab.decoyLife, age: 0, owner: r, alive: true });
        this.hooks.emit('decoy', r, this.decoys[this.decoys.length - 1]);
        break;
      }
      case 'ramplate':
        r.ramT = ab.dur;
        break;
      case 'perfectline':
        r.lineT = ab.dur;
        if (r.drift.on && r.drift.t < 2.25) r.drift.t = 2.25;
        break;
      case 'bigair':
        if (r.mode === M_AIR) {
          r.y += 0.5;
          this.giveBoost(r, ab.landBoost * r.turboMul, ab.landPow);
        } else {
          r.vy = ab.vy;
          r.grounded = false;
          r.airT = 0;
          r.trickDone = false;
          r.bigAir = true;
          if (r.drift.on) this.finishDrift(r, true);
        }
        break;
      case 'silkdrift':
        r.silkT = ab.dur;
        break;
      case 'overdrive':
        r.burnT = ab.dur;
        this.giveBoost(r, ab.dur * r.turboMul, ab.pow);
        break;
    }
    this.hooks.emit('ability', r, id);
    return true;
  }
  updateAbilities(h) {
    for (const r of this.racers) {
      if (r.abilT > 0) {
        r.abilT -= h;
        if (r.abilT <= 0) {
          r.abilT = 0;
          this.hooks.emit('abilityEnd', r, r.abilityId);
        }
      } else if (!r.finished) this.addCharge(r, CHARGE.base * h);
      if (r.ramT > 0) r.ramT = Math.max(0, r.ramT - h);
      if (r.lineT > 0) r.lineT = Math.max(0, r.lineT - h);
      if (r.silkT > 0) r.silkT = Math.max(0, r.silkT - h);
      if (r.burnT > 0) {
        r.burnT = Math.max(0, r.burnT - h);
        const ab = ABILITIES.overdrive;
        for (const o of this.racers) {
          if (o === r || o.finished) continue;
          const ds = r.s - o.s;
          if (ds > 1.5 && ds < ab.scorchRange && Math.abs(o.d - r.d) < ab.scorchLat && Math.abs(o.y - r.y) < 2) {
            if (o.scorchT <= 0) this.hooks.emit('scorch', r, o);
            o.scorchT = 0.7;
          }
        }
      }
      // near misses while overtaking: fast, close, no contact
      if (!r.finished && r.nearCool <= 0 && r.spd > 18) {
        for (const o of this.racers) {
          if (o === r) continue;
          const ds = o.s - r.s;
          const dd = Math.abs(o.d - r.d);
          if (ds > -0.6 && ds < 0.6 && dd > 1.8 && dd < 3.0 && r.v - o.v > 3 && r.bumpT <= 0 && Math.abs(o.y - r.y) < 1.5) {
            r.nearCool = 1.5;
            this.addCharge(r, CHARGE.nearMiss, 'nearMiss');
            this.hooks.emit('nearMiss', r, o);
            break;
          }
        }
      }
    }
  }
  updateDecoys(h) {
    for (const k of this.decoys) {
      if (!k.alive) continue;
      k.age += h;
      if (k.age >= k.life) {
        k.alive = false;
        this.hooks.emit('decoyGone', k);
        continue;
      }
      for (const o of this.racers) {
        if (o === k.owner || o.finished) continue;
        if (Math.abs(o.s - k.s) < 1.9 && Math.abs(o.d - k.d) < 1.5 && Math.abs(o.y - k.y) < 1.6) {
          k.alive = false;
          this.hooks.emit('decoyHit', k, o);
          this.hit(o, 'decoy', k.owner);
          break;
        }
      }
    }
    let w = 0;
    for (let i = 0; i < this.decoys.length; i++) if (this.decoys[i].alive) this.decoys[w++] = this.decoys[i];
    this.decoys.length = w;
  }

  // ---------------------------------------------------------------- legacy items (ITEMS_ON)
  useItem(r) {
    if (!r.item || r.rouletteT > 0 || r.finished || !this.running) return false;
    const it = r.item;
    r.item = null;
    r.itemHeld = 0;
    switch (it) {
      case 'turbo':
        this.giveBoost(r, 1.7 * r.turboMul, 1.15);
        break;
      case 'mega':
        this.giveBoost(r, 3.0 * r.turboMul, 1.4);
        break;
      case 'shield':
        r.shieldT = 10;
        break;
      case 'honey': {
        const ps = Math.max(0, r.s - 3.6);
        const pd = clamp(r.d, -ROAD_HW, ROAD_HW);
        const y = r.mode === M_AIR ? r.y : this.track.surfaceY(ps, pd);
        this.puddles.push({ id: ++this.uid, s: ps, d: pd, y, alive: true, age: 0, life: 28, owner: r, air: r.mode === M_AIR });
        break;
      }
      case 'rocket': {
        const target = this.nextAhead(r);
        this.rockets.push({ id: ++this.uid, s: r.s + 2.6, d: r.d, y: r.y + 0.8, v: Math.max(r.v + 24, 50), owner: r, target, life: 7, alive: true });
        break;
      }
    }
    this.hooks.emit('use', r, it);
    return true;
  }

  updateRockets(h) {
    const tr = this.track;
    for (const k of this.rockets) {
      if (!k.alive) continue;
      k.life -= h;
      let t = k.target;
      if (t && (t.finished || t.s < k.s - 6)) t = k.target = null;
      if (t) k.d = damp(k.d, t.d, 5, h);
      k.s += k.v * h;
      k.d = clamp(k.d, -WALL_HW + 1.2, WALL_HW - 1.2);
      const surf = tr.modeAt(k.s) === M_AIR ? tr.heightAt(k.s) + 0.6 : tr.surfaceY(k.s, k.d) + 0.85;
      k.y = t && Math.abs(t.s - k.s) < 25 ? damp(k.y, t.y + 0.7, 8, h) : damp(k.y, surf, 10, h);
      for (const r of this.racers) {
        if (r === k.owner) continue;
        if (Math.abs(r.s - k.s) < 1.8 && Math.abs(r.d - k.d) < 1.5 && Math.abs(r.y + 0.6 - k.y) < 2) {
          k.alive = false;
          this.hooks.emit('boom', k, r);
          this.hit(r, 'rocket', k.owner);
          break;
        }
      }
      if (k.alive && (k.life <= 0 || k.s > tr.length - 20)) {
        k.alive = false;
        this.hooks.emit('boom', k, null);
      }
    }
    let w = 0;
    for (let i = 0; i < this.rockets.length; i++) if (this.rockets[i].alive) this.rockets[w++] = this.rockets[i];
    this.rockets.length = w;
  }

  updatePuddles(h) {
    for (const p of this.puddles) {
      if (!p.alive) continue;
      p.age += h;
      if (p.age >= p.life) {
        p.alive = false;
        this.hooks.emit('puddleGone', p);
      }
    }
    let w = 0;
    for (let i = 0; i < this.puddles.length; i++) if (this.puddles[i].alive) this.puddles[w++] = this.puddles[i];
    this.puddles.length = w;
  }

  updateOrbs(h) {
    for (const o of this.track.orbs) {
      if (o.active) continue;
      o.t -= h;
      if (o.t <= 0) {
        o.t = 0;
        o.active = true;
      }
    }
  }

  // places + overtake events
  updatePlaces(silent) {
    const arr = this.sorted;
    const before = arr.map((r) => r.idx);
    arr.sort((a, b) => {
      if (a.finished && b.finished) return a.finishTime - b.finishTime;
      if (a.finished) return -1;
      if (b.finished) return 1;
      return b.s - a.s;
    });
    for (let i = 0; i < arr.length; i++) arr[i].place = i + 1;
    if (silent || !this.running || this.time < 2.5) return;
    for (let i = 0; i < arr.length; i++) {
      const a = arr[i];
      const oldI = before.indexOf(a.idx);
      if (oldI <= i || a.finished) continue;
      // a moved up: everyone that was ahead of a and is now behind got passed
      for (let j = i + 1; j < arr.length; j++) {
        const b = arr[j];
        if (b.finished) continue;
        const oj = before.indexOf(b.idx);
        if (oj < oldI && Math.abs(a.s - b.s) < 14) {
          const key = a.idx * 8 + b.idx;
          const last = this.passCool.get(key) || -99;
          if (this.time - last < 3) continue;
          this.passCool.set(key, this.time);
          this.hooks.emit('overtake', a, b);
          this.hooks.emit('overtaken', b, a);
        }
      }
    }
  }

  // ---------------------------------------------------------------- AI
  aiThink(r, h) {
    const tr = this.track;
    const ai = r.ai;
    const mode = tr.modeAt(r.s);
    ai.biasT -= h;
    if (ai.biasT <= 0) {
      ai.biasT = 1.5 + this.rng() * 2.5;
      ai.biasGoal = (this.rng() * 2 - 1) * 2.4;
    }
    ai.bias = damp(ai.bias, ai.biasGoal, 1, h);
    const look = 20 + Math.max(0, r.v) * 0.9;
    let kSum = 0;
    let cnt = 0;
    for (let x = r.s + 10; x <= r.s + 10 + look; x += 8) {
      kSum += tr.kappaAt(x);
      cnt++;
    }
    const kAvg = cnt ? kSum / cnt : 0;
    let target = clamp(kAvg * 220, -1, 1) * 4.6 + ai.bias;
    if (r.lineT > 0) target = tr.lineAt(r.s + 12);
    if (r.finished) target = r.d;
    const nb = tr.buckets.length;
    const bA = Math.max(0, Math.floor((r.s + (mode === M_AIR ? 0 : 6)) / BUCKET));
    const bB = Math.min(nb - 1, Math.floor((r.s + 60) / BUCKET));
    if (!r.finished) {
      let seekD = null;
      let seekDist = Infinity;
      const wantItem = ITEMS_ON && !r.item && r.rouletteT <= 0 && hash01(r.idx * 7 + 3, Math.floor(r.s / 250)) < ai.orbPick;
      for (let b = bA; b <= bB; b++) {
        for (const f of tr.buckets[b]) {
          const ds = f.s - r.s;
          if (ds > 60 || ds < (f.type === 'ring' ? 0.5 : 6)) continue;
          if (f.type === 'ring' && r.lastRing !== f.id && (f.route === 'main' || f.route === ai.route || !f.route)) {
            const dd = Math.abs(f.d - target);
            if (ds < seekDist + 30 && dd < 12) {
              seekDist = ds;
              seekD = f.d;
            }
          } else if (f.type === 'gate' && r.lastGate !== f.id && hash01(r.idx * 17 + 2, f.id) < ai.padPick + 0.25) {
            if (ds < seekDist + 10) {
              seekDist = ds;
              seekD = f.d;
            }
          } else if (wantItem && f.type === 'orb' && f.active) {
            const dd = Math.abs(f.d - target);
            if (dd < seekDist) {
              seekDist = dd;
              seekD = f.d;
            }
          } else if (!wantItem && f.type === 'pad' && r.boostT <= 0 && hash01(r.idx * 31 + 1, f.id) < ai.padPick) {
            const dd = Math.abs(f.d - target);
            if (dd < 7 && dd < seekDist) {
              seekDist = dd;
              seekD = f.d;
            }
          }
        }
      }
      if (seekD !== null) target = seekD;
      if (Math.abs(kAvg) < 1 / 220 && mode !== M_AIR) {
        const ahead = this.nextAhead(r);
        if (ahead) {
          const ds = ahead.s - r.s;
          if (ds > 6 && ds < 28 && Math.abs(ahead.d - r.d) < 4.5 && seekD === null) target = ahead.d;
          else if (ds > 1 && ds <= 6 && r.v > ahead.v + 0.5) target = ahead.d + (r.d >= ahead.d ? 2.9 : -2.9);
        }
      }
      ai.leanT -= h;
      for (const o of this.racers) {
        if (o === r || o.finished) continue;
        const ds = o.s - r.s;
        const dd = o.d - r.d;
        const aggro = ai.aggro * (r.ramT > 0 ? 6 : 1);
        if (Math.abs(ds) < 2.4 && Math.abs(dd) > 1.6 && Math.abs(dd) < 3.6 && ai.leanT <= 0 && this.rng() < aggro * h * 1.5) {
          ai.leanT = 1.2;
          ai.leanD = Math.sign(dd) * 1.3;
        }
      }
      if (ai.leanT > 0) target += ai.leanD || 0;
      const bC = Math.min(nb - 1, Math.floor((r.s + 40) / BUCKET));
      for (let b = Math.max(0, Math.floor((r.s + 2) / BUCKET)); b <= bC; b++) {
        for (const f of tr.buckets[b]) {
          const ds = f.s - r.s;
          if (ds < 2 || ds > 40) continue;
          // most AIs steer round barrels; a few blunder into them (chaos)
          if ((f.type === 'crate' && f.alive) || f.type === 'obs' || (f.type === 'boom' && f.alive && hash01(r.idx * 31 + 5, f.id) < 0.8)) {
            if (f.y1 !== undefined && (r.y > f.y1 + 2 || r.y < f.y0)) continue;
            const rr = f.type === 'obs' ? f.r + 2.2 : f.type === 'boom' ? 2.4 : 2.6;
            if (Math.abs(f.d - target) < rr) target = this.dodge(target, f.d, rr + 0.3);
          }
        }
      }
      for (const t of tr.tumble) {
        const ds = t.s - r.s;
        if (ds < 2 || ds > 45) continue;
        const tt = ds / Math.max(8, r.v);
        const dAt = Math.sin((this.time + tt) * t.w + t.ph) * t.amp;
        if (Math.abs(dAt - target) < 2.6) target = this.dodge(target, dAt, 2.9);
      }
      if (mode === M_AIR) {
        for (const c of tr.cables) {
          if (!c.gond) continue;
          const ds = c.s - r.s;
          if (ds < 2 || ds > 40) continue;
          const tt = ds / Math.max(8, r.v);
          const gd = Math.sin((this.time + tt) * c.w + c.ph) * 9;
          if (Math.abs(gd - target) < 3) target = this.dodge(target, gd, 3.4);
        }
      }
      for (const p of this.puddles) {
        const ds = p.s - r.s;
        if (ds < 2 || ds > 40) continue;
        if (Math.abs(p.d - target) < 2.6) target = this.dodge(target, p.d, 2.8);
      }
      for (const k of this.decoys) {
        if (k.owner === r) continue;
        const ds = k.s - r.s;
        if (ds < 2 || ds > 30) continue;
        // AI sometimes falls for the decoy
        if (Math.abs(k.d - target) < 2.6 && hash01(r.idx * 5 + 9, k.id) < 0.55) target = this.dodge(target, k.d, 2.9);
      }
      for (const o of this.racers) {
        if (o === r) continue;
        const ds = o.s - r.s;
        if (ds > 1.5 && ds < 18 && Math.abs(o.d - r.d) < 2.4 && (o.spinning || o.v < r.v - 4)) target = o.d + (r.d >= o.d ? 3 : -3);
      }
    }
    const wl = tr.wallAt(r.s) - 1.6;
    target = clamp(target, -Math.min(wl, ROAD_HW + 1), Math.min(wl, ROAD_HW + 1));
    if (mode === M_AIR) target = clamp(target, -wl, wl);
    ai.targetD = damp(ai.targetD, target, mode === M_AIR ? 6 : 3, h);
    const F = tr.frameInto(r.s, this._g);
    const vs = r.vx * F.tx + r.vz * F.tz;
    const vd = r.vx * F.rx + r.vz * F.rz;
    const psiV = Math.atan2(vd, Math.max(2, vs));
    const err = ai.targetD - r.d;
    const L = Math.max(10, r.v * 0.9);
    const psiDes = clamp(Math.atan2(err, L), -0.45, 0.45);
    const yawCmd = F.kappa * vs + (psiDes - psiV) * 3.2;
    const cap = this.yawCapacity(r);
    r.steerTarget = cap > 0.01 ? clamp(yawCmd / cap, -1, 1) : 0;
    // glider: dive when the next ring is well below (speed), otherwise let auto-pitch work
    if (mode === M_AIR && !r.finished) {
      const ring = this.nextRing(r);
      r.brake = !!(ring && ring.y < r.y - 5 && ring.s - r.s < 50);
    }
    if (!r.finished && mode !== M_AIR) {
      let kA = 0;
      let n = 0;
      for (let x = r.s + 4; x <= r.s + 36; x += 8) {
        kA += tr.kappaAt(x);
        n++;
      }
      kA /= n;
      const keen = r.silkT > 0 ? 0.6 : 1;
      if (!r.drift.on && r.lineT > 0) r.driftHeld = Math.abs(kA) > 1 / 200 && r.v > 16 && Math.sign(kA) * r.steerTarget > 0.1;
      else if (!r.drift.on) r.driftHeld = Math.abs(kA) > keen / 100 && r.v > 22 && Math.abs(r.d) < ROAD_HW - 2 && Math.sign(kA) * r.steerTarget > 0.2 && (r.silkT > 0 || hash01(r.idx * 13 + 5, Math.floor(r.s / 90)) < ai.driftPick);
      else r.driftHeld = Math.abs(kA) > 1 / 160 && r.drift.t < 2.6 && Math.abs(err) < 2.6 && Math.abs(r.d) < ROAD_HW - 0.6;
    } else r.driftHeld = false;
    if (ITEMS_ON) {
      if (!r.isPlayer) this.aiItems(r);
      else if (r.item && !r.finished && r.itemHeld > 1.5) this.useItem(r);
    } else this.aiAbility(r, h);
  }

  dodge(target, obsD, w) {
    let t = obsD + (target >= obsD ? w : -w);
    if (Math.abs(t) > ROAD_HW - 1.2) t = obsD + (target >= obsD ? -w : w);
    return t;
  }

  // signature ability heuristics (LORE.md)
  aiAbility(r, h) {
    if (!r.abilityReady || r.finished || r.spinning) return;
    const ai = r.ai;
    ai.abilHold += h;
    const tr = this.track;
    const mode = r.mode;
    let use = ai.abilHold > ai.abilPatience + 4;
    const straight = (a, b) => {
      for (let x = r.s + a; x <= r.s + b; x += 10) if (Math.abs(tr.kappaAt(x)) > 1 / 260) return false;
      return true;
    };
    switch (r.abilityId) {
      case 'afterimage':
        for (const o of this.racers) {
          const ds = r.s - o.s;
          if (o !== r && ds > 3 && ds < 18 && Math.abs(o.d - r.d) < 3) use = true;
        }
        if (ai.abilHold > 3 && straight(10, 70)) use = true;
        break;
      case 'ramplate':
        for (const o of this.racers) {
          if (o === r || o.finished) continue;
          const ds = o.s - r.s;
          if ((Math.abs(ds) < 3 && Math.abs(o.d - r.d) < 3.8) || (ds > 0 && ds < 9 && Math.abs(o.d - r.d) < 2.4)) use = true;
        }
        break;
      case 'perfectline': {
        let km = 0;
        for (let x = r.s + 25; x <= r.s + 90; x += 6) km = Math.max(km, Math.abs(tr.kappaAt(x)));
        if (km > 1 / 95 || (tr.gripAt(r.s + 30) < 1 && mode === M_ROAD)) use = true;
        break;
      }
      case 'bigair': {
        if (mode === M_AIR) {
          use = use || ai.abilHold > 2;
          break;
        }
        if (!r.grounded && mode !== M_WATER) {
          use = false;
          break;
        }
        const nb = tr.buckets.length;
        for (let b = Math.max(0, Math.floor((r.s + 8) / BUCKET)); b <= Math.min(nb - 1, Math.floor((r.s + 24) / BUCKET)); b++) {
          for (const f of tr.buckets[b]) {
            const ds = f.s - r.s;
            if (ds < 9 || ds > 22) continue;
            if (((f.type === 'crate' && f.alive) || (f.type === 'obs' && f.kind === 'reef')) && Math.abs(f.d - r.d) < 2.4) use = true;
          }
        }
        for (const t of tr.tumble) if (t.s - r.s > 9 && t.s - r.s < 20 && Math.abs(t.d - r.d) < 3) use = true;
        break;
      }
      case 'silkdrift': {
        let n = 0;
        for (let x = r.s + 15; x <= r.s + 75; x += 10) if (Math.abs(tr.kappaAt(x)) > 1 / 140) n++;
        if (n >= 4 && mode !== M_AIR) use = true;
        break;
      }
      case 'overdrive':
        if (straight(5, 125) && mode !== M_AIR) use = true;
        break;
    }
    if (use) this.useAbility(r);
  }

  aiItems(r) {
    const ai = r.ai;
    if (!r.item || r.rouletteT > 0 || r.finished) return;
    if (r.itemHeld < ai.itemDelay) return;
    let use = false;
    switch (r.item) {
      case 'turbo':
      case 'mega':
        use = Math.abs(this.track.kappaAt(r.s + 30)) < 1 / 140 || r.itemHeld > ai.itemDelay + 4;
        break;
      case 'rocket': {
        const t = this.nextAhead(r);
        use = (t && t.s - r.s < 140 && t.invulnT <= 0) || r.itemHeld > 12;
        break;
      }
      case 'honey':
        use = r.itemHeld > 10 || this.racers.some((o) => o !== r && r.s - o.s > 2 && r.s - o.s < 28 && Math.abs(o.d - r.d) < 4);
        break;
      case 'shield':
        use = true;
        break;
    }
    if (use) {
      this.useItem(r);
      ai.itemDelay = 0.6 + this.rng() * 2.4;
    }
  }
}

// ============================================================
// Character animation (ROADMAP 4): one AnimationMixer per racer.
// Layers: base locomotion state (crossfaded loops) + additive steering lean + one-shot reactions from sim hooks
// (priority + cooldown), then procedural secondary motion: spring-damped ears/tail, head look-at, breathing,
// blinks, face expressions (mouth morphs, lid/brow/jaw bones) and two-bone IK that keeps hands on the wheel.
// Characters are authored in Blender seat space (x right, y forward, z up); here char space is (x, z, -y).
// ============================================================
const ANIM_BASE = ['idle', 'drift_L', 'drift_R', 'boost', 'jump_air', 'glider', 'boat', 'spinout', 'win', 'lose'];
const ANIM_ONESHOT = { hit: 3, spinhit: 3, duck: 2.8, trick: 2.5, trick2: 2.5, ability: 2.6, taunt_overtake: 2, overtaken: 2, cheer: 1.6, land: 1, start_ritual: 1.5,
  talk: 1, shrug: 1, point: 1, nod: 1, laugh: 1, fist: 1, facepalm: 1, cross: 1 };
// cutscene body language (v5): picked per line from the expression and the punctuation when a line names no clip
const TALK_CLIPS = ['talk', 'shrug', 'point', 'nod', 'laugh', 'fist', 'facepalm', 'cross'];
const FACE_MORPHS = ['grin', 'roar', 'snarl', 'shock', 'smug', 'sad'];
// personality: resting face, lid droop, look-at style, spring looseness, breathing, reaction odds
const PERSONA = {
  fox: { face: { smug: 0.35 }, lid: 0.12, angry: 0.15, look: 1.0, lookK: 7, spring: 1.0, breathe: [2.2, 1.2], taunt: 0.95, blink: [1.8, 4.0], blinkT: 0.11 },
  panda: { face: { snarl: 0.08 }, lid: 0.28, angry: 0.55, look: 0.7, lookK: 1.6, spring: 0.55, breathe: [0.8, 2.2], taunt: 0.7, blink: [3.0, 6.0], blinkT: 0.16 },
  frog: { face: {}, lid: 0.38, angry: 0.1, look: 1.25, lookK: 4, spring: 0.6, breathe: [1.0, 0.8], taunt: 0.55, blink: [3.5, 6.0], blinkT: 0.24 },
  bunny: { face: { grin: 0.45 }, lid: 0.0, angry: 0.0, look: 1.1, lookK: 9, spring: 1.6, breathe: [2.8, 1.4], taunt: 0.9, blink: [1.4, 3.2], blinkT: 0.09 },
  cat: { face: { smug: 0.6 }, lid: 0.45, angry: 0.05, look: 0.8, lookK: 2.2, spring: 0.9, breathe: [0.9, 1.0], taunt: 0.85, blink: [2.6, 5.5], blinkT: 0.22 },
  bear: { face: { snarl: 0.25 }, lid: 0.2, angry: 0.75, look: 0.9, lookK: 5, spring: 0.8, breathe: [1.4, 2.0], taunt: 0.9, blink: [2.4, 5.0], blinkT: 0.13 },
  bull: { face: { smug: 0.55 }, lid: 0.3, angry: 0.45, look: 0.6, lookK: 2.0, spring: 0.5, breathe: [0.9, 2.4], taunt: 1.0, blink: [3.0, 6.5], blinkT: 0.18 },
};
const _aq = new THREE.Quaternion();
const _aq2 = new THREE.Quaternion();
const _aq3 = new THREE.Quaternion();
const _av = new THREE.Vector3();
const _av2 = new THREE.Vector3();
const _av3 = new THREE.Vector3();
const _av4 = new THREE.Vector3();
const _av5 = new THREE.Vector3();
const _aM = new THREE.Matrix4();
const _aX = new THREE.Vector3(1, 0, 0);
const _aY = new THREE.Vector3(0, 1, 0);
const _aZ = new THREE.Vector3(0, 0, 1);
// Blender seat space -> char space
const seatV = (a, out = new THREE.Vector3()) => out.set(a[0], a[2], -a[1]);

// model-space (char space) rotation from (pitch fwd-down, yaw right, roll right) in radians
function qModel(p, y, r, out) {
  _aq.setFromAxisAngle(_aY, -y);
  _aq2.setFromAxisAngle(_aX, -p);
  _aq3.setFromAxisAngle(_aZ, -r);
  return out.copy(_aq).multiply(_aq2).multiply(_aq3);
}

function sampleCurve(curve, t) {
  if (!curve || !curve.length) return 1;
  if (t <= curve[0][0]) return curve[0][1];
  for (let i = 1; i < curve.length; i++) {
    if (t <= curve[i][0]) {
      const a = curve[i - 1];
      const b = curve[i];
      const k = b[0] > a[0] ? (t - a[0]) / (b[0] - a[0]) : 1;
      return a[1] + (b[1] - a[1]) * k;
    }
  }
  return curve[curve.length - 1][1];
}

// bind-pose reference clip so authored poses can be played additively (steer lean)
function makeAdditiveFromBind(clip, root) {
  const tracks = [];
  for (const tr of clip.tracks) {
    const [node, prop] = tr.name.split('.');
    const o = root.getObjectByName(node);
    if (!o) continue;
    if (prop === 'quaternion') tracks.push(new THREE.QuaternionKeyframeTrack(tr.name, [0], o.quaternion.toArray()));
    else if (prop === 'position') tracks.push(new THREE.VectorKeyframeTrack(tr.name, [0], o.position.toArray()));
    else if (prop === 'scale') tracks.push(new THREE.VectorKeyframeTrack(tr.name, [0], o.scale.toArray()));
  }
  const ref = new THREE.AnimationClip(clip.name + '_ref', 0, tracks);
  const add = clip.clone();
  THREE.AnimationUtils.makeClipAdditive(add, 0, ref);
  return add;
}

class Spring {
  constructor(k, d) {
    this.k = k;
    this.d = d;
    this.x = 0;
    this.v = 0;
  }
  step(target, dt) {
    const a = (target - this.x) * this.k - this.v * this.d;
    this.v += a * dt;
    this.x += this.v * dt;
    if (this.x > 1.4) this.x = 1.4;
    else if (this.x < -1.4) this.x = -1.4;
    return this.x;
  }
}

class CharAnim {
  constructor(model, species, lib) {
    this.model = model;
    this.sp = species;
    this.meta = lib.meta;
    this.P = PERSONA[species] || PERSONA.fox;
    const pre = lib.meta.prefix;
    this.mesh = null;
    model.traverse((o) => {
      if (o.isSkinnedMesh) this.mesh = o;
    });
    this.bones = {};
    model.traverse((o) => {
      if (o.isBone && o.name.startsWith(pre)) this.bones[o.name.slice(pre.length)] = o;
    });
    model.updateMatrixWorld(true);
    // rest data: local + model-space orientation of every bone (for axis-based procedural rotations)
    const invRoot = _aq.copy(model.getWorldQuaternion(new THREE.Quaternion())).invert().clone();
    this.rest = {};
    for (const k in this.bones) {
      const b = this.bones[k];
      const wq = b.getWorldQuaternion(new THREE.Quaternion()).premultiply(invRoot);
      this.rest[k] = { q: b.quaternion.clone(), p: b.position.clone(), w: wq, wi: wq.clone().invert() };
    }
    // last pure clip pose per bone (see restorePose)
    this.pose = {};
    for (const k in this.bones) this.pose[k] = { q: this.bones[k].quaternion.clone(), p: this.bones[k].position.clone() };
    this.mixer = new THREE.AnimationMixer(model);
    this.actions = {};
    this.info = lib.meta.clips || {};
    for (const clip of lib.clips) {
      const name = clip.name.slice(pre.length);
      const inf = this.info[name] || {};
      let c = clip;
      if (inf.additive) c = makeAdditiveFromBind(clip, model);
      const a = this.mixer.clipAction(c);
      if (inf.additive) a.blendMode = THREE.AdditiveAnimationBlendMode;
      a.userData = { name, info: inf, w: 0, target: 0, lastT: 0 };
      if (inf.loop) a.setLoop(THREE.LoopRepeat, Infinity);
      else {
        a.setLoop(THREE.LoopOnce, 1);
        a.clampWhenFinished = true;
      }
      this.actions[name] = a;
    }
    // base loops can also be played as timed one-shots (cutscenes ask for 'win', 'lose', 'boost'...): a separate
    // action on a renamed copy of the clip, so the base-weight loop below never fights it
    this.onceOf = {};
    for (const n of ANIM_BASE) {
      const a = this.actions[n];
      if (!a) continue;
      const c = a.getClip().clone();
      c.name = c.name + '__once';
      const o = this.mixer.clipAction(c);
      o.setLoop(THREE.LoopRepeat, Infinity);
      o.userData = { name: n, info: a.userData.info, w: 0, target: 0, lastT: 0, limit: Math.max(1.8, Math.min(3.2, c.duration * 2)) };
      this.onceOf[n] = o;
    }
    for (const n of ANIM_BASE) {
      const a = this.actions[n];
      if (!a) continue;
      a.play();
      a.setEffectiveWeight(0);
      a.time = Math.random() * a.getClip().duration;
    }
    for (const n of ['steer_L', 'steer_R']) {
      const a = this.actions[n];
      if (a) {
        a.play();
        a.setEffectiveWeight(0);
      }
    }
    this.base = 'idle';
    if (this.actions.idle) {
      this.actions.idle.userData.w = 1;
      this.actions.idle.setEffectiveWeight(1);
    }
    this.one = null;
    this.oneW = 0;
    this.cool = {};
    this.face = {};
    this.faceCue = [];
    for (const m of FACE_MORPHS) this.face[m] = 0;
    this.morphIdx = {};
