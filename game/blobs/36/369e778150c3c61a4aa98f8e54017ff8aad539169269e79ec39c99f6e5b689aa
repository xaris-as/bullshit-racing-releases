    this.points.frustumCulled = false;
    this.points.renderOrder = 5;
  }
  // colour is sRGB hex; glow > 1 pushes additive sparks into the bloom range
  spawn(x, y, z, vx, vy, vz, life, size, color, alpha = 1, grav = 0, drag = 0, grow = 0, glow = 1) {
    const i = this.count < this.max ? this.count++ : Math.floor(Math.random() * this.max);
    const i3 = i * 3;
    this.pos[i3] = x;
    this.pos[i3 + 1] = y;
    this.pos[i3 + 2] = z;
    this.vel[i3] = vx;
    this.vel[i3 + 1] = vy;
    this.vel[i3 + 2] = vz;
    this.col[i3] = SRGB_LUT[(color >> 16) & 255] * glow;
    this.col[i3 + 1] = SRGB_LUT[(color >> 8) & 255] * glow;
    this.col[i3 + 2] = SRGB_LUT[color & 255] * glow;
    this.life[i] = life;
    this.maxLife[i] = life;
    this.size[i] = size;
    this.a0[i] = alpha;
    this.alpha[i] = alpha;
    this.grav[i] = grav;
    this.drag[i] = drag;
    this.grow[i] = grow;
  }
  update(dt) {
    let i = 0;
    while (i < this.count) {
      this.life[i] -= dt;
      if (this.life[i] <= 0) {
        const last = --this.count;
        if (i !== last) this.copy(last, i);
        continue;
      }
      const i3 = i * 3;
      const dr = Math.exp(-this.drag[i] * dt);
      this.vel[i3] *= dr;
      this.vel[i3 + 1] = this.vel[i3 + 1] * dr - this.grav[i] * dt;
      this.vel[i3 + 2] *= dr;
      this.pos[i3] += this.vel[i3] * dt;
      this.pos[i3 + 1] += this.vel[i3 + 1] * dt;
      this.pos[i3 + 2] += this.vel[i3 + 2] * dt;
      this.size[i] = Math.max(0.01, this.size[i] + this.grow[i] * dt);
      const t = this.life[i] / this.maxLife[i];
      this.alpha[i] = this.a0[i] * Math.min(1, t * 2.2);
      i++;
    }
    this.geo.setDrawRange(0, this.count);
    this.aPos.needsUpdate = true;
    this.aCol.needsUpdate = true;
    this.aSize.needsUpdate = true;
    this.aAlpha.needsUpdate = true;
  }
  copy(from, to) {
    const f3 = from * 3;
    const t3 = to * 3;
    for (let k = 0; k < 3; k++) {
      this.pos[t3 + k] = this.pos[f3 + k];
      this.vel[t3 + k] = this.vel[f3 + k];
      this.col[t3 + k] = this.col[f3 + k];
    }
    this.life[to] = this.life[from];
    this.maxLife[to] = this.maxLife[from];
    this.size[to] = this.size[from];
    this.alpha[to] = this.alpha[from];
    this.a0[to] = this.a0[from];
    this.grav[to] = this.grav[from];
    this.drag[to] = this.drag[from];
    this.grow[to] = this.grow[from];
  }
  clear() {
    this.count = 0;
    this.geo.setDrawRange(0, 0);
  }
  dispose() {
    this.geo.dispose();
    this.mat.dispose();
  }
}

class Snowfall {
  constructor(n) {
    this.n = n;
    this.box = 60;
    const pos = new Float32Array(n * 3);
    const rnd = mulberry32(42);
    for (let i = 0; i < n; i++) {
      pos[i * 3] = (rnd() - 0.5) * this.box;
      pos[i * 3 + 1] = (rnd() - 0.5) * this.box * 0.6;
      pos[i * 3 + 2] = (rnd() - 0.5) * this.box;
    }
    this.pos = pos;
    const g = new THREE.BufferGeometry();
    this.attr = new THREE.BufferAttribute(pos, 3).setUsage(THREE.DynamicDrawUsage);
    g.setAttribute('position', this.attr);
    const col = new Float32Array(n * 3).fill(1);
    const size = new Float32Array(n);
    const alpha = new Float32Array(n);
    for (let i = 0; i < n; i++) {
      size[i] = 0.12 + rnd() * 0.12;
      alpha[i] = 0.55 + rnd() * 0.4;
    }
    g.setAttribute('pcolor', new THREE.BufferAttribute(col, 3));
    g.setAttribute('psize', new THREE.BufferAttribute(size, 1));
    g.setAttribute('palpha', new THREE.BufferAttribute(alpha, 1));
    this.geo = g;
    this.mat = new THREE.ShaderMaterial({ uniforms: { uScale: { value: 500 } }, vertexShader: PARTICLE_VS, fragmentShader: PARTICLE_FS, transparent: true, depthWrite: false });
    this.points = new THREE.Points(g, this.mat);
    this.points.frustumCulled = false;
    this.t = 0;
  }
  update(dt, camPos, vel) {
    this.t += dt;
    const p = this.pos;
    const B = this.box;
    const hb = B / 2;
    const hy = B * 0.3;
    for (let i = 0; i < this.n; i++) {
      const i3 = i * 3;
      p[i3] += (Math.sin(this.t * 0.7 + i) * 0.6 - vel.x) * dt;
      p[i3 + 1] += (-2.2 - vel.y) * dt;
      p[i3 + 2] += (Math.cos(this.t * 0.5 + i * 1.3) * 0.6 - vel.z) * dt;
      if (p[i3] > hb) p[i3] -= B;
      else if (p[i3] < -hb) p[i3] += B;
      if (p[i3 + 1] > hy) p[i3 + 1] -= hy * 2;
      else if (p[i3 + 1] < -hy) p[i3 + 1] += hy * 2;
      if (p[i3 + 2] > hb) p[i3 + 2] -= B;
      else if (p[i3 + 2] < -hb) p[i3 + 2] += B;
    }
    this.points.position.copy(camPos);
    this.attr.needsUpdate = true;
  }
  dispose() {
    this.geo.dispose();
    this.mat.dispose();
  }
}

