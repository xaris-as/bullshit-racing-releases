      if (tr.segMode.includes(M_GAP)) tags.push('<span class="t-jump">Gorge jump</span>');
      if (tr.iceZones.length) tags.push('<span class="t-ice">Ice</span>');
      if (!tags.length) tags.push('<span>Street</span>');
      b.innerHTML = `
        <div class="tc-art"><div class="tc-diff" aria-hidden="true">${[1, 2, 3].map((k) => `<i class="${k <= def.diff ? 'on' : ''}"></i>`).join('')}</div></div>
        <div class="tc-body">
          <div class="tc-name"></div>
          <div class="tc-mood"></div>
          <div class="tc-tags">${tags.join('')}</div>
          <div class="tc-blurb"></div>
          <div class="tc-meta"><span>${(tr.raceLength / 1000).toFixed(1)} KM</span><span>${Math.round(tr.drop)} M DROP</span></div>
          <div class="tc-best">${medal}</div>
        </div>`;
      b.querySelector('.tc-art').prepend(trackArt(tr));
      b.querySelector('.tc-name').textContent = def.name.toUpperCase();
      b.querySelector('.tc-mood').textContent = THEMES[def.theme].label || '';
      b.querySelector('.tc-blurb').textContent = def.blurb;
      b.setAttribute('aria-label', def.name + ', difficulty ' + def.diff + ' of 3');
      b.addEventListener('click', () => onPick(i));
      list.appendChild(b);
    });
  },
  results(rows, times, P, def, newBest, bonus, earned, hasNext) {
    $('res-place').textContent = ordinal(P.place);
    $('res-sub').textContent = def.name + ' · ' + fmtTime(P.finishTime) + (newBest ? ' · NEW BEST' : '');
    const ol = $('standings');
    ol.innerHTML = '';
    rows.forEach((r, i) => {
      const li = el('li', r.isPlayer ? 'me' : '');
      const pf = el('span', 'pf');
      pf.style.backgroundImage = Portraits.css(r.def.id, i === 0 ? 'pick' : 'idle', 'sm');
      const nm = el('span', 'nm', r.name);
      nm.appendChild(el('small', '', '"' + r.def.nick + '"' + (r.isPlayer ? ' · YOU' : '')));
      li.append(el('span', 'p', ordinal(i + 1)), pf, nm, el('span', 'tm', fmtTime(times[i])));
      ol.appendChild(li);
    });
    $('earn').innerHTML = `<span class="coin-ico" aria-hidden="true"></span><b>${P.coins}</b> collected + <b>${bonus}</b> ${ordinal(P.place)} place bonus = <b>${earned}</b> coins`;
    $('btn-next').textContent = hasNext ? 'Next track' : 'Pick a track';
  },
};

