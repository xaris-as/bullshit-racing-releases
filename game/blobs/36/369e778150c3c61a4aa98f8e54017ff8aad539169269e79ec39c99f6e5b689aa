  const ex = bike ? null : Assets.root('exhaust_' + build.exhaust);
  if (ex) {
    _m4.makeTranslation(exO.x, exO.y, exO.z);
    for (const m of ex.meshes) parts.push(bakedGeo(m.name, _m4b.multiplyMatrices(_m4, m.matrix)));
