const BILLBOARDS = [
  ['MAXIMALL', 'COMING SOON TO YOUR MOUNTAIN', 'TAURUS INDUSTRIES'],
  ['WE PAVE PARADISE', 'AND PUT UP A PARKING LOT', 'TAURUS INDUSTRIES'],
