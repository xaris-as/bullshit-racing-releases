const Sound = {
  ctx: null,
  master: null,
  sfx: null,
  music: null,
  pre: null,
  sweep: null,
  duck: null,
  drums: null,
  bassBus: null,
  gtrBus: null,
  acidBus: null,
  voxBus: null,
  noise: null,
  eng: null,
  wind: null,
  skid: null,
  wash: null,
  musicOn: true,
  sfxOn: true,
  seq: null,
  timer: 0,
  lastEngineT: 0,
  ostMap: null,
  ostEl: null,
  ostSrc: null,
