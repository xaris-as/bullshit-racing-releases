function goalText(g) {
  const parts = [];
  if (g.beat) parts.push(T('Νίκησε τον/την ' + tx(CAST[g.beat].name) + ' σε μονομαχία', 'Beat ' + tx(CAST[g.beat].name) + ' one on one'));
  if (g.beatAll) parts.push(T('Τερμάτισε μπροστά από όλα τα Κέρατα', 'Finish ahead of every Horn'));
  if (g.place === 1) parts.push(T('Κέρδισε τον αγώνα', 'Win the race'));
  else if (g.place) parts.push(T('Τερμάτισε στους ' + g.place + ' πρώτους', 'Finish in the top ' + g.place));
  if (g.booms) parts.push(T('Ανατίναξε ' + g.booms + (g.booms === 1 ? ' βαρέλι' : ' βαρέλια'), 'Blow up ' + g.booms + (g.booms === 1 ? ' barrel' : ' barrels')));
  if (g.clean) parts.push(T('Χωρίς κανένα σπιν', 'Without a single spin-out'));
  if (g.rings) parts.push(T('Πέρνα το ' + Math.round(g.rings * 100) + '% των κρίκων', 'Fly through ' + Math.round(g.rings * 100) + '% of the rings'));
  if (g.coins) parts.push(T('Μάζεψε ' + g.coins + ' νομίσματα', 'Collect ' + g.coins + ' coins'));
  return { el: parts.map((p) => p.el).join(' · '), en: parts.map((p) => p.en).join(' · ') };
}

