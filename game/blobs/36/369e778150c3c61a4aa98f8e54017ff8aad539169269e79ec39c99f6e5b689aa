function resize() {
  if (!renderer) return;
  const app = $('app');
  const w = Math.max(1, app.clientWidth);
  const h = Math.max(1, app.clientHeight);
  renderer.setSize(w, h, false);
  Post.setSize(w, h, pr);
  raceCam.aspect = w / h;
  raceCam.updateProjectionMatrix();
  frameMenuCam();
  if (Game.rig) Game.rig.setAspect(w / h);
  Input.rect = $('gl').getBoundingClientRect();
  Minimap.resize();
}

