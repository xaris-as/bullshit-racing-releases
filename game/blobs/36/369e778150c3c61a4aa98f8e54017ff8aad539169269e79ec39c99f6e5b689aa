    const shaper = (amount) => {
      const s = c.createWaveShaper();
      const n = 1024;
      const curve = new Float32Array(n);
      for (let i = 0; i < n; i++) {
        const x = (i / (n - 1)) * 2 - 1;
        curve[i] = Math.tanh(x * amount) / Math.tanh(amount);
      }
      s.curve = curve;
      s.oversample = '2x';
      return s;
    };
    const bus = (amount, lp, hp, gain) => {
      const g = c.createGain();
      const sh = shaper(amount);
      const f = c.createBiquadFilter();
      f.type = 'lowpass';
      f.frequency.value = lp;
      const h = c.createBiquadFilter();
      h.type = 'highpass';
      h.frequency.value = hp;
      const o = c.createGain();
      o.gain.value = gain;
      g.connect(sh);
      sh.connect(h);
      h.connect(f);
      f.connect(o);
      o.connect(this.duck);
      return { in: g, lp: f, out: o };
    };
