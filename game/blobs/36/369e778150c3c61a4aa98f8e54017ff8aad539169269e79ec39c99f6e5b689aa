const Perf = {
  acc: 0,
  n: 0,
  cool: 0,
  ups: 0,
  fps: 60,
  sample(dt) {
    if (Game.phase !== 'race' || Game.paused) {
      this.acc = 0;
      this.n = 0;
      return;
    }
    this.acc += dt;
    this.n++;
    this.cool -= dt;
    if (this.acc < 2.5) return;
    const fps = this.n / this.acc;
    this.fps = fps;
    this.acc = 0;
    this.n = 0;
    if (this.cool > 0) return;
    if (fps < 45 && pr > 0.75) {
      pr = Math.max(0.75, pr - 0.25);
      renderer.setPixelRatio(pr);
      resize();
      this.cool = 3;
    } else if (fps > 58.5 && pr < PR_MAX - 0.01 && this.ups < 2) {
      pr = Math.min(PR_MAX, pr + 0.25);
      renderer.setPixelRatio(pr);
      resize();
      this.cool = 6;
      this.ups++;
    }
  },
};

