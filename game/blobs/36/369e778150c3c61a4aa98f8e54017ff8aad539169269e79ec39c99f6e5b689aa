function rollItem(rng, placeFrac) {
  const p = clamp(placeFrac, 0, 1);
  const w = { turbo: 3 + 2 * p, rocket: 0.6 + 3.6 * p, honey: 3.4 - 2.4 * p, shield: 2.4 - 1.0 * p, mega: 0.1 + 2.4 * p * p };
  let total = 0;
  for (const k of ITEM_IDS) total += w[k];
  let x = rng() * total;
  for (const k of ITEM_IDS) {
    x -= w[k];
    if (x <= 0) return k;
  }
  return 'turbo';
}

