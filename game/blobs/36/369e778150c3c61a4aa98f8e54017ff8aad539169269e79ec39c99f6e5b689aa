    if (legs) geos.push(legs.mesh.geometry);
  }

  const wingRoot = Assets.root('wings');
  const wingGeo = mergeOwned(wingRoot.meshes.map((m) => bakedGeo(m.name, m.matrix, build.p2)));
  geos.push(wingGeo);
  const wings = new THREE.Mesh(wingGeo, MAT.kart);
  wings.position.copy(anchor('wings', new THREE.Vector3(0, 0.62, 0.3)));
  wings.scale.setScalar(0.001);
  wings.visible = false;
  chassis.add(wings);

  const hullRoot = Assets.root('hull');
  const hull = new THREE.Group();
  hull.position.copy(anchor('hull', new THREE.Vector3(0, 0.12, 0)));
  let prop = null;
  for (const m of hullRoot.meshes) {
    const mesh = new THREE.Mesh(Assets.mesh(m.name), MAT.kart);
    mesh.position.copy(m.pos);
    mesh.quaternion.copy(m.quat);
    hull.add(mesh);
    if (/prop/.test(m.name)) prop = mesh;
  }
  hull.scale.set(1, 0.001, 1);
  hull.visible = false;
  hull.userData.w = bike ? BR.hull : 1;
  chassis.add(hull);

  // number plate + sponsor stickers on both flanks (one atlas, one draw call)
  const dl = anchor('decal_l', new THREE.Vector3(-0.8, 0.5, 0));
  const dr = anchor('decal_r', new THREE.Vector3(0.8, 0.5, 0));
  const dq = [];
  const dk = bike ? BR.decal : 1;
  for (const [p, s] of [[dl, -1], [dr, 1]]) {
    const q = new THREE.PlaneGeometry(0.46 * dk, 0.46 * dk);
    const uv = q.attributes.uv;
    for (let i = 0; i < uv.count; i++) uv.setX(i, uv.getX(i) * 0.5);
    q.rotateY(s * Math.PI * 0.5);
    q.translate(p.x + s * 0.035, p.y, p.z);
    dq.push(q);
    const st = new THREE.PlaneGeometry(0.62 * dk, 0.31 * dk);
    const uv2 = st.attributes.uv;
    for (let i = 0; i < uv2.count; i++) uv2.setX(i, 0.5 + uv2.getX(i) * 0.5);
    st.rotateY(s * Math.PI * 0.5);
    if (bike) st.translate(p.x + s * 0.03, p.y + 0.19 * dk + 0.04, p.z);
    else st.translate(p.x + s * 0.03, p.y - 0.05, p.z + (p.z < 0.3 ? 0.5 : -0.5));
    dq.push(st);
  }
  const decalGeo = mergeGeometries(dq, false);
  for (const q of dq) q.dispose();
  geos.push(decalGeo);
  const decalTex = decalTexture(build.number, build.p1, build.p2, (RACERS.indexOf(def) + 1) * 3 + build.number);
  texs.push(decalTex);
  const decalMat = new THREE.MeshStandardMaterial({ map: decalTex, transparent: true, alphaTest: 0.35, roughness: 0.45, polygonOffset: true, polygonOffsetFactor: -2, polygonOffsetUnits: -2 });
  mats.push(decalMat);
  const decal = new THREE.Mesh(decalGeo, decalMat);
  chassis.add(decal);

  // boost flames + exhaust heat glow
  const fl = FLAMES[build.flame] || FLAMES[0];
  const flameMat = new THREE.MeshBasicMaterial({ color: 0xffffff, transparent: true, opacity: 0.95, blending: THREE.AdditiveBlending, depthWrite: false, side: THREE.DoubleSide });
  flameMat.color.set(fl.a).multiplyScalar(2.4);
  mats.push(flameMat);
  const heatMat = new THREE.SpriteMaterial({ map: glowTexture(), color: fl.a, transparent: true, depthWrite: false, blending: THREE.AdditiveBlending, opacity: 0.25 });
  mats.push(heatMat);
  const flames = [];
  const outlets = [];
  const heats = [];
  for (const o of (bike ? BIKE_OUT[build.body] : EXHAUST_OUT[build.exhaust]) || EXHAUST_OUT.twin) {
    const f = new THREE.Mesh(flameGeo(), flameMat);
    f.position.set(exO.x + o[0], exO.y + o[1], exO.z + o[2]);
    f.scale.set(0.11, 0.11, 0.6);
    f.userData.k = bike ? 0.75 : 1;
    f.visible = false;
    chassis.add(f);
    flames.push(f);
    outlets.push(f.position.clone());
    const h = new THREE.Sprite(heatMat);
    h.position.copy(f.position);
    h.scale.setScalar(0.32);
    h.visible = false;
    chassis.add(h);
    heats.push(h);
  }

  // ability shell (Ram Plate steel bubble etc.), tinted by ability
  const abil = ABILITIES[def.ability];
  const shield = new THREE.Mesh(GEO.sphere, rimMaterial(abil ? abil.color : 0x6fe7ff, 1));
  mats.push(shield.material);
  shield.scale.set(1.6, 1.25, 2.1);
  shield.position.set(0, bike ? 1.05 : 0.85, 0);
  shield.visible = false;
  root.add(shield);

  const shadowGeo = new THREE.PlaneGeometry(2.3, 3.4);
  geos.push(shadowGeo);
  const shadowMat = new THREE.MeshBasicMaterial({ map: blobTexture(), transparent: true, depthWrite: false, opacity: 1, polygonOffset: true, polygonOffsetFactor: -3, polygonOffsetUnits: -3 });
  mats.push(shadowMat);
  const shadow = new THREE.Mesh(shadowGeo, shadowMat);
  shadow.renderOrder = 1;

  let label = null;
  if (withLabel) {
    label = makeLabel(def.name, build.p1 === 0x17161b ? def.color : build.p1);
    label.position.set(0, 3.0, 0);
    root.add(label);
    mats.push(label.material);
    texs.push(label.material.map);
  }
  root.traverse((o) => {
    if (o.isMesh && o !== shield && o.material !== flameMat) {
      o.castShadow = !!castShadow;
      o.receiveShadow = false;
    }
  });
  return {
    def, build, root, chassis, p1, statics, wheels, charRoot, model, anim, furShell, steerWheel, wings, hull, prop, decal, flames, outlets, heats, heatMat, flameMat, flameCol: fl, shield, shadow, label, paintMat,
    geos, mats, texs, bike: BR, legs,
    wheelSpin: 0, squash: 0, lean: 0, pitch: 0, roll: 0, yaw: 0, form: 0, formE: 0, wingE: 0, hullE: 0, propSpin: 0, steerVis: 0, sink: 0, bank: 0, wheelie: 0, trickSeq: 0, trickP: 1, trickK: 0,
  };
}

// one call per frame wherever a racer visual is animated (race, menu, podium, cutscenes, galleries):
// the character clips + procedural layers, the steering wheel / handlebar, and a bike rider's legs
function animateRider(v, dt, ctx) {
  v.anim.update(dt, ctx);
  if (v.steerWheel) v.steerWheel.userData.mesh.rotation.y = v.anim.wheelAngle;
  if (v.legs) updateRiderLegs(v.legs, v.anim);
}

// Bike rider legs: one skinned mesh, six rigid bones (thigh, shin, boot per side) posed every frame with a two-bone
// IK from the hips (follow the animated torso) to the foot pegs (fixed on the bike). One draw call.
const _lg = { h: new THREE.Vector3(), k: new THREE.Vector3(), f: new THREE.Vector3(), d: new THREE.Vector3(), p: new THREE.Vector3(), v: new THREE.Vector3() };
const _LEG_UP = new THREE.Vector3(0, 1, 0);
function buildRiderLegs(chassis, anim, pegs, cols) {
  const hipsB = anim.bones.hips;
  if (!hipsB) return null;
  const mesh0 = new THREE.Group();
  chassis.add(mesh0);
  chassis.updateMatrixWorld(true);
  const hp = mesh0.worldToLocal(hipsB.getWorldPosition(new THREE.Vector3()));
  const HW = 0.13;
  const lens = pegs.map((pg, s) => {
    const hip = hp.clone().add(new THREE.Vector3((s ? 1 : -1) * HW, -0.04, 0));
    return hip.distanceTo(pg.clone().add(new THREE.Vector3(0, 0.07, 0)));
  });
  const D = Math.max(lens[0], lens[1]);
  const L1 = Math.max(0.3, D * 0.56);
  const L2 = Math.max(0.28, D * 0.56);
  chassis.remove(mesh0);
  const pants = new THREE.Color(cols[0]);
  const boot = new THREE.Color(cols[1]);
  const parts = [];
  const add = (g, bone, col) => {
    const n = g.attributes.position.count;
    const c = new Float32Array(n * 3);
    const si = new Uint16Array(n * 4);
    const sw = new Float32Array(n * 4);
    for (let i = 0; i < n; i++) {
      c[i * 3] = col.r;
      c[i * 3 + 1] = col.g;
      c[i * 3 + 2] = col.b;
      si[i * 4] = bone;
      sw[i * 4] = 1;
    }
    g.setAttribute('color', new THREE.BufferAttribute(c, 3));
    g.setAttribute('skinIndex', new THREE.BufferAttribute(si, 4));
    g.setAttribute('skinWeight', new THREE.BufferAttribute(sw, 4));
    if (g.index) {
      const ni = g.toNonIndexed();
      g.dispose();
      g = ni;
    }
    parts.push(g);
  };
  for (let s = 0; s < 2; s++) {
    const b = s * 3;
    const th = new THREE.CapsuleGeometry(0.088, L1, 3, 10);
    th.translate(0, L1 / 2, 0);
    add(th, b, pants);
    const sh = new THREE.CapsuleGeometry(0.074, L2, 3, 10);
    sh.translate(0, L2 / 2, 0);
    add(sh, b + 1, pants);
    const bt = new THREE.BoxGeometry(0.15, 0.13, 0.27, 1, 1, 1);
    bt.translate(0, 0.0, -0.06);
    add(bt, b + 2, boot);
    const cuff = new THREE.CylinderGeometry(0.085, 0.085, 0.07, 10);
    cuff.translate(0, 0.07, 0.0);
    add(cuff, b + 2, boot);
  }
  const geo = mergeGeometries(parts, false);
  for (const g of parts) g.dispose();
  const mat = legMaterial();
  const bones = [];
  for (let i = 0; i < 6; i++) bones.push(new THREE.Bone());
  const mesh = new THREE.SkinnedMesh(geo, mat);
  for (const b of bones) mesh.add(b);
  mesh.bind(new THREE.Skeleton(bones), new THREE.Matrix4());
  mesh.frustumCulled = false;
  chassis.add(mesh);
  const L = { mesh, bones, pegs: pegs.map((p) => p.clone()), L1, L2, HW };
  updateRiderLegs(L, anim);
  return L;
}
let LEG_MAT = null;
function legMaterial() {
  if (!LEG_MAT) {
    LEG_MAT = new THREE.MeshStandardMaterial({ vertexColors: true, roughness: 0.82, metalness: 0.0 });
    SHARED_MATS.add(LEG_MAT);
  }
  return LEG_MAT;
}
function updateRiderLegs(L, anim) {
  const hipsB = anim.bones.hips;
  if (!hipsB) return;
  const m = L.mesh;
  m.updateMatrixWorld(true);
  hipsB.getWorldPosition(_lg.p);
  m.worldToLocal(_lg.p);
  for (let s = 0; s < 2; s++) {
    const sx = s ? 1 : -1;
    const H = _lg.h.set(_lg.p.x + sx * L.HW, _lg.p.y - 0.04, _lg.p.z);
    const Fp = _lg.f.copy(L.pegs[s]);
    Fp.y += 0.07;
    const d = _lg.d.subVectors(Fp, H);
    const len = clamp(d.length(), Math.abs(L.L1 - L.L2) + 1e-3, L.L1 + L.L2 - 1e-3);
    d.normalize();
    // knees forward, a little out and up
    const pole = _lg.k.set(sx * 0.45, 0.35, -1);
    pole.addScaledVector(d, -pole.dot(d)).normalize();
    const ca = clamp((L.L1 * L.L1 + len * len - L.L2 * L.L2) / (2 * L.L1 * len), -1, 1);
    const sa = Math.sqrt(Math.max(0, 1 - ca * ca));
    const K = pole.multiplyScalar(L.L1 * sa).addScaledVector(d, L.L1 * ca).add(H);
    const b0 = L.bones[s * 3];
    const b1 = L.bones[s * 3 + 1];
    const b2 = L.bones[s * 3 + 2];
    b0.position.copy(H);
    b0.quaternion.setFromUnitVectors(_LEG_UP, _lg.v.subVectors(K, H).normalize());
    b1.position.copy(K);
    b1.quaternion.setFromUnitVectors(_LEG_UP, _lg.v.subVectors(Fp, K).normalize());
    b2.position.copy(Fp);
    b2.quaternion.identity();
  }
}

function disposeRacerVisual(v) {
  if (v.anim) v.anim.dispose();
  for (const g of v.geos) g.dispose();
  for (const m of v.mats) m.dispose();
  for (const t of v.texs) t.dispose();
  v.geos.length = 0;
  v.mats.length = 0;
  v.texs.length = 0;
}

// transform blend: form 0 car, 1 glider, 2 boat. Wings unfold (swing out from folded against the flanks).
function poseTransform(v, form, k, dt) {
  const tw = form === 1 ? 1 : 0;
  const th = form === 2 ? 1 : 0;
  v.wingE = approach(v.wingE, tw, dt * (tw ? 1.9 : 3.2));
  v.hullE = approach(v.hullE, th, dt * 3.2);
  const ew = v.wingE < 1 ? 1 - Math.pow(1 - v.wingE, 3) : 1;
  const eh = v.hullE < 1 ? 1 - Math.pow(1 - v.hullE, 3) : 1;
  v.wings.visible = ew > 0.01;
  if (v.wings.visible) {
    // folded = narrow and tall, then spans out with a little overshoot
    const span = ew < 1 ? ew + Math.sin(ew * Math.PI) * 0.12 : 1;
    v.wings.scale.set(Math.max(0.001, span), Math.max(0.001, 0.35 + 0.65 * ew), Math.max(0.001, 0.55 + 0.45 * ew));
    v.wings.rotation.z = (1 - ew) * 0.0;
  }
  v.hull.visible = eh > 0.01;
  const hw = v.hull.userData.w || 1;
  if (v.hull.visible) v.hull.scale.set((0.85 + 0.15 * eh) * hw, Math.max(0.001, eh), 0.85 + 0.15 * eh);
  const tuck = Math.max(ew, eh);
  for (const w of v.wheels) {
    if (v.bike) {
      // bikes: the wheels turn flat under the frame (hover pods)
      w.pivot.rotation.z = tuck * Math.PI * 0.5;
      const b = w.inSteer ? w.local : w.base;
      w.pivot.position.set(b.x, b.y + tuck * 0.1 + (w.inSteer ? 0 : (1 - tuck) * w.susp), b.z);
      continue;
    }
    w.pivot.rotation.z = -w.side * tuck * 1.45;
    w.pivot.position.set(w.base.x - w.side * tuck * 0.08, w.base.y + tuck * 0.12 + (1 - tuck) * w.susp, w.base.z);
  }
  return tuck;
}

// ---------- small procedural helpers ----------
function honeyGeo() {
  const P = [part(GEO.cylLo, 0xf2a516, 0, 0.03, 0, 0, 0, 0, 1.55, 0.06, 1.35)];
  const rnd = mulberry32(77);
  for (let i = 0; i < 6; i++) {
    const a = rnd() * TAU;
    const r = 0.4 + rnd() * 0.9;
    P.push(part(GEO.sphereLo, i % 2 ? 0xffc23d : 0xe08c0b, Math.cos(a) * r, 0.05, Math.sin(a) * r, 0, 0, 0, 0.32 + rnd() * 0.25, 0.1, 0.3 + rnd() * 0.2));
  }
  P.push(part(GEO.sphereLo, 0xfff1b8, -0.3, 0.1, -0.2, 0, 0, 0, 0.18, 0.05, 0.12));
  return mergeParts(P);
}

// ============================================================
// Materials v4: per-class surface response (vertex-colour alpha classes, see assets/pipeline/ddkit.py color()).
// Characters: fur (strand detail, sheen, almost no specular), cloth (weave + sheen), leather, metal, rubber,
// wet skin (frog), gloss (helmets, noses, teeth, lenses), eyes, glow. Fur shells for close-ups.
// Karts: clear-coated metallic flake paint, brushed metal. Low tier keeps MeshStandard with the same decoding.
// ============================================================
const MX_NOISE = `
float mxHash(vec3 p) { p = fract(p * 0.3183099 + 0.1); p *= 17.0; return fract(p.x * p.y * p.z * (p.x + p.y + p.z)); }
float mxNoise(vec3 x) {
  vec3 i = floor(x); vec3 f = fract(x); f = f * f * (3.0 - 2.0 * f);
  return mix(mix(mix(mxHash(i), mxHash(i + vec3(1.0, 0.0, 0.0)), f.x), mix(mxHash(i + vec3(0.0, 1.0, 0.0)), mxHash(i + vec3(1.0, 1.0, 0.0)), f.x), f.y),
             mix(mix(mxHash(i + vec3(0.0, 0.0, 1.0)), mxHash(i + vec3(1.0, 0.0, 1.0)), f.x), mix(mxHash(i + vec3(0.0, 1.0, 1.0)), mxHash(i + vec3(1.0, 1.0, 1.0)), f.x), f.y), f.z);
}
// bump from a scalar height via screen-space derivatives (no UVs / tangents needed)
vec3 mxBump(vec3 surfPos, vec3 n, float h) {
  vec3 sx = dFdx(surfPos); vec3 sy = dFdy(surfPos);
  vec3 r1 = cross(sy, n); vec3 r2 = cross(n, sx);
  float det = dot(sx, r1);
  vec3 grad = sign(det) * (dFdx(h) * r1 + dFdy(h) * r2);
  return normalize(abs(det) * n - grad);
}`;

// class -> roughness / metalness / specular scale / env scale / clear coat / sheen / bump; also tweaks diffuseColor
const CHAR_CLASS_GLSL = `
  float mxSpec = 1.0; float mxEnv = 1.0; float mxCoat = 0.0; float mxCoatR = 0.08; float mxBumpH = 0.0;
  vec3 mxSheen = vec3(0.0); float mxSheenR = 0.6;
  {
    vec3 q = vObjC;
    float cls = vMc;
    // detail fades with the pixel footprint so far-away characters do not shimmer
    float det = 1.0 - smoothstep(0.55, 1.5, length(fwidth(q)) * 90.0);
    if (cls > 0.9375) { // fur: strands run down the body, dark roots, no plastic shine
      float n1 = mxNoise(q * vec3(95.0, 30.0, 95.0));
      float n2 = mxNoise(q * vec3(210.0, 70.0, 210.0) + 7.3);
      float strand = n1 * 0.62 + n2 * 0.38;
      diffuseColor.rgb *= mix(1.0, 0.7 + 0.55 * strand, det);
      roughnessFactor = 1.0; metalnessFactor = 0.0;
      mxSpec = 0.06; mxEnv = 0.16; mxBumpH = strand * 0.014 * det;
      mxSheen = min(diffuseColor.rgb * 1.7 + 0.06, vec3(1.0)); mxSheenR = 0.5;
    } else if (cls > 0.8125) { // cloth: twill weave, soft sheen
      float w = sin((q.x + q.y) * 520.0) * sin((q.z - q.y) * 520.0);
      float fuzz = mxNoise(q * 140.0);
      diffuseColor.rgb *= mix(1.0, 0.9 + 0.08 * w + 0.12 * fuzz, det);
      roughnessFactor = 0.93; metalnessFactor = 0.0;
      mxSpec = 0.28; mxEnv = 0.35; mxBumpH = (w * 0.5 + fuzz) * 0.004 * det;
      mxSheen = min(diffuseColor.rgb * 1.1 + 0.04, vec3(1.0)); mxSheenR = 0.75;
    } else if (cls > 0.6875) { // metal: brushed
      float br = mxNoise(q * vec3(6.0, 6.0, 420.0));
      roughnessFactor = 0.2 + 0.2 * br; metalnessFactor = 0.95;
      mxBumpH = br * 0.002 * det;
    } else if (cls > 0.5625) { // leather: creases, low sheen, a thin coat of wax
      float cr = mxNoise(q * 60.0) * 0.6 + mxNoise(q * 150.0) * 0.4;
      diffuseColor.rgb *= mix(1.0, 0.88 + 0.2 * cr, det);
      roughnessFactor = 0.48 - 0.12 * cr; metalnessFactor = 0.0;
      mxSpec = 0.75; mxEnv = 0.6; mxCoat = 0.18; mxCoatR = 0.35; mxBumpH = cr * 0.006 * det;
    } else if (cls > 0.4375) { // rubber / neoprene
      float g = mxNoise(q * 180.0);
      roughnessFactor = 0.8; metalnessFactor = 0.0;
      mxSpec = 0.45; mxEnv = 0.4; mxBumpH = g * 0.002 * det;
    } else if (cls > 0.3125) { // wet skin (frog, mouth): bumpy, glossy coat
      float bm = mxNoise(q * 70.0);
      float spots = smoothstep(0.62, 0.78, mxNoise(q * 22.0 + 3.0));
      diffuseColor.rgb *= mix(1.0, 0.92 + 0.12 * bm - 0.16 * spots, det);
      roughnessFactor = 0.42; metalnessFactor = 0.0;
      mxSpec = 0.9; mxEnv = 0.85; mxCoat = 0.65; mxCoatR = 0.12; mxBumpH = bm * 0.006 * det;
    } else if (cls > 0.1875) { // gloss: painted helmets, wet noses, teeth, lenses
      roughnessFactor = 0.24; metalnessFactor = 0.0; mxCoat = 0.9; mxCoatR = 0.05;
    } else if (cls > 0.0625) { // eyes
      roughnessFactor = 0.08; metalnessFactor = 0.0; mxCoat = 1.0; mxCoatR = 0.02;
    }
  }`;

const CHAR_MATS = {};
// look: { tint: [r,g,b] multiplies fur + cloth, eyes: hex glow } (the Horns); cached per look
function charMaterial(physical, look) {
  const tint = (look && look.tint) || [1, 1, 1];
  const eyes = (look && look.eyes) || 0;
  const key = (physical ? 'phys' : 'std') + (look && (look.tint || look.eyes) ? ':' + tint.join(',') + ':' + eyes : '');
  if (CHAR_MATS[key]) return CHAR_MATS[key];
  const m = physical
    ? new THREE.MeshPhysicalMaterial({ vertexColors: true, roughness: 0.9, metalness: 0, sheen: 1, sheenRoughness: 0.6, sheenColor: 0xffffff, clearcoat: 1, clearcoatRoughness: 0.1 })
    : new THREE.MeshStandardMaterial({ vertexColors: true, roughness: 0.9, metalness: 0 });
  const u = { uGlow: { value: 1.6 }, uTint: { value: new THREE.Vector3(...tint) }, uEyeGlow: { value: new THREE.Color(eyes || 0) } };
  m.userData.u = u;
  m.onBeforeCompile = (sh) => {
    Object.assign(sh.uniforms, u);
    sh.vertexShader = sh.vertexShader
      .replace('#include <common>', '#include <common>\nattribute float mclass;\nvarying float vMc;\nvarying vec3 vObjC;')
      .replace('#include <begin_vertex>', '#include <begin_vertex>\nvMc = mclass; vObjC = position;');
    sh.fragmentShader = sh.fragmentShader
      .replace('#include <common>', '#include <common>\nvarying float vMc;\nvarying vec3 vObjC;\nuniform float uGlow;\nuniform vec3 uTint;\nuniform vec3 uEyeGlow;\n' + MX_NOISE)
      .replace('#include <metalnessmap_fragment>', '#include <metalnessmap_fragment>\nif (vMc > 0.8125) diffuseColor.rgb *= uTint;\n' + CHAR_CLASS_GLSL)
      .replace('#include <normal_fragment_maps>', '#include <normal_fragment_maps>\nif (mxBumpH != 0.0) normal = mxBump(-vViewPosition, normal, mxBumpH);')
      .replace('#include <emissivemap_fragment>', '#include <emissivemap_fragment>\nif (vMc < 0.0625) totalEmissiveRadiance += diffuseColor.rgb * uGlow;\nif (vMc > 0.0625 && vMc < 0.1875) totalEmissiveRadiance += uEyeGlow * 1.6;')
      .replace(
        '#include <lights_physical_fragment>',
        `#include <lights_physical_fragment>
        material.specularColor *= mxSpec;
        material.specularColorBlended = mix(material.specularColor, diffuseColor.rgb, metalnessFactor);
        material.specularF90 *= mxSpec;
        #ifdef USE_CLEARCOAT
          material.clearcoat = mxCoat;
          material.clearcoatRoughness = max(mxCoatR, 0.0525);
        #endif
        #ifdef USE_SHEEN
          material.sheenColor = mxSheen;
          material.sheenRoughness = mxSheenR;
        #endif`
      )
      .replace('#include <lights_fragment_end>', '#include <lights_fragment_end>\nreflectedLight.indirectSpecular *= mxEnv;');
  };
