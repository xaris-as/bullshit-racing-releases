  applyQuality();
  return true;
}

function applyQuality() {
  Q = pickQuality();
  PR_MAX = Math.min(window.devicePixelRatio || 1, Q.prMax);
  pr = Math.min(PR_MAX, Q.pr);
  renderer.setPixelRatio(pr);
  renderer.shadowMap.enabled = Q.shadows > 0;
