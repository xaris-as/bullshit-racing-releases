  // shouted formant stab ("HEY", "GO", "OI"): saw + noise through parallel vowel bandpasses
  vox(vowel, when = 0, vol = 0.22, pitch = 160, dest = null) {
    const c = this.ctx;
    if (!c) return;
    const F = { a: [800, 1150, 2900], e: [400, 2100, 2700], o: [450, 800, 2830], i: [300, 2300, 3000], u: [325, 700, 2530] }[vowel] || [800, 1150, 2900];
