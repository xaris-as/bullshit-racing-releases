  geos.push(staticGeo);
  const statics = new THREE.Mesh(staticGeo, MAT.kart);
  chassis.add(statics);

  // steering wheel (spins with the steering; the driver's hands follow it with IK)
  let steerWheel = null;
  const swm = bodyRoot.meshes.find((m) => /_steer_fx$/.test(m.name));
  if (swm) {
    steerWheel = new THREE.Group();
    steerWheel.position.copy(swm.pos);
    steerWheel.quaternion.copy(swm.quat);
    const sm = new THREE.Mesh(Assets.mesh(swm.name), MAT.kart);
    chassis.add(steerWheel);
    if (bike) {
