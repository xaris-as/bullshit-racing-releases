const _cv2 = new THREE.Vector3();

// glowing ribbon trail (Silk Drift, Big Air, Perfect Line ghost) - one dynamic strip
class Trail {
  constructor(n, color, width = 0.5, opacity = 0.85) {
    this.n = n;
    this.w = width;
    this.pts = [];
    this.pos = new Float32Array(n * 2 * 3);
    this.al = new Float32Array(n * 2);
    const idx = [];
    for (let k = 0; k < n - 1; k++) {
      const a = k * 2;
      idx.push(a, a + 1, a + 2, a + 1, a + 3, a + 2);
    }
    const g = new THREE.BufferGeometry();
    g.setAttribute('position', new THREE.BufferAttribute(this.pos, 3).setUsage(THREE.DynamicDrawUsage));
    g.setAttribute('alpha', new THREE.BufferAttribute(this.al, 1).setUsage(THREE.DynamicDrawUsage));
    g.setIndex(idx);
    this.geo = g;
    const c = new THREE.Color(color);
    this.mat = new THREE.ShaderMaterial({
      uniforms: { uC: { value: new THREE.Vector3(c.r, c.g, c.b) }, uO: { value: opacity } },
      vertexShader: 'attribute float alpha; varying float vA; void main(){ vA = alpha; gl_Position = projectionMatrix * modelViewMatrix * vec4(position,1.0); }',
      fragmentShader: 'uniform vec3 uC; uniform float uO; varying float vA; void main(){ gl_FragColor = vec4(uC * 2.2, vA * uO); }',
      transparent: true,
      depthWrite: false,
      blending: THREE.AdditiveBlending,
      side: THREE.DoubleSide,
    });
    this.mesh = new THREE.Mesh(g, this.mat);
    this.mesh.frustumCulled = false;
    this.mesh.renderOrder = 4;
    this.mesh.visible = false;
  }
  // push a point with a side vector (sx, sz); on=false lets the tail shrink away
  push(x, y, z, sx, sz, on) {
    if (on) {
      const p = this.pts[0];
      if (!p || (p[0] - x) ** 2 + (p[1] - y) ** 2 + (p[2] - z) ** 2 > 0.25) {
        this.pts.unshift([x, y, z, sx, sz]);
        if (this.pts.length > this.n) this.pts.length = this.n;
      }
    } else if (this.pts.length) this.pts.pop();
    this.mesh.visible = this.pts.length > 1;
    if (!this.mesh.visible) return;
    for (let k = 0; k < this.n; k++) {
      const p = this.pts[Math.min(k, this.pts.length - 1)];
      const o = k * 6;
      const w = this.w * (1 - k / this.n);
      this.pos[o] = p[0] + p[3] * w;
      this.pos[o + 1] = p[1];
      this.pos[o + 2] = p[2] + p[4] * w;
      this.pos[o + 3] = p[0] - p[3] * w;
      this.pos[o + 4] = p[1];
      this.pos[o + 5] = p[2] - p[4] * w;
      const a = k < this.pts.length ? 1 - k / this.n : 0;
      this.al[k * 2] = this.al[k * 2 + 1] = a;
    }
    this.geo.attributes.position.needsUpdate = true;
    this.geo.attributes.alpha.needsUpdate = true;
  }
  // set from an explicit polyline (ghost racing line)
  setLine(list) {
    this.mesh.visible = list.length > 1;
    for (let k = 0; k < this.n; k++) {
      const p = list[Math.min(k, list.length - 1)];
      if (!p) break;
      const o = k * 6;
      this.pos[o] = p[0] + p[3] * this.w;
      this.pos[o + 1] = p[1];
      this.pos[o + 2] = p[2] + p[4] * this.w;
      this.pos[o + 3] = p[0] - p[3] * this.w;
      this.pos[o + 4] = p[1];
      this.pos[o + 5] = p[2] - p[4] * this.w;
      const a = k < list.length ? Math.min(1, k / 4) * (1 - k / list.length) : 0;
      this.al[k * 2] = this.al[k * 2 + 1] = a;
    }
    this.geo.attributes.position.needsUpdate = true;
    this.geo.attributes.alpha.needsUpdate = true;
  }
  clear() {
    this.pts.length = 0;
    this.mesh.visible = false;
  }
  dispose() {
    this.geo.dispose();
    this.mat.dispose();
  }
}

