  if (J.length) W.jetRings.instanceMatrix.needsUpdate = true;
  const pt = W.pads.tex;
  pt.offset.y = (pt.offset.y - dt * 1.8) % 1;
  for (const w of W.windmills) w.m.rotation.z = t * 0.8 + w.ph;
  if (W.extra) W.extra.update(dt);
  for (let i = 0; i < tr.tumble.length; i++) {
    const tb = tr.tumble[i];
    const m = W.tumble[i];
    tr.toWorld(tb.s, tb.d, _tw);
    const psi = tr.psiAt(tb.s);
    const y = tr.groundHeight(tb.s, tb.d) + Math.abs(Math.sin(t * 3 + i)) * 0.35;
    m.position.set(_tw.x, y, _tw.z);
    m.rotation.set(0, -psi, 0);
    m.rotateZ(-tb.roll);
  }
  // gondolas ride along their cables
  for (const g of W.glide.gondolas) {
    const c = g.c;
    const gd = Math.sin(race.time * c.w + c.ph) * 9;
    g.m.position.set(g.F.x + g.F.rx * gd, c.y, g.F.z + g.F.rz * gd);
    g.m.rotation.y = -g.F.psi + Math.PI / 2;
  }
  // thermal sparkles
  for (const th of W.glide.thermals) {
    if (!nearCam(th.wx, (th.y0 + th.y1) / 2, th.wz, 140) || Math.random() > 0.6 * Q.particles) continue;
    const a = Math.random() * TAU;
    Game.fxA.spawn(th.wx + Math.cos(a) * th.r * 0.8, th.y0 + Math.random() * 4, th.wz + Math.sin(a) * th.r * 0.8, -Math.sin(a) * 2, 5 + Math.random() * 3, Math.cos(a) * 2, 1.6, 0.25, 0xffe2a0, 0.7, -1, 0.5, 0, 1.6);
  }
  // decoys
  for (const d of Game.decoys) {
    if (!d.k.alive) continue;
    tr.toWorld(d.k.s, d.k.d, _tw);
    d.g.position.set(_tw.x, d.k.y + Math.sin(t * 6) * 0.03, _tw.z);
    d.g.rotation.y = -d.k.hw;
    d.mat.uniforms.uAlpha.value = (0.55 + 0.35 * Math.sin(t * 22)) * Math.min(1, (d.k.life - d.k.age) * 2);
  }
  if (ITEMS_ON) {
    const R = race.rockets;
    for (let i = 0; i < W.rockets.length; i++) {
      const m = W.rockets[i];
      const k = R[i];
      if (!k) {
        m.visible = false;
        continue;
      }
      m.visible = true;
      tr.toWorld(k.s, k.d, _tw);
      m.position.set(_tw.x, k.y, _tw.z);
      m.rotation.set(0, -tr.psiAt(k.s), 0);
    }
  }
  // Perfect Line ghost racing line ahead of the player
  if (P.lineT > 0) {
    if (!Game.ghost) {
      Game.ghost = new Trail(60, 0x7dff6b, 0.32, 0.9);
      W.scene.add(Game.ghost.mesh);
    }
    const list = [];
    for (let k = 0; k < 60; k++) {
      const s = P.s + 4 + k * 2.2;
      const d = tr.lineAt(s);
      const pp = tr.toWorld(s, d, _tw);
      const m = tr.modeAt(s);
      const y = m === M_AIR ? tr.heightAt(s) + 0.6 : m === M_WATER ? tr.waterY + 0.15 : tr.baseHeight(s, d) + 0.12;
      const ps = tr.psiAt(s);
      list.push([pp.x, y, pp.z, Math.cos(ps), Math.sin(ps)]);
    }
    Game.ghost.setLine(list);
  } else if (Game.ghost) Game.ghost.mesh.visible = false;
}

function emitParticles(dt) {
  const race = Game.race;
  const tr = race.track;
  const W = Game.world;
  const dirt = W.theme.dirt;
  const rate = Math.min(1, dt * 60) * Q.particles;
  let boatI = 0;
  for (const r of race.racers) {
    const v = Game.vis[r.idx];
    const p = v.root.position;
    const mode = tr.modeAt(r.s);
    // boat uniforms for the water shader (all boats, even far ones: wakes are long)
    if (mode === M_WATER && boatI < MAX_BOATS) {
      W.U.uBoat.value[boatI].set(p.x, p.z, Math.sin(r.hw), -Math.cos(r.hw));
      W.U.uBoatSp.value[boatI] = Math.max(0.01, r.spd);
      boatI++;
    }
    if (W.wakes) W.wakes.update(r.idx, mode === M_WATER && r.spd > 4, p.x, tr.waterY, p.z, Math.sin(r.hw), -Math.cos(r.hw), r.spd);
    W.U.uKarts.value[r.idx].set(p.x, p.y, p.z, 1);
    if (!nearCam(p.x, p.y, p.z, 110)) {
      for (let wi = 2; wi < 4; wi++) W.skids.lift(r.idx * 4 + wi);
      continue;
    }
    v.root.updateMatrixWorld(true);
    if (r.boostT > 0) {
      const fc = v.flameCol;
      const burn = r.burnT > 0;
      for (const o of v.outlets) {
        if (Math.random() > 0.8 * rate) continue;
        v.chassis.localToWorld(_lw.copy(o));
        Game.fxA.spawn(_lw.x, _lw.y, _lw.z, rnd2() * 1.5, Math.random() * 1.5, rnd2() * 1.5, 0.18 + Math.random() * 0.1, burn ? 0.5 : 0.32, Math.random() < 0.5 ? fc.a : fc.b, 0.9, -2, 2, -1, 2.6);
        if (burn && Math.random() < 0.6) {
          v.chassis.localToWorld(_lw2.set(o.x, o.y, o.z + 1.4 + Math.random() * 2));
          Game.fxA.spawn(_lw2.x, _lw2.y, _lw2.z, rnd2() * 2, 0.5 + Math.random(), rnd2() * 2, 0.35, 0.7, Math.random() < 0.5 ? 0xff5e00 : 0xffc21a, 0.85, -1, 2.5, 1, 2.8);
          Game.fx.spawn(_lw2.x, _lw2.y + 0.3, _lw2.z, rnd2(), 1, rnd2(), 1.2, 0.8, 0x2a2a2e, 0.5, -0.6, 1, 1.6);
        }
      }
    }
    // tyre smoke that lingers + accumulating skid marks
    const sliding = r.grounded && mode === M_ROAD && (r.drift.on || r.spinning || (Math.abs(r.slip) > 0.25 && r.spd > 10));
    for (let wi = 0; wi < v.wheels.length; wi++) {
      const w = v.wheels[wi];
      const key = r.idx * 4 + wi;
      if (sliding && !w.front) {
        v.chassis.localToWorld(_lw.set(w.base.x * 1.02, 0.02, w.base.z));
        const gy = tr.groundHeight(r.s, r.d) + 0.03;
        W.skids.mark(key, _lw.x, gy + CURB_H(r.d), _lw.z, Math.cos(r.hw), Math.sin(r.hw), 0.15, r.drift.on ? 0.55 : 0.4);
      } else W.skids.lift(key);
    }
    if (r.drift.on && r.grounded && mode === M_ROAD && Math.random() < 0.9 * rate) {
      const lvl = r.drift.level;
      for (const w of v.wheels) {
        if (w.front) continue;
        v.chassis.localToWorld(_lw.set(w.base.x * 1.05, 0.06, w.base.z + 0.25));
        const n = lvl ? 2 : 1;
        for (let i = 0; i < n; i++) Game.fxA.spawn(_lw.x, _lw.y, _lw.z, rnd2() * 3, 0.5 + Math.random() * 2.5, rnd2() * 3, 0.2 + Math.random() * 0.15, lvl ? 0.2 : 0.12, DRIFT_COL[lvl], 1, 12, 1, 0, lvl ? 3 : 1.4);
        if (Math.random() < 0.55) Game.fx.spawn(_lw.x, _lw.y + 0.15, _lw.z, rnd2() * 1.2, 0.5 + Math.random() * 0.4, rnd2() * 1.2, 1.6 + Math.random(), 0.5, W.theme.night ? 0x8a92a0 : 0xcfcfd4, 0.32, -0.25, 0.9, 1.8);
      }
    }
    if (r.spinning && r.grounded && Math.random() < 0.7 * rate) {
      Game.fx.spawn(p.x + rnd2(), p.y + 0.3, p.z + rnd2(), rnd2() * 2, 0.6, rnd2() * 2, 1.8, 0.8, 0xbfbfc6, 0.4, -0.2, 0.9, 2);
    }
    // boats: bow spray sheets + a few droplets
    if (mode === M_WATER) {
      const sp = clamp(r.spd / 30, 0, 1);
      if (Q.waterGrid || W.wakes) {
        const S = ensureSpray(v);
        S.mat.opacity = damp(S.mat.opacity, 0.15 + sp * 0.75 * v.hullE, 6, dt);
        S.mat.map.offset.y = (S.mat.map.offset.y + dt * (1 + sp * 4)) % 1;
        for (const m of S.sheets) m.scale.set(0.7 + sp * 0.8, 0.4 + sp * 1.1, 1);
      }
      if (r.spd > 4 && Math.random() < 0.6 * rate) {
        v.chassis.localToWorld(_lw.set(rnd2() * 0.8, 0.2, -1.6));
        Game.fx.spawn(_lw.x, tr.waterY + 0.3, _lw.z, rnd2() * 2 + (_lw.x - p.x) * 1.2, 1.5 + Math.random() * 3 * sp, rnd2() * 2 + (_lw.z - p.z) * 1.2, 0.5, 0.18 + sp * 0.12, 0xffffff, 0.85, 12, 1, 0.3);
      }
    } else if (v.spray) v.spray.mat.opacity = damp(v.spray.mat.opacity, 0, 8, dt);
    if (mode === M_AIR && v.wingE > 0.6 && Math.random() < 0.9 * rate) {
      for (const sx of [-1.75, 1.75]) {
        v.chassis.localToWorld(_lw.set(sx * v.wingE, 0.82, 0.55));
        for (let k = 0; k < 3; k++) {
          const b = (k / 3) * dt;
          Game.fx.spawn(_lw.x - r.vx * b, _lw.y - r.vy * b, _lw.z - r.vz * b, 0, 0, 0, 0.34, 0.16, 0xffffff, 0.3, 0, 0, 0.12);
        }
      }
    }
    if (r.isPlayer && r.draft > 0.3 && Math.random() < r.draft * 1.4 * rate) {
      const fx = Math.sin(r.hw);
      const fz = -Math.cos(r.hw);
      const a = (Math.random() < 0.5 ? -1 : 1) * (1.6 + Math.random() * 2);
      const ah = 3 + Math.random() * 8;
      Game.fx.spawn(p.x + fx * ah + fz * -a, p.y + 0.4 + Math.random() * 2, p.z + fz * ah + fx * a, -r.vx * 0.4, 0, -r.vz * 0.4, 0.35, 0.12, 0xffffff, 0.55, 0, 0, 0);
    }
    if (r.offroad && r.v > 8 && Math.random() < 0.8 * rate) {
      v.chassis.localToWorld(_lw.set((Math.random() < 0.5 ? -1 : 1) * 0.85, 0.15, 1.0));
      Game.fx.spawn(_lw.x, _lw.y, _lw.z, rnd2() * 2, 1 + Math.random() * 1.5, rnd2() * 2, 1.1, 1.0, dirt, 0.5, 0, 1.2, 2.4);
    }
    // corner dust kicked up by fast karts near the edges
    if (Math.abs(r.d) > ROAD_HW - 1 && r.spd > 22 && mode === M_ROAD && Math.random() < 0.25 * rate) {
      v.chassis.localToWorld(_lw.set(Math.sign(r.d) * 0.9, 0.1, 1.2));
      Game.fx.spawn(_lw.x, _lw.y, _lw.z, rnd2() * 2, 0.6, rnd2() * 2, 1.4, 0.9, dirt, 0.35, -0.1, 1, 2.2);
    }
    if (r.spinning && Math.random() < 0.5 * rate) {
      const a = Math.random() * TAU;
      Game.fxA.spawn(p.x + Math.cos(a) * 0.6, p.y + 2.0, p.z + Math.sin(a) * 0.6, 0, 1.2, 0, 0.5, 0.3, 0xffc21a, 1, 0, 0, 0, 2);
    }
    if (r.scorchT > 0 && Math.random() < 0.4 * rate) Game.fxA.spawn(p.x + rnd2(), p.y + 0.6, p.z + rnd2(), rnd2(), 1.5, rnd2(), 0.4, 0.35, 0xff5e00, 0.9, -1, 1, 0, 2.4);
  }
  for (let i = boatI; i < MAX_BOATS; i++) W.U.uBoatSp.value[i] = 0;
  W.skids.flush();
}

// clip events -> particles/sounds (steam puffs, dizzy stars, neck cracks, wheel thumps, roars)
function onAnimEvent(name, anim) {
  const v = anim._vis;
  if (!v || !Game.world) return;
  const p = v.root.position;
  const close = nearCam(p.x, p.y, p.z, 60);
  const isP = v === Game.pvis;
  switch (name) {
    case 'steam':
      if (close) for (let i = 0; i < 14; i++) Game.fx.spawn(p.x + rnd2() * 0.6, p.y + 2.2, p.z + rnd2() * 0.6, rnd2() * 1.5, 1.5 + Math.random(), rnd2() * 1.5, 1.2, 0.6, 0xf2f2f2, 0.6, -0.5, 1.2, 1.8);
      if (isP) Sound.play('steam');
      break;
    case 'stars':
      if (close) for (let i = 0; i < 8; i++) {
        const a = (i / 8) * TAU;
        Game.fxA.spawn(p.x + Math.cos(a) * 0.5, p.y + 2.3, p.z + Math.sin(a) * 0.5, -Math.sin(a) * 1.5, 0.3, Math.cos(a) * 1.5, 0.8, 0.28, 0xffc21a, 1, 0, 0, 0, 2.4);
      }
      break;
    case 'puff':
      if (close) for (let i = 0; i < 10; i++) Game.fx.spawn(p.x + rnd2(), p.y + 1.6, p.z + rnd2(), rnd2() * 2, 1, rnd2() * 2, 0.6, 0.5, 0x9aa0ab, 0.7, 0, 1.2, 1.2);
      if (isP) Sound.play('hiss');
      break;
    case 'crack':
    case 'thump':
    case 'slam':
    case 'clang':
      if (isP || attn(p, 30) > 0.2) Sound.play(name, isP ? 1 : 0.5);
      break;
    case 'roar':
      if (isP || attn(p, 40) > 0.2) Sound.play('roar', isP ? 1 : 0.5);
      break;
    case 'flash':
      if (close) for (let i = 0; i < 12; i++) Game.fxA.spawn(p.x, p.y + 1.6, p.z, rnd2() * 4, rnd2() * 3, rnd2() * 4, 0.3, 0.3, ABILITIES[v.def.ability].color, 1, 0, 2, 0, 3);
      break;
  }
}

// ---------------- Game flow ----------------
const Game = {
  phase: 'boot',
  paused: false,
  dead: false,
  tracks: [],
  idx: 0,
  world: null,
  race: null,
  vis: [],
  player: null,
  pvis: null,
  rig: null,
  fx: null,
  fxA: null,
  snow: null,
  t: 0,
  clock: 0,
  step: 0,
  tapAt: -99,
  perfect: false,
  postT: 0,
  final: false,
  snapCam: false,
  settingsFrom: null,
  qualityDirty: false,
  lastBump: new Map(),
  timeScale: 1,
  tsTarget: 1,
  tsT: 0,
  hitStop: 0,
  decoys: [],
  ghost: null,
  lineGhost: 0,
  selIdx: 0,

  inRace() {
    return !this.paused && (this.phase === 'countdown' || this.phase === 'race');
  },
  slowmo(scale, dur) {
    if (REDUCED_MOTION) return;
    this.tsTarget = Math.min(this.tsTarget, scale);
    this.tsT = Math.max(this.tsT, dur);
  },
  initUI() {
    const click = (id, fn) =>
      $(id).addEventListener('click', (e) => {
        Sound.play('click');
        fn(e);
      });
    click('btn-race', () => this.goSelect());
    Story.initUI();
    Net.initUI();
    click('btn-garage', () => this.goGarage());
    click('btn-sound', () => this.toggleSound());
    click('btn-settings', () => this.openSettings('menu'));
    click('btn-psettings', () => this.openSettings('pause'));
    click('btn-set-done', () => this.closeSettings());
    click('tracks-back', () => this.goSelect());
    click('garage-back', () => this.goMenu());
    click('sel-back', () => this.goMenu());
    click('sel-prev', () => this.selectRacer(-1));
    click('sel-next', () => this.selectRacer(1));
    click('sel-pick', () => this.pickRacer());
    click('btn-resume', () => this.resume());
    click('btn-restart', () => this.restart());
    click('btn-quit', () => this.quit());
    click('btn-again', () => (this.netCfg ? this.quit() : this.restart()));
    click('btn-menu', () => this.quit());
    click('btn-next', () => {
      if (this.storyNode) return Story.continue();
      if (this.netCfg) return this.quit();
      const nx = this.nextOpenTrack();
      if (nx > 0) this.startRace(nx);
      else {
        this.teardown();
        UI.setOn('results', false);
        this.goTracks();
      }
    });
    click('tg-music', () => {
      Save.data.music = !Save.data.music;
      this.applySound();
    });
    click('tg-sfx', () => {
      Save.data.sfx = !Save.data.sfx;
      this.applySound();
    });
    $('btn-reload').addEventListener('click', () => location.reload());
    $('btn-pause').addEventListener('pointerdown', (e) => {
      e.preventDefault();
      e.stopPropagation();
    });
    $('btn-pause').addEventListener('click', () => this.pause());
    const item = $('btn-item');
    item.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      e.stopPropagation();
      if (!this.inRace()) return;
      Input.itemQ = true;
      this.onTap();
    });
    item.addEventListener('click', (e) => {
      if (e.detail === 0 && this.inRace()) {
        Input.itemQ = true;
        this.onTap();
      }
    });
    this.menuHint();
    document.body.classList.toggle('touch', TOUCH_UI);
    UI.soundIcon();
    UI.coins();
  },
  menuHint() {
    const manual = Save.data.settings.drift === 'manual';
    $('menu-hint').textContent = TOUCH_UI
      ? 'Hold left or right to steer. ' + (manual ? 'Hold DRIFT while turning. ' : 'Hold a turn to drift. ') + 'Tap the ability button when the meter is full. Hold both sides to dive in the glider.'
      : '← → steer · ' + (manual ? 'Shift/Space drift · ' : '') + 'Space off a ramp = trick · E ability · ↓ brake / dive · P pause';
  },
  applySound() {
    Sound.setMusic(Save.data.music);
    Sound.setSfx(Save.data.sfx);
    if (Save.data.music && Sound.ctx) {
      const style = this.world && !['menu', 'tracks', 'garage', 'select'].includes(this.phase) ? this.world.theme.music : 'menu';
      Sound.startMusic(style);
    }
    Save.store();
    UI.soundIcon();
  },
  toggleSound() {
    const on = !(Save.data.music || Save.data.sfx);
    Save.data.music = on;
    Save.data.sfx = on;
    this.applySound();
  },
  openSettings(from) {
    this.settingsFrom = from;
    const before = pickQuality().id;
    SettingsUI.render(() => {
      Save.store();
      this.applySound();
      this.menuHint();
      if (this.rig) this.rig.shakeOn = Save.data.settings.shake;
      if (this.player) this.applyDriving(this.player);
      Minimap.setEnabled(Save.data.settings.minimap);
      if (pickQuality().id !== before) this.qualityDirty = true;
      if (this.qualityDirty && !this.world) {
        applyQuality();
        this.qualityDirty = false;
      }
    });
    UI.setOn('settings', true);
  },
  closeSettings() {
    UI.setOn('settings', false);
    if (this.qualityDirty && this.world) UI.toast('Graphics change applies from the next race');
  },
  applyDriving(r) {
    const S = Save.data.settings;
    r.manualDrift = S.drift === 'manual';
    r.autoDrift = S.drift === 'auto';
    r.assist = !!S.assist;
    $('btn-drift').classList.toggle('hidden', !(TOUCH_UI && r.manualDrift));
  },
  selectRacer(delta) {
    const n = RACERS.length;
    Save.data.racer = (Save.data.racer + delta + n) % n;
    Save.store();
    showMenuRacer(Save.data.racer);
    if (this.phase === 'select') SelectUI.render(Save.data.racer, delta);
    else UI.racerCard(Save.data.racer);
    Sound.play('swish');
  },
  pickRacer() {
    menuPick();
    SelectUI.pick();
    Sound.play('pick');
    setTimeout(() => {
      if (this.phase === 'select') this.goTracks();
    }, 900);
  },
  transition() {
    Post.fx.glitch = 1;
    document.body.classList.remove('glitch');
    void document.body.offsetWidth;
    document.body.classList.add('glitch');
  },
  goMenu(silent) {
    this.phase = 'menu';
    this.transition();
    Menu.holder.visible = true;
    this.paused = false;
    UI.hud(false);
    UI.show(silent ? 'none' : 'menu');
    UI.coins();
    UI.racerCard(Save.data.racer);
    showMenuRacer(Save.data.racer);
    frameMenuCam();
    Sound.silence();
    if (Sound.ctx) Sound.startMusic('menu');
  },
  goSelect() {
    this.phase = 'select';
    this.transition();
    Menu.holder.visible = true;
    UI.show('select');
    showMenuRacer(Save.data.racer);
    SelectUI.render(Save.data.racer, 0);
    requestAnimationFrame(() => frameMenuCam());
    frameMenuCam();
    if (Sound.ctx) Sound.startMusic('menu');
  },
  goTracks() {
    this.phase = 'tracks';
    this.transition();
    Menu.holder.visible = false;
    // quick race: the five originals + every story track the player has unlocked
    const open = this.tracks.map((t, i) => [t, i]).filter(([t, i]) => i < BASE_TRACKS || Story.trackUnlocked(t.def.id));
    UI.trackCards(
      open.map((x) => x[0]),
      (j) => {
        Sound.play('click');
        this.storyNode = null;
        this.startRace(open[j][1]);
      }
    );
    UI.coins();
    UI.show('tracks');
    if (Sound.ctx) Sound.startMusic('menu');
  },
  goGarage() {
    this.phase = 'garage';
    this.transition();
    Menu.holder.visible = true;
    UI.show('garage');
    const idx = Save.data.racer;
    GarageUI.open({
      racer: idx,
      build: () => Save.build(idx),
      preview: (b) => showMenuRacer(idx, b),
      onEquip: (cat, id) => {
        Save.build(idx)[cat] = id;
        Save.store();
        Sound.play('equip');
      },
      onBuy: (cat, id) => {
        const p = partOf(cat, id);
        if (Save.data.coins < p.cost) {
          Sound.play('deny');
          UI.toast(`You need ${p.cost - Save.data.coins} more coins`, 'bad');
          return;
        }
        Save.data.coins -= p.cost;
        if (!Save.data.owned[cat].includes(id)) Save.data.owned[cat].push(id);
        Save.build(idx)[cat] = id;
        Save.store();
        Sound.play('buy');
        UI.coins();
        UI.toast(p.name + ' added to your garage', 'good');
        GarageUI.trying = null;
        GarageUI.render();
      },
      onPaint: (key, val) => {
        Save.build(idx)[key] = val;
        Save.store();
        Sound.play('click');
      },
      onUpgrade: (id) => {
        const lvl = Save.data.up[id];
        if (lvl >= MAX_LVL) return;
        const cost = UPGRADE_COST[lvl];
        if (Save.data.coins < cost) {
          Sound.play('deny');
          UI.toast(`You need ${cost - Save.data.coins} more coins`, 'bad');
          return;
        }
        Save.data.coins -= cost;
        Save.data.up[id] = lvl + 1;
        Save.store();
        Sound.play('buy');
        UI.coins();
      },
      onReset: () => {
        Object.assign(Save.build(idx), copyBuild(RACERS[idx].build));
        Save.store();
        Sound.play('equip');
      },
    });
    UI.coins();
    requestAnimationFrame(() => frameMenuCam());
    frameMenuCam();
    if (Sound.ctx) Sound.startMusic('menu');
  },
  startRace(idx) {
    this.idx = idx;
    this.phase = 'loading';
    this.paused = false;
    UI.hud(false);
    UI.setOn('results', false);
    UI.setOn('pause', false);
    $('loading-text').textContent = 'BUILDING ' + TRACKS[idx].name.toUpperCase() + '…';
    UI.show('loading');
    Sound.stopMusic();
    Sound.silence();
    Podium.dispose();
    setTimeout(() => {
      try {
        if (this.qualityDirty) {
          applyQuality();
          this.qualityDirty = false;
        }
        this.build(idx);
        if (this.netCfg) Net.built();
        else if (!(this.storyNode && Story.preRace())) this.beginCountdown();
      } catch (e) {
        fatal('Something went wrong while building the track. Reload to try again.', e);
      }
    }, 50);
  },
  build(idx) {
    this.teardown();
    const track = this.tracks[idx];
    track.resetFeatures();
    const world = buildWorld(track, renderer, Q);
    const pIdx = Save.data.racer;
    const lineup = this.storyNode ? Story.lineup(this.storyNode) : this.lineupOverride;
    const racers = lineup
      ? lineup.map((e, i) => new Racer(e.def, i, !!e.player, e.build, Save.data.up))
      : RACERS.map((def, i) => new Racer(def, i, i === pIdx, i === pIdx ? copyBuild(Save.build(i)) : copyBuild(def.build), Save.data.up));
    const lv = Save.data.up.engine + Save.data.up.grip + Save.data.up.turbo;
    const boss = this.storyNode && this.storyNode.duel ? 0.025 : 0;
    const race = new Race(track, racers, { hooks: Hooks, seed: (Math.random() * 1e9) | 0, aiBoost: 1 + 0.003 * lv + boss });
    this.world = world;
    this.race = race;
    this.player = race.player;
    this.applyDriving(this.player);
    this.vis = racers.map((r) => {
      const v = buildRacerVisual(r.def, r.build, !r.isPlayer, Q.shadows > 0 && (r.isPlayer || Q.shadows >= 2048), { fur: r.isPlayer && Q.id === 'high' ? Q.fur : 0, look: r.def.look });
      world.scene.add(v.root, v.shadow);
      v.anim._vis = v;
      v.anim.onEvent = onAnimEvent;
      return v;
    });
    this.pvis = this.vis[this.player.idx];
    this.fx = new Particles(Math.round(1400 * Q.particles), false);
    this.fxA = new Particles(Math.round(1200 * Q.particles), true);
    world.scene.add(this.fx.points, this.fxA.points);
    if (world.theme.snowfall) {
      this.snow = new Snowfall(Q.id === 'low' ? 350 : 900);
      world.scene.add(this.snow.points);
    }
    renderer.toneMappingExposure = world.theme.exposure ?? 1;
    Post.setGrade(world.theme.grade);
    this.rig = new CameraRig(raceCam);
    this.rig.setAspect(raceCam.aspect);
    this.rig.shakeOn = Save.data.settings.shake;
    Minimap.build(track, race);
    this.chaos = new ChaosFX(world.scene, track, Q);
  },
  teardown() {
    if (this.chaos) this.chaos.dispose();
    this.chaos = null;
    if (this.world) this.world.dispose();
    for (const v of this.vis) {
      if (v.trail) v.trail.dispose();
      disposeRacerVisual(v);
    }
    for (const d of this.decoys) d.mat.dispose();
    this.decoys = [];
    if (this.ghost) this.ghost.dispose();
    this.ghost = null;
    if (this.fx) this.fx.dispose();
    if (this.fxA) this.fxA.dispose();
    if (this.snow) this.snow.dispose();
    this.world = null;
    this.race = null;
    this.player = null;
    this.pvis = null;
    this.vis = [];
    this.fx = null;
    this.fxA = null;
    this.snow = null;
    this.rig = null;
    this.lastBump.clear();
    renderer.toneMappingExposure = 1;
    Post.setGrade(THEMES.frost.grade);
    if (renderer) renderer.renderLists.dispose();
  },
  spawnDecoy(r, k) {
    const v = visOf(r);
    const mat = rimMaterial(ABILITIES.afterimage.color, 0.8);
    const g = new THREE.Group();
    v.chassis.traverse((o) => {
      if (o.isMesh && !o.isSkinnedMesh && o.visible && o.geometry && o.material !== v.flameMat && o !== v.decal) {
        const m = new THREE.Mesh(o.geometry, mat);
        o.updateWorldMatrix(true, false);
        m.matrix.copy(v.root.matrixWorld).invert().multiply(o.matrixWorld);
        m.matrixAutoUpdate = false;
        g.add(m);
      }
    });
    this.world.scene.add(g);
    this.decoys.push({ k, g, mat });
  },
  popDecoy(k, hit) {
    const i = this.decoys.findIndex((d) => d.k === k);
    if (i < 0) return;
    const d = this.decoys[i];
    const p = d.g.position;
    for (let j = 0; j < (hit ? 30 : 12); j++) Game.fxA.spawn(p.x, p.y + 0.8, p.z, rnd2() * 8, Math.random() * 4, rnd2() * 8, 0.4, 0.3, 0x29e3ff, 1, 2, 2, 0, 3);
    this.world.scene.remove(d.g);
    d.mat.dispose();
    this.decoys.splice(i, 1);
  },
  resetRace() {
    const race = this.race;
    const tr = race.track;
    tr.resetFeatures();
    for (const c of tr.coins) c._init = false;
    race.autopilot = false;
    race.placeOnGrid(4);
    race.input.steer = 0;
    race.input.brake = false;
    race.input.drift = false;
    race.input.ability = false;
    this.fx.clear();
    this.fxA.clear();
    this.world.skids.clear();
    this.lastBump.clear();
    while (this.decoys.length) this.popDecoy(this.decoys[0].k, false);
    for (const v of this.vis) {
      v.squash = 0;
      v.lean = 0;
      v.pitch = 0;
      v.roll = 0;
      v.wingE = 0;
      v.hullE = 0;
      v.sink = 0;
      v.root.visible = true;
      if (v.trail) v.trail.clear();
      v.anim.stopOneShot();
      v.anim.setBase('idle');
    }
    this.timeScale = 1;
    this.tsTarget = 1;
    this.tsT = 0;
    HUD.build(race);
    Input.clear();
  },
  beginCountdown() {
    if (document.activeElement && document.activeElement.blur) document.activeElement.blur();
    this.resetRace();
    this.phase = 'countdown';
    this.paused = false;
    this.t = 0;
    this.step = 0;
    this.tapAt = -99;
    this.perfect = false;
    this.final = false;
    this.postT = 0;
    this.ritualDone = false;
    UI.show('none');
    UI.setOn('results', false);
    UI.setOn('pause', false);
    UI.hud(true);
    const ch = $('count-hint');
    ch.innerHTML = '';
    const manual = Save.data.settings.drift === 'manual';
    const ab = ABILITIES[RACERS[Save.data.racer].ability];
    const lines = TOUCH_UI
      ? ['Hold left / right to steer · ' + (manual ? 'hold DRIFT to drift' : 'hold a turn to drift') + ' · tap in the air off a ramp = trick', `Fill the meter, tap ${ab.name.toUpperCase()} · tap right at GO for a turbo start`]
      : ['← → steer · ' + (manual ? 'Shift/Space drift · ' : '') + 'Space in the air off a ramp = trick · ↓ brake / dive', `E = ${ab.name.toUpperCase()} when the meter is full · press E right at GO for a turbo start`];
    for (const l of lines) ch.appendChild(el('span', 'k', l));
    ch.classList.remove('hidden');
    UI.trackIntro(this.race.track.def, THEMES[this.race.track.def.theme]);
    this.rig.setIntro(this.race.track, this.player);
    this.race.step(1 / 60);
    for (const r of this.race.racers) updateRacerVisual(r, this.vis[r.idx], 1 / 60, this.race.track, this.race);
    this.rig.update(1 / 60, 'intro', this.race.track, this.player, this.pvis, 0);
    if (Sound.ctx) Sound.startMusic(this.world.theme.music);
  },
  onTap() {
    if (this.phase === 'countdown') this.tapAt = this.t;
    else if (this.phase === 'race' && this.race && this.race.time < 0.22 && !this.perfect) this.perfectStart();
  },
  perfectStart() {
    this.perfect = true;
    this.race.giveBoost(this.player, 1.4, 1.15);
    Sound.play('perfect');
    UI.toast('PERFECT START', 'good');
  },
  // countdown: 2.2 s flyover, then 3-2-1 with hit-stop + shake, GO
  updateCountdown(dt) {
    this.t += dt;
    const marks = [2.8, 3.8, 4.8, 5.8];
    if (!this.ritualDone && this.t > 2.6) {
      this.ritualDone = true;
      for (const v of this.vis) v.anim.trigger('start_ritual', { force: true, speed: 1 });
    }
    let st = 0;
    for (const m of marks) if (this.t >= m) st++;
    if (st === this.step) return;
    this.step = st;
    if (st >= 1 && st <= 3) {
      UI.center(String(4 - st), 'count');
      Sound.play('beep');
      this.hitStop = 0.06;
      if (this.rig) this.rig.addTrauma(0.25);
      Post.fx.flash = 0.12;
      Post.fx.flashCol = [1, 0.15, 0.1];
    }
    if (st === 4) {
      this.phase = 'race';
      Input.itemQ = false;
      this.race.start();
      UI.center('GO!', 'go');
      Sound.play('go');
      this.hitStop = 0.09;
      if (this.rig) this.rig.addTrauma(0.5);
      Post.fx.flash = 0.3;
      Post.fx.flashCol = [1, 0.85, 0.2];
      $('count-hint').classList.add('hidden');
      Music.event('go');
      if (this.tapAt >= marks[3] - 0.45 && !this.perfect) this.perfectStart();
    }
  },
  onPlayerFinish() {
    if (this.phase !== 'race') return;
    this.phase = 'post';
    this.postT = 0;
    this.race.autopilot = true;
    const P = this.player;
    UI.center(P.place === 1 ? 'WINNER' : 'FINISH', P.place === 1 ? 'go' : 'small', ordinal(P.place) + ' · ' + fmtTime(P.finishTime));
    Sound.play(P.place <= 3 ? 'finish' : 'lose');
    this.slowmo(0.3, 1.1);
    Music.event('finish');
    if (P.place <= 3) {
      const p = this.pvis.root.position;
      const cols = [0xff2e3c, 0xffc21a, 0x29e3ff, 0x7dff3a, 0xffffff, 0xff2e88];
      for (let i = 0; i < 160; i++) {
        const a = Math.random() * TAU;
        const u = Math.random();
        this.fx.spawn(p.x + rnd2() * 3, p.y + 3 + Math.random() * 2, p.z + rnd2() * 3, Math.cos(a) * u * 7, 5 + Math.random() * 7, Math.sin(a) * u * 7, 2.2 + Math.random(), 0.22, cols[i % cols.length], 1, 7, 1.2, 0);
      }
    }
    this.rig.orbit = 0;
  },
  showResults() {
    if (this.phase === 'results') return;
    this.phase = 'results';
    const race = this.race;
    const P = this.player;
    const tr = race.track;
    const rows = race.racers.slice().sort((a, b) => a.place - b.place);
    const times = [];
    let last = 0;
    for (const r of rows) {
      let t = r.finished ? r.finishTime : race.time + (tr.finishS - r.s) / Math.max(r.v, 18);
      if (!r.finished) t = Math.max(t, last + 0.35);
      times.push(t);
      last = t;
    }
    const bonus = PLACE_BONUS[P.place - 1] ?? 10;
    const earned = P.coins + bonus;
    Save.data.coins += earned;
    Save.data.races++;
    const prev = Save.data.best[tr.def.id];
    const isBest = !prev || P.place < prev.p || (P.place === prev.p && P.finishTime < prev.t);
    if (isBest) Save.data.best[tr.def.id] = { p: P.place, t: P.finishTime };
    Save.store();
    UI.coins();
    UI.results(rows, times, P, tr.def, isBest && prev, bonus, earned, this.nextOpenTrack() > 0);
    $('story-result').hidden = true;
    $('btn-again').textContent = 'Race again';
    $('btn-menu').textContent = 'Menu';
    if (this.storyNode) Story.onResults(race, P);
    if (this.netCfg) {
      $('btn-next').textContent = 'Lobby';
      $('btn-again').textContent = 'Lobby';
    }
    UI.hud(false);
    UI.setOn('results', true);
    this.transition();
    Podium.build(rows);
  },
  pause() {
    if (this.paused || !(this.phase === 'countdown' || this.phase === 'race' || this.phase === 'post')) return;
    this.paused = true;
    Input.clear();
    Sound.silence();
    UI.setOn('pause', true);
  },
  resume() {
    if (!this.paused) return;
    this.paused = false;
    Input.clear();
    UI.setOn('pause', false);
    UI.setOn('settings', false);
  },
  togglePause() {
    if (this.paused) this.resume();
    else this.pause();
  },
  restart() {
    UI.setOn('pause', false);
    UI.setOn('results', false);
    UI.setOn('settings', false);
    this.paused = false;
    Podium.dispose();
    if (!this.race) return;
    if (this.qualityDirty) {
      this.startRace(this.idx);
      return;
    }
    this.beginCountdown();
  },
  quit() {
    UI.setOn('pause', false);
    UI.setOn('results', false);
    UI.setOn('settings', false);
    this.paused = false;
    Podium.dispose();
    this.teardown();
    if (this.qualityDirty) {
      applyQuality();
      this.qualityDirty = false;
    }
    if (this.netCfg) {
      this.netCfg = null;
      this.lineupOverride = null;
      Net.cfg = null;
      Net.open();
    } else if (this.storyNode) Story.open();
    else this.goMenu();
  },
  nextOpenTrack() {
    return this.tracks.findIndex((t, j) => j > this.idx && (j < BASE_TRACKS || Story.trackUnlocked(t.def.id)));
  },
  // leave the race world for a garage cutscene after the results
  teardownForCut() {
    this.paused = false;
    this.teardown();
    Menu.holder.visible = true;
    showMenuRacer(Save.data.racer);
    frameMenuCam();
  },
  tick(dt) {
    this.clock += dt;
    Post.fx.glitch = Math.max(0, Post.fx.glitch - dt * 2.8);
    Post.fx.flash = Math.max(0, Post.fx.flash - dt * 2.2);
    const ph = this.phase;
    if (ph === 'cutscene' && Cutscene.active && Cutscene.scene) {
      Cutscene.update(dt);
      if (Cutscene.active && Cutscene.scene) renderScene(Cutscene.scene, Cutscene.cam, dt);
      return;
    }
    if (ph === 'menu' || ph === 'tracks' || ph === 'garage' || ph === 'boot' || ph === 'select' || ph === 'story' || ph === 'codex' || ph === 'online') {
      if (!Menu.scene) return;
      updateMenu(dt);
      Post.fx.ca = 0;
      Post.fx.speed = 0;
      renderScene(Menu.scene, menuCam, dt);
      if (ph === 'select') SelectUI.tick(dt);
      return;
    }
    if (ph === 'gallery' && Gallery.scene) {
      renderScene(Gallery.scene, menuCam, dt);
      return;
    }
    if (ph === 'results' && Podium.scene) {
      Podium.update(dt);
      renderScene(Podium.scene, menuCam, dt);
      return;
    }
    if (!this.world || !this.race) return;
    this.world.U.uTime.value = this.clock;
    if (!this.paused) this.tickRace(dt);
    renderScene(this.world.scene, raceCam, dt);
  },
  tickRace(dtReal) {
    // slow-mo + hit-stop
    if (this.hitStop > 0) {
      this.hitStop -= dtReal;
      if (this.hitStop > 0) dtReal *= 0.05;
    }
    if (this.tsT > 0) this.tsT -= dtReal;
    else this.tsTarget = 1;
    this.timeScale = damp(this.timeScale, this.tsTarget, this.tsTarget < this.timeScale ? 18 : 4, dtReal);
    const dt = dtReal * this.timeScale;
    const race = this.race;
    const P = this.player;
    if (this.phase === 'countdown') this.updateCountdown(dtReal);
    if (this.phase === 'race') {
      race.input.steer = Input.steer();
      race.input.brake = Input.brake();
      race.input.drift = Input.drift();
      if (Input.consumeItem()) race.input.ability = true;
      if (Input.consumeTrick()) race.input.trick = true;
    } else {
      Input.consumeItem();
      Input.consumeTrick();
      race.input.steer = 0;
      race.input.brake = false;
      race.input.drift = false;
    }
    const n = Math.min(8, Math.max(1, Math.ceil(dt * 60 - 1e-6)));
    const h = dt / n;
    for (let i = 0; i < n; i++) race.step(h);
    if (this.netCfg) Net.tick(dt);
    if (this.phase === 'race' && !this.final && P.s > race.track.finishS - 320) {
      this.final = true;
      UI.toast('FINAL STRETCH', 'good');
      Music.event('final');
    }
    if (this.phase === 'post') {
      this.postT += dtReal;
      if (this.postT > 3.4) this.showResults();
    }
    const tr = race.track;
    for (const r of race.racers) updateRacerVisual(r, this.vis[r.idx], dt, tr, race);
    updateFeatures(dt);
    emitParticles(dt);
    let mode = this.phase === 'countdown' ? 'intro' : this.phase === 'race' ? 'chase' : 'orbit';
    if (mode === 'chase' && this.snapCam) {
      mode = 'snap';
      this.snapCam = false;
    }
    this.rig.update(dtReal * (0.4 + 0.6 * this.timeScale), mode, tr, P, this.pvis, clamp(this.t / 4.6, 0, 1));
    if (this.debugCam === 'side') {
      const pv = this.pvis.root.position;
      const F = tr.frameInto(P.s, {});
      raceCam.position.set(pv.x - F.rx * 5.5 + F.tx * 0.6, pv.y + 0.55, pv.z - F.rz * 5.5 + F.tz * 0.6);
      raceCam.lookAt(pv.x, pv.y + 0.35, pv.z);
    } else if (this.debugCam === 'high') {
      const pv = this.pvis.root.position;
      const F = tr.frameInto(P.s, {});
      raceCam.position.set(pv.x - F.tx * 9, pv.y + 7.5, pv.z - F.tz * 9);
      raceCam.lookAt(pv.x + F.tx * 6, pv.y, pv.z + F.tz * 6);
    }
    const W = this.world;
    W.U.uWaveT.value = race.time;
    W.U.uCam.value.copy(raceCam.position);
    W.U.uWaterCenter.value.set(raceCam.position.x, raceCam.position.z);
    if (W.waterGrid) W.water.position.set(Math.round(raceCam.position.x), tr.waterY, Math.round(raceCam.position.z));
    W.sky.position.copy(raceCam.position);
    W.sunSprite.position.copy(raceCam.position).addScaledVector(W.sunDir, 2300);
    const pp = this.pvis.root.position;
    W.sun.target.position.copy(pp);
    W.sun.position.copy(pp).addScaledVector(W.sunDir, 160);
    const scale = renderer.domElement.height / (2 * Math.tan((raceCam.fov * DEG) / 2));
    this.fx.mat.uniforms.uScale.value = scale;
    this.fxA.mat.uniforms.uScale.value = scale;
    this.fx.update(dt);
    this.fxA.update(dt);
    if (this.chaos) this.chaos.update(dt, race, race.time);
    if (this.snow) {
      this.snow.mat.uniforms.uScale.value = scale;
      this.snow.update(dt, raceCam.position, this.rig.vel);
    }
    // post FX: CA while boosting, speed lines at high speed
    const boost = P.boostT > 0 && this.phase === 'race';
    Post.fx.ca = damp(Post.fx.ca, boost ? (P.burnT > 0 ? 1.6 : 1) : 0, 6, dtReal);
    Post.fx.speed = damp(Post.fx.speed, this.phase === 'race' ? clamp((P.spd - 30) / 14, 0, 1) * (boost ? 1 : 0.55) : 0, 5, dtReal);
    $('boost-vignette').style.opacity = boost && !Q.post ? '1' : '0';
    if (this.phase !== 'results') HUD.update(dtReal, race, P);
    Minimap.update(dtReal, race);
    Sound.engine(P.v, P.boostT > 0, this.phase === 'race' || this.phase === 'countdown', this.clock, tr.modeAt(P.s), P.drift);
    Music.tick(race, P, this.phase);
  },
};

// ---------------- boot ----------------
function unlockAudio() {
  const had = !!Sound.ctx;
  Sound.musicOn = Save.data.music;
  Sound.sfxOn = Save.data.sfx;
  Sound.ensure();
  if (!had && Sound.ctx) {
    const ph = Game.phase;
    if (ph === 'menu' || ph === 'tracks' || ph === 'garage' || ph === 'select') Sound.startMusic('menu');
    else if (Game.world && ph !== 'loading') Sound.startMusic(Game.world.theme.music);
  }
}

let lastT = 0;
function loop(now) {
  requestAnimationFrame(loop);
  let dt = lastT ? (now - lastT) / 1000 : 1 / 60;
  lastT = now;
  if (!(dt > 0)) dt = 1 / 60;
  if (dt > 0.1) dt = 0.1;
  if (Game.dead) return;
  try {
    Game.tick(dt);
  } catch (e) {
    fatal('Something went wrong. Reload to keep racing.', e);
  }
  Perf.sample(dt);
}

function boot(hot) {
  Save.load();
  if (hot && hot.save) Save.merge(hot.save);
  try {
    window.claude?.hot?.snapshot?.(() => ({ save: Save.data }));
  } catch (e) {}
  Sound.musicOn = Save.data.music;
  Sound.sfxOn = Save.data.sfx;
  if (!initRenderer()) return;
  Input.init($('gl'));
  Input.onTap = () => Game.onTap();
  Game.initUI();
  Minimap.init($('minimap'));
  Minimap.setEnabled(Save.data.settings.minimap);
  for (const ev of ['pointerdown', 'touchend', 'click', 'keydown']) window.addEventListener(ev, unlockAudio, { capture: true, passive: true });
  window.addEventListener('resize', resize);
  window.addEventListener('orientationchange', () => setTimeout(resize, 150));
  if (window.ResizeObserver) new ResizeObserver(() => resize()).observe($('app'));
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      if (Game.phase === 'countdown' || Game.phase === 'race' || Game.phase === 'post') Game.pause();
      Sound.silence();
      if (Sound.ostEl && Sound.ostStyle) {
        try {
          Sound.ostEl.pause();
        } catch (e) {}
      }
      if (Sound.ctx && Sound.ctx.state === 'running') {
        try {
          const p = Sound.ctx.suspend();
          if (p && p.catch) p.catch(() => {});
        } catch (e) {}
      }
    } else Sound.resume();
  });
  Sound.loadOst();
  requestAnimationFrame(loop);
  $('loading-text').textContent = 'LOADING THE CREW…';
  Assets.load((f) => {
    if (f >= 0) $('loading-text').textContent = 'LOADING THE CREW… ' + Math.round(f * 100) + '%';
  })
    .then(() => {
      Game.tracks = TRACKS.map((d) => new Track(d));
      initMenuScene();
      Post.setGrade(THEMES.frost.grade);
      Portraits.preload();
      Game.goMenu();
      bootParams();
      window.__ddReady = true;
    })
    .catch((e) => fatal("The game's 3D models didn't load. Check your connection, then reload the page.", e));
  window.__dd = {
    Game,
    Save,
    Assets,
    Post,
    Sound,
    THREE,
    Story,
    Cutscene,
    Voice,
    Net,
    STORY_NODES,
    MUSIC,
    // animation / vehicle lab (tools/anim_lab.py): build visuals and frame close-ups outside a race
    lab: { Gallery, menuCam, buildRacerVisual, disposeRacerVisual, poseTransform, animateRider, updateRiderLegs, RACERS, RIVALS, racerDefById, Assets, Menu },
    quality: () => Q && Q.id,
    state() {
      const r = Game.race;
      const P = r && r.player;
      return {
        phase: Game.phase,
        paused: Game.paused,
        pr,
        quality: Q && Q.id,
        time: r ? r.time : 0,
        player: P ? { s: P.s, d: P.d, y: P.y, v: P.v, place: P.place, finished: P.finished, coins: P.coins, charge: P.charge, abilT: P.abilT, boostT: P.boostT, mode: P.mode, form: P.form, drift: P.drift.on, level: P.drift.level, draft: P.draft, spins: P.spins } : null,
      };
    },
    info() {
      const i = renderer.info;
      return { calls: i.render.calls, tris: i.render.triangles, geos: i.memory.geometries, tex: i.memory.textures, programs: i.programs ? i.programs.length : -1, fps: Perf.fps };
    },
    fastForward(sec) {
      const r = Game.race;
      if (!r) return;
      for (let i = 0; i < sec * 60; i++) {
        r.step(1 / 60);
        if (Game.phase !== 'race' && Game.phase !== 'post') break;
      }
    },
    advance(sec) {
      for (let i = 0; i < sec * 60; i++) Game.tickRace(1 / 60);
    },
    charge(v = 1) {
      if (Game.player) Game.player.charge = v;
    },
    gallery(clip = 'idle', t = 0.5) {
      Gallery.build(clip, t);
    },
    // fixed debug cameras: 'side' looks at the player from the left at kart height (waterline / suspension checks)
    cam(mode) {
      Game.debugCam = mode;
    },
    jumpTo(s) {
      const r = Game.race;
      if (!r) return;
      const P = r.player;
      const tr = r.track;
      const F = tr.frameInto(s, {});
      P.s = s;
      P.d = 0;
      P.mode = tr.modeAt(s);
      P.form = P.mode === M_AIR ? 1 : P.mode === M_WATER ? 2 : 0;
      P.y = P.mode === M_AIR ? tr.heightAt(s) + 0.6 : tr.groundHeight(s, 0);
      P.hw = F.psi;
      P.vx = F.tx * 25;
      P.vz = F.tz * 25;
      P.v = 25;
      Game.snapCam = true;
    },
  };
}

// started from the launcher: app://game/index.html?v=5.0.0&lang=el&name=..&host=1 | &join=CODE
function bootParams() {
  const ver = el('div', 'menu-ver', 'v' + GAME_VERSION);
  const menu = $('scr-menu');
  if (menu) menu.appendChild(ver);
  const q = new URLSearchParams(location.search);
  const name = (q.get('name') || '').slice(0, 14);
  if (!q.get('join') && !q.get('host')) return;
  try {
    Net.open();
    if (name) $('net-name').value = name;
    if (q.get('host')) Net.host();
    else Net.join(q.get('join'));
  } catch (e) {
    console.error(e);
  }
}

let booted = false;
function start(data) {
  if (booted) return;
  booted = true;
  try {
    boot(data || {});
  } catch (e) {
    fatal('The game could not start. Reload to try again.', e);
  }
}
const HOT = window.claude && window.claude.hot;
if (HOT && typeof HOT.ready === 'function') {
  try {
    HOT.ready(start);
  } catch (e) {
    start({});
  }
  setTimeout(() => start((window.claude && window.claude.hot && window.claude.hot.data) || {}), 2500);
} else start((HOT && HOT.data) || {});

</script>
