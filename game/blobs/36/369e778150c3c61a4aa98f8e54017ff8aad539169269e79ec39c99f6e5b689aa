    $('btn-drift').classList.toggle('hidden', !(TOUCH_UI && Save.data.settings.drift === 'manual'));
  },
  portraitPop(r, expr) {
    if (!r) return;
    const box = $('pops');
    const p = el('div', 'pop');
    const i = el('i');
    i.style.backgroundImage = Portraits.css(r.def.id, expr === 'grin' || expr === 'smug' ? 'pick' : 'idle', 'sm');
    i.style.setProperty('--accent', accentOf(r.def));
    p.append(i, el('span', '', r.name.toUpperCase()));
    box.appendChild(p);
    while (box.children.length > 2) box.firstChild.remove();
    setTimeout(() => p.remove(), 2300);
  },
  // spoken one-liner during a race: portrait + subtitle bubble
  bark(who, text) {
    const box = $('pops');
    const p = el('div', 'pop bark');
    const i = el('i');
    i.style.backgroundImage = Portraits.css(who, 'pick', 'sm');
    i.style.setProperty('--accent', (CAST[who] && CAST[who].color) || '#fff');
    p.append(i, el('span', '', text));
    box.appendChild(p);
    while (box.children.length > 2) box.firstChild.remove();
    setTimeout(() => p.remove(), 2600);
  },
  chargeTick() {},
  abilityReady() {
    UI.toast(ABILITIES[Game.player.abilityId].name + ' READY', 'good');
  },
  abilityUsed() {
    const P = Game.player;
    UI.center(ABILITIES[P.abilityId].name.toUpperCase(), 'small');
  },
  rivalWarn(r, ab) {
    $('rw-port').style.backgroundImage = Portraits.css(r.def.id, 'pick', 'sm');
    $('rw-text').textContent = r.name.toUpperCase() + ' · ' + ab.name.toUpperCase();
    const w = $('rival-warn');
    w.classList.remove('on');
    void w.offsetWidth;
    w.classList.add('on');
    this.warnT = 1.8;
  },
  update(dt, race, P) {
    if (P.place !== this.place) {
      this.place = P.place;
      $('hud-place').textContent = String(P.place);
      $('hud-suf').textContent = ordinal(P.place).slice(-2);
      const w = $('hud-place-wrap');
      w.classList.toggle('first', P.place === 1);
      w.classList.remove('pulse');
      void w.offsetWidth;
      w.classList.add('pulse');
    }
    const ts = fmtTime(P.finished ? P.finishTime : race.time);
    if (ts !== this.lastTime) {
      this.lastTime = ts;
      $('hud-time').textContent = ts;
    }
    this.speedT -= dt;
    if (this.speedT <= 0) {
      this.speedT = 0.1;
      const sp = Math.round(Math.max(0, P.v) * 3.6);
      if (sp !== this.lastSpeed) {
        this.lastSpeed = sp;
        $('hud-speed').textContent = String(sp);
      }
    }
    const tr = race.track;
    for (const m of this.markers) {
      const f = Math.round(clamp((m[0].s - START_S) / (tr.finishS - START_S), 0, 1) * 1000) / 10;
      if (f !== m[2]) {
        m[2] = f;
        m[1].style.left = f + '%';
      }
    }
    // ability meter
    const btn = $('btn-item');
    const ch = Math.round((P.abilT > 0 ? P.abilT / ABILITIES[P.abilityId].dur : P.charge) * 100) / 100;
    if (ch !== this.ch) {
      this.ch = ch;
      btn.style.setProperty('--ch', String(ch));
    }
    const ready = P.abilityReady && !P.finished;
    if (ready !== this.ready) {
      this.ready = ready;
      btn.classList.toggle('ready', ready);
      $('ab-in').style.backgroundImage = Portraits.css(P.def.id, ready ? 'pick' : 'idle', 'sm');
    }
    const active = P.abilT > 0;
    if (active !== this.active) {
      this.active = active;
      btn.classList.toggle('active', active);
    }
    if (this.warnT > 0) {
      this.warnT -= dt;
      if (this.warnT <= 0) $('rival-warn').classList.remove('on');
    }
    const dOn = P.drift.on && !P.finished;
    if (dOn !== this.driftOn) {
      this.driftOn = dOn;
      $('drift-meter').classList.toggle('on', dOn);
    }
    const lvl = dOn ? P.drift.level : 0;
    if (lvl !== this.driftLvl) {
      this.driftLvl = lvl;
      const segs = $('drift-meter').children;
      for (let i = 0; i < 3; i++) segs[i].className = i < lvl ? 'l' + lvl : '';
    }
    const draftOn = P.draft > 0.12 && !P.finished;
    if (draftOn !== this.draftOn) {
      this.draftOn = draftOn;
      $('draft-chip').classList.toggle('on', draftOn);
    }
    const dw = Math.round(clamp(P.draft, 0, 1) * 20) * 5;
    if (dw !== this.draftW) {
      this.draftW = dw;
      $('draft-fill').style.width = dw + '%';
    }
    const glide = P.mode === M_AIR && !P.finished;
    if (glide !== this.glide) {
      this.glide = glide;
      $('glide-hud').classList.toggle('on', glide);
    }
    if (glide) $('glide-bar').style.top = clamp(50 - P.gamma * 120, 4, 96) + '%';
  },
};

// ---------------- Input ----------------
const Input = {
  keys: new Set(),
  pointers: new Map(),
  itemQ: false,
  trickQ: false,
  driftBtn: false,
  rect: null,
  onTap: null,
  init(canvas) {
    const keyMap = (k) => {
      switch (k) {
        case 'ArrowLeft':
        case 'a':
        case 'A':
          return 'left';
        case 'ArrowRight':
        case 'd':
        case 'D':
          return 'right';
        case 'ArrowDown':
        case 's':
        case 'S':
          return 'down';
        case ' ':
        case 'Shift':
        case 'x':
        case 'X':
          return 'drift';
        case 'ArrowUp':
        case 'w':
        case 'W':
        case 'e':
        case 'E':
        case 'Enter':
          return 'item';
        default:
          return null;
      }
    };
    window.addEventListener('keydown', (e) => {
      const k = keyMap(e.key);
      const racing = Game.inRace();
      if (racing && k) e.preventDefault();
      if (e.repeat) return;
      if (k === 'item') {
        if (racing) {
          this.itemQ = true;
          if (this.onTap) this.onTap();
        } else if (Game.phase === 'select' && e.key === 'Enter') Game.pickRacer();
      } else if (k) this.keys.add(k);
      // the drift key also does ramp tricks (a fresh press while airborne off a ramp)
      if (k === 'drift' && racing) this.trickQ = true;
      if (!racing && (Game.phase === 'menu' || Game.phase === 'select') && (e.key === 'ArrowLeft' || e.key === 'ArrowRight')) Game.selectRacer(e.key === 'ArrowLeft' ? -1 : 1);
      if (e.key === 'Escape' && (Game.phase === 'tracks' || Game.phase === 'garage' || Game.phase === 'select')) Game.goMenu();
      else if (e.key === 'Escape' && $('scr-settings').classList.contains('on')) Game.closeSettings();
      else if (e.key === 'Escape' || e.key === 'p' || e.key === 'P') Game.togglePause();
      if (e.key === 'm' || e.key === 'M') Game.toggleSound();
    });
    window.addEventListener('keyup', (e) => {
      const k = keyMap(e.key);
      if (k && k !== 'item') this.keys.delete(k);
    });
    const down = (e) => {
      if (!Game.inRace()) return;
      e.preventDefault();
      this.rect = canvas.getBoundingClientRect();
      this.pointers.set(e.pointerId, { x: e.clientX, y0: e.clientY, t0: performance.now(), swiped: false });
      try {
        canvas.setPointerCapture(e.pointerId);
      } catch (err) {}
      if (this.onTap) this.onTap();
      // a fresh touch is a trick when the kart is airborne off a ramp (the sim ignores it otherwise)
      this.trickQ = true;
      this.hints();
    };
    const move = (e) => {
      const p = this.pointers.get(e.pointerId);
      if (!p) return;
      p.x = e.clientX;
      if (!p.swiped && p.y0 - e.clientY > 42 && performance.now() - p.t0 < 450) {
        p.swiped = true;
        this.itemQ = true;
      }
      this.hints();
    };
    const up = (e) => {
      if (this.pointers.delete(e.pointerId)) this.hints();
    };
    canvas.addEventListener('pointerdown', down);
    canvas.addEventListener('pointermove', move);
    canvas.addEventListener('pointerup', up);
    canvas.addEventListener('pointercancel', up);
    canvas.addEventListener('lostpointercapture', up);
    canvas.addEventListener('contextmenu', (e) => e.preventDefault());
    const db = $('btn-drift');
    const dOn = (e) => {
      e.preventDefault();
      e.stopPropagation();
      this.driftBtn = true;
      this.trickQ = true;
      db.classList.add('on');
    };
    const dOff = () => {
      this.driftBtn = false;
      db.classList.remove('on');
    };
    db.addEventListener('pointerdown', dOn);
    db.addEventListener('pointerup', dOff);
    db.addEventListener('pointercancel', dOff);
    db.addEventListener('pointerleave', dOff);
    db.addEventListener('contextmenu', (e) => e.preventDefault());
    window.addEventListener('blur', () => this.clear());
    document.addEventListener('gesturestart', (e) => e.preventDefault());
    document.addEventListener(
      'touchmove',
      (e) => {
        if (Game.inRace()) e.preventDefault();
      },
      { passive: false }
    );
  },
  clear() {
    this.keys.clear();
    this.pointers.clear();
    this.itemQ = false;
    this.trickQ = false;
    this.driftBtn = false;
    const db = $('btn-drift');
    if (db) db.classList.remove('on');
    this.hints();
  },
  side() {
    let l = 0;
    let r = 0;
    const rect = this.rect;
    const mid = rect ? rect.left + rect.width / 2 : window.innerWidth / 2;
    for (const p of this.pointers.values()) {
      if (p.x < mid) l++;
      else r++;
    }
    return [l, r];
  },
  hints() {
    const [l, r] = this.side();
    $('hint-l').classList.toggle('on', l > 0);
    $('hint-r').classList.toggle('on', r > 0);
  },
  steer() {
    let s = 0;
    if (this.keys.has('left')) s -= 1;
    if (this.keys.has('right')) s += 1;
    const [l, r] = this.side();
    if (l && !r) s -= 1;
    else if (r && !l) s += 1;
    return clamp(s, -1, 1);
  },
  // brake / glider dive: ↓ key, or both screen halves held on touch
  brake() {
    const [l, r] = this.side();
    return this.keys.has('down') || (l > 0 && r > 0);
  },
  drift() {
    return this.keys.has('drift') || this.driftBtn;
  },
  consumeItem() {
    const q = this.itemQ;
    this.itemQ = false;
    return q;
  },
  consumeTrick() {
    const q = this.trickQ;
    this.trickQ = false;
    return q;
  },
};

// ============================================================
// Story mode runtime: Voice (Greek voice lines + lip-sync level + race barks), Cutscene (garage / grid stages,
// automatic camera, letterbox, subtitles, title cards, skip), Story (progress, race line-ups, goals, unlocks,
// hub / codex / radio screens). Data: 07_story.js + 07_dialogue.js. Saves into Save.data.story.
// ============================================================
const Voice = {
  manifest: null,
  cache: new Map(),
  src: null,
  gain: null,
  an: null,
  buf: null,
  level: 0,
  lastBark: -99,
  kindT: {},
  init() {
    fetch('voice/voice.json')
      .then((r) => (r.ok ? r.json() : null))
      .then((j) => (this.manifest = j))
      .catch(() => {});
  },
  nodes() {
    Sound.ensure();
    const c = Sound.ctx;
    if (!c || !Sound.master) return false;
    if (!this.gain) {
      this.gain = c.createGain();
      this.an = c.createAnalyser();
      this.an.fftSize = 512;
      this.buf = new Float32Array(this.an.fftSize);
      this.gain.connect(this.an);
      this.an.connect(Sound.master);
    }
    this.gain.gain.value = Story.st().voice ?? 1;
    return true;
  },
  has(id) {
    return !!(this.manifest && this.manifest.lines && this.manifest.lines[id]);
  },
  load(id) {
    if (this.cache.has(id)) return this.cache.get(id);
    const p = fetch('voice/' + id + '.ogg')
      .then((r) => {
        if (!r.ok) throw new Error('missing');
        return r.arrayBuffer();
      })
      .then((b) => new Promise((res, rej) => Sound.ctx.decodeAudioData(b, res, rej)))
      .catch(() => null);
    this.cache.set(id, p);
    return p;
  },
  async play(id, duck = true) {
    if (!this.has(id) || !this.nodes() || !(Story.st().voice > 0)) return 0;
    const buf = await this.load(id);
    if (!buf) return 0;
    this.stop();
    const s = Sound.ctx.createBufferSource();
    s.buffer = buf;
    s.connect(this.gain);
    s.start();
    this.src = s;
    if (duck) this.duck(true);
    s.onended = () => {
      if (this.src === s) {
        this.src = null;
        this.duck(false);
      }
    };
    return buf.duration;
  },
  stop() {
    if (this.src) {
      try {
        this.src.stop();
      } catch (e) {}
      this.src = null;
    }
    this.duck(false);
  },
  duck(on) {
    if (!Sound.ctx || !Sound.music) return;
    Sound.music.gain.setTargetAtTime(Sound.musicOn ? (on ? 0.14 : 0.5) : 0, Sound.ctx.currentTime, 0.08);
  },
  tick(dt) {
    if (!this.an || !this.src) {
      this.level = Math.max(0, this.level - dt * 6);
      return;
    }
    this.an.getFloatTimeDomainData(this.buf);
    let s = 0;
    for (let i = 0; i < this.buf.length; i++) s += this.buf[i] * this.buf[i];
    const rms = Math.sqrt(s / this.buf.length);
    this.level = damp(this.level, clamp((rms - 0.012) * 9, 0, 1), 24, dt);
  },
  // in-race one-liners: global and per-kind cooldowns so the race does not turn into a radio play
  bark(who, kind) {
    const lines = BARKS[who] && BARKS[who][kind];
    if (!lines || !lines.length || !(Story.st().barks ?? true)) return;
    const now = Game.clock;
    if (now - this.lastBark < 3.2 || now - (this.kindT[who + kind] || -99) < 9) return;
    this.lastBark = now;
    this.kindT[who + kind] = now;
    const n = Math.floor(Math.random() * lines.length);
    this.play('b_' + who + '_' + kind + '_' + n, false);
    HUD.bark(who, tx(lines[n]));
  },
};

// ---------------- Cutscene player ----------------
const _cutV = new THREE.Vector3();
const _cutV2 = new THREE.Vector3();
const _cutT = new THREE.Vector3();
const Cutscene = {
  active: false,
  cut: null,
  id: '',
  i: -1,
  t: 0,
  minT: 0,
  voiceEnd: 0,
  typed: 0,
  stage: null,
  cast: new Map(),
  extra: [],
  cam: new THREE.PerspectiveCamera(32, 16 / 9, 0.1, 4000),
  camPos: new THREE.Vector3(),
  camLook: new THREE.Vector3(),
  goalPos: new THREE.Vector3(),
  goalLook: new THREE.Vector3(),
  onDone: null,
  scene: null,
  lights: [],
  prevPhase: '',
  play(id, onDone) {
    const cut = CUTS[id];
    if (!cut) {
      if (onDone) onDone();
      return;
    }
    this.cut = cut;
    this.id = id;
    this.onDone = onDone;
    this.i = -1;
    this.lastNow = 0;
    this.active = true;
    this.prevPhase = Game.phase;
    Game.phase = 'cutscene';
    UI.show('none');
    UI.hud(false);
    this.cam.aspect = raceCam.aspect;
    this.cam.updateProjectionMatrix();
    if (cut.where === 'grid' && Game.world) this.setupGrid(cut);
    else this.setupGarage(cut);
    Story.st().seen[id] = 1;
    Save.store();
    if (cut.music) {
      Sound.stopMusic();
      Sound.startMusic(cut.music);
    }
    $('cut').hidden = false;
    $('cut').classList.add('on');
    this.next(true);
  },
  setupGarage(cut) {
    this.stage = 'garage';
    this.scene = Menu.scene;
    if (Menu.vis) Menu.vis.root.visible = false;
    const ids = (cut.cast || CREW).filter((id) => racerDefById(id));
    const n = ids.length;
    ids.forEach((id, k) => {
      const def = racerDefById(id);
      const v = buildRacerVisual(def, def.build, false, false, { fur: Q.id === 'high' ? 6 : 0, look: def.look });
      // concave arc around a focus point in front of the crew: every driver faces it, so close-ups
      // (taken along that line) never have a neighbour in the way
      const spread = n > 4 ? 0.62 : 0.45;
      const a = n > 1 ? -spread + (2 * spread * k) / (n - 1) : 0;
      const R = n > 4 ? 10 : 8;
      v.root.position.set(Math.sin(a) * R, 0.35, R - Math.cos(a) * R - 1);
      v.root.rotation.y = Math.PI - a;
      v.face = { x: -Math.sin(a), z: Math.cos(a) };
      this.scene.add(v.root);
      v.anim.setBase('idle');
      this.cast.set(id, v);
      this.extra.push(v);
    });
    if (cut.mood === 'tower') {
      const l = new THREE.PointLight(0xff2e3c, 60, 30, 1.4);
      l.position.set(0, 6, 4);
      const l2 = new THREE.PointLight(0x29e3ff, 30, 30, 1.6);
      l2.position.set(-6, 3, -2);
      this.scene.add(l, l2);
      this.lights.push(l, l2);
    }
    this.wide();
    this.stageCam = this.goalPos.clone();
    this.camPos.copy(this.goalPos);
    this.camLook.copy(this.goalLook);
  },
  setupGrid() {
    this.stage = 'grid';
    this.scene = Game.world.scene;
    const race = Game.race;
    // place the karts on the grid before framing any shot
    for (let i = 0; i < race.racers.length; i++) {
      updateRacerVisual(race.racers[i], Game.vis[i], 1 / 60, race.track, race);
      this.cast.set(race.racers[i].def.id, Game.vis[i]);
    }
    this.wide();
    this.camPos.copy(this.goalPos);
    this.camLook.copy(this.goalLook);
  },
  centre(out) {
    out.set(0, 0, 0);
    let n = 0;
    for (const v of this.cast.values()) {
      out.add(v.root.position);
      n++;
    }
    return n ? out.multiplyScalar(1 / n) : out;
  },
  wide() {
    const c = this.centre(_cutT);
    if (this.stage === 'garage') {
      this.goalLook.set(c.x, 1.3, c.z - 0.4);
      this.goalPos.set(c.x + 1.0, 3.4, c.z + 13);
    } else {
      const P = Game.player;
      const F = Game.race.track.frameInto(P.s, {});
      this.goalLook.set(c.x, c.y + 1.2, c.z);
      this.goalPos.set(c.x + F.tx * 13 + F.rx * 5, c.y + 4.2, c.z + F.tz * 13 + F.rz * 5);
    }
  },
  headOf(v, out) {
    const h = v.anim && v.anim.bones && v.anim.bones.head;
    if (h) return h.getWorldPosition(out);
    return out.copy(v.root.position).add(_cutV2.set(0, 1.6, 0));
  },
  close(v) {
    const head = this.headOf(v, _cutV);
    // the driver's facing: down the track on the grid, towards the stage camera in the garage
    let fx;
    let fz;
    if (this.stage === 'grid') {
      const r = Game.race.racers[Game.vis.indexOf(v)];
      const F = Game.race.track.frameInto(r ? r.s : Game.player.s, {});
      fx = F.tx;
      fz = F.tz;
    } else {
      fx = v.face ? v.face.x : 0;
      fz = v.face ? v.face.z : 1;
    }
    const side = (this.i % 2 ? 1 : -1) * 0.85;
    this.goalLook.copy(head).add(_cutT.set(0, -0.1, 0));
    this.goalPos.set(head.x + fx * 3.1 + fz * side, head.y + 0.32, head.z + fz * 3.1 - fx * side);
  },
  next(first) {
    if (!this.active) return;
    const L = this.cut.lines;
    // first tap while typing completes the line
    if (!first && this.i >= 0 && this.typed < 1) {
      this.typed = 1;
      return;
    }
    this.i++;
    if (this.i >= L.length) return this.end();
    const ln = L[this.i];
    const [who, expr, clip, text, opts] = ln;
    this.t = 0;
    this.typed = 0;
    const box = $('cut');
    const title = who === '@title';
    box.classList.toggle('title', title);
    if (title) {
      $('ct-main').textContent = tx(text);
      $('ct-sub').textContent = opts && opts.sub ? tx(opts.sub) : '';
      this.minT = 2.6;
      this.voiceEnd = 0;
      Voice.stop();
      this.wide();
      Sound.play('boost', 0.5);
      return;
    }
    const cast = CAST[who] || { name: T(who, who), color: '#fff' };
    $('cut-name').textContent = up(tx(cast.name));
    $('cut-name').style.color = cast.color;
    const port = $('cut-port');
    port.classList.toggle('radio', !!cast.radio);
    port.style.backgroundImage = cast.radio ? '' : Portraits.css(who, expr === 'grin' || expr === 'roar' ? 'pick' : 'idle', 'sm');
    port.style.borderColor = cast.color;
    this.full = tx(text);
    $('cut-line').textContent = '';
    this.minT = clamp(this.full.length * 0.045, 1.6, 7);
    this.voiceEnd = 0;
    this.speaker = this.cast.get(who) || null;
    Voice.play(this.id + '_' + this.i).then((d) => {
      if (d > 0) this.voiceEnd = this.t + d + 0.35;
    });
    this.closeOn = null;
    if (this.speaker) {
      if (expr) this.speaker.anim.expr(expr, 1, this.minT + 0.5);
      // body language: the line's clip, or a gesture picked from its expression and punctuation
      const g = clip && this.speaker.anim.actions[clip] ? clip : this.gestureFor(expr, this.full);
      if (g) this.speaker.anim.trigger(g, { force: true });
      this.listenersReact(expr, this.full);
      if (Math.random() < 0.72 || this.cast.size < 2) {
        this.close(this.speaker);
        this.closeOn = this.speaker;
      } else this.wide();
    } else this.wide();
    if (opts && opts.fx === 'boom' && Game.chaos) Game.chaos.burst(this.goalLook.x, this.goalLook.y, this.goalLook.z, 0.7);
  },
  gestureFor(expr, text) {
    const r = Math.random();
    const ask = /[?;]/.test(text);
    const bang = text.includes('!');
    if (expr === 'snarl' || expr === 'roar') return r < 0.7 ? 'fist' : 'point';
    if (expr === 'sad') return r < 0.6 ? 'facepalm' : 'shrug';
    if (expr === 'smug') return r < 0.4 ? 'point' : r < 0.7 ? 'cross' : 'talk';
    if (expr === 'grin') return bang && r < 0.45 ? 'laugh' : r < 0.7 ? 'point' : 'talk';
    if (expr === 'shock') return r < 0.6 ? 'shrug' : 'talk';
    if (ask) return r < 0.6 ? 'shrug' : 'talk';
    if (text.length < 14) return r < 0.6 ? 'nod' : null;
    return r < 0.8 ? 'talk' : 'nod';
  },
  // the others are not statues: an occasional nod, laugh or folded arms while someone talks
  listenersReact(expr, text) {
    for (const v of this.cast.values()) {
      if (v === this.speaker || Math.random() > 0.35) continue;
      let g = 'nod';
      if (expr === 'grin' && text.includes('!')) g = Math.random() < 0.5 ? 'laugh' : 'nod';
      else if (expr === 'snarl' || expr === 'roar') g = Math.random() < 0.5 ? 'cross' : 'shrug';
      else if (expr === 'smug') g = Math.random() < 0.5 ? 'cross' : 'facepalm';
      const a = v.anim;
      setTimeout(() => {
        if (this.active && a && a.actions[g]) a.trigger(g, { cool: 3 });
      }, 300 + Math.random() * 900);
    }
  },
  // head turns: the speaker looks into the close-up camera (or at the group), listeners look at the speaker
  lookFor(v) {
    let tx;
    let tz;
    if (v === this.speaker || !this.speaker) {
      if (this.closeOn === v) {
        tx = this.cam.position.x;
        tz = this.cam.position.z;
      } else {
        const c = this.centre(_cutV2);
        tx = c.x;
        tz = c.z;
      }
    } else {
      const p = this.speaker.root.position;
      tx = p.x;
      tz = p.z;
    }
    const o = v.root.position;
    let fx;
    let fz;
    if (this.stage === 'grid') {
      const q = v.root.quaternion;
      _cutT.set(0, 0, -1).applyQuaternion(q);
      fx = _cutT.x;
      fz = _cutT.z;
    } else {
      fx = v.face ? v.face.x : 0;
      fz = v.face ? v.face.z : 1;
    }
    const dx = tx - o.x;
    const dz = tz - o.z;
    if (dx * dx + dz * dz < 0.5) return 0;
    return Math.atan2(dx * -fz + dz * fx, dx * fx + dz * fz);
  },
  skip() {
    if (this.active) this.end();
  },
  end() {
    if (!this.active) return;
    this.active = false;
    Voice.stop();
    $('cut').classList.remove('on');
    $('cut').hidden = true;
    for (const v of this.extra) {
      if (v.root.parent) v.root.parent.remove(v.root);
      disposeRacerVisual(v);
    }
    for (const l of this.lights) if (l.parent) l.parent.remove(l);
    this.lights = [];
    this.extra = [];
    if (this.stage === 'garage' && Menu.vis) Menu.vis.root.visible = true;
    for (const v of this.cast.values()) {
      v.anim.talk = 0;
      v.lookOverride = undefined;
    }
    this.cast.clear();
    this.scene = null;
    const cb = this.onDone;
    this.onDone = null;
    if (cb) cb();
  },
  update(dt) {
    if (!this.active) return;
    // line timing runs on wall-clock time so voice and text stay in sync even when frames are slow
    const now = performance.now() / 1000;
    const rdt = this.lastNow ? Math.min(0.5, now - this.lastNow) : dt;
    this.lastNow = now;
    this.t += rdt;
    Voice.tick(rdt);
    // typewriter
    if (this.typed < 1 && this.full) {
      this.typed = Math.min(1, this.typed + dt * (38 / Math.max(10, this.full.length)) * 1.2);
      $('cut-line').textContent = this.full.slice(0, Math.ceil(this.full.length * this.typed));
    }
    const done = this.t > this.minT && (this.voiceEnd === 0 ? this.t > this.minT + 0.4 : this.t > this.voiceEnd);
    if (done && this.t > 0.4) this.next(true);
    // camera: smooth follow + slow push-in
    const push = 1 - Math.min(1, this.t / 8) * 0.12;
    _cutV.copy(this.goalPos).sub(this.goalLook).multiplyScalar(push).add(this.goalLook);
    this.camPos.lerp(_cutV, 1 - Math.exp(-dt * 3.2));
    this.camLook.lerp(this.goalLook, 1 - Math.exp(-dt * 4));
    this.cam.position.copy(this.camPos);
    this.cam.lookAt(this.camLook);
    // performers: idle + lip-sync on the speaker
    for (const [id, v] of this.cast) {
      v.anim.talk = this.speaker === v ? Voice.level : damp(v.anim.talk || 0, 0, 10, dt);
      const look = clamp(this.lookFor(v), -0.9, 0.9);
      v.lookOverride = look;
      if (this.stage === 'garage') animateRider(v, dt, { steer: 0, inKart: true, v: 0, om: 0, vy: 0, lookYaw: look, calm: true, lod: 0 });
    }
    if (this.stage === 'grid') {
      Game.world.U.uTime.value = Game.clock;
      const race = Game.race;
      for (let i = 0; i < race.racers.length; i++) updateRacerVisual(race.racers[i], Game.vis[i], dt, race.track, race);
      updateFeatures(dt);
    }
  },
};

// ---------------- Story progress + screens ----------------
const Story = {
  node: null,
  stats: null,
  worldSel: 0,
  codexCat: 'crew',
  codexSel: null,
  radioSeed: 1,
  st() {
    const s = Save.data;
    if (!s.story || typeof s.story !== 'object') s.story = {};
    const d = s.story;
    d.done = d.done || {};
    d.tapes = d.tapes || {};
    d.seen = d.seen || {};
    if (!d.lang) d.lang = 'el';
    if (d.voice == null) d.voice = 1;
    if (d.barks == null) d.barks = true;
    LANG.cur = d.lang;
    // Greek text-transform: uppercase drops the accents only when the document language is Greek
    document.documentElement.lang = d.lang === 'el' ? 'el' : 'en';
    return d;
  },
  done(id) {
    return !!this.st().done[id];
  },
  worldIdx(id) {
    return WORLDS.findIndex((w) => w.id === id);
  },
  worldUnlocked(id) {
    const i = this.worldIdx(id);
    if (i <= 0) return true;
    return STORY_NODES.filter((n) => n.world === WORLDS[i - 1].id).every((n) => this.done(n.id));
  },
  nodeUnlocked(n) {
    if (!this.worldUnlocked(n.world)) return false;
    const list = STORY_NODES.filter((x) => x.world === n.world);
    const i = list.indexOf(n);
    return i === 0 || this.done(list[i - 1].id);
  },
  trackUnlocked(id) {
    const i = TRACKS.findIndex((t) => t.id === id);
    return i < BASE_TRACKS || STORY_NODES.some((n) => n.track === id && this.done(n.id));
  },
  codexUnlocked(e) {
    if (e.unlock === 'start') return true;
    const [k, v] = e.unlock.split(':');
    if (k === 'node') return this.done(v);
    if (k === 'tape') return !!this.st().tapes[v];
    return false;
  },
  progress() {
    const n = STORY_NODES.filter((x) => this.done(x.id)).length;
    return { n, of: STORY_NODES.length };
  },
  // race line-up for a node: player + rivals + crew to fill six (duels: player + rival)
  lineup(node) {
    const pIdx = Save.data.racer;
    const pDef = RACERS[pIdx];
    const out = [{ def: pDef, build: copyBuild(Save.build(pIdx)), player: true }];
    if (node.duel) {
      const d = RIVAL_BY_ID[node.duel];
      out.push({ def: d, build: copyBuild(d.build) });
      return out;
    }
    for (const id of node.rivals || []) out.push({ def: RIVAL_BY_ID[id], build: copyBuild(RIVAL_BY_ID[id].build) });
    for (const def of RACERS) {
      if (out.length >= 6) break;
      if (def !== pDef) out.push({ def, build: copyBuild(def.build) });
    }
    return out;
  },
  play(node) {
    this.node = node;
    this.stats = { booms: 0, spins: 0, rings: 0, ringsTotal: 0 };
    Game.storyNode = node;
    const ti = TRACKS.findIndex((t) => t.id === node.track);
    Game.startRace(ti);
  },
  // called by Game.startRace after the world is built; returns true if a cutscene now owns the flow
  preRace() {
    const node = Game.storyNode;
    if (!node) return false;
    const tr = Game.race.track;
    this.stats.ringsTotal = tr.rings.filter((r) => !r.route || r.route === 'main').length + Math.max(tr.rings.filter((r) => r.route === 'high').length, tr.rings.filter((r) => r.route === 'low').length);
    const go = () => {
      Game.beginCountdown();
      UI.toast(up(tx(T('ΣΤΟΧΟΣ: ', 'GOAL: ')) + tx(goalText(node.goal))), 'good');
    };
    if (node.pre && !this.st().seen[node.pre]) {
      Game.resetRace();
      Cutscene.play(node.pre, go);
      return true;
    }
    go();
    return true;
  },
  evaluate(race, P) {
    const g = this.node.goal;
    const s = this.stats;
    const checks = [];
    if (g.place) checks.push([P.place <= g.place, tx(T('Θέση ', 'Place ')) + P.place + ' / ' + g.place]);
    if (g.beat) {
      const r = race.racers.find((x) => x.def.id === g.beat);
      checks.push([!r || P.place < r.place, tx(CAST[g.beat].name)]);
    }
    if (g.beatAll) {
      const ok = g.beatAll.every((id) => {
        const r = race.racers.find((x) => x.def.id === id);
        return !r || P.place < r.place;
      });
      checks.push([ok, tx(T('Κέρατα', 'Horns'))]);
    }
    if (g.booms) checks.push([s.booms >= g.booms, tx(T('Βαρέλια ', 'Barrels ')) + s.booms + ' / ' + g.booms]);
    if (g.clean) checks.push([s.spins === 0, tx(T('Σπιν ', 'Spin-outs ')) + s.spins]);
    if (g.rings) {
      const ratio = s.ringsTotal ? s.rings / s.ringsTotal : 1;
      checks.push([ratio >= g.rings - 1e-6, tx(T('Κρίκοι ', 'Rings ')) + Math.round(ratio * 100) + '%']);
    }
    if (g.coins) checks.push([P.coins >= g.coins, tx(T('Νομίσματα ', 'Coins ')) + P.coins + ' / ' + g.coins]);
    return { ok: checks.every((c) => c[0]), checks };
  },
  onResults(race, P) {
    const node = this.node;
    const res = this.evaluate(race, P);
    const box = $('story-result');
    box.hidden = false;
    box.classList.toggle('ok', res.ok);
    box.innerHTML = '';
    box.appendChild(el('div', 'sr-title', tx(res.ok ? T('ΣΤΟΧΟΣ ΕΠΙΤΕΥΧΘΗΚΕ', 'GOAL COMPLETE') : T('ΣΤΟΧΟΣ ΑΠΕΤΥΧΕ', 'GOAL FAILED'))));
    for (const [ok, label] of res.checks) box.appendChild(el('div', 'sr-check ' + (ok ? 'y' : 'n'), (ok ? '✔ ' : '✖ ') + label));
    $('btn-next').textContent = tx(res.ok ? T('Συνέχεια', 'Continue') : T('Ξανά', 'Retry'));
    $('btn-again').textContent = tx(T('Ξανά', 'Retry'));
    $('btn-menu').textContent = tx(T('Ιστορία', 'Story'));
    this.lastOk = res.ok;
    if (res.ok) {
      const first = !this.done(node.id);
      this.st().done[node.id] = { p: P.place, t: P.finishTime };
      Save.store();
      if (first) UI.toast(tx(T('ΝΕΟ ΣΤΟ CODEX', 'NEW CODEX ENTRIES')), 'good');
    }
  },
  // "next" button on the results screen
  continue() {
    const node = this.node;
    if (!this.lastOk) {
      Game.restart();
      return;
    }
    const after = () => this.open();
    if (node.post) {
      Podium.dispose();
      UI.setOn('results', false);
      Game.teardownForCut();
      Cutscene.play(node.post, after);
    } else after();
  },
  leave() {
    Game.storyNode = null;
    this.node = null;
    $('story-result').hidden = true;
  },
  // ---------------- hub ----------------
  open() {
    this.leave();
    this.st();
    Game.goMenu(true);
    Game.phase = 'story';
    UI.show('story');
    const first = WORLDS.findIndex((w) => !STORY_NODES.filter((n) => n.world === w.id).every((n) => this.done(n.id)));
    this.worldSel = first < 0 ? WORLDS.length - 1 : first;
    this.render();
    this.radio();
    if (!this.st().seen.c_prologue && !this.done('v1')) {
      // the prologue plays on the first visit (garage stage), then the hub comes back
      Cutscene.play('c_prologue', () => {
        Game.phase = 'story';
        UI.show('story');
        Sound.startMusic('story');
      });
    } else Sound.startMusic('story');
  },
  render() {
    const wl = $('story-worlds');
    wl.innerHTML = '';
    WORLDS.forEach((w, i) => {
      const unlocked = this.worldUnlocked(w.id);
      const nodes = STORY_NODES.filter((n) => n.world === w.id);
      const done = nodes.filter((n) => this.done(n.id)).length;
      const b = el('button', 'sw-card' + (i === this.worldSel ? ' sel' : '') + (unlocked ? '' : ' locked'));
      b.style.setProperty('--wc', w.color);
      b.innerHTML = `<span class="sw-n">${w.n}</span><span class="sw-name"></span><span class="sw-prog">${unlocked ? done + '/' + nodes.length : '🔒'}</span>`;
      b.querySelector('.sw-name').textContent = tx(w.name);
      b.addEventListener('click', () => {
        this.worldSel = i;
        this.render();
      });
      wl.appendChild(b);
    });
    const w = WORLDS[this.worldSel];
    const unlocked = this.worldUnlocked(w.id);
    const p = $('story-panel');
    p.innerHTML = '';
    p.style.setProperty('--wc', w.color);
    p.appendChild(el('div', 'sp-kicker', tx(T('ΚΟΣΜΟΣ ', 'WORLD ')) + w.n));
    p.appendChild(el('h3', 'sp-title', tx(w.name)));
    p.appendChild(el('p', 'sp-blurb', unlocked ? tx(w.blurb) : tx(T('Κλειδωμένο. Τελείωσε τον προηγούμενο κόσμο.', 'Locked. Finish the previous world.'))));
    const list = el('div', 'sp-nodes');
    STORY_NODES.filter((n) => n.world === w.id).forEach((n, k) => {
      const ok = this.nodeUnlocked(n);
      const done = this.done(n.id);
      const tr = TRACKS.find((t) => t.id === n.track);
      const row = el('button', 'sp-node' + (done ? ' done' : '') + (ok ? '' : ' locked'));
      const kind = n.duel ? tx(T('ΜΟΝΟΜΑΧΙΑ', 'DUEL')) + ' · ' + up(tx(CAST[n.duel].name)) : tx(T('ΑΓΩΝΑΣ', 'RACE')) + ' ' + (k + 1);
      row.innerHTML = `<span class="spn-kind"></span><span class="spn-track"></span><span class="spn-goal"></span><span class="spn-state">${done ? '✔' : ok ? '▶' : '🔒'}</span>`;
      row.querySelector('.spn-kind').textContent = kind;
      row.querySelector('.spn-track').textContent = tr.name.toUpperCase();
      row.querySelector('.spn-goal').textContent = tx(goalText(n.goal));
      if (ok) row.addEventListener('click', () => this.play(n));
      list.appendChild(row);
    });
    p.appendChild(list);
    const pr = this.progress();
    $('story-prog').textContent = pr.n + ' / ' + pr.of;
    $('story-lang').textContent = LANG.cur === 'el' ? 'ΕΛ' : 'EN';
    $('story-voice').textContent = tx(T('Φωνές: ', 'Voices: ')) + (this.st().voice > 0 ? tx(T('ΝΑΙ', 'ON')) : tx(T('ΟΧΙ', 'OFF')));
  },
  radio() {
    this.radioSeed = (this.st().radio = (this.st().radio || 1) + 1);
    Save.store();
    const items = [];
    for (let k = 0; k < 5; k++) items.push(tx(LoreGen.make(this.radioSeed * 31 + k)));
    $('radio-ticker').textContent = '📻 ' + tx(T('ΡΑΔΙΟ ΜΠΟΥΛΣΙΤ 66.6', 'B.S. RADIO 66.6')) + ' · ' + items.join('   ◆   ');
  },
  // ---------------- codex ----------------
  openCodex() {
    Game.phase = 'codex';
    UI.show('codex');
    this.renderCodex();
  },
  renderCodex() {
    const cats = [['crew', T('Πλήρωμα', 'Crew')], ['horns', T('Κέρατα', 'Horns')], ['worlds', T('Κόσμοι', 'Worlds')], ['league', T('Λίγκα', 'League')], ['tapes', T('Κασέτες', 'Tapes')], ['rumours', T('Φήμες ∞', 'Rumours ∞')]];
    const tabs = $('codex-tabs');
    tabs.innerHTML = '';
    for (const [id, label] of cats) {
      const b = el('button', 'cx-tab' + (id === this.codexCat ? ' sel' : ''), tx(label));
      b.addEventListener('click', () => {
        this.codexCat = id;
        this.codexSel = null;
        this.renderCodex();
      });
      tabs.appendChild(b);
    }
    const list = $('codex-list');
    list.innerHTML = '';
    const view = $('codex-view');
    view.innerHTML = '';
    let entries;
    if (this.codexCat === 'tapes') {
      entries = Object.entries(TAPES).map(([tid, text]) => {
        const tr = TRACKS.find((t) => t.id === tid);
        return { id: 'tape_' + tid, title: T(tr.name, tr.name), text, open: !!this.st().tapes[tid], hint: T('Βρες την κασέτα στην πίστα ' + tr.name, 'Find the tape on ' + tr.name) };
      });
    } else if (this.codexCat === 'rumours') {
      const out = [];
      for (let k = 0; k < 12; k++) {
        const seed = (this.st().rumour || 1) * 97 + k;
        out.push({ id: 'r' + k, title: T('Φήμη #' + seed, 'Rumour #' + seed), text: LoreGen.make(seed), open: true });
      }
      entries = out;
      const more = el('button', 'btn btn-ghost cx-more', tx(T('Κι άλλες φήμες', 'More rumours')));
