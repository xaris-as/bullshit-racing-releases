        Cutscene.next(false);
      }
    });
    Voice.init();
  },
};

// ============================================================
// Online multiplayer, peer to peer (v4). WebRTC data channels via PeerJS (its public broker is only used for the
// handshake; game data flows directly between players). Star topology: the host relays everyone's state and runs
// the AI karts. Every peer simulates its own kart; other karts are drawn from their latest network state
// (extrapolated along their velocity and smoothed). Barrels, abilities and finishes are sent as events.
// Local test transport (two tabs, same browser): add ?net=local to the URL (BroadcastChannel).
// ============================================================
const NET_PREFIX = 'bullshit-racing-';
const NET_RATE = 1 / 20;
// STUN only finds each player's public address. The default PeerJS TURN relay (eu-0/us-0.turn.peerjs.com) no longer
// answers (checked 2026-11-24), so it is left out; same-network play relies on LAN host candidates (the exe disables
// mDNS hiding, see app/main.js). NET_TURN is where a real relay (own coturn / hosted TURN with credentials) goes.
const NET_TURN = [];
const NET_ICE = [{ urls: ['stun:stun.l.google.com:19302', 'stun:stun1.l.google.com:19302', 'stun:stun2.l.google.com:19302'] }, { urls: 'stun:stun.cloudflare.com:3478' }, ...NET_TURN];
const NET_PEER_OPTS = { debug: 0, config: { iceServers: NET_ICE } };
const NET_JOIN_TIMEOUT = 20;
const NET_KEYS = ['s', 'd', 'y', 'vy', 'hw', 'om', 'vx', 'vz', 'v', 'spd', 'steer', 'boostT', 'spinT', 'ramT', 'shieldT', 'gamma', 'airT', 'sdot', 'ddot', 'finishTime', 'trickT', 'trickK', 'trickN', 'trickSeq'];
const Net = {
  on: false,
  role: '',
  code: '',
  me: '',
  name: '',
  peer: null,
  conns: new Map(),
  hostConn: null,
  bc: null,
  players: [],
  trackIdx: 0,
  ai: true,
  states: new Map(),
  sendT: 0,
  cfg: null,
  ready: new Set(),
  status: '',
  local() {
    return new URLSearchParams(location.search).get('net') === 'local';
  },
  genCode() {
    const A = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
    let c = '';
    for (let i = 0; i < 5; i++) c += A[Math.floor(Math.random() * A.length)];
    return c;
  },
  peerLib() {
    if (window.Peer) return Promise.resolve();
    return new Promise((res, rej) => {
      const s = document.createElement('script');
      s.src = 'vendor/peerjs.min.js';
      s.onload = res;
      s.onerror = () => rej(new Error('peerjs'));
      document.head.appendChild(s);
    });
  },
  setStatus(t) {
    this.status = t;
    const e = $('net-status');
    if (e) e.textContent = t;
  },
  // ---------------- connection ----------------
  async host() {
    this.reset();
    this.role = 'host';
    this.code = this.genCode();
    this.name = ($('net-name').value || RACERS[Save.data.racer].name).slice(0, 14);
    this.setStatus('Opening room…');
    if (this.local()) {
      this.me = 'h-' + this.code;
      this.openBC();
      this.ok();
    } else {
      try {
        await this.peerLib();
      } catch (e) {
        return this.setStatus('Could not load the network library.');
      }
      this.peer = new window.Peer(NET_PREFIX + this.code, NET_PEER_OPTS);
      this.peer.on('open', (id) => {
        this.me = id;
        this.ok();
      });
      this.peer.on('connection', (c) => this.wire(c));
      this.peer.on('error', (e) => this.setStatus(this.errText(e)));
      this.peer.on('disconnected', () => {
        // lost the broker (not the players): reconnect so new players can still find the room
        if (this.peer && !this.peer.destroyed) this.peer.reconnect();
      });
    }
  },
  errText(e) {
    const t = e && e.type;
    if (t === 'peer-unavailable') return 'No room with that code. Check the code and that the host is still in the room.';
    if (t === 'unavailable-id') return 'That room code is taken, host again.';
    if (t === 'network' || t === 'server-error' || t === 'socket-error' || t === 'socket-closed') return 'Cannot reach the matchmaking server. Check your internet connection.';
    if (t === 'browser-incompatible') return 'This browser does not support online play.';
    return 'Network error: ' + (t || (e && e.message) || 'unknown');
  },
  joinFailed() {
    if (this.on) return;
    this.setStatus('Found the room but could not connect to the host. Same Wi-Fi: make sure Windows Firewall allows Bullshit Racing on both PCs and the network is not a guest/school Wi-Fi that blocks devices from seeing each other. Then try again.');
    try {
      if (this.peer) this.peer.destroy();
    } catch (e) {}
    this.peer = null;
  },
  ok() {
    this.on = true;
    this.players = [{ id: this.me, name: this.name, racer: Save.data.racer, build: copyBuild(Save.build(Save.data.racer)), host: true }];
    this.setStatus('Room open. Share the code with your crew.');
    this.renderLobby();
  },
  async join(code) {
    this.reset();
    code = (code || '').trim().toUpperCase();
    if (code.length < 4) return this.setStatus('Type the room code first.');
    this.role = 'client';
    this.code = code;
    this.name = ($('net-name').value || RACERS[Save.data.racer].name).slice(0, 14);
    this.setStatus('Joining ' + code + '…');
    const hello = { t: 'hello', ver: GAME_VERSION, name: this.name, racer: Save.data.racer, build: copyBuild(Save.build(Save.data.racer)) };
    if (this.local()) {
      this.me = 'c-' + Math.random().toString(36).slice(2, 8);
      this.openBC();
      this.on = true;
      this.send(hello);
      return;
    }
    try {
      await this.peerLib();
    } catch (e) {
      return this.setStatus('Could not load the network library.');
    }
    this.peer = new window.Peer(NET_PEER_OPTS);
    const peer = this.peer;
    peer.on('open', (id) => {
      this.me = id;
      this.setStatus('Room found, connecting to the host…');
      const c = peer.connect(NET_PREFIX + code, { reliable: true, serialization: 'json' });
      const timer = setTimeout(() => {
        if (this.peer === peer) this.joinFailed();
      }, NET_JOIN_TIMEOUT * 1000);
      c.on('open', () => {
        clearTimeout(timer);
        this.on = true;
        this.hostConn = c;
        c.send(hello);
      });
      c.on('iceStateChanged', (st) => {
        if (st === 'failed' && !this.on && this.peer === peer) {
          clearTimeout(timer);
          this.joinFailed();
        }
      });
      c.on('data', (d) => this.onMsg(NET_PREFIX + code, d));
      c.on('close', () => this.lost());
      c.on('error', () => this.lost());
    });
    peer.on('error', (e) => {
      if (this.peer === peer) this.setStatus(this.errText(e));
    });
  },
  wire(c) {
    c.on('open', () => this.conns.set(c.peer, c));
    c.on('data', (d) => this.onMsg(c.peer, d));
    c.on('close', () => this.drop(c.peer));
    c.on('error', () => this.drop(c.peer));
  },
  openBC() {
    this.bc = new BroadcastChannel('bsr-' + this.code);
    this.bc.onmessage = (e) => {
      const m = e.data;
      if (m.from === this.me || (m.to && m.to !== this.me)) return;
      if (this.role === 'client' && m.from !== 'h-' + this.code) return;
      this.onMsg(m.from, m.msg);
    };
  },
  // client -> host, host -> one client (to) or everybody
  send(msg, to) {
    if (this.bc) {
      this.bc.postMessage({ from: this.me, to: to || (this.role === 'client' ? 'h-' + this.code : null), msg });
      return;
    }
    if (this.role === 'client') {
      if (this.hostConn && this.hostConn.open) this.hostConn.send(msg);
      return;
    }
    if (to) {
      const c = this.conns.get(to);
      if (c && c.open) c.send(msg);
    } else for (const c of this.conns.values()) if (c.open) c.send(msg);
  },
  drop(id) {
    this.conns.delete(id);
    const p = this.players.find((x) => x.id === id);
    if (p) {
      this.players = this.players.filter((x) => x !== p);
      UI.toast((p.name + ' LEFT').toUpperCase(), 'bad');
      this.pushLobby();
    }
  },
  lost() {
    if (!this.on) return;
    this.setStatus('Lost the connection to the host.');
    UI.toast('HOST DISCONNECTED', 'bad');
    this.on = false;
  },
  reset() {
    try {
      if (this.peer) this.peer.destroy();
    } catch (e) {}
    if (this.bc) this.bc.close();
    this.peer = null;
    this.bc = null;
    this.hostConn = null;
    this.conns.clear();
    this.players = [];
    this.states.clear();
    this.ready.clear();
    this.cfg = null;
    this.on = false;
    this.role = '';
  },
  // ---------------- protocol ----------------
  onMsg(from, m) {
    if (!m || typeof m !== 'object') return;
    if (this.role === 'host') {
      if (m.t === 'hello') {
        // everybody must run the same build (the launcher keeps friends updated); say so instead of desyncing
        if (m.ver !== GAME_VERSION) return this.send({ t: 'ver', host: GAME_VERSION }, from);
        if (this.players.length >= 6 || this.cfg) return this.send({ t: 'full' }, from);
        if (!this.players.find((p) => p.id === from)) this.players.push({ id: from, name: String(m.name || 'Racer').slice(0, 14), racer: clamp(m.racer | 0, 0, RACERS.length - 1), build: m.build });
        UI.toast((String(m.name) + ' JOINED').toUpperCase(), 'good');
        this.pushLobby();
      } else if (m.t === 'pick') {
        const p = this.players.find((x) => x.id === from);
        if (p) {
          p.racer = clamp(m.racer | 0, 0, RACERS.length - 1);
          p.build = m.build;
          this.pushLobby();
        }
      } else if (m.t === 'ready') {
        this.ready.add(from);
        this.tryGo();
      } else if (m.t === 'st') this.states.set(from, { st: m.st, t: performance.now() });
      else if (m.t === 'ev') {
        this.applyEvent(m, from);
        this.send(Object.assign({}, m, { from }));
      }
      return;
    }
    // client
    if (m.t === 'lobby') {
      this.players = m.players;
      this.trackIdx = m.track;
      this.ai = m.ai;
      this.setStatus('In room ' + this.code + '. Waiting for the host to start.');
      this.renderLobby();
    } else if (m.t === 'full') this.setStatus('That room is full or already racing.');
    else if (m.t === 'ver') {
      this.setStatus(`Different game versions: the host has ${m.host}, you have ${GAME_VERSION}. Update the game (the launcher does it on start), then join again.`);
      this.reset();
      this.renderLobby();
    }
    else if (m.t === 'start') this.startLocal(m.cfg);
    else if (m.t === 'go') Game.beginCountdown();
    else if (m.t === 'w') {
      const now = performance.now();
      for (const [id, st] of Object.entries(m.s)) if (id !== this.me) this.states.set(id, { st, t: now });
    } else if (m.t === 'ev') this.applyEvent(m, m.from);
    else if (m.t === 'end') {
      UI.toast('THE HOST ENDED THE RACE', 'bad');
      this.leaveRace();
    }
  },
  pushLobby() {
    if (this.role !== 'host') return;
    this.send({ t: 'lobby', players: this.players, track: this.trackIdx, ai: this.ai });
    this.renderLobby();
  },
  // ---------------- race ----------------
  start() {
    if (this.role !== 'host') return;
    const lineup = this.players.map((p) => ({ nid: p.id, racer: p.racer, build: p.build, name: p.name }));
    if (this.ai) {
      for (let i = 0; i < RACERS.length && lineup.length < 6; i++) if (!lineup.find((x) => x.racer === i)) lineup.push({ nid: 'ai-' + i, racer: i, build: null, ai: true });
    }
    const cfg = { track: this.trackIdx, seed: (Math.random() * 1e9) | 0, lineup };
    this.send({ t: 'start', cfg });
    this.startLocal(cfg);
  },
  startLocal(cfg) {
    this.cfg = cfg;
    this.ready.clear();
    this.states.clear();
    Game.storyNode = null;
    Game.lineupOverride = cfg.lineup.map((e) => {
      const def = Object.assign({}, RACERS[e.racer]);
      if (e.name && !e.ai) def.name = e.name;
      return { def, build: e.build ? Object.assign(copyBuild(RACERS[e.racer].build), e.build) : copyBuild(RACERS[e.racer].build), player: e.nid === this.me, nid: e.nid, ai: !!e.ai };
    });
    Game.netCfg = cfg;
    Game.startRace(cfg.track);
  },
  // called by Game.startRace after building: mark remote karts, report ready, wait for "go"
  built() {
    const race = Game.race;
    this.byNid = new Map();
    Game.lineupOverride.forEach((e, i) => {
      const r = race.racers[i];
      r.nid = e.nid;
      this.byNid.set(e.nid, r);
      // humans elsewhere are remote everywhere; AI karts are simulated by the host only
      r.remote = !r.isPlayer && (!e.ai || this.role === 'client');
    });
    $('loading-text').textContent = 'WAITING FOR THE OTHER RACERS…';
    if (this.role === 'host') {
      this.ready.add(this.me);
      this.tryGo();
      this.goTimer = setTimeout(() => this.forceGo(), 20000);
    } else this.send({ t: 'ready' });
  },
  tryGo() {
    if (this.role !== 'host' || !this.cfg || !Game.race) return;
    const humans = this.cfg.lineup.filter((e) => !e.ai).map((e) => e.nid);
    if (humans.every((id) => this.ready.has(id))) this.forceGo();
  },
  forceGo() {
    clearTimeout(this.goTimer);
    if (!this.cfg || this.going) return;
    this.going = true;
    this.send({ t: 'go' });
    Game.beginCountdown();
    setTimeout(() => (this.going = false), 1000);
  },
  pack(r) {
    const o = { m: r.mode, g: r.grounded ? 1 : 0, sp: r.spinning ? 1 : 0, fin: r.finished ? 1 : 0, dr: r.drift.on ? r.drift.dir : 0, dl: r.drift.level };
    for (const k of NET_KEYS) o[k] = typeof r[k] === 'number' ? Math.round(r[k] * 1000) / 1000 : 0;
    return o;
  },
  tick(dt) {
    const race = Game.race;
    if (!this.on || !this.cfg || !race || !this.byNid) return;
    const now = performance.now();
    // apply remote karts
    for (const [nid, rec] of this.states) {
      const r = this.byNid.get(nid);
      if (!r || !r.remote) continue;
      const st = rec.st;
      const age = Math.min(0.25, (now - rec.t) / 1000);
      const k = 1 - Math.exp(-dt * 14);
      const ts = st.s + (st.sdot || 0) * age;
      const td = st.d + (st.ddot || 0) * age;
      if (Math.abs(ts - r.s) > 30) {
        r.s = ts;
        r.d = td;
        r.y = st.y;
      } else {
        r.s += (ts - r.s) * k;
        r.d += (td - r.d) * k;
        r.y += (st.y - r.y) * k;
      }
      let dh = st.hw - r.hw;
      dh = Math.atan2(Math.sin(dh), Math.cos(dh));
      r.hw += dh * k;
      for (const key of ['vy', 'om', 'vx', 'vz', 'v', 'spd', 'steer', 'boostT', 'spinT', 'ramT', 'shieldT', 'gamma', 'airT', 'sdot', 'ddot']) r[key] = st[key];
      if (r.mode !== st.m) r.mode = st.m;
      r.grounded = !!st.g;
      r.spinning = !!st.sp;
      r.drift.on = !!st.dr;
      r.drift.dir = st.dr || 0;
      r.drift.level = st.dl || 0;
      if (st.fin && !r.finished) {
        r.finished = true;
        r.finishTime = st.finishTime;
        Hooks.emit('finish', r);
      }
    }
    // send
    this.sendT -= dt;
    if (this.sendT > 0) return;
    this.sendT = NET_RATE;
    const P = Game.player;
    if (this.role === 'client') this.send({ t: 'st', st: this.pack(P) });
    else {
      const s = {};
      for (const r of race.racers) if (!r.remote) s[r.nid] = this.pack(r);
      for (const [nid, rec] of this.states) s[nid] = rec.st;
      this.send({ t: 'w', s });
    }
  },
  // events: ability use and barrel blasts mirrored on every screen
  event(kind, data) {
    if (!this.on || !this.cfg) return;
    const m = Object.assign({ t: 'ev', kind }, data);
    if (this.role === 'client') this.send(m);
    else this.send(Object.assign(m, { from: this.me }));
  },
  applyEvent(m, from) {
    const race = Game.race;
    if (!race || !this.byNid) return;
    const r = this.byNid.get(m.nid || from);
    if (m.kind === 'ab' && r && r.remote) {
      r.charge = 1;
      race.useAbility(r);
    } else if (m.kind === 'boom') {
      const f = race.track.booms[m.id];
      if (f && f.alive) race.detonate(f, r || null);
    }
  },
  leaveRace() {
    this.cfg = null;
    Game.netCfg = null;
    Game.lineupOverride = null;
    if (Game.race) Game.quit();
  },
  // ---------------- UI ----------------
  open() {
    Game.phase = 'online';
    UI.show('online');
    $('net-name').value = $('net-name').value || RACERS[Save.data.racer].name;
    this.renderLobby();
    if (!this.on) this.setStatus(this.local() ? 'Local test mode (two tabs).' : 'Host a room or join one with a code. Peer to peer: needs an internet connection.');
  },
  renderLobby() {
    const box = $('net-lobby');
    if (!box) return;
    box.innerHTML = '';
    $('net-code').textContent = this.on ? this.code : '—';
    $('net-room').hidden = !this.on;
    $('net-entry').hidden = this.on;
    for (const p of this.players) {
      const row = el('div', 'net-p');
      const pf = el('i');
      pf.style.backgroundImage = Portraits.css(RACERS[p.racer].id, 'idle', 'sm');
      row.append(pf, el('b', '', p.name), el('span', '', RACERS[p.racer].name.toUpperCase() + (p.host ? ' · HOST' : '') + (p.id === this.me ? ' · YOU' : '')));
      box.appendChild(row);
    }
    const tr = TRACKS[this.trackIdx];
    $('net-track').textContent = tr ? tr.name.toUpperCase() : '';
    $('net-ai').textContent = 'AI KARTS: ' + (this.ai ? 'ON' : 'OFF');
    const host = this.role === 'host';
    for (const id of ['net-start', 'net-tprev', 'net-tnext', 'net-ai']) $(id).disabled = !host;
  },
  cycleTrack(dir) {
    const open = TRACKS.map((t, i) => i).filter((i) => i < BASE_TRACKS || Story.trackUnlocked(TRACKS[i].id));
    const k = open.indexOf(this.trackIdx);
    this.trackIdx = open[(k + dir + open.length) % open.length];
    this.pushLobby();
  },
  initUI() {
    const sec = el('section', 'screen');
    sec.id = 'scr-online';
    sec.setAttribute('aria-label', 'Online');
    sec.innerHTML = `
      <header class="topbar"><button class="btn btn-ghost" id="net-back">Back</button><h2 class="screen-title">ONLINE · P2P</h2><div class="topbar-right"></div></header>
      <div class="net-wrap panel">
        <div id="net-entry" class="net-entry">
          <label>Your name <input id="net-name" maxlength="14" autocomplete="off"></label>
          <button class="btn btn-big" id="net-host">Host a room</button>
          <div class="net-join"><input id="net-join-code" maxlength="6" placeholder="CODE" autocomplete="off"><button class="btn" id="net-join">Join</button></div>
        </div>
        <div id="net-room" class="net-room" hidden>
          <div class="net-codebox">ROOM CODE <b id="net-code">—</b></div>
          <div class="net-lobby" id="net-lobby"></div>
          <div class="net-opts"><button class="btn btn-ghost" id="net-tprev">‹</button><span id="net-track"></span><button class="btn btn-ghost" id="net-tnext">›</button><button class="btn btn-ghost" id="net-ai">AI KARTS</button></div>
          <div class="row"><button class="btn btn-ghost" id="net-leave">Leave</button><button class="btn btn-big" id="net-start">Start race</button></div>
        </div>
        <p class="net-status" id="net-status"></p>
      </div>`;
    $('scr-menu').parentElement.appendChild(sec);
    $('net-back').addEventListener('click', () => {
      if (!this.cfg) this.reset();
      Game.goMenu();
    });
    $('net-host').addEventListener('click', () => this.host());
    $('net-join').addEventListener('click', () => this.join($('net-join-code').value));
    $('net-leave').addEventListener('click', () => {
      this.reset();
      this.renderLobby();
      this.setStatus('Left the room.');
    });
    $('net-start').addEventListener('click', () => this.start());
    $('net-tprev').addEventListener('click', () => this.cycleTrack(-1));
    $('net-tnext').addEventListener('click', () => this.cycleTrack(1));
    $('net-ai').addEventListener('click', () => {
      this.ai = !this.ai;
      this.pushLobby();
    });
    $('btn-online').addEventListener('click', () => this.open());
  },
};

