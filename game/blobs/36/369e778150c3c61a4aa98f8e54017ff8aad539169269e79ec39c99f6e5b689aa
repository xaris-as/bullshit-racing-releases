const LoreGen = {
  pick(arr, rng) {
    return arr[Math.floor(rng() * arr.length) % arr.length];
  },
  // kind: rumour | headline | rule | weather ; returns { el, en } built from the same seeded choices
  make(seed, kind) {
    const out = {};
    for (const lg of ['el', 'en']) {
      const F = LORE_FRAG[lg];
      const rng = mulberry32(seed * 7919 + 13);
      const k = kind || ['rumour', 'headline', 'rule', 'weather'][Math.floor(rng() * 4)];
      const who = this.pick(F.who, rng);
      const did = this.pick(F.did, rng);
      const when = this.pick(F.when, rng);
      const head = this.pick(F.head, rng);
      const rule = this.pick(F.rule, rng);
      const n = 7 + Math.floor(rng() * 990);
      const w = this.pick(F.weather, rng);
      if (k === 'rumour') out[lg] = lg === 'el' ? `Λένε ότι ${who.charAt(0).toLowerCase() + who.slice(1)} ${did} ${when}.` : `Word is ${who.charAt(0).toLowerCase() === who.charAt(0) ? who : who} ${did} ${when}.`;
      else if (k === 'headline') out[lg] = `${head}: ${who} ${did} ${when}!`;
      else if (k === 'rule') out[lg] = (lg === 'el' ? 'ΚΑΝΟΝΑΣ #' : 'RULE #') + n + ': ' + rule + '.';
      else out[lg] = w;
    }
    return out;
  },
};

