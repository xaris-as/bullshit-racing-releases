// track silhouette art for the track cards
function trackArt(tr) {
  const th = THEMES[tr.def.theme];
  const W = 440;
  const H = 192;
  const c = document.createElement('canvas');
  c.width = W;
  c.height = H;
  c.className = 'tc-map';
  const g = c.getContext('2d');
  const sky = g.createLinearGradient(0, 0, 0, H);
  sky.addColorStop(0, hexCss(th.skyTop));
  sky.addColorStop(1, hexCss(th.skyHorizon));
  g.fillStyle = sky;
  g.fillRect(0, 0, W, H);
  const hill = (col, base, a1, a2) => {
    g.fillStyle = col;
    g.beginPath();
    g.moveTo(0, H);
    for (let x = 0; x <= W; x += 8) g.lineTo(x, base + Math.sin(x * 0.017 + tr.def.seed + a1) * 16 + Math.sin(x * 0.049 + a2) * 7);
    g.lineTo(W, H);
    g.closePath();
    g.fill();
  };
  hill('rgba(0,0,0,0.35)', H * 0.5, 0, 1);
  hill('rgba(0,0,0,0.6)', H * 0.66, 2, 3);
  const xs = [];
  const zs = [];
  const ms = [];
  for (let i = 0; i <= tr.n - 1; i += 4) {
    xs.push(tr.X[i]);
    zs.push(tr.Z[i]);
    ms.push(tr.M[i]);
  }
  let ax = xs;
  let az = zs;
  if (Math.max(...zs) - Math.min(...zs) > Math.max(...xs) - Math.min(...xs)) {
    ax = zs;
    az = xs;
  }
  const minX = Math.min(...ax);
  const maxX = Math.max(...ax);
  const minZ = Math.min(...az);
  const maxZ = Math.max(...az);
  const sc = Math.min((W - 60) / Math.max(1, maxX - minX), (H - 50) / Math.max(1, maxZ - minZ));
  const ox = (W - (maxX - minX) * sc) / 2;
  const oz = (H - (maxZ - minZ) * sc) / 2;
  const P = (i) => [ox + (ax[i] - minX) * sc, oz + (az[i] - minZ) * sc];
  g.lineJoin = 'round';
  g.lineCap = 'round';
  const path = (a = 0, b = ax.length - 1) => {
    g.beginPath();
    for (let i = a; i <= b; i++) {
      const [x, y] = P(i);
      if (i === a) g.moveTo(x, y);
      else g.lineTo(x, y);
    }
  };
  path();
  g.strokeStyle = '#0b0b0e';
  g.lineWidth = 14;
  g.stroke();
  path();
  g.strokeStyle = '#ffc21a';
  g.lineWidth = 5;
  g.stroke();
  let a = -1;
  for (let i = 0; i <= ms.length; i++) {
    const m = i < ms.length ? ms[i] : -1;
    const special = m === M_WATER || m === M_AIR;
    if (special && a < 0) a = i;
    if ((!special || (a >= 0 && ms[a] !== m)) && a >= 0) {
      path(Math.max(0, a - 1), Math.min(ms.length - 1, i));
      g.strokeStyle = ms[a] === M_WATER ? '#29e3ff' : '#ff6fcf';
      g.lineWidth = 6;
      g.stroke();
      a = special ? i : -1;
    }
  }
  const [sx, sy] = P(0);
  g.fillStyle = '#7dff3a';
  g.fillRect(sx - 6, sy - 6, 12, 12);
  const fi = Math.min(ax.length - 1, Math.round(tr.finishS / STEP / 4));
  const [fx, fy] = P(fi);
  g.fillStyle = '#ffffff';
  g.fillRect(fx - 8, fy - 8, 16, 16);
  g.fillStyle = '#0b0b0e';
  g.fillRect(fx - 8, fy - 8, 8, 8);
  g.fillRect(fx, fy, 8, 8);
  return c;
}

