let CROWD_TEX = null;
function crowdTexture() {
  if (CROWD_TEX) return CROWD_TEX;
  CROWD_TEX = canvasTex(512, 128, (g) => {
    const rnd = mulberry32(5);
    const cols = ['#ffc21a', '#ff2e3c', '#29e3ff', '#7dff3a', '#ff2e88', '#e8e8e8', '#ff5e00', '#9a5cff'];
    for (let k = 0; k < 8; k++) {
      const x = k * 64 + 32;
      g.fillStyle = '#121215';
      // body + head + ears (critter silhouettes)
      g.beginPath();
      g.ellipse(x, 98, 20, 30, 0, 0, TAU);
      g.fill();
      g.beginPath();
      g.arc(x, 52, 18, 0, TAU);
      g.fill();
      const ears = k % 4;
      g.beginPath();
      if (ears === 0) {
        g.moveTo(x - 14, 44);
        g.lineTo(x - 8, 18);
        g.lineTo(x - 2, 40);
        g.moveTo(x + 14, 44);
        g.lineTo(x + 8, 18);
        g.lineTo(x + 2, 40);
      } else if (ears === 1) {
        g.ellipse(x - 8, 22, 5, 16, -0.1, 0, TAU);
        g.ellipse(x + 8, 22, 5, 16, 0.1, 0, TAU);
      } else if (ears === 2) {
        g.arc(x - 13, 38, 7, 0, TAU);
        g.arc(x + 13, 38, 7, 0, TAU);
      }
      g.fill();
      // scarf / shirt colour + raised arm
      g.fillStyle = cols[k];
      g.fillRect(x - 18, 70, 36, 10);
      g.strokeStyle = '#121215';
      g.lineWidth = 8;
      g.beginPath();
      g.moveTo(x + 14, 80);
      g.lineTo(x + 26, 50 - rnd() * 20);
      g.stroke();
      g.fillStyle = cols[(k + 3) % 8];
      g.fillRect(x + 20, 26, 22, 14);
    }
  });
  return CROWD_TEX;
}

function crowdMaterial(U) {
  return new THREE.ShaderMaterial({
    uniforms: { uTime: U.uTime, map: { value: crowdTexture() } },
    vertexShader: `
      attribute vec4 inst; // x, y, z, kind
      uniform float uTime;
      varying vec2 vUv;
      void main() {
        float k = inst.w;
        vUv = vec2((floor(k) + uv.x) / 8.0, uv.y);
        float ph = inst.x * 1.7 + inst.z * 1.3;
        float jump = max(0.0, sin(uTime * (5.0 + fract(ph) * 3.0) + ph)) * 0.35;
        vec3 c = vec3(inst.x, inst.y + jump, inst.z);
        vec3 camR = vec3(viewMatrix[0][0], viewMatrix[1][0], viewMatrix[2][0]);
        vec3 p = c + camR * position.x * 1.2 + vec3(0.0, position.y * 1.5 + 0.75, 0.0);
        gl_Position = projectionMatrix * viewMatrix * vec4(p, 1.0);
      }`,
    fragmentShader: `
      uniform sampler2D map; varying vec2 vUv;
      void main() { vec4 c = texture2D(map, vUv); if (c.a < 0.5) discard; gl_FragColor = vec4(c.rgb * 0.9, 1.0);
        #include <colorspace_fragment>
      }`,
  });
}

function flagMaterial(U, tex) {
  const m = new THREE.MeshStandardMaterial({ map: tex, side: THREE.DoubleSide, roughness: 0.8 });
  m.onBeforeCompile = (sh) => {
    sh.uniforms.uTime = U.uTime;
    sh.vertexShader = sh.vertexShader
      .replace('#include <common>', '#include <common>\nuniform float uTime;')
      .replace('#include <begin_vertex>', '#include <begin_vertex>\nfloat fw = uv.x; transformed.z += sin(uTime * 6.0 + uv.x * 7.0 + position.y) * 0.18 * fw; transformed.y -= fw * fw * 0.12;');
  };
  m.customProgramCacheKey = () => 'dd-flag';
  return m;
}

// ---------------------------------------------------------------- set dressing for the hardcore look
function buildStreetDressing(track, terrain, theme, Q, U, scene, statics) {
  const set = track.def.set || {};
  const L = track.finishS;
  const rng = mulberry32(track.def.seed * 3 + 1);
  const F = {};
  const out = { lamps: [], flags: [], crowd: null };
  const onRoad = (s) => track.modeAt(s) === M_ROAD;
  // graffiti walls beyond the barriers
  const walls = [];
  for (const f of set.graffiti || []) {
    const s0 = f * L;
    for (let k = 0; k < 4; k++) {
      const s = s0 + k * 8.5;
      if (!onRoad(s)) continue;
      track.frameInto(s, F);
      for (const sg of [-1, 1]) {
        if (rng() < 0.3) continue;
        const d = sg * (WALL_HW + 2.2);
        const x = F.x + F.rx * d;
        const z = F.z + F.rz * d;
        const y = Math.max(terrain.heightAt(x, z), F.y - 0.6);
        walls.push([x, y, z, -F.psi + (sg > 0 ? Math.PI : 0), Math.floor(rng() * 4)]);
      }
    }
  }
  if (walls.length) {
    const geo = new THREE.BoxGeometry(8.4, 2.8, 0.4);
    geo.translate(0, 1.4, 0);
    const uv = geo.attributes.uv;
    const mats = [];
    const tex = graffitiTexture();
    for (let q = 0; q < 4; q++) {
      const m = new THREE.MeshStandardMaterial({ map: tex, roughness: 0.92 });
      mats.push(m);
    }
    // four quadrant variants share one atlas via uv remap in separate geometries
    const geos = [0, 1, 2, 3].map((q) => {
      const g = geo.clone();
      const u2 = g.attributes.uv;
      for (let i = 0; i < u2.count; i++) u2.setXY(i, (q % 2) * 0.5 + u2.getX(i) * 0.5, (1 - Math.floor(q / 2)) * 0.5 + u2.getY(i) * 0.5 - 0.5 * 0);
      return g;
    });
    uv.needsUpdate = true;
    for (let q = 0; q < 4; q++) {
      const items = walls.filter((w) => w[4] === q).map((w) => [w[0], w[1], w[2], 1, w[3], 1]);
      if (items.length) addInstanced(statics, geos[q], mats[q], items, { cast: Q.shadows > 0, receive: Q.shadows > 0 });
    }
    geo.dispose();
  }
  // tyre stacks on the outside of tight corners
  if (set.tyres) {
    const items = [];
    for (let s = START_S + 60; s < L - 40; s += 6) {
      if (!onRoad(s)) continue;
      const k = track.kappaAt(s);
      if (Math.abs(k) < 1 / 110) continue;
      if (Math.floor(s / 6) % 3) continue;
      track.frameInto(s, F);
      const sg = k > 0 ? -1 : 1; // outside of the turn
      for (let j = 0; j < 2; j++) {
        const d = sg * (WALL_HW + 0.75 + j * 0.9);
        const x = F.x + F.rx * d + F.tx * (rng() - 0.5);
        const z = F.z + F.rz * d + F.tz * (rng() - 0.5);
        items.push([x, Math.max(terrain.heightAt(x, z), F.y - 0.5) - 0.05, z, 1, rng() * TAU, 0.9 + rng() * 0.2]);
      }
    }
    if (items.length) addInstanced(statics, tyreStackGeo(), MAT.prop, items, { cast: Q.shadows >= 2048, receive: false });
  }
  // chain-link fences above the barriers near start/finish and on long straights
  if (set.fences) {
    const P = [];
    const UV = [];
    const idx = [];
    const posts = [];
    const add = (s0, s1, sg) => {
      const base = P.length / 3;
      let n = 0;
      for (let s = s0; s <= s1; s += 3) {
        if (!onRoad(s)) break;
        track.frameInto(s, F);
        const d = sg * (WALL_HW + 0.45);
        const x = F.x + F.rx * d;
        const z = F.z + F.rz * d;
        const y = F.y - d * Math.sin(F.bank) + 0.95;
        P.push(x, y, z, x, y + 2.6, z);
        UV.push(s / 2.2, 0, s / 2.2, 1.2);
        if (Math.round(s / 3) % 2 === 0) posts.push([x, y - 0.2, z, 1, 0, 1]);
        n++;
      }
      for (let j = 0; j < n - 1; j++) {
        const a = base + j * 2;
        idx.push(a, a + 1, a + 2, a + 1, a + 3, a + 2);
      }
    };
    for (const sg of [-1, 1]) {
      add(START_S - 30, START_S + 120, sg);
      add(L - 160, L + 30, sg);
    }
    for (let s = START_S + 300; s < L - 300; s += 520) add(s, s + 90, rng() < 0.5 ? -1 : 1);
    if (P.length) {
      const g = new THREE.BufferGeometry();
      g.setAttribute('position', new THREE.Float32BufferAttribute(P, 3));
      g.setAttribute('uv', new THREE.Float32BufferAttribute(UV, 2));
      g.setIndex(idx);
      g.computeVertexNormals();
      g.computeBoundingSphere();
      const fm = new THREE.MeshStandardMaterial({ map: fenceTexture(), alphaTest: 0.5, side: THREE.DoubleSide, metalness: 0.6, roughness: 0.5 });
      scene.add(new THREE.Mesh(g, fm));
      const pg = new THREE.CylinderGeometry(0.05, 0.05, 2.8, 6);
      pg.translate(0, 1.4, 0);
      addInstanced(statics, pg, new THREE.MeshStandardMaterial({ color: 0x5a6068, metalness: 0.7, roughness: 0.4 }), posts, {});
    }
  }
  // floodlights
  const lampItems = [];
  const lampEvery = theme.night ? 85 : 150;
  for (let s = START_S - 20; s < L + 10; s += lampEvery * (0.8 + rng() * 0.4)) {
    if (!onRoad(s)) continue;
    if (rng() > (theme.lamps ?? 0.3) + 0.25 && Math.abs(s - START_S) > 60 && Math.abs(s - L) > 60) continue;
    track.frameInto(s, F);
    const sg = rng() < 0.5 ? -1 : 1;
    const d = sg * (WALL_HW + 1.4);
    const x = F.x + F.rx * d;
    const z = F.z + F.rz * d;
    const y = Math.max(terrain.heightAt(x, z), F.y - 0.6) - 0.1;
    const ry = -F.psi + (sg > 0 ? -Math.PI / 2 : Math.PI / 2);
    lampItems.push([x, y, z, 1, ry, 1]);
    out.lamps.push({ x: x - F.rx * sg * 0.9, y: y + 9.0, z: z - F.rz * sg * 0.9 });
  }
  if (lampItems.length) addInstanced(statics, lampGeo(), MAT.prop, lampItems, { cast: false });
  if (out.lamps.length) {
    // glow sprites (+ volumetric cones at night)
    const n = out.lamps.length;
    const gp = [];
    for (const l of out.lamps) gp.push(l.x, l.y, l.z);
    const gg = new THREE.BufferGeometry();
    gg.setAttribute('position', new THREE.Float32BufferAttribute(gp, 3));
    const gpm = new THREE.PointsMaterial({ map: glowTexture(), color: theme.night ? 0xcfe6ff : 0xffe2b0, size: theme.night ? 7 : 4, sizeAttenuation: true, transparent: true, depthWrite: false, blending: THREE.AdditiveBlending, opacity: theme.night ? 1 : 0.6 });
    const glows = new THREE.Points(gg, gpm);
    glows.frustumCulled = false;
    scene.add(glows);
    if (theme.night || theme.storm) {
      const cg = new THREE.ConeGeometry(4.2, 9.5, 16, 1, true);
      cg.translate(0, -4.75, 0);
      const cm = new THREE.MeshBasicMaterial({ color: 0x9fc4ff, transparent: true, opacity: theme.night ? 0.07 : 0.04, blending: THREE.AdditiveBlending, depthWrite: false, side: THREE.DoubleSide, fog: false });
      const items = out.lamps.map((l) => [l.x, l.y, l.z, 1, 0, 1]);
      addInstanced(statics, cg, cm, items, {});
    }
    out.lampCount = n;
  }
  // crowd stands + flags at start and finish
  if (Q.crowd) {
    const inst = [];
    const stands = [];
    for (const s0 of [START_S + 6, L - 6]) {
      for (const sg of [-1, 1]) {
        for (let k = -6; k <= 6; k++) {
          const s = s0 + k * 3.2;
          if (!onRoad(s)) continue;
          track.frameInto(s, F);
          for (let row = 0; row < 3; row++) {
            const d = sg * (WALL_HW + 2.4 + row * 1.3);
            const x = F.x + F.rx * d;
            const z = F.z + F.rz * d;
            const y = Math.max(terrain.heightAt(x, z), F.y - 0.6) + row * 0.75;
            if (rng() < 0.85) inst.push(x + (rng() - 0.5), y + 0.4, z + (rng() - 0.5), Math.floor(rng() * 8));
            if (k % 3 === 0) stands.push([x, y - 0.4, z, 1, -F.psi, 0.6 + row * 0.1]);
          }
        }
      }
    }
    if (inst.length) {
      const g = new THREE.InstancedBufferGeometry();
      const q = new THREE.PlaneGeometry(1, 1);
      g.index = q.index;
      g.attributes.position = q.attributes.position;
      g.attributes.uv = q.attributes.uv;
      g.setAttribute('inst', new THREE.InstancedBufferAttribute(new Float32Array(inst), 4));
      g.instanceCount = inst.length / 4;
      g.boundingSphere = new THREE.Sphere(new THREE.Vector3(), 1e5);
      const m = new THREE.Mesh(g, crowdMaterial(U));
      m.frustumCulled = false;
      scene.add(m);
      out.crowd = m;
    }
    if (stands.length) {
      const sg = new THREE.BoxGeometry(3.4, 0.8, 1.3);
      sg.translate(0, 0.4, 0);
      addInstanced(statics, sg, new THREE.MeshStandardMaterial({ color: 0x3a3d45, roughness: 0.9 }), stands, { receive: Q.shadows > 0 });
    }
    // flags on poles at the gates
    const flagTex = canvasTex(128, 64, (g) => {
      for (let y = 0; y < 4; y++) for (let x = 0; x < 8; x++) {
        g.fillStyle = (x + y) % 2 ? '#0b0b0e' : '#efece4';
        g.fillRect(x * 16, y * 16, 16, 16);
      }
    });
    const hazTex = canvasTex(128, 64, (g) => {
      g.fillStyle = '#ffc21a';
      g.fillRect(0, 0, 128, 64);
      g.fillStyle = '#0b0b0e';
      for (let k = -2; k < 10; k++) {
        g.beginPath();
        g.moveTo(k * 24, 64);
        g.lineTo(k * 24 + 12, 64);
        g.lineTo(k * 24 + 44, 0);
        g.lineTo(k * 24 + 32, 0);
        g.fill();
      }
    });
    const fg = new THREE.PlaneGeometry(2.4, 1.2, 12, 3);
    fg.translate(1.2, 0, 0);
    const poleG = new THREE.CylinderGeometry(0.05, 0.05, 5, 6);
    poleG.translate(0, 2.5, 0);
    const poleM = new THREE.MeshStandardMaterial({ color: 0x8a9098, metalness: 0.7, roughness: 0.4 });
    const poles = [];
    for (const [s0, tex] of [[START_S, hazTex], [L, flagTex]]) {
      const fm = flagMaterial(U, tex);
      const parts = [];
      for (const sg of [-1, 1]) {
        for (const ds of [-9, 9]) {
          track.frameInto(s0 + ds, F);
          const d = sg * (WALL_HW + 1.1);
          const x = F.x + F.rx * d;
          const z = F.z + F.rz * d;
          const y = Math.max(terrain.heightAt(x, z), F.y - 0.6);
          poles.push([x, y, z, 1, 0, 1]);
          const g = fg.clone();
          g.rotateY(-F.psi + Math.PI / 2);
          g.translate(x, y + 4.3, z);
          parts.push(g);
        }
      }
      const merged = mergeGeometries(parts, false);
      for (const g of parts) g.dispose();
      scene.add(new THREE.Mesh(merged, fm));
    }
    addInstanced(statics, poleG, poleM, poles, {});
  }
  return out;
}

// ---------------------------------------------------------------- glide + boat dressing
function buildGlideDressing(track, terrain, theme, Q, U, scene) {
  const out = { thermals: [], gondolas: [] };
  const tmp = {};
  // thermals: swirling translucent columns
  if (track.thermals.length) {
    const cg = new THREE.CylinderGeometry(1, 1, 1, 24, 6, true);
    const tm = new THREE.ShaderMaterial({
      uniforms: { uTime: U.uTime },
      vertexShader: 'varying vec2 vUv; varying float vY; void main(){ vUv = uv; vY = position.y; gl_Position = projectionMatrix * modelViewMatrix * instanceMatrix * vec4(position,1.0); }',
      fragmentShader: `uniform float uTime; varying vec2 vUv; varying float vY;
        void main(){ float s = sin(vUv.x * 37.7 + vUv.y * 18.0 - uTime * 4.0) * 0.5 + 0.5; s = pow(s, 6.0);
          float edge = smoothstep(0.0, 0.25, vUv.y) * smoothstep(1.0, 0.7, vUv.y);
          gl_FragColor = vec4(vec3(1.0, 0.9, 0.65) * 1.4, s * edge * 0.32); }`,
      transparent: true,
      depthWrite: false,
      blending: THREE.AdditiveBlending,
      side: THREE.DoubleSide,
    });
    const im = new THREE.InstancedMesh(cg, tm, track.thermals.length);
    track.thermals.forEach((t, i) => {
      const p = track.toWorld(t.s, t.d, tmp);
      t.wx = p.x;
      t.wz = p.z;
      _m4.compose(_v1.set(p.x, (t.y0 + t.y1) / 2, p.z), _q.identity(), _v2.set(t.r, t.y1 - t.y0, t.r));
      im.setMatrixAt(i, _m4);
      out.thermals.push(t);
    });
    im.frustumCulled = false;
    scene.add(im);
  }
  // cables strung between pylons, gondolas hanging from some
  if (track.cables.length) {
    const pylonG = new THREE.CylinderGeometry(0.35, 0.6, 1, 8);
    pylonG.translate(0, 0.5, 0);
    const pm = new THREE.MeshStandardMaterial({ color: 0x3a3d45, metalness: 0.5, roughness: 0.6 });
    const cm = new THREE.MeshStandardMaterial({ color: 0x17161b, metalness: 0.8, roughness: 0.3 });
    const gm = classedMaterial({ roughness: 0.5 }, 'gondola');
    const gGeo = mergeParts([part(GEO.box, 0xff2e3c, 0, -1.7, 0, 0, 0, 0, 2.2, 1.8, 1.8), part(GEO.box, 0x17161b, 0, -1.4, 0, 0, 0, 0, 2.25, 0.5, 1.85), part(GEO.cylLo, 0x8a9098, 0, -0.4, 0, 0, 0, 0, 0.06, 0.9, 0.06)]);
    gGeo.setAttribute('mclass', new THREE.BufferAttribute(new Float32Array(gGeo.attributes.position.count).fill(1), 1));
    for (const c of track.cables) {
      const F = track.frameInto(c.s, tmp);
      const ends = [];
      for (const sg of [-1, 1]) {
        const d = sg * (AIR_HW + 3);
        const x = F.x + F.rx * d;
        const z = F.z + F.rz * d;
        const base = track.waterY - 3;
        const p = new THREE.Mesh(pylonG, pm);
        p.position.set(x, base, z);
        p.scale.set(1, c.y + 2.5 - base, 1);
        scene.add(p);
        ends.push(new THREE.Vector3(x, c.y, z));
      }
      const len = ends[0].distanceTo(ends[1]);
      const cab = new THREE.Mesh(new THREE.CylinderGeometry(0.06, 0.06, len, 5), cm);
      cab.position.copy(ends[0]).add(ends[1]).multiplyScalar(0.5);
      cab.quaternion.setFromUnitVectors(_UP, _v1.subVectors(ends[1], ends[0]).normalize());
      scene.add(cab);
      if (c.gond) {
        const g = new THREE.Mesh(gGeo, gm);
        scene.add(g);
        out.gondolas.push({ c, m: g, F: { x: F.x, z: F.z, rx: F.rx, rz: F.rz, psi: F.psi } });
      }
    }
  }
  // stacks (tall sea columns in the glide line)
  const stacks = track.obstacles.filter((o) => o.kind === 'stack');
  if (stacks.length) {
    const pr = Assets.prop('prop_seastack');
    pr.geo.computeBoundingBox();
    const bb = pr.geo.boundingBox;
    const ph = Math.max(1, bb.max.y - bb.min.y);
    const pw = Math.max(0.5, Math.max(bb.max.x - bb.min.x, bb.max.z - bb.min.z) / 2);
    const items = stacks.map((o) => {
      const p = track.toWorld(o.s, o.d, tmp);
      const h = o.y1 - o.y0;
      const sc = (o.r * 1.05) / pw;
      return [p.x, o.y0 - bb.min.y * (h / ph), p.z, sc, o.s * 0.13, 0.9, 0, 0, h / ph / sc];
    });
    if (pr) addInstanced(scene, pr.geo, MAT.prop, items, { cast: Q.shadows > 0 });
  }
  // boat gates: tall buoys with a hazard banner between them
  if (track.gates.length) {
    const pole = mergeParts([part(GEO.cylLo, 0xff5e00, 0, 1.2, 0, 0, 0, 0, 0.32, 2.6, 0.32), part(GEO.sphereLo, 0xffc21a, 0, 2.7, 0, 0, 0, 0, 0.34, 0.34, 0.34), part(GEO.cylLo, 0x17161b, 0, 0.1, 0, 0, 0, 0, 0.55, 0.5, 0.55)]);
    const items = [];
    const banners = [];
    for (const g of track.gates) {
      const F = track.frameInto(g.s, tmp);
      for (const sg of [-1, 1]) {
        const d = g.d + sg * g.w;
        items.push([F.x + F.rx * d, track.waterY - 0.3, F.z + F.rz * d, 1, 0, 1]);
      }
      const p = track.toWorld(g.s, g.d, tmp);
      g.wx = p.x;
      g.wz = p.z;
      banners.push([p.x, track.waterY + 2.4, p.z, 1, -F.psi, 1]);
    }
    addInstanced(scene, pole, MAT.prop, items, { cast: Q.shadows > 0 });
    const bt = canvasTex(256, 64, (g) => {
      g.fillStyle = '#0b0b0e';
      g.fillRect(0, 0, 256, 64);
      g.fillStyle = '#ffc21a';
      g.font = '900 40px ' + COND_FONT;
      g.textAlign = 'center';
      g.textBaseline = 'middle';
      g.fillText('>>> GATE >>>', 128, 34);
    });
    const bg = new THREE.PlaneGeometry(track.gates[0].w * 2, 0.7);
    addInstanced(scene, bg, new THREE.MeshBasicMaterial({ map: bt, side: THREE.DoubleSide }), banners, {});
  }
  return out;
}

// ============================================================
// v4 world dressing for the new themes: runtime props (registered into the asset library so the normal scatter and
// instancing use them), plus per-track extras: neon signs, Taurus billboards, hero chimneys with smoke, lava falls,
// lily pads, fireflies, ash/embers, the golden bull statue and banners. Draw-call friendly: every extra kind is one
// merged mesh / Points object; low tier skips the particles.
// ============================================================
// ---------- part helpers with material class (vertex alpha class -> 'mclass' attribute, see 30_models prepGeo) ----------
function xpart(geo, color, cls, x, y, z, rx = 0, ry = 0, rz = 0, sx = 1, sy = sx, sz = sx) {
  _e.set(rx, ry, rz);
  _q.setFromEuler(_e);
  return { geo, color, cls, m: new THREE.Matrix4().compose(_v1.set(x, y, z), _q, _v2.set(sx, sy, sz)) };
}
function xmerge(parts) {
  const gs = [];
  for (const p of parts) {
    const g = p.geo.index ? p.geo.toNonIndexed() : p.geo.clone();
    g.applyMatrix4(p.m);
    const n = g.attributes.position.count;
    const col = new Float32Array(n * 3);
    const mc = new Float32Array(n).fill(p.cls);
    _col.set(p.color);
    for (let i = 0; i < n; i++) {
      col[i * 3] = _col.r;
      col[i * 3 + 1] = _col.g;
      col[i * 3 + 2] = _col.b;
    }
    const out = new THREE.BufferGeometry();
    out.setAttribute('position', g.attributes.position);
    out.setAttribute('normal', g.attributes.normal);
    out.setAttribute('color', new THREE.BufferAttribute(col, 3));
    out.setAttribute('mclass', new THREE.BufferAttribute(mc, 1));
    gs.push(out);
    g.dispose();
  }
  const merged = mergeGeometries(gs, false);
  for (const g of gs) g.dispose();
  merged.computeBoundingSphere();
  return merged;
}
const C_PAINT = 1;
const C_METAL = 0.75;
const C_MATTE = 0.5;
const C_GLOW = 0;

function towerGeo(v) {
  const rng = mulberry32(31 + v * 17);
  const P = [];
  const w = v === 1 ? 7 : 6.2;
  const h = v === 1 ? 30 : 42;
  const body = v === 1 ? 0x2a2833 : 0x22252e;
  P.push(xpart(GEO.box, body, C_PAINT, 0, h / 2, 0, 0, 0, 0, w, h, w));
  P.push(xpart(GEO.box, 0x17161b, C_METAL, 0, h + 0.6, 0, 0, 0, 0, w * 0.7, 1.2, w * 0.7));
  if (v === 2) P.push(xpart(GEO.cylLo, 0x3a3d45, C_METAL, 1.2, h + 4, 1.2, 0, 0, 0, 0.12, 7, 0.12));
  // lit floors: window bands broken by mullions, some floors dark
  const floors = Math.floor(h / 3.2) - 1;
  const cols = [0xffd9a0, 0xbfe6ff, 0xff9ad0, 0x9affd8];
  for (let f = 1; f <= floors; f++) {
    const y = f * 3.2;
    for (let side = 0; side < 4; side++) {
      const ry = side * Math.PI / 2;
      for (let seg = 0; seg < 3; seg++) {
        if (rng() < 0.32) continue;
        const lit = rng() < 0.72;
        const off = (seg - 1) * (w / 3);
        const cx = Math.sin(ry) * (w / 2 + 0.03) + Math.cos(ry) * off;
        const cz = Math.cos(ry) * (w / 2 + 0.03) - Math.sin(ry) * off;
        P.push(xpart(GEO.plane, lit ? cols[Math.floor(rng() * cols.length)] : 0x101218, lit ? C_GLOW : C_METAL, cx, y, cz, 0, ry, 0, w / 3 - 0.5, 1.5, 1));
      }
    }
  }
  // roof sign strip
  P.push(xpart(GEO.box, v === 1 ? 0xff2e88 : 0x29e3ff, C_GLOW, 0, h - 0.6, w / 2 + 0.05, 0, 0, 0, w * 0.8, 0.35, 0.1));
  return xmerge(P);
}
function neonPropGeo() {
  const P = [];
  P.push(xpart(GEO.cylLo, 0x2a2a30, C_METAL, 0, 3, 0, 0, 0, 0, 0.18, 6, 0.18));
  P.push(xpart(GEO.box, 0x121117, C_PAINT, 0, 7.4, 0, 0, 0, 0, 4.6, 2.8, 0.3));
  // abstract tube shapes: a bolt + a ring of dashes
  const bolt = [[-1.2, 0.6, -0.4, 0.6], [-0.4, 0.6, 0.0, -0.2], [0.0, -0.2, -0.6, -0.2], [-0.6, -0.2, 0.6, -0.9]];
  for (const [x0, y0, x1, y1] of bolt) {
    const len = Math.hypot(x1 - x0, y1 - y0);
    P.push(xpart(GEO.box, 0xffe14a, C_GLOW, (x0 + x1) / 2 - 0.6, 7.4 + (y0 + y1) / 2, 0.2, 0, 0, Math.atan2(y1 - y0, x1 - x0), len, 0.12, 0.12));
  }
  for (let i = 0; i < 10; i++) {
    const a = (i / 10) * TAU;
    P.push(xpart(GEO.box, 0xff2e88, C_GLOW, 1.3 + Math.cos(a) * 0.8, 7.4 + Math.sin(a) * 0.8, 0.2, 0, 0, a + Math.PI / 2, 0.36, 0.1, 0.1));
  }
  P.push(xpart(GEO.box, 0x29e3ff, C_GLOW, 0, 5.9, 0.2, 0, 0, 0, 4.4, 0.1, 0.1));
