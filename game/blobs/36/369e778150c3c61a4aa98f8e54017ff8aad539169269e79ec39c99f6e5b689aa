<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<meta name="theme-color" content="#0b0b0e">
<title>Bullshit Racing</title>
<link rel="stylesheet" href="vendor/fonts/fonts.css">
<style>
:root {
  /* Bullshit Racing (v4, formerly Downhill Dash): hardcore street-racing HUD. Charcoal panels cut on a slant, hazard yellow, hot red, toxic green, electric cyan. */
  --ink: #0b0b0e;
  --coal: #17161b;
  --steel: #2b2d33;
  --paper: #efece4;
  --haz: #ffc21a;
  --hot: #ff2e3c;
  --tox: #7dff3a;
  --cyan: #29e3ff;
  --mag: #ff2e88;
  --shade: rgba(11, 11, 14, 0.82);
  --slant: polygon(14px 0, 100% 0, calc(100% - 14px) 100%, 0 100%);
  --slant-l: polygon(0 0, 100% 0, calc(100% - 14px) 100%, 0 100%);
  --font-display: "Saira Stencil One", "Black Ops One", Impact, "Arial Black", system-ui, sans-serif;
  --font-cond: "Saira Condensed", "Arial Narrow", Impact, system-ui, sans-serif;
  --font-body: "Chakra Petch", "Saira Condensed", "Trebuchet MS", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  --safe-t: max(10px, env(safe-area-inset-top));
  --safe-r: max(12px, env(safe-area-inset-right));
  --safe-b: max(10px, env(safe-area-inset-bottom));
  --safe-l: max(12px, env(safe-area-inset-left));
  color-scheme: dark;
}
* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
html, body { height: 100%; margin: 0; background: var(--ink); color: var(--paper); overflow: hidden; overscroll-behavior: none; }
body { font-family: var(--font-body); font-weight: 700; -webkit-user-select: none; user-select: none; -webkit-touch-callout: none; touch-action: none; }
#app { position: fixed; inset: 0; overflow: hidden; }
#gl { position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: none; outline: none; }
.hidden { display: none !important; }
button { font: inherit; color: inherit; cursor: pointer; touch-action: manipulation; }
button:focus-visible { outline: 3px solid var(--cyan); outline-offset: 3px; }
/* low tier: CSS-only vignette + scanlines instead of the post pass */
#vignette { position: absolute; inset: 0; pointer-events: none; display: none; background: radial-gradient(ellipse at center, transparent 55%, rgba(0,0,0,0.55) 100%); }
body.q-low #vignette { display: block; }

/* ---------- shared pieces ---------- */
.btn {
  font-family: var(--font-cond); font-weight: 900; font-size: clamp(16px, 2.2vmin + 8px, 24px); letter-spacing: 0.08em; text-transform: uppercase;
  background: var(--haz); color: var(--ink); border: 0; padding: 0.5em 1.5em; clip-path: var(--slant);
  transition: transform 0.08s, filter 0.08s; white-space: nowrap; position: relative;
}
.btn:hover { filter: brightness(1.08); }
.btn:active { transform: translateY(2px) scale(0.98); }
.btn[disabled] { filter: grayscale(0.85) brightness(0.6); cursor: default; }
.btn-big { font-size: clamp(22px, 3.6vmin + 10px, 38px); padding: 0.4em 1.8em; }
.btn-alt { background: var(--cyan); }
.btn-ghost { background: var(--steel); color: var(--paper); }
.btn-hot { background: var(--hot); color: var(--paper); }
.icon-btn {
  width: 46px; height: 46px; display: grid; place-items: center; border: 0; clip-path: polygon(8px 0, 100% 0, calc(100% - 8px) 100%, 0 100%);
  background: var(--coal); color: var(--paper); padding: 0;
}
.icon-btn:active { transform: translateY(2px); }
.icon-btn svg { width: 22px; height: 22px; }
.chip {
  display: inline-flex; align-items: center; gap: 8px; padding: 6px 18px 6px 14px; clip-path: var(--slant);
  background: var(--coal); color: var(--paper); font-family: var(--font-cond); font-weight: 800; font-size: 19px; font-variant-numeric: tabular-nums;
}
.coin-ico {
  width: 16px; height: 16px; display: inline-block; flex: none; transform: rotate(45deg);
  background: linear-gradient(135deg, #fff3a6 0 20%, var(--haz) 21% 70%, #c48a0a 71%); box-shadow: 0 0 0 2px var(--ink);
}
.panel { background: rgba(14, 14, 18, 0.9); color: var(--paper); border-left: 4px solid var(--haz); clip-path: polygon(0 0, 100% 0, 100% calc(100% - 18px), calc(100% - 18px) 100%, 0 100%); }
.screen { position: absolute; inset: 0; display: none; padding: var(--safe-t) var(--safe-r) var(--safe-b) var(--safe-l); }
.screen.on { display: flex; }
.topbar { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
.topbar-right { display: flex; align-items: center; gap: 8px; }
.screen-title { font-family: var(--font-display); font-weight: 400; font-size: clamp(24px, 4vmin + 10px, 44px); margin: 0; letter-spacing: 0.02em; transform: skewX(-8deg); text-shadow: 3px 3px 0 var(--hot); }
.hz { background: repeating-linear-gradient(-45deg, var(--haz) 0 10px, var(--ink) 10px 20px); }
/* glitch transition between screens */
body.glitch .screen.on { animation: glitchIn 0.42s steps(6) both; }
@keyframes glitchIn {
  0% { clip-path: inset(0 0 100% 0); transform: translateX(-12px); filter: hue-rotate(80deg) saturate(2); }
  30% { clip-path: inset(30% 0 40% 0); transform: translateX(10px); }
  60% { clip-path: inset(0 0 20% 0); transform: translateX(-4px); filter: none; }
  100% { clip-path: inset(0 0 0 0); transform: none; }
}
#scanlines { position: absolute; inset: 0; pointer-events: none; background: repeating-linear-gradient(0deg, rgba(0,0,0,0.12) 0 1px, transparent 1px 3px); opacity: 0.35; mix-blend-mode: multiply; }

/* ---------- logo ---------- */
.logo { margin: 0; line-height: 0.86; font-family: var(--font-display); font-weight: 400; transform: skewX(-10deg); transform-origin: left top; }
.logo span { display: block; }
.logo .l1 { font-size: clamp(20px, 3.4vmin + 8px, 40px); color: var(--paper); letter-spacing: 0.18em; margin-left: 0.2em; }
.logo .l2 { font-size: clamp(54px, 11vmin + 12px, 128px); color: var(--haz); text-shadow: 5px 5px 0 var(--hot), 10px 10px 0 rgba(0,0,0,0.6); }
.logo .tag { display: inline-block; font-family: var(--font-cond); font-weight: 800; font-size: clamp(11px, 1.4vmin + 7px, 17px); color: var(--ink); background: var(--haz); letter-spacing: 0.3em; text-transform: uppercase; margin: 0.6em 0 0 0.3em; padding: 2px 12px; }

/* ---------- menu ---------- */
#scr-menu { flex-direction: column; justify-content: space-between; background: linear-gradient(90deg, rgba(11,11,14,0.75), transparent 45%); }
.menu-bottom { display: flex; align-items: flex-end; justify-content: space-between; gap: 14px; flex-wrap: wrap; }
.racer-card { padding: 12px 18px 16px; min-width: 260px; max-width: 360px; flex: 1 1 260px; display: grid; grid-template-columns: 74px 1fr; gap: 12px; align-items: center; }
.rc-port { width: 74px; height: 74px; clip-path: polygon(10px 0, 100% 0, calc(100% - 10px) 100%, 0 100%); background: var(--steel) center/cover no-repeat; }
.rc-name { font-family: var(--font-display); font-size: 30px; line-height: 1; }
.rc-kind { font-family: var(--font-cond); font-size: 15px; color: var(--haz); letter-spacing: 0.12em; text-transform: uppercase; margin-top: 2px; }
.rc-line { grid-column: 1 / -1; font-size: 13px; font-weight: 500; opacity: 0.85; }
.rc-count { font-family: var(--font-cond); font-size: 14px; opacity: 0.6; }
.menu-actions { display: flex; flex-direction: column; align-items: flex-end; gap: 12px; }
.menu-actions .row { display: flex; gap: 10px; }
.hint-line { font-size: 13px; opacity: 0.85; text-align: right; max-width: 380px; font-weight: 500; }

/* ---------- character select ---------- */
#scr-select { flex-direction: column; gap: 10px; background: linear-gradient(90deg, rgba(11,11,14,0.92) 0%, rgba(11,11,14,0.6) 52%, transparent 75%); }
.sel-wrap { flex: 1; min-height: 0; display: grid; grid-template-columns: minmax(260px, 44%) minmax(250px, 380px); gap: 18px; align-items: stretch; }
.sel-card { position: relative; overflow: hidden; clip-path: polygon(6% 0, 100% 0, 94% 100%, 0 100%); background: var(--coal); min-height: 0; }
.sel-bg { position: absolute; inset: -6%; background: radial-gradient(circle at 60% 40%, var(--accent, var(--haz)) 0 20%, transparent 21%), repeating-linear-gradient(-55deg, rgba(255,255,255,0.05) 0 14px, transparent 14px 28px), radial-gradient(circle at 20% 80%, rgba(255,255,255,0.08), transparent 50%); transition: transform 0.4s; }
.sel-dots { position: absolute; inset: 0; background-image: radial-gradient(rgba(0,0,0,0.55) 1.2px, transparent 1.6px); background-size: 7px 7px; mix-blend-mode: multiply; opacity: 0.6; }
.sel-port { position: absolute; inset: 0; background: center 18%/cover no-repeat; animation: breathe 3.2s ease-in-out infinite; transform-origin: 50% 90%; }
.sel-port.pick { animation: pickPop 0.5s cubic-bezier(.2,1.6,.4,1) both; }
@keyframes breathe { 0%, 100% { transform: scale(1) translateY(0); } 50% { transform: scale(1.015) translateY(-0.6%); } }
@keyframes pickPop { 0% { transform: scale(1.18) rotate(-2deg); filter: brightness(2); } 100% { transform: scale(1) rotate(0); filter: none; } }
.sel-fg { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(0deg, rgba(11,11,14,0.95) 0%, transparent 30%); }
.sel-num { position: absolute; left: 7%; bottom: 3%; font-family: var(--font-display); font-size: clamp(60px, 14vmin, 150px); line-height: 0.8; color: transparent; -webkit-text-stroke: 2px rgba(255,255,255,0.35); }
.sel-tag { position: absolute; right: 9%; top: 5%; font-family: var(--font-cond); font-weight: 900; font-size: 14px; letter-spacing: 0.25em; background: var(--accent, var(--haz)); color: var(--ink); padding: 3px 10px; transform: skewX(-12deg); }
.sel-panel { padding: 16px 20px 18px; display: flex; flex-direction: column; gap: 10px; align-self: center; max-height: 100%; overflow-y: auto; }
.sel-name { font-family: var(--font-display); font-size: clamp(40px, 6vmin + 12px, 74px); line-height: 0.9; transform: skewX(-8deg); }
.sel-nick { font-family: var(--font-cond); font-weight: 900; font-size: clamp(16px, 1.8vmin + 10px, 26px); letter-spacing: 0.35em; color: var(--accent, var(--haz)); text-transform: uppercase; }
.sel-line { font-size: 14px; font-weight: 500; opacity: 0.88; line-height: 1.35; }
.sel-tagline { font-family: var(--font-cond); font-size: 15px; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.7; }
.stats { margin: 4px 0 0; display: grid; gap: 5px; }
.stat { display: grid; grid-template-columns: 84px 1fr; align-items: center; }
.stat dt { font-family: var(--font-cond); font-size: 14px; text-transform: uppercase; letter-spacing: 0.12em; opacity: 0.8; }
.stat dd { margin: 0; display: flex; gap: 3px; }
.stat i { flex: 1; height: 9px; background: rgba(255,255,255,0.12); transform: skewX(-20deg); }
.stat i.on { background: var(--accent, var(--haz)); }
.abil { display: grid; grid-template-columns: 54px 1fr; gap: 12px; align-items: center; background: rgba(255,255,255,0.05); padding: 10px 12px; border-left: 3px solid var(--accent, var(--haz)); }
.abil-ico { width: 54px; height: 54px; display: grid; place-items: center; background: var(--ink); clip-path: polygon(25% 0, 75% 0, 100% 50%, 75% 100%, 25% 100%, 0 50%); color: var(--accent, var(--haz)); }
.abil-ico svg { width: 30px; height: 30px; }
.abil b { font-family: var(--font-cond); font-weight: 900; font-size: 20px; letter-spacing: 0.06em; text-transform: uppercase; display: block; }
.abil span { font-size: 13px; font-weight: 500; opacity: 0.85; }
.sel-nav { display: flex; align-items: center; gap: 10px; }
.sel-nav .btn-big { flex: 1; }
.arrow { width: 54px; height: 54px; border: 0; background: var(--coal); color: var(--paper); display: grid; place-items: center; padding: 0; clip-path: polygon(10px 0, 100% 0, calc(100% - 10px) 100%, 0 100%); }
.arrow svg { width: 24px; height: 24px; }
.arrow:active { transform: translateY(2px); }
.sel-roster { display: flex; gap: 6px; }
.sel-roster button { width: 46px; height: 46px; border: 0; padding: 0; background: var(--steel) center/cover no-repeat; clip-path: polygon(8px 0, 100% 0, calc(100% - 8px) 100%, 0 100%); opacity: 0.55; }
.sel-roster button[aria-pressed="true"] { opacity: 1; outline: 3px solid var(--haz); outline-offset: -3px; }

/* ---------- tracks ---------- */
#scr-tracks, #scr-garage { flex-direction: column; gap: 14px; background: linear-gradient(180deg, rgba(11,11,14,0.4), rgba(11,11,14,0.9)); }
.list { flex: 1; min-height: 0; overflow-y: auto; overflow-x: hidden; display: grid; gap: 14px; align-content: center; touch-action: pan-y; -webkit-overflow-scrolling: touch; padding: 4px 2px 12px; }
.track-list { grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); max-width: 1200px; width: 100%; margin: 0 auto; }
.tc-tags { display: flex; flex-wrap: wrap; gap: 5px; }
.tc-tags span { font-family: var(--font-cond); font-size: 12px; font-weight: 900; text-transform: uppercase; letter-spacing: 0.1em; padding: 1px 8px; background: var(--steel); }
.tc-tags .t-boat { background: var(--cyan); color: var(--ink); } .tc-tags .t-air { background: var(--mag); color: var(--ink); } .tc-tags .t-jump { background: var(--hot); } .tc-tags .t-ice { background: #cfe6ff; color: var(--ink); }
.track-card { text-align: left; padding: 0; overflow: hidden; display: flex; flex-direction: column; transition: transform 0.12s; border: 0; background: rgba(14,14,18,0.92); clip-path: polygon(0 0, 100% 0, 100% calc(100% - 18px), calc(100% - 18px) 100%, 0 100%); border-top: 4px solid var(--haz); }
.track-card:hover { transform: translateY(-3px); }
.track-card:active { transform: translateY(2px); }
.tc-art { height: 96px; position: relative; overflow: hidden; background: var(--ink); }
.tc-map { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
.tc-diff { position: absolute; top: 8px; right: 10px; display: flex; gap: 3px; }
.tc-diff i { width: 14px; height: 8px; background: rgba(255,255,255,0.25); transform: skewX(-20deg); }
.tc-diff i.on { background: var(--hot); }
.tc-body { padding: 10px 14px 16px; display: grid; gap: 6px; color: var(--paper); }
.tc-name { font-family: var(--font-display); font-size: 24px; line-height: 1; }
.tc-mood { font-family: var(--font-cond); font-size: 13px; font-weight: 800; color: var(--haz); letter-spacing: 0.2em; text-transform: uppercase; }
.tc-blurb { font-size: 13px; font-weight: 500; opacity: 0.8; }
.tc-meta { display: flex; gap: 12px; font-family: var(--font-cond); font-size: 14px; font-variant-numeric: tabular-nums; opacity: 0.85; }
.tc-best { font-family: var(--font-cond); font-size: 15px; font-variant-numeric: tabular-nums; }
.medal { display: inline-grid; place-items: center; width: 24px; height: 20px; font-family: var(--font-display); font-size: 12px; vertical-align: -4px; margin-right: 6px; transform: skewX(-12deg); color: var(--ink); }
.m1 { background: var(--haz); } .m2 { background: #d9dee6; } .m3 { background: #e39a5a; } .m0 { background: var(--steel); color: var(--paper); }

/* ---------- garage ---------- */
.up-row { padding: 12px 14px; display: grid; grid-template-columns: 1fr auto; gap: 8px 14px; align-items: center; background: rgba(255,255,255,0.04); }
.up-name { font-family: var(--font-cond); font-weight: 900; font-size: 22px; text-transform: uppercase; letter-spacing: 0.06em; }
.up-desc { font-size: 13px; font-weight: 500; opacity: 0.8; grid-column: 1; }
.up-pips { display: flex; gap: 4px; grid-column: 1; }
.up-pips i { width: 26px; height: 9px; background: rgba(255,255,255,0.12); transform: skewX(-20deg); }
.up-pips i.on { background: var(--tox); }
.up-row .btn { grid-column: 2; grid-row: 1 / span 3; display: inline-flex; align-items: center; gap: 8px; font-size: 18px; }

/* ---------- HUD ---------- */
#hud { position: absolute; inset: 0; pointer-events: none; padding: var(--safe-t) var(--safe-r) var(--safe-b) var(--safe-l); }
.hud-top { display: grid; grid-template-columns: auto 1fr auto; align-items: start; gap: 14px; }
.hud-place { font-family: var(--font-display); line-height: 0.82; color: var(--paper); transform: skewX(-12deg) rotate(-4deg); transform-origin: left top; display: flex; align-items: flex-start; }
.hud-place b { font-weight: 400; font-size: clamp(64px, 12vmin + 18px, 132px); display: inline-block; text-shadow: 5px 5px 0 var(--hot), 9px 9px 0 rgba(0,0,0,0.55); }
.hud-place sup { font-family: var(--font-cond); font-weight: 900; font-size: clamp(18px, 2.4vmin + 8px, 32px); margin: 0.4em 0 0 4px; background: var(--haz); color: var(--ink); padding: 0 6px; }
.hud-place small { font-family: var(--font-cond); font-weight: 800; font-size: clamp(14px, 1.8vmin + 6px, 22px); opacity: 0.85; margin: 0.4em 0 0 6px; }
.hud-place.first b { color: var(--haz); text-shadow: 5px 5px 0 var(--hot), 9px 9px 0 rgba(0,0,0,0.55); }
.hud-place.pulse b { animation: slam 0.4s cubic-bezier(.2,1.8,.4,1); }
@keyframes slam { 0% { transform: scale(1.6) translateY(-10px); } 100% { transform: scale(1); } }
.hud-time { font-family: var(--font-cond); font-weight: 800; font-size: clamp(16px, 1.6vmin + 10px, 24px); font-variant-numeric: tabular-nums; margin-top: 10px; background: var(--shade); padding: 2px 16px 2px 10px; clip-path: var(--slant-l); display: inline-block; }
.hud-progress { padding-top: 12px; display: flex; justify-content: center; }
.bar { position: relative; width: min(46vw, 460px); height: 12px; background: rgba(11,11,14,0.8); transform: skewX(-25deg); border-bottom: 2px solid var(--haz); }
.bar .flag { position: absolute; right: -6px; top: -10px; width: 18px; height: 30px; background: conic-gradient(var(--ink) 0 25%, #fff 0 50%, var(--ink) 0 75%, #fff 0) 0 0 / 9px 9px; }
.mk { position: absolute; top: 50%; width: 10px; height: 18px; margin: -9px 0 0 -5px; border: 2px solid var(--ink); }
.mk.me { width: 16px; height: 26px; margin: -13px 0 0 -8px; box-shadow: 0 0 0 2px #fff; z-index: 2; }
.hud-right { display: flex; flex-direction: column; align-items: flex-end; gap: 8px; pointer-events: auto; justify-self: end; }
.hud-right .row { display: flex; gap: 8px; align-items: center; }
#minimap { width: clamp(110px, 17vmin + 40px, 190px); height: clamp(110px, 17vmin + 40px, 190px); pointer-events: none; }
.hud-bottom { position: absolute; left: 50%; bottom: calc(var(--safe-b) + 6px); transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: 6px; }
.hud-speed { font-family: var(--font-display); font-size: clamp(30px, 4vmin + 14px, 54px); font-variant-numeric: tabular-nums; line-height: 1; transform: skewX(-10deg); text-shadow: 3px 3px 0 rgba(0,0,0,0.6); }
.hud-speed small { font-family: var(--font-cond); font-size: 0.36em; margin-left: 4px; letter-spacing: 0.15em; color: var(--haz); }
/* ability button: portrait inside a hex with a radial charge meter */
.item-btn {
  position: absolute; right: var(--safe-r); bottom: calc(var(--safe-b) + 34px); width: 112px; height: 112px; border: 0; padding: 0; background: none;
  pointer-events: auto; display: grid; place-items: center;
}
.ab-ring { position: absolute; inset: 0; clip-path: polygon(25% 0, 75% 0, 100% 50%, 75% 100%, 25% 100%, 0 50%); background: conic-gradient(var(--accent, var(--haz)) calc(var(--ch, 0) * 1turn), rgba(255,255,255,0.12) 0); }
.ab-in { position: absolute; inset: 7px; clip-path: polygon(25% 0, 75% 0, 100% 50%, 75% 100%, 25% 100%, 0 50%); background: var(--coal) center 22%/cover no-repeat; filter: grayscale(0.7) brightness(0.6); transition: filter 0.2s; }
.item-btn.ready .ab-in { filter: none; }
.item-btn.ready { animation: readyPulse 0.8s ease-in-out infinite; }
.item-btn.active .ab-ring { background: var(--paper); animation: activeFlash 0.18s steps(2) infinite; }
@keyframes readyPulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.07); } }
@keyframes activeFlash { 50% { background: var(--accent, var(--haz)); } }
.ab-lbl { position: absolute; bottom: -24px; left: 50%; transform: translateX(-50%) skewX(-10deg); font-family: var(--font-cond); font-weight: 900; font-size: 14px; letter-spacing: 0.12em; white-space: nowrap; background: var(--ink); padding: 1px 10px; }
.item-btn.ready .ab-lbl { background: var(--accent, var(--haz)); color: var(--ink); }
.ab-ready { position: absolute; top: -18px; font-family: var(--font-display); font-size: 22px; color: var(--accent, var(--haz)); opacity: 0; transform: skewX(-12deg); text-shadow: 2px 2px 0 var(--ink); }
.item-btn.ready .ab-ready { opacity: 1; animation: blink 0.5s steps(2) infinite; }
body.touch .item-btn { top: 50%; bottom: auto; transform: translateY(-50%); }
body.touch .item-btn.ready { animation: none; }
.steer-hint { position: absolute; bottom: calc(var(--safe-b) + 8px); width: 64px; height: 64px; background: rgba(11,11,14,0.45); display: grid; place-items: center; color: rgba(239,236,228,0.8); clip-path: polygon(10px 0, 100% 0, calc(100% - 10px) 100%, 0 100%); }
.steer-hint svg { width: 28px; height: 28px; }
.steer-hint.l { left: var(--safe-l); }
.steer-hint.r { right: var(--safe-r); }
.steer-hint.on { background: var(--haz); color: var(--ink); }
#rival-warn { position: absolute; left: 50%; top: calc(var(--safe-t) + 46px); transform: translateX(-50%); display: flex; align-items: center; gap: 10px; background: var(--hot); color: var(--paper); padding: 4px 20px 4px 4px; clip-path: var(--slant); font-family: var(--font-cond); font-weight: 900; font-size: 17px; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0; transition: opacity 0.15s; }
#rival-warn.on { opacity: 1; animation: warnIn 0.3s ease-out; }
#rival-warn i { width: 40px; height: 40px; background: var(--ink) center 20%/cover no-repeat; clip-path: polygon(6px 0, 100% 0, calc(100% - 6px) 100%, 0 100%); }
@keyframes warnIn { 0% { transform: translateX(-50%) scale(1.3); } 100% { transform: translateX(-50%) scale(1); } }
@keyframes blink { 50% { opacity: 0.35; } }
#pops { position: absolute; left: var(--safe-l); top: 42%; display: flex; flex-direction: column; gap: 6px; }
.pop { display: flex; align-items: center; gap: 8px; animation: popIn 2.2s ease-out forwards; }
.pop i { width: 58px; height: 58px; background: var(--coal) center 20%/cover no-repeat; clip-path: polygon(8px 0, 100% 0, calc(100% - 8px) 100%, 0 100%); border-bottom: 3px solid var(--accent, var(--haz)); }
.pop span { font-family: var(--font-cond); font-weight: 900; font-size: 14px; letter-spacing: 0.1em; background: var(--ink); padding: 2px 8px; }
@keyframes popIn { 0% { transform: translateX(-80px); opacity: 0; } 10% { transform: none; opacity: 1; } 80% { opacity: 1; } 100% { opacity: 0; transform: translateX(-20px); } }
#boost-vignette { position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity 0.25s; background: radial-gradient(ellipse at center, transparent 55%, rgba(255,120,20,0.32) 100%); }
#glide-hud { position: absolute; left: calc(var(--safe-l) + 4px); top: 34%; width: 14px; height: 160px; background: rgba(11,11,14,0.6); display: none; }
#glide-hud.on { display: block; }
#glide-hud b { position: absolute; left: -4px; right: -4px; height: 6px; background: var(--mag); top: 50%; }
#glide-hud span { position: absolute; left: 20px; top: -4px; font-family: var(--font-cond); font-weight: 900; font-size: 13px; letter-spacing: 0.15em; white-space: nowrap; }

/* ---------- messages ---------- */
#center-msg { position: absolute; left: 0; right: 0; top: 26%; text-align: center; pointer-events: none; font-family: var(--font-display); }
#center-msg .m { display: inline-block; font-size: clamp(64px, 18vmin, 200px); color: var(--paper); line-height: 1; transform: skewX(-10deg); text-shadow: 6px 6px 0 var(--hot), 12px 12px 0 rgba(0,0,0,0.5); animation: impact 0.9s cubic-bezier(.15,1.6,.4,1) forwards; }
#center-msg .m.count { color: var(--paper); }
#center-msg .m.go { color: var(--haz); font-size: clamp(80px, 22vmin, 240px); }
#center-msg .m.small { font-size: clamp(32px, 7vmin, 80px); color: var(--haz); }
#center-msg .m.bad { color: var(--hot); text-shadow: 5px 5px 0 var(--ink); }
#center-msg .sub { display: block; font-family: var(--font-cond); font-weight: 800; font-size: clamp(16px, 2vmin + 8px, 26px); color: var(--paper); letter-spacing: 0.2em; margin-top: 10px; text-shadow: 0 2px 0 var(--ink); }
@keyframes impact { 0% { transform: skewX(-10deg) scale(2.6); opacity: 0; } 12% { transform: skewX(-10deg) scale(0.92); opacity: 1; } 22% { transform: skewX(-10deg) scale(1.04); } 75% { opacity: 1; } 100% { transform: skewX(-10deg) scale(1); opacity: 0; } }
#toast { position: absolute; left: 50%; top: calc(var(--safe-t) + 92px); transform: translateX(-50%); pointer-events: none; display: flex; flex-direction: column; align-items: center; gap: 5px; }
#toast .t { background: var(--coal); color: var(--paper); padding: 4px 22px; clip-path: var(--slant); font-family: var(--font-cond); font-weight: 900; font-size: 17px; letter-spacing: 0.12em; text-transform: uppercase; white-space: nowrap; animation: toast 2.2s ease-out forwards; }
#toast .t.bad { background: var(--hot); }
#toast .t.good { background: var(--haz); color: var(--ink); }
@keyframes toast { 0% { transform: translateX(-40px) skewX(-10deg); opacity: 0; } 10% { transform: skewX(-10deg); opacity: 1; } 80% { opacity: 1; } 100% { opacity: 0; } }
#count-hint { position: absolute; left: 50%; bottom: calc(var(--safe-b) + 22%); transform: translateX(-50%); text-align: center; pointer-events: none; font-size: 14px; width: min(92vw, 560px); display: grid; gap: 6px; }
#count-hint .k { display: inline-block; background: var(--shade); padding: 5px 14px; font-weight: 500; }
#track-intro { position: absolute; left: 0; top: 36%; pointer-events: none; opacity: 0; }
#track-intro.on { animation: introCard 3.2s ease-out forwards; }
#track-intro .ti-name { font-family: var(--font-display); font-size: clamp(44px, 9vmin, 110px); line-height: 0.9; background: var(--ink); padding: 8px 40px 8px var(--safe-l); clip-path: polygon(0 0, 100% 0, calc(100% - 30px) 100%, 0 100%); }
#track-intro .ti-mood { display: inline-block; font-family: var(--font-cond); font-weight: 900; letter-spacing: 0.4em; font-size: clamp(14px, 2vmin + 8px, 22px); background: var(--haz); color: var(--ink); padding: 3px 20px 3px var(--safe-l); margin-top: 6px; }
@keyframes introCard { 0% { transform: translateX(-100%); opacity: 1; } 12% { transform: none; } 80% { transform: translateX(2%); opacity: 1; } 100% { transform: translateX(-30%); opacity: 0; } }

/* ---------- modal screens ---------- */
.modal { align-items: center; justify-content: center; background: rgba(11,11,14,0.6); }
.modal .panel { padding: 20px 24px 26px; width: min(460px, 100%); max-height: 100%; overflow-y: auto; display: grid; gap: 12px; touch-action: pan-y; }
.modal h2 { font-family: var(--font-display); font-weight: 400; margin: 0; font-size: 38px; transform: skewX(-8deg); }
.modal .btn { width: 100%; }
.toggles { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.toggle { border: 0; background: var(--steel); color: var(--paper); padding: 10px; font-family: var(--font-cond); font-weight: 900; letter-spacing: 0.1em; text-transform: uppercase; clip-path: var(--slant); }
.toggle[aria-pressed="false"] { opacity: 0.45; text-decoration: line-through; }
.results { justify-content: flex-end; background: linear-gradient(90deg, transparent 30%, rgba(11,11,14,0.85) 62%); }
.results .panel { width: min(540px, 100%); margin-right: 2vw; }
.res-head { text-align: left; }
.res-place { font-family: var(--font-display); font-size: clamp(64px, 14vmin, 120px); line-height: 0.85; color: var(--haz); transform: skewX(-10deg); text-shadow: 5px 5px 0 var(--hot); }
.res-sub { font-family: var(--font-cond); font-weight: 800; font-size: 17px; letter-spacing: 0.08em; margin-top: 8px; font-variant-numeric: tabular-nums; text-transform: uppercase; }
.standings { list-style: none; margin: 0; padding: 0; display: grid; gap: 3px; }
.standings li { display: grid; grid-template-columns: 40px 36px 1fr auto; gap: 10px; align-items: center; padding: 3px 12px 3px 6px; background: rgba(255,255,255,0.04); font-variant-numeric: tabular-nums; }
.standings li.me { background: var(--haz); color: var(--ink); }
.standings .p { font-family: var(--font-display); font-size: 17px; }
.standings .pf { width: 36px; height: 36px; background: var(--steel) center 20%/cover no-repeat; clip-path: polygon(6px 0, 100% 0, calc(100% - 6px) 100%, 0 100%); }
.standings .nm { font-family: var(--font-cond); font-weight: 800; font-size: 16px; text-transform: uppercase; letter-spacing: 0.06em; }
.standings .nm small { font-weight: 600; opacity: 0.7; margin-left: 6px; }
.standings .tm { font-family: var(--font-cond); font-size: 15px; }
.earn { display: block; font-size: 14px; background: rgba(255,255,255,0.06); padding: 8px 12px; font-variant-numeric: tabular-nums; }
.earn b { font-family: var(--font-cond); font-weight: 900; font-size: 18px; }
.earn .coin-ico { vertical-align: -2px; margin-right: 8px; }
.res-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.res-actions .btn-big { grid-column: 1 / -1; }

/* ---------- loading & fatal ---------- */
#scr-loading { align-items: center; justify-content: center; flex-direction: column; gap: 18px; background: radial-gradient(circle at 50% 40%, #1c1d24, var(--ink) 70%); }
.wheel { width: 220px; height: 14px; background: repeating-linear-gradient(-45deg, var(--haz) 0 12px, var(--ink) 12px 24px); background-size: 34px 14px; animation: haz 0.6s linear infinite; transform: skewX(-20deg); }
@keyframes haz { to { background-position: 34px 0; } }
#loading-text { font-family: var(--font-cond); font-weight: 900; letter-spacing: 0.3em; font-size: 18px; margin: 0; text-align: center; }
#fatal { position: absolute; inset: 0; display: grid; place-items: center; background: rgba(11,11,14,0.94); padding: 20px; z-index: 50; }
#fatal .panel { padding: 22px; max-width: 420px; display: grid; gap: 12px; text-align: center; }
#fatal h2 { margin: 0; font-family: var(--font-display); font-weight: 400; }
#fatal p { margin: 0; font-weight: 500; }

/* ---------- garage editor ---------- */
#scr-garage { flex-direction: column; gap: 10px; background: none; pointer-events: none; }
#scr-garage > * { pointer-events: auto; }
#scr-garage .topbar { pointer-events: none; }
#scr-garage .topbar > * { pointer-events: auto; }
.gar-title { background: rgba(11,11,14,0.82); padding: 4px 16px 6px; clip-path: polygon(10px 0, 100% 0, calc(100% - 10px) 100%, 0 100%); }
.gar-title small { display: block; font-family: var(--font-cond); font-size: 15px; font-weight: 800; letter-spacing: 0.2em; text-transform: uppercase; color: var(--haz); transform: none; text-shadow: none; }
.gar-panel {
  position: absolute; top: calc(var(--safe-t) + 74px); right: var(--safe-r); bottom: var(--safe-b); width: min(440px, 46vw);
  display: flex; flex-direction: column; overflow: hidden; padding: 0;
}
.gar-stats { padding: 12px 14px 8px; display: grid; gap: 5px; background: rgba(255,255,255,0.04); }
.sbar { display: grid; grid-template-columns: 78px 1fr 26px; align-items: center; gap: 8px; font-family: var(--font-cond); font-size: 14px; text-transform: uppercase; letter-spacing: 0.1em; }
.sbar .trk { position: relative; height: 9px; background: rgba(255,255,255,0.1); overflow: hidden; transform: skewX(-20deg); }
.sbar .fill { position: absolute; inset: 0 auto 0 0; background: var(--haz); transition: width 0.18s; }
.sbar .delta { position: absolute; top: 0; bottom: 0; transition: left 0.18s, width 0.18s; }
.sbar .delta.up { background: repeating-linear-gradient(45deg, var(--tox) 0 4px, #b8ff8e 4px 8px); }
.sbar .delta.down { background: repeating-linear-gradient(45deg, var(--hot) 0 4px, #ff8a92 4px 8px); }
.sbar b { font-family: var(--font-cond); font-weight: 900; font-size: 16px; text-align: right; font-variant-numeric: tabular-nums; }
.tabs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; padding: 0 2px; }
.tab { border: 0; background: var(--steel); color: var(--paper); padding: 9px 6px; font-family: var(--font-cond); font-weight: 900; font-size: 17px; letter-spacing: 0.12em; text-transform: uppercase; }
.tab[aria-selected="true"] { background: var(--haz); color: var(--ink); }
.gar-body { flex: 1; min-height: 0; overflow-y: auto; padding: 10px 14px 18px; display: grid; gap: 14px; align-content: start; touch-action: pan-y; -webkit-overflow-scrolling: touch; }
.gsec h3 { margin: 0 0 7px; font-family: var(--font-cond); font-weight: 900; font-size: 17px; letter-spacing: 0.12em; text-transform: uppercase; display: flex; justify-content: space-between; align-items: baseline; }
.gsec h3 small { font-family: var(--font-body); font-size: 12px; font-weight: 700; opacity: 0.7; text-transform: none; letter-spacing: 0; }
.opts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px; }
.opt { text-align: left; border: 0; background: rgba(255,255,255,0.06); color: var(--paper); padding: 7px 10px; display: grid; gap: 1px; border-left: 3px solid transparent; }
.opt:active { transform: translateY(1px); }
.opt .on { font-family: var(--font-cond); font-weight: 900; font-size: 16px; text-transform: uppercase; letter-spacing: 0.05em; }
.opt .os { font-size: 11px; font-weight: 700; opacity: 0.75; display: flex; align-items: center; gap: 5px; }
.opt .os .coin-ico { width: 10px; height: 10px; }
.opt[aria-pressed="true"] { border-left-color: var(--haz); background: rgba(255,194,26,0.14); }
.opt.trying { border-left-color: var(--cyan); background: rgba(41,227,255,0.14); }
.opt.locked .on::after { content: " ·LOCKED"; font-size: 10px; opacity: 0.7; letter-spacing: 0.1em; }
.sw-grid { display: grid; grid-template-columns: repeat(9, 1fr); gap: 5px; }
.sw { aspect-ratio: 1; border: 0; padding: 0; clip-path: polygon(20% 0, 100% 0, 80% 100%, 0 100%); }
.sw[aria-pressed="true"] { outline: 3px solid var(--paper); outline-offset: -3px; transform: scale(1.1); }
.chips { display: flex; flex-wrap: wrap; gap: 6px; }
.chipbtn { border: 0; background: var(--steel); color: var(--paper); padding: 5px 14px; font-family: var(--font-cond); font-weight: 800; font-size: 14px; letter-spacing: 0.08em; text-transform: uppercase; clip-path: var(--slant); }
.chipbtn[aria-pressed="true"] { background: var(--haz); color: var(--ink); }
.chipbtn i { display: inline-block; width: 12px; height: 12px; margin-right: 6px; vertical-align: -2px; }
.stepper { display: flex; align-items: center; gap: 10px; }
.stepper button { width: 40px; height: 40px; border: 0; background: var(--steel); color: var(--paper); font-family: var(--font-cond); font-weight: 900; font-size: 22px; padding: 0; clip-path: var(--slant); }
.stepper output { font-family: var(--font-display); font-size: 28px; min-width: 50px; text-align: center; }
.buybar { background: rgba(41,227,255,0.12); padding: 10px 14px; display: flex; align-items: center; gap: 10px; border-top: 2px solid var(--cyan); }
.buybar .bb-t { flex: 1; font-size: 13px; line-height: 1.25; font-weight: 500; }
.buybar .bb-t b { font-family: var(--font-cond); font-weight: 900; display: block; font-size: 17px; text-transform: uppercase; }
.buybar .btn { display: inline-flex; align-items: center; gap: 6px; font-size: 17px; padding: 0.45em 1.1em; }

/* ---------- settings ---------- */
.set-row { display: grid; gap: 6px; }
.set-row > span { font-family: var(--font-cond); font-size: 14px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.14em; opacity: 0.75; }
.seg { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 2px; }
.seg button { border: 0; background: var(--steel); color: var(--paper); padding: 9px 4px; font-family: var(--font-cond); font-weight: 900; font-size: 15px; letter-spacing: 0.08em; text-transform: uppercase; }
.seg button[aria-pressed="true"] { background: var(--haz); color: var(--ink); }
.set-note { font-size: 12px; font-weight: 500; opacity: 0.7; margin: -2px 0 0; }

/* ---------- HUD extras ---------- */
#drift-meter { display: flex; gap: 4px; opacity: 0; transition: opacity 0.15s; }
#drift-meter.on { opacity: 1; }
#drift-meter i { width: 46px; height: 10px; background: rgba(239,236,228,0.25); transform: skewX(-25deg); }
#drift-meter i.l1 { background: var(--cyan); } #drift-meter i.l2 { background: #ff8c1a; } #drift-meter i.l3 { background: #b98cff; box-shadow: 0 0 12px #b98cff; }
#draft-chip { font-family: var(--font-cond); font-weight: 900; font-size: 14px; letter-spacing: 0.2em; color: var(--ink); background: var(--cyan); padding: 2px 14px; clip-path: var(--slant); display: flex; align-items: center; gap: 8px; opacity: 0; transition: opacity 0.2s; }
#draft-chip.on { opacity: 1; }
#draft-chip .df { width: 54px; height: 6px; overflow: hidden; background: rgba(0,0,0,0.3); }
#draft-chip .df b { display: block; height: 100%; width: 0; background: var(--ink); }
.drift-btn { position: absolute; right: calc(var(--safe-r) + 10px); width: 78px; height: 78px; border: 0; background: var(--cyan); color: var(--ink); font-family: var(--font-cond); font-weight: 900; letter-spacing: 0.12em; font-size: 15px; pointer-events: auto; padding: 0; top: calc(50% - 160px); clip-path: polygon(25% 0, 75% 0, 100% 50%, 75% 100%, 25% 100%, 0 50%); }
.drift-btn.on { background: var(--haz); transform: scale(0.94); }

/* ---------- compact & portrait layouts ---------- */
@media (max-height: 520px) {
  .gar-panel { top: calc(var(--safe-t) + 60px); width: min(400px, 50vw); }
  .gar-stats { padding: 6px 12px 5px; gap: 2px; }
  .tab { padding: 6px; font-size: 14px; }
  .racer-card { padding: 8px 12px 10px; min-width: 230px; }
  .rc-name { font-size: 24px; }
  .hint-line { display: none; }
  .tc-art { height: 56px; }
  .tc-blurb { display: none; }
  .track-list { grid-template-columns: repeat(5, 1fr); gap: 8px; }
  .tc-meta { display: none; }
  .item-btn { width: 92px; height: 92px; }
  .modal .panel { padding: 14px 16px; gap: 8px; }
  .res-place { font-size: 56px; }
  .logo .tag { display: none; }
  .sel-line { display: none; }
  .abil { padding: 6px 10px; }
  .sel-panel { gap: 6px; padding: 10px 14px 12px; }
  .hud-place b { font-size: 64px; }
  #minimap { width: 104px; height: 104px; }
}
@media (max-aspect-ratio: 4/5) {
  .gar-panel { top: auto; left: var(--safe-l); right: var(--safe-r); width: auto; height: min(56%, 470px); }
  .drift-btn { top: auto; bottom: calc(var(--safe-b) + 150px); right: calc(var(--safe-r) + 4px); }
  .menu-bottom { flex-direction: column; align-items: stretch; }
  .racer-card { max-width: none; flex: none; }
  .menu-actions { align-items: stretch; }
  .menu-actions .row { justify-content: stretch; }
  .menu-actions .row .btn { flex: 1; }
  .hint-line { text-align: center; max-width: none; }
  .hud-top { grid-template-columns: auto auto; }
  .hud-progress { grid-column: 1 / -1; grid-row: 2; padding-top: 2px; }
  .bar { width: min(78vw, 440px); }
  body.touch .item-btn { top: auto; bottom: calc(var(--safe-b) + 30px); left: 50%; right: auto; transform: translateX(-50%); }
  #toast { top: calc(var(--safe-t) + 132px); }
  /* minimap moves bottom-left on portrait */
  #minimap { position: absolute; left: var(--safe-l); bottom: calc(var(--safe-b) + 84px); width: 118px; height: 118px; }
  .sel-wrap { grid-template-columns: 1fr; grid-template-rows: 46% auto; gap: 8px; }
  .sel-card { clip-path: polygon(0 0, 100% 0, 100% 92%, 0 100%); }
  .sel-panel { align-self: stretch; }
  .sel-name { font-size: 44px; }
  #scr-select .screen-title { display: none; }
  #scr-select .topbar { justify-content: space-between; }
  .sel-roster { gap: 5px; }
  .sel-roster button { width: 40px; height: 40px; }
  .results { justify-content: center; align-items: flex-end; background: linear-gradient(180deg, transparent 25%, rgba(11,11,14,0.9) 50%); }
  .results .panel { margin: 0; }
  .hud-bottom { bottom: calc(var(--safe-b) + 150px); }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition: none !important; }
  #center-msg .m { animation: fadeonly 0.9s forwards !important; animation-duration: 0.9s !important; }
  @keyframes fadeonly { 0%, 75% { opacity: 1; } 100% { opacity: 0; } }
}

/* ---------- v4 story mode ---------- */
.menu-actions .row-top { margin-bottom: 8px; }
.btn-story { width: 100%; background: var(--hot); color: var(--paper); }
#scr-story, #scr-codex { flex-direction: column; background: linear-gradient(180deg, rgba(11,11,14,0.55), rgba(11,11,14,0.88)); }
.story-wrap { flex: 1; display: grid; grid-template-columns: minmax(210px, 300px) 1fr; gap: 14px; padding: 10px 14px 6px; min-height: 0; }
.story-worlds { display: flex; flex-direction: column; gap: 6px; overflow-y: auto; }
.sw-card { display: grid; grid-template-columns: 34px 1fr auto; align-items: center; gap: 8px; text-align: left; padding: 9px 12px; border: 0; background: rgba(23,22,27,0.92); color: var(--paper); font: 800 15px var(--font-cond); letter-spacing: 0.06em; text-transform: uppercase; clip-path: var(--slant); border-left: 4px solid var(--wc); cursor: pointer; }
.sw-card .sw-n { font: 400 24px var(--font-display); color: var(--wc); }
.sw-card .sw-prog { font-size: 13px; opacity: 0.75; }
.sw-card.sel { background: var(--wc); color: var(--ink); }
.sw-card.sel .sw-n { color: var(--ink); }
.sw-card.locked { opacity: 0.45; }
.story-panel { padding: 16px 20px; overflow-y: auto; border-left-color: var(--wc); }
.sp-kicker { font: 800 13px var(--font-cond); letter-spacing: 0.3em; color: var(--wc); }
.sp-title { margin: 2px 0 6px; font: 400 clamp(26px, 4vmin + 8px, 44px) var(--font-display); transform: skewX(-8deg); }
.sp-blurb { margin: 0 0 12px; opacity: 0.85; max-width: 60ch; }
.sp-nodes { display: flex; flex-direction: column; gap: 6px; }
.sp-node { display: grid; grid-template-columns: minmax(110px, 160px) minmax(120px, 1fr) 2fr 34px; gap: 10px; align-items: center; text-align: left; padding: 10px 12px; border: 0; color: var(--paper); background: rgba(43,45,51,0.75); clip-path: var(--slant); font: 600 14px var(--font-cond); cursor: pointer; }
.sp-node:hover:not(.locked), .sp-node:focus-visible { background: var(--wc); color: var(--ink); }
.sp-node .spn-kind { font-weight: 800; letter-spacing: 0.08em; color: var(--wc); }
.sp-node:hover:not(.locked) .spn-kind { color: var(--ink); }
.sp-node .spn-track { font-weight: 800; }
.sp-node .spn-goal { opacity: 0.85; font-size: 13px; }
.sp-node .spn-state { font-size: 18px; text-align: center; }
.sp-node.done { box-shadow: inset 4px 0 0 var(--tox); }
.sp-node.locked { opacity: 0.4; cursor: default; }
.radio-ticker { overflow: hidden; white-space: nowrap; background: var(--ink); border-top: 2px solid var(--cyan); padding: 7px 0; font: 700 14px var(--font-cond); color: var(--cyan); }
.radio-ticker > div { display: inline-block; padding-left: 100%; animation: ticker 70s linear infinite; }
@keyframes ticker { to { transform: translateX(-100%); } }
