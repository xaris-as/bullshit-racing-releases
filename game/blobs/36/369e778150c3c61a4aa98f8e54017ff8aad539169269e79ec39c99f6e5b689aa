function lavaRockGeo() {
  const g = new THREE.IcosahedronGeometry(1.6, 1).toNonIndexed();
  const pos = g.attributes.position;
  const rng = mulberry32(77);
  const jit = new Map();
  for (let i = 0; i < pos.count; i++) {
    const key = pos.getX(i).toFixed(3) + ',' + pos.getY(i).toFixed(3) + ',' + pos.getZ(i).toFixed(3);
    if (!jit.has(key)) jit.set(key, 0.75 + rng() * 0.45);
    const k = jit.get(key);
    pos.setXYZ(i, pos.getX(i) * k, Math.max(-0.3, pos.getY(i) * k * 0.8), pos.getZ(i) * k);
  }
  g.computeVertexNormals();
  const n = pos.count;
  const col = new Float32Array(n * 3);
  const mc = new Float32Array(n);
  for (let t = 0; t < n; t += 3) {
    const glow = rng() < 0.18;
    _col.set(glow ? 0xff6a1a : rng() < 0.5 ? 0x2a2224 : 0x3a2e2a);
    for (let k = 0; k < 3; k++) {
      col[(t + k) * 3] = _col.r;
      col[(t + k) * 3 + 1] = _col.g;
      col[(t + k) * 3 + 2] = _col.b;
      mc[t + k] = glow ? C_GLOW : C_MATTE;
    }
  }
  g.setAttribute('color', new THREE.BufferAttribute(col, 3));
  g.setAttribute('mclass', new THREE.BufferAttribute(mc, 1));
  g.deleteAttribute('uv');
  g.computeBoundingSphere();
  return g;
}
function chimneyGeo() {
  const P = [];
  P.push(xpart(GEO.cyl, 0x5a4a44, C_PAINT, 0, 12, 0, 0, 0, 0, 1.6, 24, 1.6));
  for (const y of [8, 16, 22]) P.push(xpart(GEO.cyl, 0xd01f1f, C_PAINT, 0, y, 0, 0, 0, 0, 1.68, 1.2, 1.68));
  P.push(xpart(GEO.cyl, 0xff7a1a, C_GLOW, 0, 24.1, 0, 0, 0, 0, 1.4, 0.3, 1.4));
  P.push(xpart(GEO.box, 0x3a3d45, C_METAL, 0, 1, 0, 0, 0, 0, 4, 2, 4));
  return xmerge(P);
}
function cypressGeo() {
  const P = [];
  P.push(xpart(GEO.cylLo, 0x3a2e22, C_MATTE, 0, 0.8, 0, 0, 0, 0, 1.1, 1.6, 1.1));
  P.push(xpart(GEO.cylLo, 0x4a3a2a, C_MATTE, 0, 6, 0, 0, 0, 0, 0.45, 10, 0.45));
  const rng = mulberry32(5);
  for (let i = 0; i < 5; i++) {
    const a = (i / 5) * TAU + rng();
    const y = 8 + rng() * 4;
    P.push(xpart(GEO.sphereLo, i % 2 ? 0x2e4a24 : 0x3a5a2a, C_MATTE, Math.cos(a) * 1.8, y, Math.sin(a) * 1.8, 0, 0, 0, 2.6, 1.1, 2.6));
    // hanging moss
    for (let m = 0; m < 3; m++) P.push(xpart(GEO.cylLo, 0x8a9a7a, C_MATTE, Math.cos(a) * (2.2 + m * 0.5), y - 1.8, Math.sin(a) * (2.2 + m * 0.5), 0, 0, 0, 0.12, 2.6 + rng() * 1.5, 0.12));
  }
  return xmerge(P);
}
// the golden bull of Bull Mountain (original design: blocky stylised head with swept horns and a nose ring)
function bullStatueGeo() {
  const P = [];
  const gold = 0xe3b23c;
  P.push(xpart(GEO.box, 0x2a2622, C_PAINT, 0, 2, 0, 0, 0, 0, 14, 4, 10));
  P.push(xpart(GEO.box, 0x17161b, C_PAINT, 0, 4.3, 0, 0, 0, 0, 12, 0.6, 8));
  P.push(xpart(GEO.sphere, gold, C_METAL, 0, 11, 0, 0, 0, 0, 5.2, 4.6, 4.4));
  P.push(xpart(GEO.sphere, gold, C_METAL, 0, 9, 3.6, 0.25, 0, 0, 3.6, 2.8, 3.0));
  P.push(xpart(GEO.sphere, 0x8a5a1a, C_METAL, -1.3, 8.6, 6.2, 0, 0, 0, 0.6, 0.45, 0.4));
  P.push(xpart(GEO.sphere, 0x8a5a1a, C_METAL, 1.3, 8.6, 6.2, 0, 0, 0, 0.6, 0.45, 0.4));
  const ring = new THREE.TorusGeometry(1.2, 0.22, 8, 20);
  P.push(xpart(ring, 0xfff0b0, C_METAL, 0, 7.3, 6.2, 0, 0, 0, 1, 1, 1));
  // swept horns: chains of tapering segments
  for (const sx of [-1, 1]) {
    let x = sx * 4.2;
    let y = 13;
    let a = 0.2;
    for (let i = 0; i < 9; i++) {
      const r = 1.1 * (1 - i / 10);
      const nx = x + sx * Math.cos(a) * 1.5;
      const ny = y + Math.sin(a) * 1.5;
      P.push(xpart(GEO.cyl, i > 6 ? 0xfff0c0 : gold, C_METAL, (x + nx) / 2, (y + ny) / 2, 0.5, 0, 0, sx * (Math.PI / 2 - a) * -1, r, 1.7, r));
      x = nx;
      y = ny;
      a += 0.22;
    }
  }
  for (const sx of [-1, 1]) {
    P.push(xpart(GEO.sphere, 0x17161b, C_METAL, sx * 2.2, 12.4, 3.7, 0, 0, 0, 0.7, 0.5, 0.4));
    P.push(xpart(GEO.sphere, 0xff2e3c, C_GLOW, sx * 2.2, 12.4, 3.95, 0, 0, 0, 0.32, 0.26, 0.2));
    P.push(xpart(GEO.sphere, gold, C_METAL, sx * 5.4, 11.6, -0.6, 0, sx * 0.4, 0, 1.4, 0.7, 0.9));
  }
  const g = xmerge(P);
  ring.dispose();
  return g;
}

