// all voice lines (id, speaker, Greek text) for tools/export_lines.mjs -> tools/voice/make_voices.py
function allVoiceLines() {
  const out = [];
  for (const [cid, c] of Object.entries(CUTS)) {
    c.lines.forEach((ln, i) => {
      if (ln[0] !== '@title') out.push({ id: cid + '_' + i, who: ln[0], el: ln[3].el, en: ln[3].en });
    });
  }
  for (const [who, kinds] of Object.entries(BARKS)) {
    for (const [kind, list] of Object.entries(kinds)) list.forEach((t, n) => out.push({ id: 'b_' + who + '_' + kind + '_' + n, who, el: t.el, en: t.en }));
  }
  return out;
}

