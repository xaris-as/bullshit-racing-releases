  const tireR = Math.max(0.2, wGeo.boundingBox.max.y, -wGeo.boundingBox.min.y);
  const wheels = [];
  if (bike) {
    // two narrow wheels on the centre line; the front one rides inside the steering group
    if (steerWheel) steerWheel.updateMatrix();
    for (const key of ['f', 'r']) {
      const p = anchor('wheel_' + key, new THREE.Vector3(0, 0.36, key === 'f' ? -0.76 : 0.72));
      const pivot = new THREE.Group();
      const flip = new THREE.Group();
      const mesh = new THREE.Mesh(wGeo, MAT.kart);
      const rr = key === 'f' ? BR.rf : BR.rr;
      const sc = rr / tireR;
      mesh.scale.set(sc * BR.wf, sc, sc);
      pivot.add(flip);
      flip.add(mesh);
