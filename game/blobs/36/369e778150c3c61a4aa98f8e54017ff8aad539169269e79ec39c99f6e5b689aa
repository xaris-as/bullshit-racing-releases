function frameMenuCam() {
  const app = $('app');
  const W = Math.max(1, app.clientWidth);
  const H = Math.max(1, app.clientHeight);
  let fw = W;
  let fh = H;
  let ox = 0;
  let oy = 0;
  let freeW = W;
  let freeH = H;
  const sel = Game.phase === 'select';
  if (Game.phase === 'garage' || sel) {
    const el2 = document.querySelector(sel ? '.sel-panel' : '.gar-panel');
    const r = el2 ? el2.getBoundingClientRect() : { width: 0, height: 0 };
    if (r.width > 0 && r.height > 0) {
      if (r.top > H * 0.3) {
        const P = Math.max(0, H - r.top + 6);
        fh = H + P;
        oy = P;
        freeH = H - P;
      } else if (sel) {
        const P = Math.max(0, r.right + 6);
        fw = W + P;
        ox = -P * 0;
        freeW = W - P;
        ox = 0;
        menuCam.userData.left = P;
      } else {
        const P = Math.max(0, W - r.left + 6);
        fw = W + P;
        ox = P;
        freeW = W - P;
      }
    }
  }
  const portrait = W / H < 0.9;
  menuCam.fov = portrait ? 44 : 32;
  menuCam.aspect = fw / fh;
  const tf = Math.tan((menuCam.fov * DEG) / 2);
  const dH = 2.3 / (0.9 * tf * (Math.max(80, freeH) / fh));
  const dW = 4.3 / (1.4 * tf * (Math.max(80, freeW) / fh));
  const dist = clamp(Math.max(dH, dW, 7), 7, 30);
  const garage = Game.phase === 'garage';
  menuCam.position.set(0, (garage ? 1.6 : 1.2) + dist * 0.22, dist);
  menuCam.lookAt(0, garage ? 0.7 : portrait ? -0.2 : 0.55, 0);
  if (sel && !portrait && menuCam.userData.left) menuCam.setViewOffset(W + menuCam.userData.left, H, 0, 0, W, H);
  else if (ox || oy) menuCam.setViewOffset(fw, fh, ox, oy, W, H);
  else menuCam.clearViewOffset();
  menuCam.updateProjectionMatrix();
}
