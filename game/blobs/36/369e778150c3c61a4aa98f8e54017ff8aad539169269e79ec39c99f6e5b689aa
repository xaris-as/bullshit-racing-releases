function copyBuild(b) {
  return { body: b.body, wheels: b.wheels, spoiler: b.spoiler, exhaust: b.exhaust, p1: b.p1, p2: b.p2, pattern: b.pattern, number: b.number, rim: b.rim, flame: b.flame };
}

const Save = {
  data: null,
  fresh() {
    const owned = {};
    for (const cat of PART_CATS) owned[cat] = PARTS[cat].filter((p) => p.cost === 0).map((p) => p.id);
