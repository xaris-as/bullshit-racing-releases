// ---------- chunked instancing for GLB props ----------
// items: [x, y, z, scale, rotY, shade, tiltX, tiltZ, sy]
function addInstanced(group, geo, mat, items, opts = {}) {
  const chunks = new Map();
  const CH = opts.chunk || CHUNK;
  for (const it of items) {
    const key = Math.floor(it[0] / CH) + ',' + Math.floor(it[2] / CH);
    let L = chunks.get(key);
    if (!L) chunks.set(key, (L = []));
    L.push(it);
  }
  const out = [];
  for (const L of chunks.values()) {
    const im = new THREE.InstancedMesh(geo, mat, L.length);
    for (let i = 0; i < L.length; i++) {
      const it = L[i];
      _e.set(it[6] || 0, it[4] || 0, it[7] || 0, 'YXZ');
      _q.setFromEuler(_e);
      const sc = it[3] ?? 1;
      _m4.compose(_v1.set(it[0], it[1], it[2]), _q, _v2.set(sc, sc * (it[8] ?? 1), sc));
      im.setMatrixAt(i, _m4);
      if (it[10]) im.setColorAt(i, _col.copy(it[10]).multiplyScalar(it[5] ?? 1));
      else if (opts.color) im.setColorAt(i, _col.setRGB(it[5] ?? 1, it[5] ?? 1, it[5] ?? 1).multiply(opts.color));
      else im.setColorAt(i, _col.setRGB(it[5] ?? 1, it[5] ?? 1, it[5] ?? 1));
    }
    im.instanceMatrix.needsUpdate = true;
    if (im.instanceColor) im.instanceColor.needsUpdate = true;
    im.computeBoundingSphere();
    im.castShadow = !!opts.cast;
    im.receiveShadow = !!opts.receive;
    group.add(im);
    out.push(im);
  }
  return out;
}

function grassGeo(tall) {
  const P = [];
  const C = [];
  const rnd = mulberry32(tall ? 5 : 6);
  const nB = 5;
  for (let b = 0; b < nB; b++) {
    const a = (b / nB) * TAU + rnd() * 0.6;
    const r = 0.08 + rnd() * 0.18;
    const x = Math.cos(a) * r;
    const z = Math.sin(a) * r;
    const h = (tall ? 0.75 : 0.5) + rnd() * 0.35;
    const lean = 0.18 + rnd() * 0.2;
    const w = 0.055;
    const px = -Math.sin(a) * w;
    const pz = Math.cos(a) * w;
    P.push(x - px, 0, z - pz, x + px, 0, z + pz, x + Math.cos(a) * lean, h, z + Math.sin(a) * lean);
    C.push(0.55, 0.55, 0.55, 0.55, 0.55, 0.55, 1.15, 1.15, 1.15);
  }
  const g = new THREE.BufferGeometry();
  g.setAttribute('position', new THREE.Float32BufferAttribute(P, 3));
  g.setAttribute('color', new THREE.Float32BufferAttribute(C, 3));
  g.computeVertexNormals();
  const nrm = g.attributes.normal.array;
  for (let i = 0; i < nrm.length; i += 3) {
    nrm[i] *= 0.3;
    nrm[i + 1] = 1;
    nrm[i + 2] *= 0.3;
  }
  g.computeBoundingSphere();
  return g;
}
// ~14 triangles: crossed stem quads, a 6-petal star and a centre
function flowerGeo() {
  const P = [];
  const C = [];
  const push = (x, y, z, c) => {
    P.push(x, y, z);
    C.push(c[0], c[1], c[2]);
  };
  const stem = [0.32, 0.55, 0.28];
  const pet = [1, 1, 1];
  const mid = [1, 0.82, 0.25];
  for (const a of [0, Math.PI / 2]) {
    const dx = Math.cos(a) * 0.02;
    const dz = Math.sin(a) * 0.02;
    push(-dx, 0, -dz, stem);
    push(dx, 0, dz, stem);
    push(0, 0.46, 0, stem);
  }
  const h = 0.46;
  for (let k = 0; k < 6; k++) {
    const a0 = (k / 6) * TAU;
    const a1 = a0 + TAU / 12;
    const a2 = a0 - TAU / 12;
    push(0, h, 0, pet);
    push(Math.cos(a2) * 0.06, h + 0.005, Math.sin(a2) * 0.06, pet);
    push(Math.cos(a0) * 0.15, h + 0.02, Math.sin(a0) * 0.15, pet);
    push(0, h, 0, pet);
    push(Math.cos(a0) * 0.15, h + 0.02, Math.sin(a0) * 0.15, pet);
    push(Math.cos(a1) * 0.06, h + 0.005, Math.sin(a1) * 0.06, pet);
  }
  for (let k = 0; k < 4; k++) {
    const a0 = (k / 4) * TAU;
    const a1 = ((k + 1) / 4) * TAU;
    push(0, h + 0.04, 0, mid);
    push(Math.cos(a0) * 0.045, h + 0.025, Math.sin(a0) * 0.045, mid);
    push(Math.cos(a1) * 0.045, h + 0.025, Math.sin(a1) * 0.045, mid);
  }
  const g = new THREE.BufferGeometry();
  g.setAttribute('position', new THREE.Float32BufferAttribute(P, 3));
  g.setAttribute('color', new THREE.Float32BufferAttribute(C, 3));
  const N = new Float32Array(P.length);
  for (let i = 1; i < N.length; i += 3) N[i] = 1;
  g.setAttribute('normal', new THREE.BufferAttribute(N, 3));
  g.computeBoundingSphere();
  return g;
}

// ---------- Mountains & clouds (backdrop) ----------
function buildMountains(track, terrain, theme) {
  const rng = mulberry32(track.def.seed + 555);
  const cx = terrain.minX + (terrain.nx * terrain.cell) / 2;
  const cz = terrain.minZ + (terrain.nz * terrain.cell) / 2;
  const radius = (Math.max(terrain.nx, terrain.nz) * terrain.cell) / 2 + 500;
  const fog = new THREE.Color(theme.fog);
  const base = new THREE.Color(theme.mountain).lerp(fog, 0.35);
  const snow = new THREE.Color(theme.mountainSnow).lerp(fog, 0.25);
  const band = new THREE.Color(theme.mountain).lerp(new THREE.Color(0x8e3b2a), 0.35).lerp(fog, 0.35);
  const pos = [];
  const col = [];
  const c = new THREE.Color();
  const mesa = !!theme.mesas;
  for (let i = 0; i < 26; i++) {
    const a = (i / 26) * TAU + rng() * 0.2;
    const r = radius + rng() * 500;
    let h = 260 + rng() * 420;
    const w = 260 + rng() * 300;
    if (mesa) h *= 0.42;
    const g = (mesa ? new THREE.CylinderGeometry(w * 0.5, w * 0.72, h, 7, 4) : new THREE.ConeGeometry(w, h, 7, 3)).toNonIndexed();
    g.rotateY(rng() * TAU);
    g.translate(cx + Math.cos(a) * r, track.waterY + h / 2 - 20, cz + Math.sin(a) * r);
    const pa = g.attributes.position;
    for (let k = 0; k < pa.count; k++) {
      const t = (pa.getY(k) - (track.waterY - 20)) / h;
      c.copy(base);
      if (mesa) {
        if (Math.floor(t * 4.999) % 2 === 1) c.copy(band);
        if (t > 0.98) c.copy(snow);
      } else if (t > 0.62) c.copy(snow);
      pos.push(pa.getX(k), pa.getY(k), pa.getZ(k));
      col.push(c.r, c.g, c.b);
    }
    g.dispose();
  }
  const geo = new THREE.BufferGeometry();
  geo.setAttribute('position', new THREE.Float32BufferAttribute(pos, 3));
  geo.setAttribute('color', new THREE.Float32BufferAttribute(col, 3));
  geo.computeVertexNormals();
  const mat = new THREE.MeshLambertMaterial({ vertexColors: true, flatShading: true, fog: false });
  const m = new THREE.Mesh(geo, mat);
  m.frustumCulled = false;
  return m;
}
function buildClouds(track, terrain, theme) {
  const rng = mulberry32(track.def.seed + 999);
  const cx = terrain.minX + (terrain.nx * terrain.cell) / 2;
  const cz = terrain.minZ + (terrain.nz * terrain.cell) / 2;
  const P = [];
  for (let i = 0; i < 18; i++) {
    const a = rng() * TAU;
    const r = 650 + rng() * 950;
    const x = cx + Math.cos(a) * r;
    const z = cz + Math.sin(a) * r;
    const y = track.topY + 140 + rng() * 260;
    const k = 3 + Math.floor(rng() * 4);
    for (let j = 0; j < k; j++) {
      const s = 30 + rng() * 40;
      P.push(part(GEO.ico1, theme.cloud, x + (j - k / 2) * s * 0.9, y + rng() * s * 0.3, z + (rng() - 0.5) * s * 0.6, 0, rng(), 0, s, s * 0.6, s * 0.8));
    }
  }
  const mat = new THREE.MeshLambertMaterial({ vertexColors: true, flatShading: true, fog: false, emissive: new THREE.Color(theme.cloud).multiplyScalar(theme.night ? 0.12 : theme.storm ? 0.3 : 0.45) });
  const m = new THREE.Mesh(mergeParts(P), mat);
  m.frustumCulled = false;
  return m;
}

// ---------- set pieces & decor placement ----------
function makeDecor(track, terrain, theme, rng) {
  const lists = new Map();
  const keep = [];
  const add = (kind, x, y, z, sc, ry, shade = 1, cast = true) => {
    let L = lists.get(kind);
    if (!L) lists.set(kind, (L = { items: [], cast }));
    L.items.push([x, y, z, sc, ry, shade]);
  };
  const block = (x, z, r) => keep.push([x, z, r * r]);
  const F = {};
  const P = {};
  const L = track.finishS;
  // a point beside the road at distance dist, preferring the side that is clear of other road parts
  const beside = (s, dist, side = 0) => {
    track.frameInto(s, F);
    const sides = side ? [side] : rng() < 0.5 ? [1, -1] : [-1, 1];
    for (const sg of sides) {
      const x = F.x + F.rx * sg * dist;
      const z = F.z + F.rz * sg * dist;
      const k = terrain.idx(x, z);
      if (terrain.minD[k] > dist * 0.82 - 4 && Math.abs(terrain.nearS[k] - s) < dist * 2.5 + 30) {
        P.x = x;
        P.z = z;
        P.y = terrain.heightAt(x, z);
        P.side = sg;
        P.psi = F.psi;
        return P;
      }
    }
    return null;
  };
  const set = track.def.set || {};
  const wy = track.waterY;
  const windmills = [];

  for (const f of set.windmills || []) {
    const p = beside(f * L, 40 + rng() * 14);
    if (!p) continue;
    const ry = -p.psi + (p.side > 0 ? -Math.PI / 2 : Math.PI / 2) + (rng() - 0.5) * 0.5;
    add('prop_windmill', p.x, p.y - 0.2, p.z, 1.15, ry);
    windmills.push({ x: p.x, y: p.y - 0.2, z: p.z, ry, sc: 1.15, ph: rng() * TAU });
    block(p.x, p.z, 9);
  }
  const village = (f, kinds, count, spread) => {
    const s0 = f * L;
    for (let i = 0; i < count; i++) {
      const s = clamp(s0 + (rng() - 0.5) * spread, START_S + 10, L - 10);
      const p = beside(s, WALL_HW + 9 + rng() * 26);
      if (!p || p.y < wy + 1.5) continue;
      let ok = true;
      for (const [kx, kz, r2] of keep) if ((kx - p.x) * (kx - p.x) + (kz - p.z) * (kz - p.z) < r2) ok = false;
      if (!ok) continue;
      const ry = -p.psi + (p.side > 0 ? -Math.PI / 2 : Math.PI / 2) + Math.round((rng() - 0.5) * 2) * 0.12;
      add(kinds[Math.floor(rng() * kinds.length)], p.x, p.y - 0.15, p.z, 1 + rng() * 0.15, ry, 0.9 + rng() * 0.15);
      block(p.x, p.z, 5);
    }
  };
  for (const f of set.village || []) village(f, ['prop_cottage', 'prop_cottage2'], 14, 160);
  for (const f of set.town || []) village(f, ['prop_townhouse', 'prop_townhouse2', 'prop_townhouse3'], 22, 140);
  for (const f of set.huts || []) village(f, ['prop_beachhut'], 9, 120);
  for (const f of set.sunflowers || []) {
    const p = beside(f * L, WALL_HW + 22);
    if (!p) continue;
    const fx = Math.sin(p.psi);
    const fz = -Math.cos(p.psi);
    const rx = Math.cos(p.psi) * p.side;
    const rz = Math.sin(p.psi) * p.side;
    const sunYaw = Math.atan2(theme.sunDir[0], theme.sunDir[2]);
    for (let a = -24; a <= 24; a += 2.2) {
      for (let b = -8; b <= 8; b += 1.6) {
        const x = p.x + fx * a + rx * b + (rng() - 0.5) * 0.5;
        const z = p.z + fz * a + rz * b + (rng() - 0.5) * 0.5;
        const k = terrain.idx(x, z);
        if (terrain.minD[k] < WALL_HW + 3) continue;
        add('prop_sunflower', x, terrain.heightAt(x, z) - 0.05, z, 0.9 + rng() * 0.35, sunYaw + (rng() - 0.5) * 0.4, 0.85 + rng() * 0.2, false);
      }
    }
    block(p.x, p.z, 26);
  }
  for (const f of set.hay || []) {
    for (let i = 0; i < 12; i++) {
      const p = beside(f * L + (rng() - 0.5) * 120, WALL_HW + 5 + rng() * 28);
      if (p) add('prop_haybale', p.x, p.y - 0.05, p.z, 1 + rng() * 0.2, rng() * TAU, 0.9 + rng() * 0.15);
    }
  }
  for (const f of set.lighthouse || []) {
    const p = beside(f * L, 44);
    if (!p) continue;
    add('prop_lighthouse', p.x, Math.max(p.y, wy + 0.5) - 0.2, p.z, 1.25, rng() * TAU);
    block(p.x, p.z, 8);
  }
  for (const f of set.snowmen || []) {
    for (let i = 0; i < 3; i++) {
      const p = beside(f * L + i * 4, WALL_HW + 3 + rng() * 3, i === 0 ? 0 : P.side || 1);
      if (p) add('prop_snowman', p.x, p.y - 0.05, p.z, 0.9 + rng() * 0.4, -p.psi + (p.side > 0 ? -Math.PI / 2 : Math.PI / 2) + (rng() - 0.5));
    }
  }
  // ski lift towers climbing away from the road
  const cables = [];
  for (const f of set.skilift || []) {
    const p = beside(f * L, WALL_HW + 14);
    if (!p) continue;
    const ang = p.psi + p.side * (Math.PI / 2 + (rng() - 0.5) * 0.5);
    let prev = null;
    for (let i = 0; i < 6; i++) {
      const x = p.x + Math.sin(ang) * i * 48;
      const z = p.z - Math.cos(ang) * i * 48;
      const k = terrain.idx(x, z);
      if (i > 0 && terrain.minD[k] < WALL_HW + 8) break;
      const y = terrain.heightAt(x, z);
      add('prop_skitower', x, y - 0.2, z, 1, -ang);
      block(x, z, 4);
      const top = [x, y + 11.4, z];
      if (prev) cables.push(prev, top);
      prev = top;
    }
  }
  // canyon arches straddle the road
  for (const f of set.arches || []) {
    track.frameInto(f * L, F);
    add('prop_rockarch', F.x, F.y - 0.6, F.z, 1, -F.psi, 0.95);
    block(F.x + F.rx * 21, F.z + F.rz * 21, 9);
    block(F.x - F.rx * 21, F.z - F.rz * 21, 9);
  }
  // ice gallery
  for (const g of set.gallery || []) {
    const s0 = track.segAt(g.seg, g.t0);
    const s1 = track.segAt(g.seg, g.t1);
    for (let s = s0; s <= s1; s += 6.4) {
      track.frameInto(s, F);
      add('prop_galleryice', F.x, F.y - 0.35, F.z, 1, -F.psi, 0.95 + 0.08 * Math.sin(s));
    }
  }
  // covered bridge trusses
  for (const b of set.bridge || []) {
    const s0 = track.segAt(b.seg, b.t0);
    const s1 = track.segAt(b.seg, b.t1);
    for (let s = s0 + 3.2; s <= s1 - 3.2; s += 6.3) {
      for (const sg of [-1, 1]) {
        track.frameInto(s, F);
        const d = sg * (WALL_HW + 0.55);
        add('prop_bridgeside', F.x + F.rx * d, F.y - d * Math.sin(F.bank) - 0.2, F.z + F.rz * d, 1, -F.psi, 1);
      }
    }
  }
  // water-side decor
  const shoreSpots = (s, dmin, dmax, wantWater) => {
    track.frameInto(s, F);
    const sg = rng() < 0.5 ? -1 : 1;
    const d = sg * (dmin + rng() * (dmax - dmin));
    const x = F.x + F.rx * d;
    const z = F.z + F.rz * d;
    const y = terrain.heightAt(x, z);
    if (wantWater ? y > wy - 0.6 : y < wy + 0.6) return null;
    return { x, y, z, psi: F.psi, d };
  };
  for (let k = 0; k < track.segS.length; k++) {
    const m = track.segMode[k];
    if (m === M_WATER) {
      // buoy lines
      for (let s = track.segS[k] + 4; s < track.segE[k] - 2; s += 7) {
        track.frameInto(s, F);
        for (const sg of [-1, 1]) {
          const d = sg * (WATER_HW + 0.5);
          add('prop_buoy', F.x + F.rx * d, wy - 0.15, F.z + F.rz * d, 1, rng() * TAU, Math.floor(s / 7) % 2 ? 1 : 0.62, false);
        }
      }
      if (set.corals || set.boats) {
        for (let s = track.segS[k] + 10; s < track.segE[k]; s += 9) {
          const p = shoreSpots(s, WATER_HW + 3, WATER_HW + 26, true);
          if (p && set.corals && p.y < wy - 1.7) add('prop_coral', p.x, p.y + 0.1, p.z, 0.45 + rng() * 0.4, rng() * TAU, 0.8 + rng() * 0.3, false);
          if (set.boats && rng() < 0.25) {
            const q = shoreSpots(s, WATER_HW + 8, WATER_HW + 30, true);
            if (q) add('prop_boat', q.x, wy - 0.25, q.z, 1.1, -q.psi + (rng() - 0.5) * 0.8, 1, false);
          }
        }
      }
    } else if (m === M_AIR) {
      for (let s = track.segS[k] + 20; s < track.segE[k] - 10; s += 26) {
        track.frameInto(s, F);
        if (set.stacks) {
          for (let j = 0; j < 2; j++) {
            const d = (rng() < 0.5 ? -1 : 1) * (22 + rng() * 60);
            const x = F.x + F.rx * d;
            const z = F.z + F.rz * d;
            add('prop_seastack', x, wy - 4 - rng() * 3, z, 0.7 + rng() * 0.8, rng() * TAU, 0.85 + rng() * 0.2);
          }
        }
        if (set.balloons && rng() < 0.55) {
          const d = (rng() < 0.5 ? -1 : 1) * (AIR_HW + 5 + rng() * 14);
          add('prop_balloon', F.x + F.rx * d, F.y - 6 + rng() * 12, F.z + F.rz * d, 0.9 + rng() * 0.5, rng() * TAU, 1, false);
        }
      }
    }
  }
  for (const f of set.docks || []) {
    for (let i = 0; i < 5; i++) {
      const p = shoreSpots(f * L + (rng() - 0.5) * 60, WALL_HW + 6, WALL_HW + 30, true);
      if (p) add('prop_dock', p.x, wy - 0.1, p.z, 1, -p.psi + (p.d > 0 ? -1 : 1) * Math.PI / 2, 1, false);
    }
  }
  return { lists, keep, windmills, cables };
}

function buildScenery(track, terrain, theme, Q, keep) {
  const rng = mulberry32(track.def.seed * 101 + 9);
  const kinds = theme.flora.map((f) => f[0]);
  const weights = theme.flora.map((f) => f[1]);
  let wsum = 0;
  for (const w of weights) wsum += w;
  const lists = new Map(kinds.map((k) => [k, []]));
  const rocks = theme.rocks || ['prop_rock'];
  for (const r of rocks) if (!lists.has(r)) lists.set(r, []);
  const target = Math.round((TOUCH_UI ? 1100 : 1500) * theme.density * Q.scenery);
  let placed = 0;
  const { nx, nz, cell, minX, minZ, minD, nor, carved } = terrain;
  for (let tries = 0; tries < target * 8 && placed < target; tries++) {
    const jx = 1 + Math.floor(rng() * (nx - 2));
    const jz = 1 + Math.floor(rng() * (nz - 2));
    const k = jz * nx + jx;
    const dm = minD[k];
    if (dm < 17 || dm > 270 || carved[k]) continue;
    if (rng() > 1.25 - dm / 230) continue;
    const x = minX + jx * cell + (rng() - 0.5) * cell;
    const z = minZ + jz * cell + (rng() - 0.5) * cell;
    let bad = false;
    for (const [kx, kz, r2] of keep) if ((kx - x) * (kx - x) + (kz - z) * (kz - z) < r2) bad = true;
    if (bad) continue;
    const y = terrain.heightAt(x, z);
    if (y < track.waterY + 1.4) continue;
    const ny = nor[k * 3 + 1];
    let kind;
    if (ny < 0.8) {
      if (rng() < 0.5) continue;
      kind = rocks[Math.floor(rng() * rocks.length)];
    } else {
      let r = rng() * wsum;
      kind = kinds[kinds.length - 1];
      for (let i = 0; i < kinds.length; i++) {
        r -= weights[i];
        if (r <= 0) {
          kind = kinds[i];
          break;
        }
      }
    }
    const big = kind === 'prop_hoodoo';
    const sc = big ? 0.7 + rng() * 0.9 : 0.8 + rng() * 0.55;
    lists.get(kind).push([x, y - 0.2, z, sc, rng() * TAU, 0.82 + rng() * 0.3, 0, 0, 1, dm]);
    placed++;
  }
  // keep heavy props within a triangle budget, preferring the ones closest to the road
  const tris = (k) => {
    const p = Assets.prop(k);
    return p && p.geo.index ? p.geo.index.count / 3 : 100;
  };
  let cheap = 0;
  let heavy = 0;
  for (const [k, L] of lists) {
    const t = tris(k) * L.length;
    if (tris(k) > 600) heavy += t;
    else cheap += t;
  }
  const budget = Q.sceneryTris || 900000;
  if (heavy > 0 && cheap + heavy > budget) {
    const f = clamp((budget - cheap) / heavy, 0.15, 1);
    for (const [k, L] of lists) {
      if (tris(k) <= 600) continue;
      L.sort((a, b) => a[9] - b[9]);
      L.length = Math.round(L.length * f);
    }
  }
  return lists;
}

function buildGrass(track, terrain, theme, Q, group, U) {
  const n = Math.round((TOUCH_UI ? 6000 : 9000) * Q.grass * (theme.tufts ?? 1) * (Q.grassField && Q.id !== 'high' ? 0 : 1));
  const nf = theme.flowers ? Math.round(1600 * Q.flowers) : 0;
  if (n <= 0 && nf <= 0) return [];
  const rng = mulberry32(track.def.seed + 4242);
  const G = [];
  const Fl = [];
  const { minD, carved, nor } = terrain;
  const tmp = {};
  const pick = () => {
    const s = START_S + rng() * (track.length - START_S - 10);
    if (track.modeAt(s) !== M_ROAD) return null;
    const sg = rng() < 0.5 ? -1 : 1;
    const d = sg * (WALL_HW + 1.5 + Math.pow(rng(), 1.6) * 48);
    const p = track.toWorld(s, d, tmp);
    const k = terrain.idx(p.x, p.z);
    if (minD[k] < WALL_HW + 1 || carved[k] || nor[k * 3 + 1] < 0.84) return null;
    const y = terrain.heightAt(p.x, p.z);
    if (y < track.waterY + 1.2) return null;
    return [p.x, y - 0.03, p.z];
  };
  for (let i = 0; i < n * 2 && G.length < n; i++) {
    const p = pick();
    if (p) G.push([p[0], p[1], p[2], 0.8 + rng() * 0.7, rng() * TAU, 0.85 + rng() * 0.3]);
  }
  const flowerCols = [0xff6fae, 0xffffff, 0xffd23f, 0xb48cff, 0xff8a3c].map((c) => new THREE.Color(c));
  for (let i = 0; i < nf * 3 && Fl.length < nf; i++) {
    const p = pick();
    if (!p) continue;
    const cx = p[0];
    const cz = p[2];
    const ci = Math.floor(rng() * flowerCols.length);
    for (let j = 0; j < 5 && Fl.length < nf; j++) {
      const x = cx + (rng() - 0.5) * 2.4;
      const z = cz + (rng() - 0.5) * 2.4;
      Fl.push([x, terrain.heightAt(x, z) - 0.02, z, 0.8 + rng() * 0.5, rng() * TAU, ci]);
    }
  }
  const made = [];
  if (G.length) {
    const mat = new THREE.MeshStandardMaterial({ vertexColors: true, roughness: 0.95, side: THREE.DoubleSide });
    const tint = new THREE.Color(theme.grass[1]).lerp(new THREE.Color(theme.grass[2]), 0.4);
    mat.onBeforeCompile = (sh) => {
      sh.uniforms.uTime = U.uTime;
      sh.vertexShader = sh.vertexShader
        .replace('#include <common>', '#include <common>\nuniform float uTime;')
        .replace(
          '#include <begin_vertex>',
          `#include <begin_vertex>
          #ifdef USE_INSTANCING
            float ph = instanceMatrix[3].x * 0.31 + instanceMatrix[3].z * 0.23;
            float sw = sin(uTime * 1.8 + ph) * 0.12 + sin(uTime * 3.1 + ph * 1.7) * 0.05;
            transformed.x += sw * transformed.y;
            transformed.z += sw * 0.6 * transformed.y;
          #endif`
        );
    };
    mat.customProgramCacheKey = () => 'dd-grass';
    made.push(...addInstanced(group, grassGeo(theme.tufts > 0.7), mat, G, { color: tint, chunk: Q.chunk }));
  }
  if (Fl.length) {
    const fg = flowerGeo();
    const items = Fl.map((f) => [f[0], f[1], f[2], f[3], f[4], 1, 0, 0, 1, 0, flowerCols[f[5]]]);
    made.push(...addInstanced(group, fg, MAT.prop, items, { chunk: Q.chunk }));
  }
  return made;
}

// ---------- Assemble ----------
function buildWorld(track, renderer, Q) {
  ensureRuntimeProps();
  const theme = THEMES[track.def.theme];
  const aniso = Math.min(8, renderer.capabilities.getMaxAnisotropy());
  const scene = new THREE.Scene();
  const fogC = new THREE.Color(theme.fog);
  scene.fog = new THREE.Fog(fogC, theme.fogNear, theme.fogFar);
  scene.background = fogC.clone();
  const U = {
    uTime: { value: 0 },
    uWaveT: { value: 0 },
    uBoat: { value: Array.from({ length: MAX_BOATS }, () => new THREE.Vector4()) },
    uBoatSp: { value: new Array(MAX_BOATS).fill(0) },
    uWaterCenter: { value: new THREE.Vector2() },
    uCam: { value: new THREE.Vector3() },
    uKarts: { value: Array.from({ length: 6 }, () => new THREE.Vector4(0, -999, 0, 0)) },
  };
  const env = buildEnvMap(renderer, theme);
  scene.environment = env.texture;
  scene.environmentIntensity = 0.75;
  const hemi = new THREE.HemisphereLight(theme.hemiSky, theme.hemiGround, theme.hemiI * 0.55);
  scene.add(hemi);
  const sun = new THREE.DirectionalLight(theme.sun, theme.sunI);
  const sunDir = new THREE.Vector3(...theme.sunDir).normalize();
  sun.position.copy(sunDir).multiplyScalar(120);
  scene.add(sun, sun.target);
  if (Q.shadows > 0) {
    sun.castShadow = true;
    sun.shadow.mapSize.set(Q.shadows, Q.shadows);
    const sc = sun.shadow.camera;
    const ext = Q.shadows >= 2048 ? 42 : 34;
    sc.left = -ext;
    sc.right = ext;
    sc.top = ext;
    sc.bottom = -ext;
    sc.near = 1;
    sc.far = 320;
    sc.updateProjectionMatrix();
    sun.shadow.bias = -0.0005;
    sun.shadow.normalBias = 0.05;
  }
  const sky = buildSky(theme);
  scene.add(sky);
  if (theme.night) {
    const rs = mulberry32(7);
    const sp = [];
    for (let i = 0; i < 900; i++) {
      const a = rs() * TAU;
      const e = Math.asin(0.1 + rs() * 0.9);
      sp.push(Math.cos(e) * Math.cos(a) * 2400, Math.sin(e) * 2400, Math.cos(e) * Math.sin(a) * 2400);
    }
    const sg = new THREE.BufferGeometry();
    sg.setAttribute('position', new THREE.Float32BufferAttribute(sp, 3));
    const stars = new THREE.Points(sg, new THREE.PointsMaterial({ color: 0xcfe0ff, size: 2.2, sizeAttenuation: false, fog: false, transparent: true, opacity: 0.8 }));
    stars.frustumCulled = false;
    sky.add(stars);
  }
  const sunSprite = new THREE.Sprite(new THREE.SpriteMaterial({ map: glowTexture(), color: theme.sun, transparent: true, depthWrite: false, fog: false, blending: THREE.AdditiveBlending, toneMapped: false }));
  sunSprite.scale.set(560, 560, 1);
  sunSprite.renderOrder = -9;
  scene.add(sunSprite);

  // carved valleys: gorges under gap jumps, a ravine + river under covered bridges
  const carves = [];
  const rivers = [];
  const Fc = {};
  for (let k = 0; k < track.segS.length; k++) {
    if (track.segMode[k] !== M_GAP) continue;
    const s = (track.segS[k] + track.segE[k]) / 2;
    const f = track.frameInto(s, Fc);
    const half = (track.segE[k] - track.segS[k]) / 2;
    carves.push({ s, x: f.x, z: f.z, tx: f.tx, tz: f.tz, rx: f.rx, rz: f.rz, half, lat: 190, floor: f.y - 38 });
    rivers.push({ x: f.x, z: f.z, psi: f.psi, w: half * 2 + 6, l: 380, y: f.y - 35.5 });
  }
  for (const b of (track.def.set && track.def.set.bridge) || []) {
    const s0 = track.segAt(b.seg, b.t0);
    const s1 = track.segAt(b.seg, b.t1);
    const s = (s0 + s1) / 2;
    const f = track.frameInto(s, Fc);
    const half = (s1 - s0) / 2 - 5;
    carves.push({ s, x: f.x, z: f.z, tx: f.tx, tz: f.tz, rx: f.rx, rz: f.rz, half, lat: 170, floor: f.y - 12 });
    rivers.push({ x: f.x, z: f.z, psi: f.psi, w: half * 2 + 8, l: 340, y: f.y - 9.5 });
  }
  const terrain = buildTerrain(track, theme, Q, carves);
  scene.add(terrain.mesh);

  const waterMat = makeWaterMaterial(theme, Q, U);
  const cxT = terrain.minX + (terrain.nx * terrain.cell) / 2;
  const czT = terrain.minZ + (terrain.nz * terrain.cell) / 2;
  let water;
  let waterGrid = false;
  if (Q.waterGrid > 0 && !theme.ice) {
    water = new THREE.Mesh(waterGridGeo(Q.waterGrid), makeWaveWaterMaterial(theme, U, Q));
    water.position.set(cxT, track.waterY, czT);
    water.frustumCulled = false;
    waterGrid = true;
  } else {
    water = new THREE.Mesh(new THREE.PlaneGeometry(9000, 9000), waterMat);
    water.rotation.x = -Math.PI / 2;
    water.position.set(cxT, track.waterY, czT);
  }
  water.receiveShadow = Q.shadows > 0;
  water.renderOrder = 2;
  scene.add(water);
  for (const r of rivers) {
    const m = new THREE.Mesh(new THREE.PlaneGeometry(r.w, r.l), waterMat);
    m.rotation.set(-Math.PI / 2, Math.PI / 2 - r.psi, 0, 'YXZ');
    m.position.set(r.x, r.y, r.z);
    m.renderOrder = 2;
    scene.add(m);
  }

  const runs = roadRuns(track);
  scene.add(buildRoad(track, theme, aniso, runs, Q));
  scene.add(buildCurbs(track, theme, runs, Q));
  scene.add(buildBarriers(track, theme, runs, Q));
  scene.add(buildBerms(track, terrain, theme, runs, Q));
  const skids = new SkidMarks(Q.skids || 600);
  scene.add(skids.mesh);
  const landRamps = track.ramps.filter((r) => r.kind !== 'water');
  const wRamps = track.ramps.filter((r) => r.kind === 'water');
  if (landRamps.length) scene.add(buildRamps(track, landRamps, rampTexture('#ffb01f', '#2b2d36'), Q));
  if (wRamps.length) scene.add(buildRamps(track, wRamps, rampTexture('#ff5a36', '#ffffff'), Q));

  // boost pads (road)
  const padOut = { pos: [], nor: [], uv: [], idx: [] };
  for (const p of track.pads) if (p.kind === 'pad') surfaceQuad(track, p.s - p.len / 2, p.s + p.len / 2, p.d - p.w / 2, p.d + p.w / 2, 0.06, 3, padOut);
  const padTex = padTexture();
  const padMat = new THREE.MeshBasicMaterial({ map: padTex, polygonOffset: true, polygonOffsetFactor: -2, polygonOffsetUnits: -4 });
  padMat.color.setScalar(1.25);
  const pads = { mesh: new THREE.Mesh(geoFromOut(padOut), padMat), tex: padTex };
  pads.mesh.renderOrder = 1;
  scene.add(pads.mesh);
  // ice patches
  if (track.iceZones.length) {
    const io = { pos: [], nor: [], uv: [], idx: [] };
    for (const z of track.iceZones) surfaceQuad(track, z.s0, z.s1, -ROAD_HW - 0.4, ROAD_HW + 0.4, 0.04, Math.max(2, Math.round((z.s1 - z.s0) / 4)), io);
    const im = new THREE.MeshStandardMaterial({ color: 0xcfeeff, roughness: 0.08, metalness: 0.1, transparent: true, opacity: 0.62, polygonOffset: true, polygonOffsetFactor: -2, polygonOffsetUnits: -4, envMapIntensity: 1.4 });
    const ice = new THREE.Mesh(geoFromOut(io), im);
    ice.renderOrder = 1;
    ice.receiveShadow = Q.shadows > 0;
    scene.add(ice);
  }

  // start & finish
  const lines = { pos: [], nor: [], uv: [], idx: [] };
  surfaceQuad(track, track.finishS - 1.2, track.finishS + 1.2, -ROAD_HW, ROAD_HW, 0.05, 1, lines);
  const finishLine = new THREE.Mesh(geoFromOut(lines), new THREE.MeshStandardMaterial({ map: checkerTexture(3, 26), roughness: 0.7, polygonOffset: true, polygonOffsetFactor: -2, polygonOffsetUnits: -4 }));
  finishLine.receiveShadow = Q.shadows > 0;
  scene.add(finishLine);
  const sl = { pos: [], nor: [], uv: [], idx: [] };
  surfaceQuad(track, START_S - 0.4, START_S + 0.4, -ROAD_HW, ROAD_HW, 0.05, 1, sl);
  scene.add(new THREE.Mesh(geoFromOut(sl), new THREE.MeshBasicMaterial({ color: 0xffffff, polygonOffset: true, polygonOffsetFactor: -2, polygonOffsetUnits: -4 })));
  const gateGeo = Assets.prop('prop_gate').geo;
  for (const [s, text, color] of [[START_S, 'START', 0x2fb5ff], [track.finishS, 'FINISH', 0xff4f5e]]) {
    const f = track.frameInto(s, Fc);
    const g = new THREE.Group();
    g.position.set(f.x, f.y - 0.2, f.z);
    g.rotation.y = -f.psi;
    const gm = new THREE.Mesh(gateGeo, MAT.prop);
    gm.castShadow = Q.shadows > 0;
    g.add(gm);
    const bt = bannerTexture(text, color);
    const bm = new THREE.MeshStandardMaterial({ map: bt, roughness: 0.6, side: THREE.DoubleSide });
    const bn = new THREE.Mesh(new THREE.PlaneGeometry(18, 2.1), bm);
    bn.position.set(0, 6.4, 0.95);
    g.add(bn);
    const bn2 = new THREE.Mesh(bn.geometry, bm);
    bn2.position.set(0, 6.4, -0.95);
    bn2.rotation.y = Math.PI;
    g.add(bn2);
    scene.add(g);
  }

  // set pieces, scenery and grass
  const rngD = mulberry32(track.def.seed * 17 + 3);
  const decor = makeDecor(track, terrain, theme, rngD);
  const statics = new THREE.Group();
  scene.add(statics);
  for (const [kind, L] of decor.lists) {
    const pr = Assets.prop(kind);
    if (!pr || !L.items.length) continue;
    addInstanced(statics, pr.geo, /^propx_/.test(kind) ? MAT.propx : MAT.prop, L.items, { cast: Q.shadows >= 2048 && L.cast, receive: Q.shadows > 0, chunk: Q.chunk });
  }
  const windmills = [];
  const bladeProp = Assets.prop('prop_windmill');
  const blade = bladeProp && bladeProp.extra.find((e) => /blades/.test(e.name));
  if (blade) {
    for (const w of decor.windmills) {
      const m = new THREE.Mesh(blade.geo, MAT.prop);
      const holder = new THREE.Group();
      holder.position.set(w.x, w.y, w.z);
      holder.rotation.y = w.ry;
      holder.scale.setScalar(w.sc);
      m.position.copy(blade.pos);
      m.castShadow = Q.shadows > 0;
      holder.add(m);
      scene.add(holder);
      windmills.push({ m, ph: w.ph });
    }
  }
  if (decor.cables.length) {
    const cg = new THREE.BufferGeometry();
    const arr = [];
    for (const p of decor.cables) arr.push(p[0], p[1], p[2]);
    cg.setAttribute('position', new THREE.Float32BufferAttribute(arr, 3));
    scene.add(new THREE.LineSegments(cg, new THREE.LineBasicMaterial({ color: 0x2a2a33 })));
  }
  const scen = buildScenery(track, terrain, theme, Q, decor.keep);
  const blobItems = [];
  for (const [kind, items] of scen) {
    const pr = Assets.prop(kind);
    if (!pr || !items.length) continue;
    addInstanced(statics, pr.geo, /^propx_/.test(kind) ? MAT.propx : MAT.prop, items, { cast: Q.shadows >= 2048, receive: false, chunk: Q.chunk });
    if (!/rock/.test(kind)) for (const it of items) blobItems.push([it[0], it[1] + 0.25, it[2], it[3] * (kind === 'prop_bush' ? 1.6 : 2.6), it[4], 1]);
  }
  if (blobItems.length) {
    const bg = new THREE.PlaneGeometry(1, 1);
    bg.rotateX(-Math.PI / 2);
    const bm = new THREE.MeshBasicMaterial({ map: blobTexture(), transparent: true, depthWrite: false, opacity: 0.75, polygonOffset: true, polygonOffsetFactor: -1, polygonOffsetUnits: -2 });
    for (const im of addInstanced(statics, bg, bm, blobItems, {})) im.renderOrder = 1;
  }
  buildGrass(track, terrain, theme, Q, statics, U);
  const extra = buildWorldExtras(track, terrain, theme, Q, scene, statics, U);
  const grassField = buildGrassField(track, terrain, theme, Q, U);
  if (grassField) scene.add(grassField);
  const street = buildStreetDressing(track, terrain, theme, Q, U, scene, statics);
  const glide = buildGlideDressing(track, terrain, theme, Q, U, scene);
  const wakes = !waterGrid && track.hasWater ? new WakeRibbons(6, 26) : null;
  if (wakes) scene.add(wakes.mesh);
  scene.add(buildMountains(track, terrain, theme));
  scene.add(buildClouds(track, terrain, theme));

  // ---- dynamic features
  const tmp = {};
  const toW = (o) => {
    const p = track.toWorld(o.s, o.d, tmp);
    o.wx = p.x;
    o.wz = p.z;
    o.psi = track.psiAt(o.s);
  };
  for (const o of track.orbs) toW(o);
  for (const c of track.coins) toW(c);
  for (const c of track.crates) toW(c);
  for (const r of track.rings) toW(r);
  for (const o of track.obstacles) toW(o);
  for (const p of track.pads) toW(p);

  const gem = Assets.prop('prop_gem');
  const orbMat = new THREE.MeshStandardMaterial({ vertexColors: true, roughness: 0.25, metalness: 0.2, emissive: 0x222222, flatShading: true });
  const orbs = new THREE.InstancedMesh(gem.geo, orbMat, Math.max(1, track.orbs.length));
  orbs.count = track.orbs.length;
  orbs.frustumCulled = false;
  for (let i = 0; i < track.orbs.length; i++) orbs.setColorAt(i, _col.setHSL((i * 0.17) % 1, 0.9, 0.6));
  const shells = new THREE.InstancedMesh(GEO.ico2, rimMaterial(0xffffff, 0.9), Math.max(1, track.orbs.length));
  shells.count = track.orbs.length;
  shells.frustumCulled = false;
  scene.add(orbs, shells);

  const coinMat = new THREE.MeshStandardMaterial({ vertexColors: true, roughness: 0.28, metalness: 0.55, emissive: 0x3a2600 });
  const coins = new THREE.InstancedMesh(Assets.prop('prop_coin').geo, coinMat, Math.max(1, track.coins.length));
  coins.count = track.coins.length;
  coins.frustumCulled = false;
  scene.add(coins);

  const crates = new THREE.InstancedMesh(Assets.prop('prop_crate').geo, MAT.prop, Math.max(1, track.crates.length));
  crates.count = track.crates.length;
  crates.frustumCulled = false;
  crates.castShadow = Q.shadows > 0;
  scene.add(crates);

  const ringMat = new THREE.MeshStandardMaterial({ vertexColors: true, roughness: 0.3, metalness: 0.3, emissive: 0x553300 });
  const rings = new THREE.InstancedMesh(Assets.prop('prop_ring').geo, ringMat, Math.max(1, track.rings.length));
  rings.count = track.rings.length;
  rings.frustumCulled = false;
  scene.add(rings);

  const jets = track.pads.filter((p) => p.kind === 'jet');
  const jetMat = new THREE.MeshStandardMaterial({ vertexColors: true, roughness: 0.35, emissive: 0x0a3a55 });
  const jetRings = new THREE.InstancedMesh(Assets.prop('prop_jetring').geo, jetMat, Math.max(1, jets.length));
  jetRings.count = jets.length;
  jetRings.frustumCulled = false;
  scene.add(jetRings);

  const reefs = track.obstacles.filter((o) => o.kind === 'reef');
  const skyrocks = track.obstacles.filter((o) => o.kind === 'skyrock');
  const obsGroup = new THREE.Group();
  scene.add(obsGroup);
  if (reefs.length) addInstanced(obsGroup, Assets.prop('prop_coral').geo, MAT.prop, reefs.map((o) => [o.wx, track.waterY - 1.4, o.wz, o.r / 1.1, o.s * 0.37, 1]), { cast: Q.shadows > 0 });
  if (skyrocks.length) addInstanced(obsGroup, Assets.prop('prop_floatisland').geo, MAT.prop, skyrocks.map((o) => [o.wx, o.y - 0.3, o.wz, o.r / 5.1, o.s * 0.21, 1]), { cast: Q.shadows > 0 });

  const rocketGeo = Assets.prop('prop_rocket').geo;
  const rockets = [];
  for (let i = 0; i < 8; i++) {
    const m = new THREE.Mesh(rocketGeo, MAT.prop);
    m.visible = false;
    scene.add(m);
    rockets.push(m);
  }
  const hGeo = honeyGeo();
  const honeyMat = new THREE.MeshStandardMaterial({ vertexColors: true, roughness: 0.15, emissive: 0x2a1600, transparent: true, opacity: 0.95, polygonOffset: true, polygonOffsetFactor: -2, polygonOffsetUnits: -4 });
  const puddles = [];
  for (let i = 0; i < 12; i++) {
    const m = new THREE.Mesh(hGeo, honeyMat);
    m.visible = false;
    scene.add(m);
    puddles.push(m);
  }
  const tumble = [];
  const tw = Assets.prop('prop_tumbleweed');
  for (let i = 0; i < track.tumble.length; i++) {
    const m = new THREE.Mesh(tw.geo, MAT.prop);
    m.castShadow = Q.shadows > 0;
    scene.add(m);
    tumble.push(m);
  }

  return {
    scene, theme, track, terrain, sky, sun, sunDir, sunSprite, hemi, env, U, water, waterGrid, skids, grassField, street, glide, wakes,
    pads, orbs, shells, coins, crates, rings, jets, jetRings, rockets, puddles, tumble, windmills, extra,
    dispose() {
      skids.dispose();
      if (wakes) wakes.dispose();
      if (grassField) grassField.userData.tex.dispose();
      const done = new Set();
      const shared = new Set([...SHARED_TEX(), DETAIL_TEX, SPLAT_TEX, GRAF_TEX, FENCE_TEX, CROWD_TEX, SPRAY_TEX]);
      scene.traverse((o) => {
        if (o.isInstancedMesh) o.dispose();
        if (o.geometry && !done.has(o.geometry) && !isLibraryGeo(o.geometry)) {
          done.add(o.geometry);
          o.geometry.dispose();
        }
        const mats = o.material ? (Array.isArray(o.material) ? o.material : [o.material]) : [];
        for (const m of mats) {
          if (done.has(m) || SHARED_MATS.has(m)) continue;
          done.add(m);
          for (const k of Object.keys(m)) {
            const t = m[k];
            if (t && t.isTexture && !shared.has(t) && !done.has(t)) {
              done.add(t);
              t.dispose();
            }
          }
          if (m.uniforms) {
            for (const k of Object.keys(m.uniforms)) {
              const t = m.uniforms[k] && m.uniforms[k].value;
              if (t && t.isTexture && !shared.has(t) && !done.has(t)) {
                done.add(t);
                t.dispose();
              }
            }
          }
          m.dispose();
        }
      });
      env.dispose();
    },
  };
}

function isLibraryGeo(g) {
  for (const k in GEO) if (GEO[k] === g) return true;
  if (g === FLAME_GEO || g === TYRE_GEO || g === LAMP_GEO) return true;
  if (Assets.charGeos.has(g)) return true;
  for (const v of Assets.geo.values()) if (v === g) return true;
  return false;
}

// ============================================================
// Environment v3 (ROADMAP 1, 6, 7, 8, 11): camera-following wave water with boat wakes, hardcore road surface
// (1024 asphalt + normal map, real curbs, dirt berms, accumulating skid marks), camera-following grass field +
// terrain splat, graffiti walls, tyre stacks, chain-link fences, floodlights, crowd + flags, glide/boat set dressing.
// ============================================================
const waveGLSL = () => `
float ddWave(vec2 p, float t) {
  float h = 0.0;
  ${WAVES.map((w) => `h += ${w[3].toFixed(4)} * sin(dot(p, vec2(${w[0].toFixed(4)}, ${w[1].toFixed(4)})) * ${w[2].toFixed(4)} + ${w[4].toFixed(4)} * t);`).join('\n  ')}
  return h;
}`;

// noise canvas helper (tileable by wrapping the value noise lattice)
function tileNoise(N, cells, seed) {
  const rnd = mulberry32(seed);
  const g = new Float32Array(cells * cells);
  for (let i = 0; i < g.length; i++) g[i] = rnd();
  const out = new Float32Array(N * N);
  for (let y = 0; y < N; y++) {
    for (let x = 0; x < N; x++) {
      const fx = (x / N) * cells;
      const fy = (y / N) * cells;
      const ix = Math.floor(fx);
      const iy = Math.floor(fy);
      const tx = fx - ix;
      const ty = fy - iy;
      const sx = tx * tx * (3 - 2 * tx);
      const sy = ty * ty * (3 - 2 * ty);
      const a = g[(iy % cells) * cells + (ix % cells)];
      const b = g[(iy % cells) * cells + ((ix + 1) % cells)];
      const c = g[((iy + 1) % cells) * cells + (ix % cells)];
      const d = g[((iy + 1) % cells) * cells + ((ix + 1) % cells)];
      out[y * N + x] = a + (b - a) * sx + (c - a) * sy + (a - b - c + d) * sx * sy;
    }
  }
  return out;
}

// ---------------------------------------------------------------- water (grid + wakes)
const MAX_BOATS = 6;
function makeWaveWaterMaterial(theme, U, Q) {
  const m = new THREE.MeshStandardMaterial({ color: theme.water, roughness: 0.08, metalness: 0, transparent: true, opacity: 0.94, envMapIntensity: 1.3 });
  m.onBeforeCompile = (sh) => {
    sh.uniforms.uTime = U.uTime;
    sh.uniforms.uWaveT = U.uWaveT;
    sh.uniforms.uBoat = U.uBoat;
    sh.uniforms.uBoatSp = U.uBoatSp;
    sh.uniforms.uDeep = { value: new THREE.Color(theme.waterDeep) };
    sh.uniforms.uCenter = U.uWaterCenter;
    sh.uniforms.uLava = { value: theme.lava ? 1 : 0 };
    const field = `
      uniform float uWaveT;
      uniform vec4 uBoat[${MAX_BOATS}];
      uniform float uBoatSp[${MAX_BOATS}];
      uniform vec2 uCenter;
      varying vec3 vWPos;
      varying float vFoam;
      ${waveGLSL()}
      // analytic hull interaction: depression under the hull, bow bulge, Kelvin V wake (19.5 deg arms) + transverse waves
      float boats(vec2 p, out float foam) {
        float h = 0.0;
        foam = 0.0;
        for (int i = 0; i < ${MAX_BOATS}; i++) {
          float sp = uBoatSp[i];
          if (sp <= 0.0) continue;
          vec2 q = p - uBoat[i].xy;
          vec2 f = uBoat[i].zw;
          float along = -dot(q, f);
          float lat = dot(q, vec2(-f.y, f.x));
          if (along < -6.0 || along > 70.0 || abs(lat) > 30.0) continue;
          float k = clamp(sp / 30.0, 0.0, 1.0);
          float ell = (along / 1.7) * (along / 1.7) + (lat / 0.95) * (lat / 0.95);
          h -= 0.32 * exp(-ell);
          h += 0.22 * k * exp(-((along + 1.9) * (along + 1.9)) / 0.7 - lat * lat / 1.1);
          foam += exp(-pow((sqrt(ell) - 1.05) / 0.16, 2.0)) * (0.3 + 0.6 * k);
          if (along > 0.5) {
            float arm = abs(abs(lat) - along * 0.354);
            float w = 0.55 + along * 0.05;
            float env = exp(-along / 26.0) * k;
            float armA = exp(-(arm * arm) / (w * w)) * env;
            h += 0.24 * armA * sin(along * 1.25 + abs(lat) * 1.7 - uWaveT * 3.0);
            float inside = smoothstep(0.0, 1.5, along * 0.354 - abs(lat));
            h += 0.08 * env * inside * sin(along * 0.9 - uWaveT * 2.2);
            foam += armA * 1.1 * exp(-along / 18.0) + inside * exp(-along / 5.0) * k * 0.9 * exp(-lat * lat / 1.5);
          }
        }
        return h;
      }
      float waterH(vec2 p, out float foam) {
        float fade = 1.0 - smoothstep(110.0, 230.0, length(p - uCenter));
        return ddWave(p, uWaveT) * fade + boats(p, foam);
      }`;
    sh.vertexShader = sh.vertexShader
      .replace('#include <common>', '#include <common>\n' + field)
      .replace(
        '#include <beginnormal_vertex>',
        `vec3 wp0 = (modelMatrix * vec4(position, 1.0)).xyz;
        float fo0; float fo1; float fo2;
        float wh = waterH(wp0.xz, fo0);
        float e = 0.35;
        float hx = waterH(wp0.xz + vec2(e, 0.0), fo1);
        float hz = waterH(wp0.xz + vec2(0.0, e), fo2);
        vec3 objectNormal = normalize(vec3(wh - hx, e, wh - hz));
        vFoam = fo0;
        #ifdef USE_TANGENT
          vec3 objectTangent = vec3( tangent.xyz );
        #endif`
      )
      .replace('#include <begin_vertex>', '#include <begin_vertex>\ntransformed.y += wh;')
      .replace('#include <project_vertex>', '#include <project_vertex>\nvWPos = (modelMatrix * vec4(transformed, 1.0)).xyz;');
    sh.fragmentShader = sh.fragmentShader
      .replace(
        '#include <common>',
        `#include <common>
        varying vec3 vWPos;
        varying float vFoam;
        uniform float uTime;
        uniform vec3 uDeep;
        uniform float uLava;
        float lavaCrust = 0.0;
        uniform vec4 uBoat[${MAX_BOATS}];
        uniform float uBoatSp[${MAX_BOATS}];
        // per-pixel Kelvin wake foam: the arms are ~1 m wide, too thin for the vertex grid to carry
        float wakeFoam(vec2 p) {
          float foam = 0.0;
          for (int i = 0; i < ${MAX_BOATS}; i++) {
            float sp = uBoatSp[i];
            if (sp <= 0.0) continue;
            vec2 q = p - uBoat[i].xy;
            vec2 f = uBoat[i].zw;
            float along = -dot(q, f);
            float lat = dot(q, vec2(-f.y, f.x));
            if (along < 0.4 || along > 60.0 || abs(lat) > 24.0) continue;
            float k = clamp(sp / 26.0, 0.0, 1.0);
            float arm = abs(abs(lat) - along * 0.354);
            float w = 0.3 + along * 0.028;
            float env = exp(-along / 24.0) * k;
            // broken foam along the arms: streaks that drift backwards
            float br = smoothstep(0.2, 0.85, 0.5 + 0.5 * sin(along * 1.6 - uTime * 4.0 + abs(lat) * 0.9));
            foam += exp(-(arm * arm) / (w * w)) * env * (0.45 + 0.75 * br);
            // short churned trail right behind the hull
            foam += exp(-lat * lat / (0.22 + along * 0.05)) * exp(-along / 6.0) * k * (0.5 + 0.4 * br);
          }
          return foam;
        }`
      )
      .replace(
        '#include <normal_fragment_maps>',
        `#include <normal_fragment_maps>
        {
          vec2 p = vWPos.xz; float t = uTime;
          float gx = sin(p.x * 1.7 - p.y * 1.3 + t * 3.1) * 0.05 + sin(p.x * 3.3 + t * 4.0) * 0.025;
          float gz = sin(p.y * 1.9 + p.x * 0.8 - t * 2.7) * 0.05 + sin(p.y * 3.7 - t * 3.6) * 0.025;
          vec3 wn = normalize(normalize((inverse(viewMatrix) * vec4(normal, 0.0)).xyz) + vec3(-gx, 0.0, -gz));
          normal = normalize((viewMatrix * vec4(wn, 0.0)).xyz);
          float fr = pow(1.0 - clamp(abs(dot(normalize(vViewPosition), normal)), 0.0, 1.0), 3.0);
          diffuseColor.rgb = mix(diffuseColor.rgb, uDeep, 0.45 * (1.0 - fr));
          float n = 0.5 + 0.25 * sin(p.x * 2.3 + t * 1.7) * sin(p.y * 2.9 - t * 1.3) + 0.25 * sin((p.x + p.y) * 5.1 + t * 2.1);
          float foam = smoothstep(0.25, 0.9, (vFoam * 0.4 + wakeFoam(p)) * (0.55 + 0.6 * n)) * 0.88;
          diffuseColor.rgb = mix(diffuseColor.rgb, vec3(0.92, 0.96, 0.98), foam);
          roughnessFactor = mix(roughnessFactor, 0.7, foam);
          diffuseColor.a = mix(mix(0.78, 0.97, fr), 1.0, foam);
          if (uLava > 0.5) {
            // molten channel: drifting black crust over glowing rock, wake = bright molten splash
            float cn = 0.5 + 0.3 * sin(p.x * 0.21 + t * 0.15) * sin(p.y * 0.17 - t * 0.11) + 0.2 * sin((p.x - p.y) * 0.6 + t * 0.4);
            lavaCrust = smoothstep(0.42, 0.62, cn) * (1.0 - foam);
            diffuseColor.rgb = mix(vec3(0.9, 0.22, 0.03), vec3(0.06, 0.04, 0.035), lavaCrust);
            diffuseColor.a = 1.0;
            roughnessFactor = mix(0.55, 0.92, lavaCrust);
          }
        }`
      );
  };
  if (theme.lava) {
    m.transparent = false;
    const ob = m.onBeforeCompile;
    m.onBeforeCompile = (sh) => {
      ob(sh);
      sh.fragmentShader = sh.fragmentShader.replace('#include <emissivemap_fragment>', '#include <emissivemap_fragment>\nif (uLava > 0.5) totalEmissiveRadiance += vec3(2.6, 0.75, 0.1) * (1.0 - lavaCrust) * (0.85 + 0.15 * sin(uTime * 2.3 + vWPos.x * 0.2));');
    };
  }
  m.customProgramCacheKey = () => 'dd-wavewater' + (theme.lava ? '-lava' : '');
  return m;
}

// grid finer near the centre (follows the camera), reaching the horizon at the rim
function waterGridGeo(n) {
  const pos = [];
  const idx = [];
  const half = n / 2;
  const R = 4600;
  const map = (k) => {
    const t = (k - half) / half;
    return Math.sign(t) * (Math.pow(Math.abs(t), 2.6) * R + Math.abs(t) * 6);
  };
  for (let j = 0; j <= n; j++) for (let i = 0; i <= n; i++) pos.push(map(i), 0, map(j));
  const W = n + 1;
  for (let j = 0; j < n; j++)
    for (let i = 0; i < n; i++) {
      const a = j * W + i;
      idx.push(a, a + W, a + 1, a + 1, a + W, a + W + 1);
    }
  const g = new THREE.BufferGeometry();
  g.setAttribute('position', new THREE.Float32BufferAttribute(pos, 3));
  g.setAttribute('normal', new THREE.Float32BufferAttribute(new Array(pos.length).fill(0).map((_, i) => (i % 3 === 1 ? 1 : 0)), 3));
  g.setIndex(idx);
  g.boundingSphere = new THREE.Sphere(new THREE.Vector3(), R * 1.5);
  return g;
}

// low tier: foam ribbons trailing each boat (decal on the flat water)
class WakeRibbons {
  constructor(n, len) {
    this.n = n;
    this.len = len;
    this.pts = Array.from({ length: n }, () => []);
    const g = new THREE.BufferGeometry();
    this.pos = new Float32Array(n * len * 2 * 3);
    this.alpha = new Float32Array(n * len * 2);
    g.setAttribute('position', new THREE.BufferAttribute(this.pos, 3).setUsage(THREE.DynamicDrawUsage));
    g.setAttribute('alpha', new THREE.BufferAttribute(this.alpha, 1).setUsage(THREE.DynamicDrawUsage));
    const idx = [];
    for (let b = 0; b < n; b++)
      for (let k = 0; k < len - 1; k++) {
        const a = (b * len + k) * 2;
        idx.push(a, a + 1, a + 2, a + 1, a + 3, a + 2);
      }
    g.setIndex(idx);
    this.geo = g;
    this.mat = new THREE.ShaderMaterial({
      vertexShader: 'attribute float alpha; varying float vA; void main(){ vA = alpha; gl_Position = projectionMatrix * modelViewMatrix * vec4(position,1.0); }',
      fragmentShader: 'varying float vA; void main(){ gl_FragColor = vec4(vec3(0.95), vA * 0.75); }',
      transparent: true,
      depthWrite: false,
    });
    this.mesh = new THREE.Mesh(g, this.mat);
    this.mesh.frustumCulled = false;
    this.mesh.renderOrder = 3;
  }
  update(i, on, x, y, z, fx, fz, sp) {
    const P = this.pts[i];
    if (on) {
      const last = P[0];
      if (!last || (last[0] - x) ** 2 + (last[2] - z) ** 2 > 1.0) {
        P.unshift([x, y + 0.06, z, fx, fz, Math.min(1, sp / 25)]);
        if (P.length > this.len) P.length = this.len;
      }
    } else if (P.length) P.pop();
    const base = i * this.len * 2;
    for (let k = 0; k < this.len; k++) {
      const p = P[Math.min(k, P.length - 1)];
      const o = (base + k * 2) * 3;
      if (!p) {
        this.alpha[base + k * 2] = this.alpha[base + k * 2 + 1] = 0;
        continue;
      }
      const w = 0.8 + k * 0.35;
      const rx = -p[4];
      const rz = p[3];
      this.pos[o] = p[0] + rx * w;
      this.pos[o + 1] = p[1];
      this.pos[o + 2] = p[2] + rz * w;
      this.pos[o + 3] = p[0] - rx * w;
      this.pos[o + 4] = p[1];
      this.pos[o + 5] = p[2] - rz * w;
      const a = k < P.length ? (1 - k / this.len) * p[5] : 0;
      this.alpha[base + k * 2] = this.alpha[base + k * 2 + 1] = a;
    }
    this.geo.attributes.position.needsUpdate = true;
    this.geo.attributes.alpha.needsUpdate = true;
  }
  dispose() {
    this.geo.dispose();
    this.mat.dispose();
  }
}

// ---------------------------------------------------------------- road surface
function roadTextures(theme, aniso, Q) {
  const N = Q.roadTex || 1024;
  const ppm = N / (2 * WALL_HW);
  const X = (m) => (m + WALL_HW) * ppm;
  const rnd = mulberry32(17);
  const n1 = tileNoise(N, 32, 5);
  const n2 = tileNoise(N, 128, 9);
  const height = new Float32Array(N * N);
  const col = canvasTex(
    N,
    N,
    (g) => {
      const img = g.createImageData(N, N);
      const A = new THREE.Color(theme.asphalt);
      const S = new THREE.Color(theme.shoulder);
      const wet = theme.night || theme.storm;
      for (let y = 0; y < N; y++) {
        for (let x = 0; x < N; x++) {
          const i = y * N + x;
          const m = x / ppm - WALL_HW;
          const road = Math.abs(m) <= ROAD_HW;
          const grain = rnd();
          const agg = grain > 0.93 ? 0.16 : grain < 0.06 ? -0.12 : (grain - 0.5) * 0.08;
          let k = 1 + (n1[i] - 0.5) * 0.22 + (n2[i] - 0.5) * 0.12 + agg;
          let c = road ? A : S;
          if (road) {
            // darker oily racing line in each lane, lighter worn edges
            const lane = Math.abs(Math.abs(m) - 4.0);
            k *= 1 - 0.1 * Math.exp(-lane * lane * 0.9);
            if (wet && n1[i] > 0.62) k *= 0.82;
          } else k = 1 + (n2[i] - 0.5) * 0.4 + agg * 1.5;
          height[i] = agg * 3 + n2[i] * 0.4;
          const o = i * 4;
          img.data[o] = Math.min(255, c.r * 255 * k);
          img.data[o + 1] = Math.min(255, c.g * 255 * k);
          img.data[o + 2] = Math.min(255, c.b * 255 * k);
          img.data[o + 3] = 255;
        }
      }
      g.putImageData(img, 0, 0);
      // patches
      for (let i = 0; i < 9; i++) {
        const w = (1.2 + rnd() * 3) * ppm;
        const h = (1 + rnd() * 5) * ppm;
        const x = X(-ROAD_HW + 0.5) + rnd() * (2 * ROAD_HW - 1) * ppm - w / 2;
        const y = rnd() * N;
        g.fillStyle = rnd() < 0.5 ? 'rgba(0,0,0,0.18)' : 'rgba(255,255,255,0.05)';
        g.fillRect(x, y, w, h);
        g.strokeStyle = 'rgba(0,0,0,0.35)';
        g.lineWidth = 2;
        g.strokeRect(x, y, w, h);
      }
      // cracks
      g.strokeStyle = 'rgba(8,8,10,0.55)';
      for (let i = 0; i < 26; i++) {
        let x = X(-ROAD_HW) + rnd() * 2 * ROAD_HW * ppm;
        let y = rnd() * N;
        g.lineWidth = 1 + rnd() * 1.6;
        g.beginPath();
        g.moveTo(x, y);
        for (let k = 0; k < 9; k++) {
          x += (rnd() - 0.5) * 40;
          y += (rnd() - 0.3) * 36;
          g.lineTo(x, y);
        }
        g.stroke();
      }
      // old tyre marks
      for (let i = 0; i < 14; i++) {
        const x0 = X(-ROAD_HW + 1) + rnd() * (2 * ROAD_HW - 2) * ppm;
        const y0 = rnd() * N;
        const bend = (rnd() - 0.5) * 200;
        g.strokeStyle = 'rgba(0,0,0,' + (0.12 + rnd() * 0.18) + ')';
        g.lineWidth = 0.18 * ppm;
        for (const off of [0, 1.1 * ppm]) {
          g.beginPath();
          g.moveTo(x0 + off, y0);
          g.quadraticCurveTo(x0 + off + bend, y0 + 160, x0 + off + bend * 0.4, y0 + 330);
          g.stroke();
        }
      }
      // edge lines + centre dashes (hazard colour)
      g.fillStyle = theme.line;
      g.fillRect(X(-ROAD_HW + 0.25), 0, 0.22 * ppm, N);
      g.fillRect(X(ROAD_HW - 0.47), 0, 0.22 * ppm, N);
      g.fillStyle = theme.center;
      for (let v = 0; v < N; v += N / 2) g.fillRect(X(-0.14), v + N * 0.06, 0.28 * ppm, N * 0.26);
      // worn paint
      g.fillStyle = 'rgba(30,30,30,0.25)';
      for (let i = 0; i < 400; i++) g.fillRect(X(-ROAD_HW + 0.25) + rnd() * 0.22 * ppm, rnd() * N, 3, 2);
    },
    { repeat: true, wrapS: THREE.ClampToEdgeWrapping, aniso }
  );
  let nrm = null;
  if (Q.roadNormal) {
    const M = N / 2;
    nrm = canvasTex(
      M,
      M,
      (g) => {
        const img = g.createImageData(M, M);
        const hAt = (x, y) => height[((y * 2 + N) % N) * N + ((x * 2 + N) % N)];
        for (let y = 0; y < M; y++)
          for (let x = 0; x < M; x++) {
            const dx = hAt(x + 1, y) - hAt(x - 1, y);
            const dy = hAt(x, y + 1) - hAt(x, y - 1);
            const l = Math.hypot(dx, dy, 0.5);
            const o = (y * M + x) * 4;
            img.data[o] = 128 + (-dx / l) * 127;
            img.data[o + 1] = 128 + (dy / l) * 127;
            img.data[o + 2] = 128 + (0.5 / l) * 127;
            img.data[o + 3] = 255;
          }
        g.putImageData(img, 0, 0);
      },
      { repeat: true, linear: true, wrapS: THREE.ClampToEdgeWrapping }
    );
  }
  return { map: col, normal: nrm };
}

// raised curbs (real geometry): alternating red/white blocks with a sloped inner edge
function buildCurbs(track, theme, runs, Q) {
  const P = [];
  const N = [];
  const C = [];
  const idx = [];
  const cA = new THREE.Color(theme.curbA);
  const cB = new THREE.Color(theme.curbB);
  const prof = [[0, 0.0], [0.25, 0.065], [CURB_W - 0.2, 0.075], [CURB_W, 0.02]];
  for (const [a, b] of runs) {
    for (const sg of [-1, 1]) {
      const base = P.length / 3;
      for (let i = a; i <= b; i++) {
        const cx = track.X[i];
        const cz = track.Z[i];
        const cy = track.H[i];
        const rx = Math.cos(track.PSI[i]);
        const rz = Math.sin(track.PSI[i]);
        const bk = track.B[i];
        const cb = Math.cos(bk);
        const sb = Math.sin(bk);
        const stripe = Math.floor((i * STEP) / 2) % 2 ? cA : cB;
        for (const [w, hh] of prof) {
          const d = sg * (ROAD_HW + w);
          P.push(cx + rx * d * cb, cy - d * sb + 0.02 + hh, cz + rz * d * cb);
          N.push(rx * sb * 0.3, 1, rz * sb * 0.3);
          const k = hh < 0.03 ? 0.75 : 1;
          C.push(stripe.r * k, stripe.g * k, stripe.b * k);
        }
      }
      for (let j = 0; j < b - a; j++)
        for (let q = 0; q < 3; q++) {
          const p0 = base + j * 4 + q;
          const p1 = p0 + 1;
          const p2 = p0 + 4;
          const p3 = p1 + 4;
          if (sg > 0) idx.push(p0, p2, p1, p1, p2, p3);
          else idx.push(p0, p1, p2, p1, p3, p2);
        }
    }
  }
  const g = new THREE.BufferGeometry();
  g.setAttribute('position', new THREE.Float32BufferAttribute(P, 3));
  g.setAttribute('normal', new THREE.Float32BufferAttribute(N, 3));
  g.setAttribute('color', new THREE.Float32BufferAttribute(C, 3));
  g.setIndex(idx);
  g.computeVertexNormals();
  g.computeBoundingSphere();
  const m = new THREE.Mesh(g, new THREE.MeshStandardMaterial({ vertexColors: true, roughness: 0.62, polygonOffset: true, polygonOffsetFactor: -1, polygonOffsetUnits: -3 }));
  m.receiveShadow = Q.shadows > 0;
  return m;
}

// dirt berm outside the barriers, blending the road edge into the terrain
function buildBerms(track, terrain, theme, runs, Q) {
  const P = [];
  const C = [];
  const idx = [];
  const dirt = new THREE.Color(theme.dirt).multiplyScalar(0.8);
  const tmp = {};
  for (const [a, b] of runs) {
    for (const sg of [-1, 1]) {
      const base = P.length / 3;
      let cnt = 0;
      for (let i = a; i <= b; i += 2) {
        const s = i * STEP;
        const F = track.frameInto(s, tmp);
        const roadY = F.y - sg * WALL_HW * Math.sin(F.bank);
        for (const [d, al] of [[WALL_HW + 0.3, 1], [WALL_HW + 2.0, 0.85], [WALL_HW + 4.2, 0]]) {
          const x = F.x + F.rx * sg * d;
          const z = F.z + F.rz * sg * d;
          const ty = terrain.heightAt(x, z);
          const y = d < WALL_HW + 1 ? Math.max(ty, roadY - 0.35) + 0.04 : lerp(roadY - 0.3, ty, (d - WALL_HW) / 4.2) + 0.06;
          P.push(x, Math.max(y, ty + 0.03), z);
          C.push(dirt.r, dirt.g, dirt.b, al);
        }
        cnt++;
      }
      for (let j = 0; j < cnt - 1; j++)
        for (let q = 0; q < 2; q++) {
          const p0 = base + j * 3 + q;
          if (sg > 0) idx.push(p0, p0 + 3, p0 + 1, p0 + 1, p0 + 3, p0 + 4);
          else idx.push(p0, p0 + 1, p0 + 3, p0 + 1, p0 + 4, p0 + 3);
        }
    }
  }
  const g = new THREE.BufferGeometry();
  g.setAttribute('position', new THREE.Float32BufferAttribute(P, 3));
  g.setAttribute('color', new THREE.Float32BufferAttribute(C, 4));
  g.setIndex(idx);
  g.computeVertexNormals();
  g.computeBoundingSphere();
  const mat = new THREE.MeshStandardMaterial({ vertexColors: true, transparent: true, roughness: 0.98, depthWrite: false, map: detailTexture() });
  const m = new THREE.Mesh(g, mat);
  m.renderOrder = 1;
  m.receiveShadow = Q.shadows > 0;
  return m;
}

// accumulating skid marks (ring buffer of quads)
class SkidMarks {
  constructor(maxQuads) {
    this.max = maxQuads;
    this.pos = new Float32Array(maxQuads * 4 * 3);
    this.alpha = new Float32Array(maxQuads * 4);
    const idx = new Uint32Array(maxQuads * 6);
    for (let q = 0; q < maxQuads; q++) {
      const a = q * 4;
      idx.set([a, a + 1, a + 2, a + 1, a + 3, a + 2], q * 6);
    }
    const g = new THREE.BufferGeometry();
    g.setAttribute('position', new THREE.BufferAttribute(this.pos, 3).setUsage(THREE.DynamicDrawUsage));
    g.setAttribute('alpha', new THREE.BufferAttribute(this.alpha, 1).setUsage(THREE.DynamicDrawUsage));
    g.setIndex(new THREE.BufferAttribute(idx, 1));
    g.boundingSphere = new THREE.Sphere(new THREE.Vector3(), 1e5);
    this.geo = g;
    this.mat = new THREE.ShaderMaterial({
      vertexShader: 'attribute float alpha; varying float vA; void main(){ vA = alpha; gl_Position = projectionMatrix * modelViewMatrix * vec4(position,1.0); }',
      fragmentShader: 'varying float vA; void main(){ gl_FragColor = vec4(0.02, 0.02, 0.025, vA); }',
      transparent: true,
      depthWrite: false,
      polygonOffset: true,
      polygonOffsetFactor: -2,
      polygonOffsetUnits: -6,
    });
    this.mesh = new THREE.Mesh(g, this.mat);
    this.mesh.renderOrder = 1;
    this.mesh.frustumCulled = false;
    this.head = 0;
    this.prev = new Map();
    this.dirty = false;
  }
  // continue a mark for key (racer*4+wheel) at world point p with lateral dir (rx, rz)
  mark(key, x, y, z, rx, rz, w, a) {
    const pr = this.prev.get(key);
    const cur = [x + rx * w, y, z + rz * w, x - rx * w, y, z - rz * w];
    if (pr && (pr[0] - cur[0]) ** 2 + (pr[2] - cur[2]) ** 2 < 6) {
      if ((pr[0] - cur[0]) ** 2 + (pr[2] - cur[2]) ** 2 < 0.12) return;
      const q = this.head;
      this.head = (this.head + 1) % this.max;
      const o = q * 12;
      this.pos.set([pr[0], pr[1], pr[2], pr[3], pr[4], pr[5], cur[0], cur[1], cur[2], cur[3], cur[4], cur[5]], o);
      this.alpha.set([pr[6], pr[6], a, a], q * 4);
      this.dirty = true;
    }
    cur.push(a);
    this.prev.set(key, cur);
  }
  lift(key) {
    this.prev.delete(key);
  }
  flush() {
    if (!this.dirty) return;
    this.dirty = false;
    this.geo.attributes.position.needsUpdate = true;
    this.geo.attributes.alpha.needsUpdate = true;
  }
  clear() {
    this.alpha.fill(0);
    this.prev.clear();
    this.dirty = true;
    this.flush();
  }
  dispose() {
    this.geo.dispose();
    this.mat.dispose();
  }
}

// ---------------------------------------------------------------- grass field + terrain splat
function terrainDataTexture(track, terrain, theme) {
  const { nx, nz, h, minD, carved, nor } = terrain;
  const data = new Float32Array(nx * nz * 2);
  for (let k = 0; k < nx * nz; k++) {
    data[k * 2] = h[k];
    const ok = minD[k] > WALL_HW + 1.6 && !carved[k] && nor[k * 3 + 1] > 0.82 && h[k] > track.waterY + 1.0;
    data[k * 2 + 1] = ok ? 1 : 0;
  }
  const t = new THREE.DataTexture(data, nx, nz, THREE.RGFormat, THREE.FloatType);
  t.needsUpdate = true;
  t.minFilter = t.magFilter = THREE.NearestFilter;
  return t;
}

function buildGrassField(track, terrain, theme, Q, U) {
  const n = Math.round((Q.grassField || 0) * (theme.tufts ?? 1));
  if (n < 200) return null;
  const tile = Q.grassTile || 56;
  const blade = new THREE.BufferGeometry();
  // 3-segment tapered blade (7 verts) in the XY plane, base at y=0
  const bp = [-0.05, 0, 0, 0.05, 0, 0, -0.035, 0.35, 0, 0.035, 0.35, 0, -0.018, 0.62, 0, 0.018, 0.62, 0, 0, 0.82, 0];
  blade.setAttribute('position', new THREE.Float32BufferAttribute(bp, 3));
  blade.setIndex([0, 1, 2, 1, 3, 2, 2, 3, 4, 3, 5, 4, 4, 5, 6]);
  const g = new THREE.InstancedBufferGeometry();
  g.index = blade.index;
  g.attributes.position = blade.attributes.position;
  const off = new Float32Array(n * 4);
  const rnd = mulberry32(track.def.seed + 77);
  for (let i = 0; i < n; i++) {
    off[i * 4] = rnd() * tile;
    off[i * 4 + 1] = rnd() * tile;
    off[i * 4 + 2] = rnd() * TAU;
    off[i * 4 + 3] = 0.6 + rnd() * 0.9;
  }
  g.setAttribute('off', new THREE.InstancedBufferAttribute(off, 4));
  g.instanceCount = n;
  g.boundingSphere = new THREE.Sphere(new THREE.Vector3(), 1e5);
  const tex = terrainDataTexture(track, terrain, theme);
  const c0 = new THREE.Color(theme.grass[0]);
  const c1 = new THREE.Color(theme.grass[2]);
  const mat = new THREE.MeshStandardMaterial({ vertexColors: false, roughness: 0.92, side: THREE.DoubleSide });
  const u = {
    uTime: U.uTime,
    uCam: U.uCam,
    uKarts: U.uKarts,
    uTer: { value: tex },
    uTerO: { value: new THREE.Vector2(terrain.minX, terrain.minZ) },
    uTerN: { value: new THREE.Vector2(terrain.nx, terrain.nz) },
    uCell: { value: terrain.cell },
    uTile: { value: tile },
    uC0: { value: new THREE.Vector3(c0.r, c0.g, c0.b) },
    uC1: { value: new THREE.Vector3(c1.r, c1.g, c1.b) },
  };
  mat.onBeforeCompile = (sh) => {
    Object.assign(sh.uniforms, u);
    sh.vertexShader = sh.vertexShader
      .replace(
        '#include <common>',
        `#include <common>
        attribute vec4 off;
        uniform float uTime; uniform vec3 uCam; uniform vec4 uKarts[6];
        uniform sampler2D uTer; uniform vec2 uTerO; uniform vec2 uTerN; uniform float uCell; uniform float uTile;
        uniform vec3 uC0; uniform vec3 uC1;
        varying vec3 vGC;
        vec2 terAt(vec2 p) {
          vec2 f = clamp((p - uTerO) / uCell, vec2(0.0), uTerN - 1.001);
          ivec2 i = ivec2(floor(f));
          vec2 t = f - vec2(i);
          vec2 a = texelFetch(uTer, i, 0).rg;
          vec2 b = texelFetch(uTer, i + ivec2(1, 0), 0).rg;
          vec2 c = texelFetch(uTer, i + ivec2(0, 1), 0).rg;
          vec2 d = texelFetch(uTer, i + ivec2(1, 1), 0).rg;
          return vec2(mix(mix(a.r, b.r, t.x), mix(c.r, d.r, t.x), t.y), min(min(a.g, b.g), min(c.g, d.g)));
        }`
      )
      .replace('#include <beginnormal_vertex>', 'vec3 objectNormal = vec3(0.0, 1.0, 0.0);')
      .replace(
        '#include <begin_vertex>',
        `vec2 wp = off.xy + uTile * floor((uCam.xz - off.xy) / uTile + 0.5);
        vec2 ter = terAt(wp);
        float dist = length(wp - uCam.xz);
        float sc = off.w * ter.y * (1.0 - smoothstep(uTile * 0.32, uTile * 0.5, dist));
        float ca = cos(off.z), sa = sin(off.z);
        vec3 transformed = vec3(position.x * ca, position.y * sc, position.x * sa);
        float ph = wp.x * 0.37 + wp.y * 0.29;
        float sw = (sin(uTime * 1.9 + ph) * 0.16 + sin(uTime * 3.3 + ph * 1.6) * 0.06) * position.y;
        transformed.x += sw;
        transformed.z += sw * 0.5;
        // bend away from karts
        for (int k = 0; k < 6; k++) {
          vec2 dv = wp - uKarts[k].xz;
          float dd = length(dv);
          if (dd < 2.2) transformed.xz += normalize(dv + 1e-4) * (2.2 - dd) * 0.45 * position.y * 1.6;
        }
        transformed += vec3(wp.x, ter.x - 0.04, wp.y);
        float hh = fract(sin(dot(off.xy, vec2(12.9898, 78.233))) * 43758.5453);
        vGC = mix(uC0, uC1, hh) * (0.45 + 0.75 * position.y);`
      )
      .replace('#include <project_vertex>', 'vec4 mvPosition = viewMatrix * vec4(transformed, 1.0); gl_Position = projectionMatrix * mvPosition;')
      .replace('#include <worldpos_vertex>', 'vec4 worldPosition = vec4(transformed, 1.0);');
    sh.fragmentShader = sh.fragmentShader
      .replace('#include <common>', '#include <common>\nvarying vec3 vGC;')
      .replace('#include <color_fragment>', '#include <color_fragment>\ndiffuseColor.rgb = vGC;');
  };
  mat.customProgramCacheKey = () => 'dd-grassfield';
  const mesh = new THREE.Mesh(g, mat);
  mesh.frustumCulled = false;
  mesh.userData.tex = tex;
  return mesh;
}

let SPLAT_TEX = null;
function splatTextures() {
  if (SPLAT_TEX) return SPLAT_TEX;
  const N = 256;
  const a = tileNoise(N, 16, 3);
  const b = tileNoise(N, 64, 4);
  const c = tileNoise(N, 8, 8);
  SPLAT_TEX = canvasTex(
    N,
    N,
    (g) => {
      const img = g.createImageData(N, N);
      const rnd = mulberry32(55);
      for (let i = 0; i < N * N; i++) {
        // R: grass clumps + strokes, G: rock cracks/strata, B: dirt pebbles
        const gr = 0.72 + a[i] * 0.3 + (rnd() - 0.5) * 0.18;
        const ridge = 1 - Math.abs(b[i] * 2 - 1);
        const rk = 0.62 + c[i] * 0.3 + Math.pow(ridge, 6) * 0.25 - (ridge > 0.96 ? 0.35 : 0);
        const dt = 0.75 + b[i] * 0.2 + (rnd() > 0.92 ? 0.25 : 0) - (rnd() < 0.05 ? 0.2 : 0);
        const o = i * 4;
        img.data[o] = clamp(gr, 0, 1) * 255;
        img.data[o + 1] = clamp(rk, 0, 1) * 255;
        img.data[o + 2] = clamp(dt, 0, 1) * 255;
        img.data[o + 3] = 255;
      }
      g.putImageData(img, 0, 0);
    },
    { repeat: true, linear: true }
  );
  return SPLAT_TEX;
}
// terrain material with a slope/height splat (grass / rock / dirt detail), medium + high
function splatTerrainMaterial(theme) {
  const m = new THREE.MeshStandardMaterial({ vertexColors: true, roughness: 0.95, metalness: 0 });
  const tex = splatTextures();
  m.onBeforeCompile = (sh) => {
    sh.uniforms.uSplat = { value: tex };
    sh.vertexShader = sh.vertexShader
      .replace('#include <common>', '#include <common>\nvarying vec3 vTW; varying vec3 vTN;')
      .replace('#include <worldpos_vertex>', '#include <worldpos_vertex>\nvTW = (modelMatrix * vec4(transformed, 1.0)).xyz; vTN = normalize(mat3(modelMatrix) * objectNormal);');
    sh.fragmentShader = sh.fragmentShader
      .replace('#include <common>', '#include <common>\nvarying vec3 vTW; varying vec3 vTN; uniform sampler2D uSplat;')
      .replace(
        '#include <color_fragment>',
        `#include <color_fragment>
        {
          vec3 n = normalize(vTN);
          float rock = smoothstep(0.82, 0.6, n.y);
          float gA = texture2D(uSplat, vTW.xz * 0.21).r * 0.6 + texture2D(uSplat, vTW.xz * 0.043).r * 0.4;
          vec3 bw = pow(abs(n), vec3(4.0)); bw /= (bw.x + bw.y + bw.z);
          float rA = texture2D(uSplat, vTW.zy * 0.11).g * bw.x + texture2D(uSplat, vTW.xz * 0.11).g * bw.y + texture2D(uSplat, vTW.xy * 0.11).g * bw.z;
          float dA = texture2D(uSplat, vTW.xz * 0.35).b;
          float dirt = smoothstep(0.08, 0.0, abs(diffuseColor.g - diffuseColor.r) - 0.02);
          float detail = mix(mix(gA, dA, dirt * 0.6), rA, rock);
          diffuseColor.rgb *= 0.55 + detail * 0.75;
        }`
      );
  };
  m.customProgramCacheKey = () => 'dd-splat';
  return m;
}

// ---------------------------------------------------------------- graffiti, tyres, fences, floodlights
const TAGS = ['WRECK', 'NO BRAKES', 'DIESEL', 'GLASS', 'STATIC', 'VELVET', 'KICK', 'HILLRUN', 'DOWN!', 'BURN'];
const GRAF_COLS = [['#ffc21a', '#ff2e3c'], ['#29e3ff', '#9a5cff'], ['#7dff3a', '#14b8c8'], ['#ff2e88', '#ffc21a'], ['#ff5e00', '#17161b'], ['#e8e8e8', '#ff2e3c']];
let GRAF_TEX = null;
function graffitiTexture() {
  if (GRAF_TEX) return GRAF_TEX;
  GRAF_TEX = canvasTex(1024, 512, (g) => {
    const rnd = mulberry32(99);
    // concrete
    const img = g.createImageData(1024, 512);
    for (let i = 0; i < 1024 * 512; i++) {
      const v = 112 + (rnd() - 0.5) * 30;
      img.data[i * 4] = v;
      img.data[i * 4 + 1] = v * 0.98;
      img.data[i * 4 + 2] = v * 0.95;
      img.data[i * 4 + 3] = 255;
    }
    g.putImageData(img, 0, 0);
    g.fillStyle = 'rgba(0,0,0,0.25)';
    for (let x = 0; x < 1024; x += 128) g.fillRect(x, 0, 3, 512);
    for (let k = 0; k < 4; k++) {
      const x0 = (k % 2) * 512;
      const y0 = Math.floor(k / 2) * 256;
      const word = TAGS[Math.floor(rnd() * TAGS.length)];
      const [c1, c2] = GRAF_COLS[Math.floor(rnd() * GRAF_COLS.length)];
      g.save();
      g.translate(x0 + 256, y0 + 132);
      g.rotate((rnd() - 0.5) * 0.18);
      g.transform(1, 0, -0.25, 1, 0, 0);
      g.font = '900 ' + (word.length > 6 ? 88 : 118) + 'px ' + DISPLAY_FONT;
      g.textAlign = 'center';
      g.textBaseline = 'middle';
      g.lineJoin = 'round';
      // splash behind
      g.fillStyle = c2;
      g.globalAlpha = 0.85;
      for (let i = 0; i < 9; i++) {
        g.beginPath();
        g.arc((rnd() - 0.5) * 360, (rnd() - 0.5) * 120, 20 + rnd() * 50, 0, TAU);
        g.fill();
      }
      g.globalAlpha = 1;
      g.lineWidth = 22;
      g.strokeStyle = '#0b0b0e';
      g.strokeText(word, 0, 0);
      const gr = g.createLinearGradient(0, -60, 0, 60);
      gr.addColorStop(0, '#ffffff');
      gr.addColorStop(0.35, c1);
      gr.addColorStop(1, c2);
      g.fillStyle = gr;
      g.fillText(word, 0, 0);
      g.lineWidth = 3;
      g.strokeStyle = '#ffffff';
      g.strokeText(word, -3, -3);
      // drips
      g.fillStyle = c1;
      for (let i = 0; i < 7; i++) {
        const x = (rnd() - 0.5) * 300;
        g.fillRect(x, 30, 4, 20 + rnd() * 60);
      }
      // arrow / crown doodle
      g.strokeStyle = c1;
      g.lineWidth = 8;
      g.beginPath();
      g.moveTo(-200, 70);
      g.lineTo(-120, 92);
      g.lineTo(-40, 70);
      g.stroke();
      g.restore();
    }
  });
  return GRAF_TEX;
}

let TYRE_GEO = null;
