      $('sel-bg').style.transform = `translateX(${delta > 0 ? -18 : 18}px)`;
      port.style.transform = `translateX(${delta > 0 ? 40 : -40}px)`;
      requestAnimationFrame(() => {
        $('sel-bg').style.transform = '';
        port.style.transform = '';
      });
    }
  },
  pick() {
    const d = RACERS[this.idx];
    const port = $('sel-port');
    port.style.backgroundImage = Portraits.css(d.id, 'pick');
    port.classList.remove('pick');
    void port.offsetWidth;
    port.classList.add('pick');
    this.picked = 1;
  },
  tick(dt) {
    if (this.picked) return;
    const d = RACERS[this.idx];
    this.blinkT -= dt;
    const port = $('sel-port');
    if (this.blinking > 0) {
      this.blinking -= dt;
      if (this.blinking <= 0) port.style.backgroundImage = Portraits.css(d.id, 'idle');
    } else if (this.blinkT <= 0) {
      this.blinkT = 2.2 + Math.random() * 3;
      this.blinking = 0.13;
      port.style.backgroundImage = Portraits.css(d.id, 'blink') + ', ' + Portraits.css(d.id, 'idle');
