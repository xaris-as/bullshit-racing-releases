    this.gtrBus = bus(9, 3200, 110, 0.32);
    this.acidBus = bus(2.4, 6000, 60, 0.5);
    this.voxBus = c.createGain();
    this.voxBus.gain.value = 0.9;
    this.voxBus.connect(this.pre);
