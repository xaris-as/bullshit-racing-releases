// ---------- GLB asset library ----------
// One root per asset at the origin. Kart bodies carry anchor empties; characters are skinned (rig_<sp>) with
// clips named <sp>_<clip> and metadata (dd_meta) on the armature node.
const Assets = {
  ok: false,
  roots: new Map(),
  geo: new Map(),
  chars: new Map(),
  charGeos: new Set(),
  async load(onProgress) {
    let buf = null;
    try {
      const r = await fetch('models/assets.json');
      if (r.ok) {
        const total = +(r.headers.get('content-length') || 0);
        let bytes;
        if (r.body && r.body.getReader) {
          const rd = r.body.getReader();
          const parts = [];
          let got = 0;
          for (;;) {
            const { done, value } = await rd.read();
            if (done) break;
            parts.push(value);
            got += value.length;
            if (onProgress) onProgress(total ? Math.min(0.99, got / total) : -1);
          }
          bytes = new Uint8Array(got);
          let o = 0;
          for (const part of parts) {
            bytes.set(part, o);
            o += part.length;
          }
        } else bytes = new Uint8Array(await r.arrayBuffer());
        const j = JSON.parse(new TextDecoder().decode(bytes));
        if (j && typeof j.data === 'string') buf = b64ToBuffer(j.data);
      }
    } catch (e) {
      buf = null;
    }
    if (!buf) {
      const r = await fetch('models/assets.glb');
      if (!r.ok) throw new Error('asset load failed: ' + r.status);
      buf = await r.arrayBuffer();
    }
    const gltf = await new Promise((resolve, reject) => new GLTFLoader().parse(buf, '', resolve, (err) => reject(err || new Error('asset parse failed'))));
    this.ingest(gltf);
    this.ok = true;
  },
  ingest(gltf) {
    const scene = gltf.scene;
    for (const root of scene.children.slice()) {
      if (/^char_/.test(root.name)) {
        this.ingestChar(root, gltf.animations);
        continue;
      }
      const entry = { name: root.name, meshes: [], anchors: new Map() };
      for (const o of root.children) {
        if (/^anchor_/.test(o.name)) {
          entry.anchors.set(o.name.replace(/^anchor_/, '').replace(/\.?\d{3}$/, ''), o.position.clone());
          continue;
        }
        const mesh = o.isMesh ? o : o.children.find((c) => c.isMesh);
        if (!mesh) continue;
        const g = prepGeo(mesh.geometry);
        this.geo.set(o.name, g);
        o.updateMatrix();
        entry.meshes.push({ name: o.name, matrix: o.matrix.clone(), pos: o.position.clone(), quat: o.quaternion.clone(), scl: o.scale.clone() });
      }
      this.roots.set(root.name, entry);
    }
    for (const need of ['body_classic', 'wheel_standard', 'spoiler_none', 'exhaust_twin', 'wings', 'hull', 'prop_oak', 'prop_coin']) {
      if (!this.roots.has(need)) throw new Error('missing asset ' + need);
    }
    for (const sp of ['fox', 'panda', 'frog', 'bunny', 'cat', 'bear']) if (!this.chars.has(sp)) throw new Error('missing character ' + sp);
  },
  ingestChar(root, animations) {
    const sp = root.name.slice(5);
    let meta = null;
    let mesh = null;
    root.traverse((o) => {
      if (o.userData && typeof o.userData.dd_meta === 'string') meta = JSON.parse(o.userData.dd_meta);
      if (o.isSkinnedMesh) mesh = o;
    });
    if (!meta || !mesh) throw new Error('bad character ' + sp);
    prepGeo(mesh.geometry, true);
    mesh.geometry.computeBoundingSphere();
    mesh.geometry.boundingSphere.radius = 2.2;
    this.charGeos.add(mesh.geometry);
    mesh.material = charMaterial(false);
    mesh.frustumCulled = false;
    root.removeFromParent();
    root.position.set(0, 0, 0);
    const clips = animations.filter((a) => a.name.startsWith(sp + '_'));
    this.chars.set(sp, { root, meta, clips, mesh });
  },
  mesh(name) {
    return this.geo.get(name);
  },
  root(name) {
    return this.roots.get(name);
  },
  // prop -> { main geometry, extra parts [{name, geo, pos}] }
  prop(name) {
    const r = this.roots.get(name);
    if (!r) return null;
    const main = r.meshes.find((m) => m.name === name + '_m') || r.meshes[0];
    return { geo: this.geo.get(main.name), extra: r.meshes.filter((m) => m !== main).map((m) => ({ name: m.name, geo: this.geo.get(m.name), pos: m.pos, quat: m.quat })) };
  },
};

function b64ToBuffer(str) {
  const bin = atob(str);
  const n = bin.length;
  const u = new Uint8Array(n);
  for (let i = 0; i < n; i++) u[i] = bin.charCodeAt(i);
  return u.buffer;
}

// vertex colours -> Float32 RGB + 'mclass' (material class from the colour alpha)
function prepGeo(g, skinned = false) {
  const c = g.attributes.color;
  const n = g.attributes.position.count;
  const mc = new Float32Array(n).fill(1);
  if (c) {
    if (c.itemSize === 4) for (let i = 0; i < n; i++) mc[i] = c.getW(i);
    if (c.itemSize !== 3 || !(c.array instanceof Float32Array)) {
      const out = new Float32Array(n * 3);
      for (let i = 0; i < n; i++) {
        out[i * 3] = c.getX(i);
        out[i * 3 + 1] = c.getY(i);
        out[i * 3 + 2] = c.getZ(i);
      }
      g.setAttribute('color', new THREE.BufferAttribute(out, 3));
    }
  } else g.setAttribute('color', new THREE.BufferAttribute(new Float32Array(n * 3).fill(1), 3));
  g.setAttribute('mclass', new THREE.BufferAttribute(mc, 1));
  if (!g.attributes.normal) g.computeVertexNormals();
  const keep = new Set(['position', 'normal', 'color', 'mclass']);
  if (skinned) {
    keep.add('skinIndex');
    keep.add('skinWeight');
  }
  for (const k of Object.keys(g.attributes)) if (!keep.has(k)) g.deleteAttribute(k);
  g.computeBoundingSphere();
  g.computeBoundingBox();
  return g;
}

// clone a library mesh, transform it and tint its vertex colours (linear)
function bakedGeo(name, matrix, tint) {
