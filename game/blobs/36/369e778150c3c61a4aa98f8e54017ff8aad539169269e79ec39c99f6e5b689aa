      g.lineTo(x + 13, h * 0.36);
      g.lineTo(x + 13 + h * 0.3, h * 0.66);
      g.lineTo(x + h * 0.3, h * 0.66);
      g.closePath();
      g.fill();
    }
    // made-up brand stencil, twice around the barrel
    g.font = '400 30px ' + DISPLAY_FONT;
    g.textAlign = 'center';
    g.textBaseline = 'middle';
    for (const cx of [w * 0.25, w * 0.75]) {
      g.fillStyle = '#17161b';
      g.fillRect(cx - 34, h * 0.06, 68, 34);
      g.fillStyle = '#ffc21a';
      g.fillText('B.S.', cx, h * 0.06 + 18);
      g.fillStyle = '#efece4';
      g.font = '700 13px ' + COND_FONT;
      g.fillText('KABOOM GAS', cx, h * 0.83);
      g.font = '400 30px ' + DISPLAY_FONT;
    }
    // ribs + grime
    g.fillStyle = 'rgba(0,0,0,0.35)';
    g.fillRect(0, h * 0.3, w, 4);
    g.fillRect(0, h * 0.7, w, 4);
    for (let i = 0; i < 260; i++) {
      g.fillStyle = 'rgba(30,18,10,' + (Math.random() * 0.18).toFixed(3) + ')';
      g.fillRect(Math.random() * w, h * 0.75 + Math.random() * h * 0.25, 2 + Math.random() * 6, 1 + Math.random() * 3);
    }
  });
  return BARREL_TEX;
}

function barrelGeometry() {
  const body = new THREE.CylinderGeometry(0.5, 0.5, 1.1, 18, 1, false);
  const lid = new THREE.CylinderGeometry(0.47, 0.5, 0.06, 18);
  lid.translate(0, 0.58, 0);
  const rim = new THREE.TorusGeometry(0.5, 0.035, 6, 18);
  rim.rotateX(Math.PI / 2);
  const rim2 = rim.clone();
  rim.translate(0, 0.25, 0);
  rim2.translate(0, -0.25, 0);
  for (const g of [lid, rim, rim2]) {
    const uv = g.attributes.uv;
    for (let i = 0; i < uv.count; i++) uv.setXY(i, 0.5, 0.33); // red area of the label
  }
  const geo = mergeGeometries([body, lid, rim, rim2], false);
  for (const g of [body, lid, rim, rim2]) g.dispose();
  geo.translate(0, 0.55, 0);
  return geo;
}

function coneGeometry() {
  const cone = new THREE.CylinderGeometry(0.04, 0.24, 0.7, 12, 3);
  cone.translate(0, 0.39, 0);
  const base = new THREE.BoxGeometry(0.56, 0.05, 0.56);
  base.translate(0, 0.025, 0);
  const geo = mergeGeometries([cone, base], false);
  cone.dispose();
  base.dispose();
  const pos = geo.attributes.position;
  const col = new Float32Array(pos.count * 3);
  const c = new THREE.Color();
  for (let i = 0; i < pos.count; i++) {
    const y = pos.getY(i);
    if (y < 0.06) c.set(0x17161b);
    else if ((y > 0.32 && y < 0.44) || (y > 0.56 && y < 0.64)) c.set(0xf2f2f2);
    else c.set(0xff5e00);
    c.convertSRGBToLinear();
    col[i * 3] = c.r;
    col[i * 3 + 1] = c.g;
    col[i * 3 + 2] = c.b;
  }
  geo.setAttribute('color', new THREE.BufferAttribute(col, 3));
  return geo;
}

let CASSETTE_TEX = null;
function cassetteTexture() {
  if (CASSETTE_TEX) return CASSETTE_TEX;
  CASSETTE_TEX = canvasTex(256, 160, (g, w, h) => {
    g.fillStyle = '#17161b';
    g.fillRect(0, 0, w, h);
    g.fillStyle = '#ffc21a';
    g.fillRect(14, 12, w - 28, 54);
    g.fillStyle = '#8e1717';
    g.font = '400 34px ' + DISPLAY_FONT;
    g.textAlign = 'center';
    g.textBaseline = 'middle';
    g.fillText('BULL TAPE', w / 2, 40);
    g.fillStyle = '#efece4';
    for (const x of [78, 178]) {
      g.beginPath();
      g.arc(x, 108, 26, 0, TAU);
      g.fill();
      g.fillStyle = '#17161b';
      g.beginPath();
      g.arc(x, 108, 10, 0, TAU);
      g.fill();
      g.fillStyle = '#efece4';
    }
    g.fillStyle = '#3a3d45';
    g.fillRect(104, 96, 48, 24);
  });
  return CASSETTE_TEX;
}

let RING_TEX = null;
function ringTexture() {
  if (RING_TEX) return RING_TEX;
  RING_TEX = canvasTex(128, 128, (g) => {
    const gr = g.createRadialGradient(64, 64, 30, 64, 64, 63);
    gr.addColorStop(0, 'rgba(255,255,255,0)');
    gr.addColorStop(0.72, 'rgba(255,220,160,0.0)');
    gr.addColorStop(0.86, 'rgba(255,236,200,0.95)');
    gr.addColorStop(1, 'rgba(255,255,255,0)');
    g.fillStyle = gr;
    g.fillRect(0, 0, 128, 128);
  });
  return RING_TEX;
}

const _cm4 = new THREE.Matrix4();
const _cq = new THREE.Quaternion();
const _ce = new THREE.Euler();
const _cv = new THREE.Vector3();
const _cs = new THREE.Vector3();
const _cw = { x: 0, y: 0, z: 0 };
const _cF = {};

class ChaosFX {
  constructor(scene, track, Q) {
    this.scene = scene;
    this.track = track;
    this.Q = Q;
    this.low = Q.id === 'low';
    this.group = new THREE.Group();
    scene.add(this.group);
    this.geos = [];
    this.mats = [];
    // ---- barrels
    const booms = track.booms;
    this.barrels = null;
    if (booms.length) {
      const g = barrelGeometry();
      const m = new THREE.MeshStandardMaterial({ map: barrelTexture(), roughness: 0.5, metalness: 0.35 });
      this.geos.push(g);
      this.mats.push(m);
      this.barrels = new THREE.InstancedMesh(g, m, booms.length);
      this.barrels.castShadow = Q.shadows > 0;
      this.barrels.frustumCulled = false;
      this.group.add(this.barrels);
      this.bScale = new Float32Array(booms.length).fill(1);
      this.bYaw = booms.map((b, i) => (i * 2.399) % TAU);
      this.placeBarrels(0);
    }
    // ---- debris chunks
    this.debrisN = this.low ? 40 : 90;
    const dg = new THREE.BoxGeometry(0.22, 0.12, 0.3);
    const dm = new THREE.MeshStandardMaterial({ roughness: 0.6, metalness: 0.3 });
    this.geos.push(dg);
    this.mats.push(dm);
    this.debris = new THREE.InstancedMesh(dg, dm, this.debrisN);
    this.debris.frustumCulled = false;
    this.debris.count = 0;
    this.deb = [];
    for (let i = 0; i < this.debrisN; i++) this.debris.setColorAt(i, new THREE.Color(0xffffff));
    this.group.add(this.debris);
    // ---- shock rings (pooled meshes) + scorch marks
    this.rings = [];
    if (!this.low) {
      const rg = new THREE.PlaneGeometry(1, 1);
      rg.rotateX(-Math.PI / 2);
      this.geos.push(rg);
      for (let i = 0; i < 3; i++) {
        const rm = new THREE.MeshBasicMaterial({ map: ringTexture(), transparent: true, depthWrite: false, blending: THREE.AdditiveBlending, color: 0xffd9a0 });
        this.mats.push(rm);
        const mesh = new THREE.Mesh(rg, rm);
        mesh.visible = false;
        this.group.add(mesh);
        this.rings.push({ mesh, t: 1 });
      }
      const sg = new THREE.PlaneGeometry(1, 1);
      sg.rotateX(-Math.PI / 2);
      const sm = new THREE.MeshBasicMaterial({ map: blobTexture(), color: 0x000000, transparent: true, opacity: 0.75, depthWrite: false, polygonOffset: true, polygonOffsetFactor: -2 });
      this.geos.push(sg);
      this.mats.push(sm);
      this.scorchN = 24;
      this.scorch = new THREE.InstancedMesh(sg, sm, this.scorchN);
      this.scorch.count = 0;
      this.scorch.frustumCulled = false;
      this.scorchI = 0;
      this.group.add(this.scorch);
      this.light = new THREE.PointLight(0xff8a3a, 0, 26, 1.6);
      this.group.add(this.light);
    }
    this.lightT = 0;
    // ---- cones: clusters at corners and next to barrels, punted by karts
    this.cones = [];
    this.buildCones();
    // ---- hidden Bull Tape (cassette) collectible
    this.tape = null;
    const tp = track.tapes && track.tapes[0];
    if (tp) {
      const g = new THREE.BoxGeometry(0.72, 0.46, 0.12);
      const m = new THREE.MeshStandardMaterial({ map: cassetteTexture(), roughness: 0.4, metalness: 0.2, emissive: 0xffc21a, emissiveIntensity: 0.25 });
      this.geos.push(g);
      this.mats.push(m);
      const mesh = new THREE.Mesh(g, m);
      const p = this.worldOf(tp.s, tp.d);
      mesh.position.set(p.x, tp.y, p.z);
      this.group.add(mesh);
      const glow = new THREE.Sprite(new THREE.SpriteMaterial({ map: glowTexture(), color: 0xffc21a, transparent: true, depthWrite: false, blending: THREE.AdditiveBlending, opacity: 0.8 }));
      this.mats.push(glow.material);
      glow.scale.setScalar(2.2);
      glow.position.copy(mesh.position);
      this.group.add(glow);
      this.tape = { f: tp, mesh, glow, y: tp.y };
    }
  }

  worldOf(s, d, out) {
    const p = this.track.toWorld(s, d, out || _cw);
    return p;
  }

  placeBarrels(time) {
    const booms = this.track.booms;
    for (let i = 0; i < booms.length; i++) {
      const b = booms[i];
      const p = this.worldOf(b.s, b.d);
      let y = b.y;
      let tilt = 0;
      if (b.water) {
        y = b.y + waveHeight(p.x, p.z, time) - 0.55;
        tilt = Math.sin(time * 1.7 + i) * 0.18;
      }
      const sc = this.bScale[i];
      _ce.set(tilt, this.bYaw[i], tilt * 0.6, 'YXZ');
      _cq.setFromEuler(_ce);
      _cm4.compose(_cv.set(p.x, y, p.z), _cq, _cs.set(sc, sc, sc));
      this.barrels.setMatrixAt(i, _cm4);
    }
    this.barrels.instanceMatrix.needsUpdate = true;
  }

  buildCones() {
    const tr = this.track;
    const rng = mulberry32((tr.def.seed || 7) * 13 + 5);
    const items = [];
    const L = tr.finishS;
    // a few work-zone clusters along the road edges + a small ring around barrel clusters
    const n = this.low ? 6 : 10;
    for (let k = 0; k < n; k++) {
      const s = START_S + 120 + ((k + rng()) / n) * (L - START_S - 260);
      if (tr.modeAt(s) !== M_ROAD) continue;
      const side = rng() < 0.5 ? -1 : 1;
      const cnt = 3 + Math.floor(rng() * 3);
      for (let j = 0; j < cnt; j++) items.push([s + j * 2.6, side * (ROAD_HW - 1.6 - rng() * 1.6)]);
    }
    for (const b of tr.booms) {
      if (b.water || rng() < 0.45) continue;
      for (let j = 0; j < 2; j++) items.push([b.s + (rng() * 2 - 1) * 3, clamp(b.d + (rng() < 0.5 ? -1 : 1) * (1.6 + rng()), -7, 7)]);
    }
    if (!items.length) return;
    const g = coneGeometry();
    const m = new THREE.MeshStandardMaterial({ vertexColors: true, roughness: 0.62 });
    this.geos.push(g);
    this.mats.push(m);
    this.coneMesh = new THREE.InstancedMesh(g, m, items.length);
    this.coneMesh.frustumCulled = false;
    this.coneMesh.castShadow = this.Q.shadows >= 2048;
    this.group.add(this.coneMesh);
    for (const [s, d] of items) {
      const p = this.worldOf(s, d);
      const y = tr.groundHeight(s, d);
      this.cones.push({ s, d, x: p.x, y, z: p.z, vx: 0, vy: 0, vz: 0, rx: 0, ry: rng() * TAU, rz: 0, wx: 0, wz: 0, fly: false, rest: false });
    }
    this.coneDirty = true;
  }

  // ---- explosion at a sim barrel
  explode(f, by, isPlayerNear, time) {
    const p = this.worldOf(f.s, f.d);
    const y = f.water ? f.y + waveHeight(p.x, p.z, time) : f.y;
    this.burst(p.x, y + 0.6, p.z, 1, f.water);
    if (this.barrels) {
      this.bScale[f.id] = 0;
      this.placeBarrels(time);
    }
    if (this.scorch && !f.water) {
      const i = this.scorchI++ % this.scorchN;
      const F = this.track.frameInto(f.s, _cF);
      _ce.set(0, -F.psi + Math.random(), 0);
      _cq.setFromEuler(_ce);
      const sz = 3.2 + Math.random() * 1.4;
      _cm4.compose(_cv.set(p.x, f.y + 0.04, p.z), _cq, _cs.set(sz, 1, sz));
      this.scorch.setMatrixAt(i, _cm4);
      this.scorch.count = Math.min(this.scorchN, Math.max(this.scorch.count, i + 1));
      this.scorch.instanceMatrix.needsUpdate = true;
    }
    // cones near the blast fly
    for (const c of this.cones) {
      const dx = c.x - p.x;
      const dz = c.z - p.z;
      const dist = Math.hypot(dx, dz);
      if (dist < 7 && !c.fly) this.punt(c, (dx / (dist + 0.1)) * (9 - dist), 6 + Math.random() * 4, (dz / (dist + 0.1)) * (9 - dist));
    }
  }

  // generic explosion (also used for decoys, wipeouts, fireworks scale): k = size
  burst(x, y, z, k = 1, water = false) {
    const fx = Game.fx;
    const fa = Game.fxA;
    const pk = this.low ? 0.55 : 1;
    // flash + fireball (additive)
    fa.spawn(x, y + 0.5, z, 0, 0, 0, 0.09, 3.2 * k, 0xfff3c4, 0.9, 0, 0, 2.2, 1.5);
    for (let i = 0; i < 16 * pk * k; i++) {
      const a = Math.random() * TAU;
      const sp = 1.5 + Math.random() * 4.5 * k;
      fa.spawn(x + rnd2() * 0.6, y + Math.random() * 0.6, z + rnd2() * 0.6, Math.cos(a) * sp, 2 + Math.random() * 4 * k, Math.sin(a) * sp, 0.3 + Math.random() * 0.25, (0.8 + Math.random() * 0.8) * k, Math.random() < 0.45 ? 0xffb02e : Math.random() < 0.5 ? 0xff5e1a : 0xffe27a, 0.9, -2, 2.4, 2.6, 1.6);
    }
    // sparks
    for (let i = 0; i < 18 * pk; i++) {
      const a = Math.random() * TAU;
      const sp = 7 + Math.random() * 10;
      fa.spawn(x, y + 0.4, z, Math.cos(a) * sp, 4 + Math.random() * 8, Math.sin(a) * sp, 0.5 + Math.random() * 0.4, 0.18, 0xffd25a, 1, 18, 0.6, 0, 3);
    }
    // smoke (or spray on water)
    for (let i = 0; i < 14 * pk * k; i++) {
      if (water) fx.spawn(x + rnd2(), y + 0.3, z + rnd2(), rnd2() * 5, 5 + Math.random() * 6, rnd2() * 5, 0.9 + Math.random() * 0.5, 0.6 + Math.random() * 0.5, 0xffffff, 0.85, 10, 1, 0.8);
      else fx.spawn(x + rnd2() * 1.2, y + 0.8 + Math.random(), z + rnd2() * 1.2, rnd2() * 2.2, 1.6 + Math.random() * 2.2, rnd2() * 2.2, 1.4 + Math.random() * 1.1, (1.1 + Math.random() * 0.9) * k, Math.random() < 0.5 ? 0x1c1b1f : 0x302d31, 0.8, -0.8, 1.4, 1.5);
    }
    // debris
    for (let i = 0; i < 10 * pk * k; i++) {
      if (this.deb.length >= this.debrisN) this.deb.shift();
      const a = Math.random() * TAU;
      const sp = 3 + Math.random() * 7;
      this.deb.push({ x, y: y + 0.4, z, vx: Math.cos(a) * sp, vy: 5 + Math.random() * 8, vz: Math.sin(a) * sp, rx: Math.random() * 3, ry: Math.random() * 3, wx: rnd2() * 16, wy: rnd2() * 16, floor: y - 0.55, t: 0, col: Math.random() < 0.6 ? 0xc4231b : Math.random() < 0.5 ? 0xffc21a : 0x2b2a2e, sc: 0.6 + Math.random() * 0.9 });
    }
    // shock ring + light
    const ring = this.rings.find((r) => r.t >= 1);
    if (ring) {
      ring.t = 0;
      ring.k = k;
      ring.mesh.position.set(x, y - 0.45, z);
      ring.mesh.visible = true;
    }
    if (this.light) {
      this.light.position.set(x, y + 1.5, z);
      this.lightT = 1;
    }
  }

  punt(c, vx, vy, vz) {
    c.fly = true;
    c.rest = false;
    c.vx = vx;
    c.vy = vy;
    c.vz = vz;
    c.wx = rnd2() * 18;
    c.wz = rnd2() * 18;
  }

  fireworks(x, y, z) {
    const cols = [0xff2e88, 0x29e3ff, 0xffc21a, 0x7dff6b, 0xff5e00];
    for (let b = 0; b < 4; b++) {
      const cx = x + rnd2() * 30;
      const cy = y + 18 + Math.random() * 12;
      const cz = z + rnd2() * 30;
      const col = cols[(Math.random() * cols.length) | 0];
      for (let i = 0; i < (this.low ? 24 : 46); i++) {
        const u = Math.random() * 2 - 1;
        const a = Math.random() * TAU;
        const r = Math.sqrt(1 - u * u);
        const sp = 9 + Math.random() * 3;
        Game.fxA.spawn(cx, cy, cz, Math.cos(a) * r * sp, u * sp, Math.sin(a) * r * sp, 1.1 + Math.random() * 0.5, 0.45, col, 1, 4, 1.4, 0, 3);
      }
    }
  }

  update(dt, race, time) {
    if (this.tape) {
      const T = this.tape;
      T.mesh.visible = T.glow.visible = !T.f.taken;
      T.mesh.rotation.y = time * 2.4;
      T.mesh.position.y = T.y + Math.sin(time * 3) * 0.12;
      T.glow.position.y = T.mesh.position.y;
    }
    // floating barrels bob, respawned ones scale back in
    if (this.barrels) {
      let any = false;
      for (const b of this.track.booms) {
        if (b.alive && this.bScale[b.id] < 1) {
          this.bScale[b.id] = Math.min(1, this.bScale[b.id] + dt * 3);
          any = true;
        }
        if (b.water) any = true;
      }
      if (any) this.placeBarrels(time);
    }
    // debris
    const D = this.deb;
    for (let i = D.length - 1; i >= 0; i--) {
      const d = D[i];
      d.t += dt;
      d.vy -= 24 * dt;
      d.x += d.vx * dt;
      d.y += d.vy * dt;
      d.z += d.vz * dt;
      d.rx += d.wx * dt;
      d.ry += d.wy * dt;
      if (d.y < d.floor) {
        d.y = d.floor;
        d.vy *= -0.35;
        d.vx *= 0.6;
        d.vz *= 0.6;
        d.wx *= 0.5;
        d.wy *= 0.5;
      }
      if (d.t > 3.2) D.splice(i, 1);
    }
    for (let i = 0; i < D.length; i++) {
      const d = D[i];
      _ce.set(d.rx, d.ry, 0);
      _cq.setFromEuler(_ce);
      const sc = d.sc * (d.t > 2.6 ? Math.max(0.01, (3.2 - d.t) / 0.6) : 1);
      _cm4.compose(_cv.set(d.x, d.y, d.z), _cq, _cs.set(sc, sc, sc));
      this.debris.setMatrixAt(i, _cm4);
      this.debris.setColorAt(i, _col.set(d.col));
    }
    this.debris.count = D.length;
    if (D.length) {
      this.debris.instanceMatrix.needsUpdate = true;
      this.debris.instanceColor.needsUpdate = true;
    }
    // rings + light
    for (const r of this.rings) {
      if (r.t >= 1) continue;
      r.t = Math.min(1, r.t + dt / 0.42);
      const e = 1 - Math.pow(1 - r.t, 3);
      const sc = (1 + 13 * e) * (r.k || 1);
      r.mesh.scale.set(sc, 1, sc);
      r.mesh.material.opacity = 1 - r.t;
      if (r.t >= 1) r.mesh.visible = false;
    }
    if (this.light) {
      this.lightT = Math.max(0, this.lightT - dt * 4);
      this.light.intensity = this.lightT * this.lightT * 60;
    }
    // cones: karts punt them
    if (this.cones.length && race) {
      for (const c of this.cones) {
        if (c.fly) continue;
        for (const r of race.racers) {
          if (Math.abs(r.s - c.s) > 3 || r.spd < 4) continue;
          if (Math.abs(r.d - c.d) < 1.3 && Math.abs(r.y - c.y) < 1.5) {
            const sp = Math.hypot(r.vx, r.vz);
            this.punt(c, r.vx * 0.75 + rnd2() * 4, 3 + sp * 0.12 + Math.random() * 2, r.vz * 0.75 + rnd2() * 4);
            if (r.isPlayer) Sound.play('cone');
            break;
          }
        }
      }
      let moved = this.coneDirty;
      for (const c of this.cones) {
        if (!c.fly) continue;
        moved = true;
        c.vy -= 22 * dt;
        c.x += c.vx * dt;
        c.y += c.vy * dt;
        c.z += c.vz * dt;
        c.rx += c.wx * dt;
        c.rz += c.wz * dt;
        const floor = this.track.groundHeight(c.s, c.d) - 0.05;
        if (c.y < floor && c.vy < 0) {
          c.y = floor;
          c.vy *= -0.3;
          c.vx *= 0.55;
          c.vz *= 0.55;
          c.wx *= 0.4;
          c.wz *= 0.4;
          if (Math.abs(c.vy) < 1 && Math.hypot(c.vx, c.vz) < 1) {
            c.fly = false;
            c.rest = true;
            c.rx = Math.PI / 2;
          }
        }
      }
      if (moved) {
        for (let i = 0; i < this.cones.length; i++) {
          const c = this.cones[i];
          _ce.set(c.rx, c.ry, c.rz, 'YXZ');
          _cq.setFromEuler(_ce);
          _cm4.compose(_cv.set(c.x, c.y + (c.rest ? 0.24 : 0), c.z), _cq, _cs.set(1, 1, 1));
          this.coneMesh.setMatrixAt(i, _cm4);
        }
        this.coneMesh.instanceMatrix.needsUpdate = true;
        this.coneDirty = false;
      }
    }
  }

  dispose() {
    this.scene.remove(this.group);
    for (const g of this.geos) g.dispose();
    for (const m of this.mats) m.dispose();
    for (const o of [this.barrels, this.debris, this.scorch, this.coneMesh]) if (o) o.dispose();
  }
}

// ============================================================
// Post FX (ROADMAP 1): one fullscreen "grade" pass that does tone mapping + sRGB output + per-track colour
// grade (lift/gain/saturation/contrast, LUT-like split toning), vignette, film grain, chromatic aberration at
// boost, speed lines, hit flash and the glitch/scanline transition. High adds bloom before it. Low has no
// composer at all (CSS vignette overlay only).
// ============================================================
const GRADE_SHADER = {
  name: 'DDGrade',
  uniforms: {
    tDiffuse: { value: null },
    toneMappingExposure: { value: 1 },
    uLift: { value: new THREE.Vector3(0.02, 0.04, 0.07) },
    uGain: { value: new THREE.Vector3(1.05, 1.0, 0.92) },
    uSat: { value: 1.1 },
    uContrast: { value: 1.12 },
    uVig: { value: 0.4 },
    uGrain: { value: 0.05 },
    uTime: { value: 0 },
    uCA: { value: 0 },
    uSpeed: { value: 0 },
    uFlash: { value: 0 },
    uFlashCol: { value: new THREE.Vector3(1, 1, 1) },
    uGlitch: { value: 0 },
    uAspect: { value: 1 },
  },
  vertexShader: `
    precision highp float;
    uniform mat4 modelViewMatrix;
    uniform mat4 projectionMatrix;
    attribute vec3 position;
    attribute vec2 uv;
    varying vec2 vUv;
    void main() { vUv = uv; gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0); }`,
  fragmentShader: `
    precision highp float;
    uniform sampler2D tDiffuse;
    uniform vec3 uLift; uniform vec3 uGain; uniform float uSat; uniform float uContrast;
    uniform float uVig; uniform float uGrain; uniform float uTime; uniform float uCA; uniform float uSpeed;
    uniform float uFlash; uniform vec3 uFlashCol; uniform float uGlitch; uniform float uAspect;
    varying vec2 vUv;
    #include <tonemapping_pars_fragment>
    #include <colorspace_pars_fragment>
    vec3 tm(vec3 c) {
      #if defined( NEUTRAL_TONE_MAPPING )
        c = NeutralToneMapping(c);
      #elif defined( ACES_FILMIC_TONE_MAPPING )
        c = ACESFilmicToneMapping(c);
      #elif defined( AGX_TONE_MAPPING )
        c = AgXToneMapping(c);
      #elif defined( REINHARD_TONE_MAPPING )
        c = ReinhardToneMapping(c);
      #endif
      #ifdef SRGB_TRANSFER
        c = sRGBTransferOETF(vec4(c, 1.0)).rgb;
      #endif
      return c;
    }
    float hash(vec2 p) { return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453); }
    void main() {
      vec2 uv = vUv;
      vec2 cc = uv - 0.5;
      // glitch transition: horizontal slice offsets + scanlines
      if (uGlitch > 0.0) {
        float band = floor(uv.y * 38.0 + floor(uTime * 24.0) * 7.0);
        float o = (hash(vec2(band, floor(uTime * 30.0))) - 0.5) * 0.12 * uGlitch;
        uv.x += o * step(0.55, hash(vec2(band * 1.7, 3.0)));
      }
      vec3 col;
      if (uCA > 0.001) {
        vec2 dir = cc * uCA * 0.012;
        col.r = tm(texture2D(tDiffuse, uv + dir).rgb).r;
        col.g = tm(texture2D(tDiffuse, uv).rgb).g;
        col.b = tm(texture2D(tDiffuse, uv - dir).rgb).b;
      } else col = tm(texture2D(tDiffuse, uv).rgb);
      // grade (display space): saturation, contrast, split-tone lift/gain
      float l = dot(col, vec3(0.299, 0.587, 0.114));
      col = mix(vec3(l), col, uSat);
      col = (col - 0.5) * uContrast + 0.5;
      col = clamp(col, 0.0, 1.0);
      col = col * uGain + uLift * (1.0 - col);
      // speed lines: thin radial streaks at the edges
      if (uSpeed > 0.001) {
        vec2 q = cc * vec2(uAspect, 1.0);
        float ang = atan(q.y, q.x);
        float r = length(q);
        float id = floor(ang * 60.0);
        float h = hash(vec2(id, floor(uTime * 9.0 + id)));
        float streak = step(0.82, h) * smoothstep(0.32, 0.75, r) * (0.6 + 0.4 * sin(r * 40.0 - uTime * 60.0));
        col = mix(col, vec3(1.0), streak * uSpeed * 0.35);
      }
      // vignette
      float v = smoothstep(0.95, 0.25, length(cc * vec2(1.0 + 0.25 * uAspect, 1.25)));
      col *= mix(1.0 - uVig, 1.0, v);
      // grain
      float g = hash(uv * vec2(1920.0, 1080.0) + fract(uTime) * 100.0) - 0.5;
      col += g * uGrain * (1.0 - l * 0.6);
      if (uGlitch > 0.0) {
        col *= 1.0 - 0.25 * uGlitch * step(0.5, fract(vUv.y * 220.0));
        col.r += uGlitch * 0.15 * step(0.92, hash(vec2(floor(vUv.y * 60.0), floor(uTime * 20.0))));
      }
      col = mix(col, uFlashCol, uFlash);
      gl_FragColor = vec4(col, 1.0);
    }`,
};

class GradePass extends ShaderPass {
  constructor() {
    super(
      new THREE.RawShaderMaterial({
        name: GRADE_SHADER.name,
        uniforms: THREE.UniformsUtils.clone(GRADE_SHADER.uniforms),
        vertexShader: GRADE_SHADER.vertexShader,
        fragmentShader: GRADE_SHADER.fragmentShader,
      })
    );
    this._tm = -1;
    this._cs = null;
  }
  render(renderer, writeBuffer, readBuffer, deltaTime, maskActive) {
    if (this._tm !== renderer.toneMapping || this._cs !== renderer.outputColorSpace) {
      this._tm = renderer.toneMapping;
      this._cs = renderer.outputColorSpace;
      const d = {};
      if (THREE.ColorManagement.getTransfer(this._cs) === THREE.SRGBTransfer) d.SRGB_TRANSFER = '';
      if (this._tm === THREE.NeutralToneMapping) d.NEUTRAL_TONE_MAPPING = '';
      else if (this._tm === THREE.ACESFilmicToneMapping) d.ACES_FILMIC_TONE_MAPPING = '';
      else if (this._tm === THREE.AgXToneMapping) d.AGX_TONE_MAPPING = '';
      else if (this._tm === THREE.ReinhardToneMapping) d.REINHARD_TONE_MAPPING = '';
      this.material.defines = d;
      this.material.needsUpdate = true;
    }
    this.uniforms.toneMappingExposure.value = renderer.toneMappingExposure;
    super.render(renderer, writeBuffer, readBuffer, deltaTime, maskActive);
  }
}

const Post = {
  composer: null,
  renderPass: null,
  bloom: null,
  grade: null,
  fx: { ca: 0, speed: 0, flash: 0, flashCol: [1, 1, 1], glitch: 0 },
  setup(renderer, Q, camera) {
    this.dispose();
    if (!Q.post) return;
    try {
      const size = renderer.getDrawingBufferSize(new THREE.Vector2());
      const rt = new THREE.WebGLRenderTarget(Math.max(1, size.x), Math.max(1, size.y), { type: THREE.HalfFloatType, samples: Q.msaa ? 4 : 0 });
      this.composer = new EffectComposer(renderer, rt);
      this.renderPass = new RenderPass(new THREE.Scene(), camera);
      this.composer.addPass(this.renderPass);
      if (Q.bloom) {
        this.bloom = new UnrealBloomPass(new THREE.Vector2(Math.max(1, size.x / 2), Math.max(1, size.y / 2)), 0.55, 0.45, 0.92);
        this.composer.addPass(this.bloom);
      }
      this.grade = new GradePass();
      this.composer.addPass(this.grade);
    } catch (e) {
      console.error(e);
      this.dispose();
    }
  },
  dispose() {
    if (this.composer) this.composer.dispose();
    this.composer = null;
    this.renderPass = null;
    this.bloom = null;
    this.grade = null;
  },
  setSize(w, h, pr) {
    if (!this.composer) return;
    this.composer.setPixelRatio(pr);
    this.composer.setSize(w, h);
    if (this.grade) this.grade.uniforms.uAspect.value = w / Math.max(1, h);
  },
  // per-theme grade
  setGrade(g) {
    if (!this.grade || !g) return;
    const u = this.grade.uniforms;
    u.uLift.value.set(...g.lift);
    u.uGain.value.set(...g.gain);
    u.uSat.value = g.sat;
    u.uContrast.value = g.contrast;
    u.uVig.value = g.vignette;
    u.uGrain.value = g.grain;
    if (this.bloom) {
      this.bloom.strength = 0.25 + 0.5 * g.bloom;
      this.bloom.threshold = 0.9;
      this.bloom.radius = 0.5;
    }
  },
  render(renderer, scene, cam, dt, t) {
    if (!this.composer) {
      renderer.render(scene, cam);
      return;
    }
    this.renderPass.scene = scene;
    this.renderPass.camera = cam;
    const u = this.grade.uniforms;
    const f = this.fx;
    u.uTime.value = t;
    u.uCA.value = f.ca;
    u.uSpeed.value = f.speed;
    u.uFlash.value = f.flash;
    u.uFlashCol.value.set(f.flashCol[0], f.flashCol[1], f.flashCol[2]);
    u.uGlitch.value = f.glitch;
    this.composer.render(dt);
  },
};

// ============================================================
// Minimap (ROADMAP 10): track polyline drawn once to an offscreen canvas (road grey, water cyan, air pink,
// gap red), then a 2D canvas redrawn at ~20 Hz, rotated so the player's heading points up, with racer dots
// in kart paint (player = bigger arrow) and ability / hazard markers.
// ============================================================
const Minimap = {
  canvas: null,
  g: null,
  off: null,
  on: true,
  acc: 0,
  scale: 1,
  minX: 0,
  minZ: 0,
  track: null,
  size: 150,
  dpr: 1,
  init(canvas) {
    this.canvas = canvas;
    this.g = canvas.getContext('2d');
    this.resize();
  },
  setEnabled(on) {
    this.on = on !== false;
    if (this.canvas) this.canvas.classList.toggle('hidden', !this.on);
  },
  resize() {
    if (!this.canvas) return;
    const r = this.canvas.getBoundingClientRect();
    const css = Math.max(80, Math.round(r.width || 150));
    this.size = css;
    this.dpr = Math.min(2, window.devicePixelRatio || 1);
    this.canvas.width = Math.round(css * this.dpr);
    this.canvas.height = Math.round(css * this.dpr);
  },
  build(track, race) {
    this.track = track;
    let minX = Infinity;
    let maxX = -Infinity;
    let minZ = Infinity;
    let maxZ = -Infinity;
    for (let i = 0; i < track.n; i++) {
      minX = Math.min(minX, track.X[i]);
      maxX = Math.max(maxX, track.X[i]);
      minZ = Math.min(minZ, track.Z[i]);
      maxZ = Math.max(maxZ, track.Z[i]);
    }
    const pad = 40;
    minX -= pad;
    minZ -= pad;
    maxX += pad;
    maxZ += pad;
    const S = 1024;
    const sc = S / Math.max(maxX - minX, maxZ - minZ);
    this.scale = sc;
    this.minX = minX;
    this.minZ = minZ;
    const c = document.createElement('canvas');
    c.width = S;
    c.height = S;
    const g = c.getContext('2d');
    const P = (i) => [(track.X[i] - minX) * sc, (track.Z[i] - minZ) * sc];
    g.lineJoin = 'round';
    g.lineCap = 'round';
    const stroke = (w, col, filter) => {
      g.strokeStyle = col;
      g.lineWidth = w;
      g.beginPath();
      let open = false;
      for (let i = 0; i < track.n; i += 2) {
        const ok = !filter || filter(track.M[i]);
        const [x, y] = P(i);
        if (ok) {
          if (!open) {
            g.moveTo(x, y);
            open = true;
          } else g.lineTo(x, y);
        } else if (open) {
          g.stroke();
          g.beginPath();
          open = false;
        }
      }
      if (open) g.stroke();
    };
    const wpx = Math.max(10, ROAD_HW * 2 * sc);
    stroke(wpx + 10, 'rgba(0,0,0,0.85)');
    stroke(wpx, '#5c5f66', (m) => m === M_ROAD);
    stroke(wpx, '#29e3ff', (m) => m === M_WATER);
    stroke(wpx, '#ff6fcf', (m) => m === M_AIR);
    stroke(wpx + 4, '#ff2e3c', (m) => m === M_GAP);
    // start + finish ticks
    for (const [s, col] of [[START_S, '#7dff3a'], [track.finishS, '#ffffff']]) {
      const f = track.frameInto(s, {});
      const x = (f.x - minX) * sc;
      const y = (f.z - minZ) * sc;
      g.strokeStyle = col;
      g.lineWidth = 8;
      g.beginPath();
      g.moveTo(x - f.rx * wpx, y - f.rz * wpx);
      g.lineTo(x + f.rx * wpx, y + f.rz * wpx);
      g.stroke();
    }
    this.off = c;
    this.race = race;
  },
  update(dt, race) {
    if (!this.on || !this.off || !this.g) return;
    this.acc += dt;
    if (this.acc < 0.05) return;
    this.acc = 0;
    const g = this.g;
    const W = this.canvas.width;
    const P = race.player;
    const tr = this.track;
    const F = tr.frameInto(P.s, {});
    const px = F.x + F.rx * P.d;
    const pz = F.z + F.rz * P.d;
    const zoom = (W / 300) * (P.mode === M_AIR ? 0.55 : 0.75);
    g.setTransform(1, 0, 0, 1, 0, 0);
    g.clearRect(0, 0, W, W);
    g.save();
    g.beginPath();
    g.arc(W / 2, W / 2, W / 2 - 2, 0, TAU);
    g.closePath();
    g.fillStyle = 'rgba(10,10,13,0.72)';
    g.fill();
    g.clip();
    // rotate so the player's heading is up (screen -y)
    g.translate(W / 2, W * 0.58);
    g.rotate(-P.hw);
    g.scale(zoom / this.scale, zoom / this.scale);
    g.translate(-(px - this.minX) * this.scale, -(pz - this.minZ) * this.scale);
    g.drawImage(this.off, 0, 0);
    g.setTransform(1, 0, 0, 1, 0, 0);
    // racers + markers in screen space
    const toScreen = (x, z) => {
      const dx = (x - px) * zoom;
      const dz = (z - pz) * zoom;
      const c = Math.cos(-P.hw);
      const s = Math.sin(-P.hw);
      return [W / 2 + dx * c - dz * s, W * 0.58 + dx * s + dz * c];
    };
    const tmp = {};
    for (const k of race.decoys) {
      const p = tr.toWorld(k.s, k.d, tmp);
      const [x, y] = toScreen(p.x, p.z);
      g.fillStyle = '#29e3ff';
      g.fillRect(x - 3 * this.dpr, y - 3 * this.dpr, 6 * this.dpr, 6 * this.dpr);
    }
    for (const o of tr.obstacles) {
      if (Math.abs(o.s - P.s) > 160) continue;
      const p = tr.toWorld(o.s, o.d, tmp);
      const [x, y] = toScreen(p.x, p.z);
      g.fillStyle = 'rgba(255,46,60,0.8)';
      g.beginPath();
      g.arc(x, y, 2.2 * this.dpr, 0, TAU);
      g.fill();
    }
    for (const r of race.racers) {
      if (r === P) continue;
      const f = tr.frameInto(r.s, tmp);
      const [x, y] = toScreen(f.x + f.rx * r.d, f.z + f.rz * r.d);
      g.fillStyle = hexCss(r.build.p1 === 0x17161b ? r.def.color : r.build.p1);
      g.strokeStyle = '#0b0b0e';
      g.lineWidth = 2 * this.dpr;
      g.beginPath();
      g.arc(x, y, (r.abilT > 0 ? 5.5 : 4.2) * this.dpr, 0, TAU);
      g.fill();
      g.stroke();
      if (r.abilT > 0) {
        g.strokeStyle = hexCss(ABILITIES[r.abilityId].color);
        g.lineWidth = 2 * this.dpr;
        g.beginPath();
        g.arc(x, y, 8 * this.dpr, 0, TAU);
        g.stroke();
      }
    }
    // player arrow
    const ax = W / 2;
    const ay = W * 0.58;
    const s = 7 * this.dpr;
    g.fillStyle = hexCss(P.build.p1 === 0x17161b ? P.def.color : P.build.p1);
    g.strokeStyle = '#ffffff';
    g.lineWidth = 2 * this.dpr;
    g.beginPath();
    g.moveTo(ax, ay - s * 1.4);
    g.lineTo(ax + s, ay + s);
    g.lineTo(ax, ay + s * 0.45);
    g.lineTo(ax - s, ay + s);
    g.closePath();
    g.fill();
    g.stroke();
    g.restore();
    g.strokeStyle = 'rgba(255,194,26,0.9)';
    g.lineWidth = 2 * this.dpr;
    g.beginPath();
    g.arc(W / 2, W / 2, W / 2 - 2, 0, TAU);
    g.stroke();
  },
};

