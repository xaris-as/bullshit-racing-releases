      case 'boom':
        this.burst(0.6, 0.35 * k, 'lowpass', 1800, 60);
        this.tone(120, 0.4, 'sine', 0.25 * k, 40);
        break;
      case 'hit':
        this.tone(320, 0.45, 'sawtooth', 0.07, 60);
        this.burst(0.35, 0.28, 'lowpass', 2200, 120);
        break;
      case 'spinout':
        this.tone(700, 0.5, 'triangle', 0.05, 180);
        this.burst(0.45, 0.12, 'bandpass', 2600, 900);
        break;
      case 'bump':
        this.burst(0.12, 0.22 * k, 'lowpass', 900, 150);
        this.tone(90, 0.14, 'sine', 0.2 * k, 50);
        break;
      case 'wall':
        this.burst(0.22, 0.22 * k, 'bandpass', 2600, 500);
        this.tone(80, 0.15, 'sine', 0.14 * k, 45);
        break;
