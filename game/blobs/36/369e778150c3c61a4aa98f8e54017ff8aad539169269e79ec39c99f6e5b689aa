// ---------- Paint shader: two colours + pattern in kart object space, plus wear (scratches, chips, grime) ----------
const PAINT_GLSL = `
varying vec3 vObj;
uniform vec3 uP1;
uniform vec3 uP2;
uniform float uPat;
float aaStep(float e, float x) { float w = max(fwidth(x), 1e-4) * 0.8; return smoothstep(e - w, e + w, x); }
float h21(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
float paintMask(vec3 q, float pat) {
  if (pat < 0.5) return 0.0;
  if (pat < 1.5) return 1.0 - aaStep(0.075, abs(abs(q.x) - 0.15));
  if (pat < 2.5) {
    float t = q.z + 1.8;
    float lick = 0.62 + 0.3 * sin(q.x * 11.0 + 0.6) * sin(q.y * 8.0 + 1.3) + 0.22 * sin(q.x * 25.0 + q.y * 6.0);
    return 1.0 - aaStep(lick, t);
  }
  if (pat < 3.5) return aaStep(0.0, sin(q.x * 9.0) * sin(q.z * 9.0));
  if (pat < 4.5) {
    vec2 c = fract(vec2(q.x * 2.7, q.z * 2.7 + q.y * 1.2)) - 0.5;
    return 1.0 - aaStep(0.2, length(c));
  }
  float zig = abs(fract(q.z * 1.25) - 0.5) * 0.34;
  return (1.0 - aaStep(0.055, abs(q.y - 0.47 - zig))) * aaStep(0.28, abs(q.x));
}
// thin scratches + chipped paint showing primer/metal
float wear(vec3 q) {
  vec2 cell = floor(q.xz * vec2(3.0, 2.2) + q.y * 1.3);
  float r = h21(cell);
  vec2 f = fract(q.xz * vec2(3.0, 2.2) + q.y * 1.3) - 0.5;
  float ang = r * 6.283;
  float d = abs(dot(f, vec2(cos(ang), sin(ang))));
  float scr = (1.0 - aaStep(0.012, d)) * step(0.62, r) * step(abs(dot(f, vec2(-sin(ang), cos(ang)))), 0.38);
  float chip = step(0.93, h21(floor(q.xz * 14.0 + q.y * 9.0)));
  return max(scr, chip * 0.8);
}
`;
function makePaintMaterial(build) {
  const phys = !!(Q && Q.id !== 'low');
  const m = phys
    ? new THREE.MeshPhysicalMaterial({ color: 0xffffff, vertexColors: true, roughness: 0.46, metalness: 0.22, clearcoat: 0.7, clearcoatRoughness: 0.2 })
    : new THREE.MeshStandardMaterial({ color: 0xffffff, vertexColors: true, roughness: 0.32, metalness: 0.18 });
  const u = { uP1: { value: new THREE.Color(build.p1) }, uP2: { value: new THREE.Color(build.p2) }, uPat: { value: build.pattern } };
  m.userData.u = u;
  m.onBeforeCompile = (sh) => {
    Object.assign(sh.uniforms, u);
    sh.vertexShader = sh.vertexShader
      .replace('#include <common>', '#include <common>\nvarying vec3 vObj;')
      .replace('#include <begin_vertex>', '#include <begin_vertex>\nvObj = position;');
    sh.fragmentShader = sh.fragmentShader
      .replace('#include <common>', '#include <common>\n' + PAINT_GLSL)
      .replace(
        '#include <color_fragment>',
        `#include <color_fragment>
        float wr = wear(vObj);
        diffuseColor.rgb *= mix(uP1, uP2, paintMask(vObj, uPat));
        diffuseColor.rgb = mix(diffuseColor.rgb, vec3(0.42, 0.43, 0.45) * (0.7 + 0.3 * vColor.r), wr * 0.85);`
      )
      .replace('#include <roughnessmap_fragment>', '#include <roughnessmap_fragment>\nroughnessFactor = mix(roughnessFactor, 0.55, wr);')
      .replace('#include <normal_fragment_maps>', '#include <normal_fragment_maps>\n' + (phys ? FLAKE_GLSL : ''))
      // chipped / scratched paint loses its clear coat
      .replace('#include <lights_physical_fragment>', '#include <lights_physical_fragment>\n#ifdef USE_CLEARCOAT\nmaterial.clearcoat *= 1.0 - wr;\n#endif');
  };
  m.customProgramCacheKey = () => 'dd-paint-4' + (phys ? 'p' : 's');
  return m;
}

