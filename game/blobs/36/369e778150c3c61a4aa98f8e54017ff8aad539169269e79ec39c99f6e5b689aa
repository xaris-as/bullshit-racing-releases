  },
  renderStats() {
    const d = RACERS[this.ctx.racer];
    const cur = kartStats(d, this.ctx.build(), Save.data.up).show;
    const pv = this.trying ? kartStats(d, this.viewBuild(), Save.data.up).show : cur;
    const box = $('gar-stats');
    box.innerHTML = '';
    for (const k of STAT_KEYS) {
      const row = el('div', 'sbar');
