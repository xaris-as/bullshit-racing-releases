// ---------- fur shells: N offset copies of the fur triangles, alpha-tested strands (close-ups only) ----------
const FUR_GEO = new Map();
function furShellGeometry(lib, layers) {
  const key = lib.meta.species + ':' + layers;
  if (FUR_GEO.has(key)) return FUR_GEO.get(key);
  const g = lib.mesh.geometry;
  const pos = g.attributes.position;
  const nrm = g.attributes.normal;
  const col = g.attributes.color;
  const mc = g.attributes.mclass;
  const si = g.attributes.skinIndex;
  const sw = g.attributes.skinWeight;
  const pre = lib.meta.prefix;
  const bones = lib.mesh.skeleton.bones;
  // lids/brows/jaw move against the head (lids hide inside it when open): no shells there
  const bad = new Set(['lid_L', 'lid_R', 'brow_L', 'brow_R', 'jaw'].map((n) => bones.findIndex((b) => b.name === pre + n)).filter((i) => i >= 0));
  const ok = new Uint8Array(pos.count);
  for (let i = 0; i < pos.count; i++) {
    let ex = mc.getX(i) < 0.9375;
    for (let k = 0; k < 4 && !ex; k++) if (bad.has(si.getComponent(i, k)) && sw.getComponent(i, k) > 0.2) ex = true;
    ok[i] = ex ? 0 : 1;
  }
  const idx = g.index ? g.index.array : null;
  const nTri = idx ? idx.length / 3 : pos.count / 3;
  const tris = [];
  for (let t = 0; t < nTri; t++) {
    const a = idx ? idx[t * 3] : t * 3;
    const b = idx ? idx[t * 3 + 1] : t * 3 + 1;
    const c = idx ? idx[t * 3 + 2] : t * 3 + 2;
    if (ok[a] && ok[b] && ok[c]) tris.push(a, b, c);
  }
  const map = new Int32Array(pos.count).fill(-1);
  const used = [];
  for (const v of tris) if (map[v] < 0) map[v] = used.push(v) - 1;
  const nv = used.length;
  const N = nv * layers;
  const P = new Float32Array(N * 3);
  const Nn = new Float32Array(N * 3);
  const C = new Float32Array(N * 3);
  const SI = new Uint16Array(N * 4);
  const SW = new Float32Array(N * 4);
  const S = new Float32Array(N);
  for (let L = 0; L < layers; L++) {
    const sh = (L + 1) / layers;
    for (let j = 0; j < nv; j++) {
      const v = used[j];
      const o = L * nv + j;
      P[o * 3] = pos.getX(v);
      P[o * 3 + 1] = pos.getY(v);
      P[o * 3 + 2] = pos.getZ(v);
      Nn[o * 3] = nrm.getX(v);
      Nn[o * 3 + 1] = nrm.getY(v);
      Nn[o * 3 + 2] = nrm.getZ(v);
      C[o * 3] = col.getX(v);
      C[o * 3 + 1] = col.getY(v);
      C[o * 3 + 2] = col.getZ(v);
      for (let k = 0; k < 4; k++) {
        SI[o * 4 + k] = si.getComponent(v, k);
        SW[o * 4 + k] = sw.getComponent(v, k);
      }
      S[o] = sh;
    }
  }
  const index = new (N > 65535 ? Uint32Array : Uint16Array)(tris.length * layers);
  for (let L = 0; L < layers; L++) for (let t = 0; t < tris.length; t++) index[L * tris.length + t] = map[tris[t]] + L * nv;
  const out = new THREE.BufferGeometry();
  out.setAttribute('position', new THREE.BufferAttribute(P, 3));
  out.setAttribute('normal', new THREE.BufferAttribute(Nn, 3));
  out.setAttribute('color', new THREE.BufferAttribute(C, 3));
  out.setAttribute('skinIndex', new THREE.Uint16BufferAttribute(SI, 4));
  out.setAttribute('skinWeight', new THREE.BufferAttribute(SW, 4));
  out.setAttribute('shell', new THREE.BufferAttribute(S, 1));
  out.setIndex(new THREE.BufferAttribute(index, 1));
  out.boundingSphere = g.boundingSphere ? g.boundingSphere.clone() : null;
  FUR_GEO.set(key, out);
  return out;
}

let FUR_MAT = null;
function furShellMaterial() {
  if (FUR_MAT) return FUR_MAT;
  const m = new THREE.MeshStandardMaterial({ vertexColors: true, roughness: 1, metalness: 0 });
  const u = { uFurLen: { value: 0.022 }, uDroop: { value: 0.008 }, uDens: { value: 150 } };
  m.onBeforeCompile = (sh) => {
    Object.assign(sh.uniforms, u);
    sh.vertexShader = sh.vertexShader
      .replace('#include <common>', '#include <common>\nattribute float shell;\nvarying float vShell;\nvarying vec3 vRoot;\nuniform float uFurLen;\nuniform float uDroop;')
      // offset in bind space (before skinning), so the strands follow the bones
      .replace('#include <begin_vertex>', '#include <begin_vertex>\nvShell = shell; vRoot = position;\ntransformed += normalize(normal) * uFurLen * shell;\ntransformed.y -= uDroop * shell * shell;');
    sh.fragmentShader = sh.fragmentShader
      .replace('#include <common>', '#include <common>\nvarying float vShell;\nvarying vec3 vRoot;\nuniform float uDens;\n' + MX_NOISE)
      .replace(
        '#include <color_fragment>',
        `#include <color_fragment>
        {
          vec3 cell = floor(vRoot * uDens);
          vec3 f = fract(vRoot * uDens) - 0.5;
          float len = 0.35 + 0.65 * mxHash(cell);
          float taper = (1.0 - vShell / len) * 0.62;
          if (vShell > len || dot(f, f) > taper * taper) discard;
          diffuseColor.rgb *= mix(0.55, 1.08, vShell);
        }`
      )
      .replace('#include <lights_fragment_end>', '#include <lights_fragment_end>\nreflectedLight.indirectSpecular *= 0.1; reflectedLight.directSpecular *= 0.1;');
  };
  m.customProgramCacheKey = () => 'dd-furshell-1';
  FUR_MAT = m;
  SHARED_MATS.add(m);
  return m;
}

// adds a fur shell mesh bound to the clone's skeleton (call after CharAnim found the main skinned mesh)
function addFurShells(model, lib, layers) {
  if (!layers) return null;
  let main = null;
  model.traverse((o) => {
    if (o.isSkinnedMesh && !main) main = o;
  });
  if (!main) return null;
  const geo = furShellGeometry(lib, layers);
  const shell = new THREE.SkinnedMesh(geo, furShellMaterial());
  shell.bind(main.skeleton, main.bindMatrix);
  shell.frustumCulled = false;
  shell.castShadow = false;
  shell.receiveShadow = false;
  shell.name = 'furShells';
  main.add(shell);
  return shell;
}

