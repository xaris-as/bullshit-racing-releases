      races: 0,
      owned,
      builds,
      settings: { quality: 'auto', drift: TOUCH_UI ? 'auto' : 'manual', assist: TOUCH_UI, shake: true, minimap: true },
    };
  },
  merge(o) {
    if (!o || typeof o !== 'object') return;
    const d = this.data;
    if (Number.isFinite(o.coins)) d.coins = Math.max(0, Math.min(999999, Math.floor(o.coins)));
    if (o.up && typeof o.up === 'object') {
      for (const u of UPGRADES) if (Number.isFinite(o.up[u.id])) d.up[u.id] = clamp(Math.floor(o.up[u.id]), 0, MAX_LVL);
    }
    if (o.best && typeof o.best === 'object') {
      for (const t of TRACKS) {
        const b = o.best[t.id];
        if (b && Number.isFinite(b.p) && Number.isFinite(b.t)) d.best[t.id] = { p: clamp(Math.floor(b.p), 1, RACERS.length), t: Math.max(0, b.t) };
      }
    }
    if (Number.isFinite(o.racer)) d.racer = clamp(Math.floor(o.racer), 0, RACERS.length - 1);
    if (o.story && typeof o.story === 'object') {
      const st = o.story;
      const obj = (x) => (x && typeof x === 'object' && !Array.isArray(x) ? x : {});
      d.story = { done: obj(st.done), tapes: obj(st.tapes), seen: obj(st.seen), lang: st.lang === 'en' ? 'en' : 'el', voice: st.voice === 0 ? 0 : 1, barks: st.barks !== false, radio: Number.isFinite(st.radio) ? st.radio : 1, rumour: Number.isFinite(st.rumour) ? st.rumour : 1 };
    }
    if (typeof o.music === 'boolean') d.music = o.music;
    if (typeof o.sfx === 'boolean') d.sfx = o.sfx;
    if (Number.isFinite(o.races)) d.races = Math.max(0, Math.floor(o.races));
    if (o.owned && typeof o.owned === 'object') {
      for (const cat of PART_CATS) {
        const list = o.owned[cat];
        if (!Array.isArray(list)) continue;
        for (const id of list) if (PARTS[cat].some((p) => p.id === id) && !d.owned[cat].includes(id)) d.owned[cat].push(id);
      }
    }
    if (o.builds && typeof o.builds === 'object') {
      for (const r of RACERS) {
        const b = o.builds[r.id];
        if (!b || typeof b !== 'object') continue;
        const cur = d.builds[r.id];
        for (const cat of PART_CATS) if (typeof b[cat] === 'string' && PARTS[cat].some((p) => p.id === b[cat])) cur[cat] = b[cat];
        for (const k of ['p1', 'p2', 'rim']) if (Number.isFinite(b[k])) cur[k] = clamp(Math.floor(b[k]), 0, 0xffffff);
        if (Number.isFinite(b.pattern)) cur.pattern = clamp(Math.floor(b.pattern), 0, PATTERNS.length - 1);
        if (Number.isFinite(b.number)) cur.number = clamp(Math.floor(b.number), 0, 99);
        if (Number.isFinite(b.flame)) cur.flame = clamp(Math.floor(b.flame), 0, FLAMES.length - 1);
      }
    }
    if (o.settings && typeof o.settings === 'object') {
      const s = o.settings;
      if (QUALITY_IDS.includes(s.quality)) d.settings.quality = s.quality;
      if (s.drift === 'auto' || s.drift === 'manual') d.settings.drift = s.drift;
      if (typeof s.assist === 'boolean') d.settings.assist = s.assist;
      if (typeof s.shake === 'boolean') d.settings.shake = s.shake;
      if (typeof s.minimap === 'boolean') d.settings.minimap = s.minimap;
    }
  },
  load() {
    this.data = this.fresh();
    try {
      const raw = window.localStorage.getItem(SAVE_KEY);
      if (raw) this.merge(JSON.parse(raw));
      else {
        for (const k of SAVE_KEY_OLD) {
          const old = window.localStorage.getItem(k);
          if (old) {
            this.merge(JSON.parse(old));
            break;
          }
        }
      }
    } catch (e) {}
  },
  store() {
    try {
      window.localStorage.setItem(SAVE_KEY, JSON.stringify(this.data));
    } catch (e) {}
  },
  build(racerIdx) {
    return this.data.builds[RACERS[racerIdx].id];
  },
  // a part is usable if bought, or if it is part of this racer's signature kart
  canUse(racerIdx, cat, id) {
    return this.data.owned[cat].includes(id) || RACERS[racerIdx].build[cat] === id;
  },
};

