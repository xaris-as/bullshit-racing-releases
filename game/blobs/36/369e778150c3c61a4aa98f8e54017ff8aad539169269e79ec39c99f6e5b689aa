const CHUNK = 300;

function buildSkyGeo(theme, radius, seg) {
  const geo = new THREE.SphereGeometry(radius, seg, Math.round(seg * 0.6));
  const top = new THREE.Color(theme.skyTop);
  const hor = new THREE.Color(theme.skyHorizon);
  const bot = new THREE.Color(theme.skyBottom);
  const sunC = new THREE.Color(theme.sun);
  const sd = new THREE.Vector3(...theme.sunDir).normalize();
  const pos = geo.attributes.position;
  const col = new Float32Array(pos.count * 3);
  const c = new THREE.Color();
  for (let i = 0; i < pos.count; i++) {
    _v1.set(pos.getX(i), pos.getY(i), pos.getZ(i)).divideScalar(radius);
    const y = _v1.y;
    if (y >= 0) c.copy(hor).lerp(top, Math.pow(smoothstep(0, 0.62, y), 0.8));
    else c.copy(hor).lerp(bot, smoothstep(0, -0.25, y));
