// one-shot reaction with personality odds
function react(r, clip, opts) {
  const v = visOf(r);
  if (v && v.anim) return v.anim.trigger(clip, opts);
  return false;
}
function sayFace(r, expr, w = 1, hold = 0.8) {
  const v = visOf(r);
  if (v && v.anim) v.anim.expr(expr, w, hold);
}

// ---------------- Hooks (sim -> visuals/audio) ----------------
const Hooks = {
  emit(type, a, b, c) {
    const f = this[type];
    if (!f || !Game.race) return;
    try {
      f.call(this, a, b, c);
    } catch (e) {
      console.error(e);
    }
  },
  wall(r, impact, side) {
    const p = visOf(r).root.position;
    const F = Game.race.track.frameInto(r.s, _fr);
    const x = p.x + F.rx * side * 0.9;
    const z = p.z + F.rz * side * 0.9;
    if (nearCam(x, p.y, z, 80)) {
      const water = r.mode === M_WATER;
      for (let i = 0; i < 16; i++) {
        if (water) Game.fx.spawn(x, p.y + 0.3, z, rnd2() * 4 - F.rx * side * 2, 2 + Math.random() * 4, rnd2() * 4 - F.rz * side * 2, 0.6, 0.35, 0xffffff, 0.8, 9, 1, 0.6);
        else Game.fxA.spawn(x, p.y + 0.5, z, rnd2() * 7 - F.rx * side * 3, 2 + Math.random() * 6, rnd2() * 7 - F.rz * side * 3, 0.3 + Math.random() * 0.25, 0.2, Math.random() < 0.5 ? 0xffd25a : 0xff7a1a, 1, 16, 1, 0, 3);
      }
    }
    if (impact > 7) {
      react(r, 'hit', { cool: 1.5 });
      sayFace(r, 'snarl', 1, 0.6);
    }
    if (r.isPlayer) {
      Sound.play('wall', clamp(impact / 10, 0.4, 1));
      Game.rig.addTrauma(Math.min(0.45, impact * 0.035));
    }
  },
  scrape(r, side) {
    if (!nearCam(visOf(r).root.position.x, visOf(r).root.position.y, visOf(r).root.position.z, 60) || Math.random() > 0.5) return;
    const p = visOf(r).root.position;
    const F = Game.race.track.frameInto(r.s, _fr);
    Game.fxA.spawn(p.x + F.rx * side * 1.0, p.y + 0.35, p.z + F.rz * side * 1.0, -r.vx * 0.2 + rnd2() * 2, 1 + Math.random() * 2, -r.vz * 0.2 + rnd2() * 2, 0.25, 0.14, 0xffc25a, 1, 14, 1, 0, 3);
  },
  bump(a, b, rel) {
    const pa = visOf(a).root.position;
    const pb = visOf(b).root.position;
    const x = (pa.x + pb.x) / 2;
    const y = (pa.y + pb.y) / 2 + 0.5;
    const z = (pa.z + pb.z) / 2;
    if (rel > 2 && nearCam(x, y, z, 70)) for (let i = 0; i < Math.min(22, rel * 3); i++) Game.fxA.spawn(x, y, z, rnd2() * 9, 1 + Math.random() * 5, rnd2() * 9, 0.25 + Math.random() * 0.2, 0.16, Math.random() < 0.5 ? 0xffd25a : 0xffffff, 1, 16, 1, 0, 3);
    if (rel > 4.5) {
      for (const r of [a, b]) if (r.ramT <= 0) react(r, 'hit', { cool: 1.8 });
    }
    if (a.isPlayer || b.isPlayer) {
      Sound.play('bump', clamp(rel / 6, 0.4, 1));
      Game.rig.addTrauma(Math.min(0.4, 0.1 + rel * 0.04));
      const other = a.isPlayer ? b : a;
      Game.lastBump.set(other, Game.clock);
      if (rel > 7) Game.slowmo(0.35, 0.18);
    }
  },
  spinout(r) {
    react(r, 'hit', { force: true, cool: 1 });
    sayFace(r, 'shock', 1, 0.9);
    if (r.isPlayer) {
      Sound.play('spinout');
      UI.toast('SPUN OUT', 'bad');
      Game.rig.addTrauma(0.35);
    } else {
      const t = Game.lastBump.get(r);
      if (t !== undefined && Game.clock - t < 0.9) {
        UI.toast(`${r.name.toUpperCase()} SENT SPINNING`, 'good');
        HUD.portraitPop(Game.player, 'grin');
      }
      if (attn(visOf(r).root.position, 60) > 0.1) Sound.play('spinout');
    }
  },
  pad(r, f) {
    const v = visOf(r);
    if (f.kind === 'jet') {
      const p = v.root.position;
      if (nearCam(p.x, p.y, p.z, 90)) for (let i = 0; i < 18; i++) Game.fx.spawn(p.x + rnd2() * 2, p.y + 0.2, p.z + rnd2() * 2, rnd2() * 5, 3 + Math.random() * 4, rnd2() * 5, 0.7, 0.45, 0xffffff, 0.85, 10, 1, 0.8);
    }
    if (r.isPlayer) {
      Sound.play(f.kind === 'jet' ? 'jet' : 'pad');
      Game.rig.punch = Math.max(Game.rig.punch, 0.5);
      Music.event('boost');
    }
  },
  ring(r, f) {
    if (r.isPlayer && Story.stats) Story.stats.rings++;
    f.flash = 1;
    if (nearCam(f.wx, f.y, f.wz, 120)) {
      const F = Game.race.track.frameInto(f.s, _fr);
      for (let i = 0; i < 24; i++) {
        const a = (i / 24) * TAU;
        const ox = Math.cos(a) * f.r;
        Game.fxA.spawn(f.wx + F.rx * ox, f.y + Math.sin(a) * f.r, f.wz + F.rz * ox, F.rx * ox * 1.5, Math.sin(a) * 4, F.rz * ox * 1.5, 0.5, 0.35, i % 2 ? 0xffc21a : 0xfff1b8, 1, 0, 2, 0, 2.5);
      }
    }
    if (r.isPlayer) {
      Sound.play('ring');
      Game.rig.punch = Math.max(Game.rig.punch, 0.4);
    }
  },
  gate(r, g) {
    g.flash = 1;
    if (r.isPlayer) {
      Sound.play('ring', 0.8);
      UI.toast('GATE +BOOST', 'good');
    }
  },
  thermal(r) {
    if (r.isPlayer) {
      Sound.play('thermal');
      UI.toast('THERMAL: RIDE IT UP', 'good');
    }
  },
  cable(r) {
    const p = visOf(r).root.position;
    for (let i = 0; i < 18; i++) Game.fxA.spawn(p.x, p.y + 1, p.z, rnd2() * 8, rnd2() * 6, rnd2() * 8, 0.3, 0.18, 0x9fe8ff, 1, 4, 1, 0, 3);
    react(r, 'hit', { force: true });
    if (r.isPlayer) {
      Sound.play('hit');
      UI.toast('CABLE STRIKE', 'bad');
      Game.rig.addTrauma(0.5);
    }
  },
  skim(r) {
    const p = visOf(r).root.position;
    if (nearCam(p.x, p.y, p.z, 80)) for (let i = 0; i < 10; i++) Game.fx.spawn(p.x + rnd2() * 2, Game.race.track.waterY + 0.3, p.z + rnd2() * 2, rnd2() * 4, 3 + Math.random() * 3, rnd2() * 4, 0.8, 0.4, 0xffffff, 0.85, 10, 0.6, 0.9);
  },
  launch(r) {
    if (r.isPlayer) {
      Sound.play('wings');
      Game.slowmo(0.4, 0.7);
      Game.rig.swing = 1;
      Game.rig.swingSide = Math.random() < 0.5 ? -1 : 1;
      UI.toast('GLIDE: STEER TO BANK · ↓ TO DIVE', 'good');
      Music.event('glide');
    }
    sayFace(r, 'grin', 1, 1);
  },
  landing(r, kind) {
    if (kind === 'perfect') {
      sayFace(r, 'grin', 1, 1);
      react(r, 'cheer', { cool: 3 });
      if (r.isPlayer) {
        UI.center('PERFECT LANDING', 'small');
        Sound.play('perfect');
        Game.rig.punch = 1;
      }
    }
    if (r.isPlayer) Music.event('glideEnd');
  },
  wipeout(r) {
    react(r, 'hit', { force: true });
    sayFace(r, 'shock', 1, 1.2);
    if (r.isPlayer) {
      UI.center('WIPEOUT', 'small bad');
      Sound.play('hit');
      Game.rig.addTrauma(0.7);
      Game.slowmo(0.3, 0.4);
    }
  },
  coin(r, c) {
    if (!r.isPlayer) return;
    Sound.play('coin');
    $('hud-coins').textContent = String(r.coins);
    for (let i = 0; i < 6; i++) Game.fxA.spawn(c.wx, c.y, c.wz, rnd2() * 4, Math.random() * 4, rnd2() * 4, 0.35, 0.25, 0xffc21a, 1, 6, 2, 0, 2);
  },
  crate(r, f) {
    const x = f.wx;
    const y = f.y + 0.6;
    const z = f.wz;
    if (nearCam(x, y, z, 100)) {
      for (let i = 0; i < 16; i++) Game.fx.spawn(x, y, z, rnd2() * 10, 3 + Math.random() * 7, rnd2() * 10, 0.8 + Math.random() * 0.4, 0.3 + Math.random() * 0.25, i % 2 ? 0x8a5a2a : 0xb3874b, 1, 20, 0.5, 0);
      for (let i = 0; i < 6; i++) Game.fx.spawn(x, y, z, rnd2() * 3, 1 + Math.random() * 2, rnd2() * 3, 1.4, 1.2, 0x8f8a80, 0.55, -0.3, 1.2, 2.4);
    }
    const k = r && r.isPlayer ? 1 : attn(_hv.set(x, y, z));
    if (k > 0.05) Sound.play('crate', k);
    if (r && r.isPlayer) Game.rig.addTrauma(0.3);
  },
  obstacle(r, vn) {
    if (vn > 5) react(r, 'hit', { cool: 1.5 });
    if (r.isPlayer) {
      Sound.play('bump', clamp(vn / 8, 0.4, 1));
      Game.rig.addTrauma(0.3);
    }
  },
  tumble(r, vn, t) {
    if (r.isPlayer) {
      Sound.play('crate', 0.6);
      Game.rig.addTrauma(0.25);
    }
    const p = visOf(r).root.position;
    for (let i = 0; i < 8; i++) Game.fx.spawn(p.x, p.y + 0.8, p.z, rnd2() * 5, Math.random() * 3, rnd2() * 5, 0.8, 0.25, 0xc9a46a, 0.9, 8, 1, 0);
  },
  spin(r, cause, by) {
    if (r.isPlayer && Story.stats) Story.stats.spins++;
    if (r.isPlayer) Voice.bark(r.def.id, 'hit');
    const p = visOf(r).root.position;
    for (let i = 0; i < 10; i++) Game.fx.spawn(p.x, p.y + 0.8, p.z, rnd2() * 4, Math.random() * 3, rnd2() * 4, 0.9, 0.9, cause === 'honey' ? 0xf2a516 : 0x8f8f96, 0.7, -0.5, 1.2, 1.6);
    react(r, 'hit', { force: true, cool: 1 });
    sayFace(r, 'shock', 1, 1);
    if (by && by !== r) {
      sayFace(by, by.def.species === 'cat' ? 'smug' : 'grin', 1, 1.2);
    }
    if (r.isPlayer) {
      Sound.play('hit');
      Game.rig.addTrauma(0.55);
      Game.slowmo(0.3, 0.35);
      Post.fx.flash = 0.35;
      Post.fx.flashCol = [1, 0.2, 0.15];
      let msg = 'HIT!';
      if (cause === 'decoy') msg = `FELL FOR ${by.name.toUpperCase()}'S DECOY`;
      else if (cause === 'ram') msg = `${by.name.toUpperCase()} RAMMED YOU`;
      else if (cause === 'honey') msg = 'STUCK IN HONEY';
      UI.toast(msg, 'bad');
      if (by) HUD.portraitPop(by, 'grin');
    } else if (by && by.isPlayer) {
      UI.toast(cause === 'decoy' ? `${r.name.toUpperCase()} HIT YOUR DECOY` : cause === 'ram' ? `RAMMED ${r.name.toUpperCase()}` : `DIRECT HIT ON ${r.name.toUpperCase()}`, 'good');
      Game.rig.addTrauma(0.25);
      Game.slowmo(0.45, 0.25);
    }
  },
  shieldPop(r) {
    const p = visOf(r).root.position;
    for (let i = 0; i < 18; i++) {
      const a = Math.random() * TAU;
      Game.fxA.spawn(p.x, p.y + 1, p.z, Math.cos(a) * 6, rnd2() * 5, Math.sin(a) * 6, 0.4, 0.3, 0x8ff0ff, 1, 0, 2, 0, 2);
    }
    if (r.isPlayer) Sound.play('pop');
  },
  boom(k, target) {
    Game.race.track.toWorld(k.s, k.d, _tw);
    const x = _tw.x;
    const y = k.y;
    const z = _tw.z;
    if (nearCam(x, y, z, 120)) {
      for (let i = 0; i < 22; i++) Game.fxA.spawn(x, y, z, rnd2() * 10, Math.random() * 7, rnd2() * 10, 0.45 + Math.random() * 0.2, 0.55, i % 3 ? 0xff9a2e : 0xffe066, 1, 6, 2.5, 0, 2.5);
      for (let i = 0; i < 8; i++) Game.fx.spawn(x, y, z, rnd2() * 3, 1 + Math.random() * 2, rnd2() * 3, 1.1, 1.2, 0x5a5a62, 0.55, -0.4, 1.2, 2.4);
    }
    const kk = target && target.isPlayer ? 1 : attn(_hv.set(x, y, z), 80);
    if (kk > 0.05) Sound.play('boom', kk);
    for (const o of Game.race.racers) {
      if (o === target || o.finished) continue;
      const vp = visOf(o).root.position;
      const dx = vp.x - x;
      const dz = vp.z - z;
      if (dx * dx + dz * dz < 12 * 12) react(o, 'duck', { cool: 2.5 });
    }
  },
  air(r) {
    r._airStart = Game.clock;
  },
  airTrick(r) {
    if (r.isPlayer) {
      UI.toast('AIR TIME', 'good');
      Sound.play('trick');
    }
    sayFace(r, 'grin', 1, 0.8);
  },
  // v5 ramp tricks
  rampAir(r) {
    if (!r.isPlayer) return;
    Game.trickHints = (Game.trickHints || 0) + 1;
    if (Game.trickHints <= 6 && r.trickN === 0) UI.center('TRICK!', 'small', TOUCH_UI ? 'TAP NOW' : 'PRESS SPACE');
  },
  trick(r, kind, n) {
    const p = visOf(r).root.position;
    if (nearCam(p.x, p.y, p.z, 70)) {
      for (let i = 0; i < 14; i++) {
        const a = (i / 14) * TAU;
        Game.fxA.spawn(p.x, p.y + 0.8, p.z, Math.cos(a) * 5, Math.sin(a) * 4, Math.sin(a * 2) * 3, 0.35, 0.22, n >= 2 ? 0xff2e88 : 0xffc21a, 1, 0, 2, 0, 2.5);
      }
    }
    if (r.isPlayer) {
      Sound.play('whoosh');
      if (n >= 2) Sound.play('trick');
      UI.center(n === 1 ? 'TRICK!' : n === 2 ? 'DOUBLE!' : 'TRIPLE!', 'small');
      Game.rig.punch = Math.max(Game.rig.punch, 0.25 + n * 0.1);
    }
  },
  trickLand(r, n) {
    const p = visOf(r).root.position;
    if (nearCam(p.x, p.y, p.z, 70)) for (let i = 0; i < 10 + n * 8; i++) Game.fxA.spawn(p.x, p.y + 0.3, p.z, rnd2() * 9, 1 + Math.random() * 3, rnd2() * 9, 0.4, 0.25, n >= 2 ? 0xff2e88 : 0x29e3ff, 1, 4, 2, 0, 3);
    if (n >= 2 || (r.isPlayer && Math.random() < 0.5)) react(r, 'cheer', { cool: 2 });
    sayFace(r, r.def.species === 'cat' ? 'smug' : 'grin', 1, 1);
    if (r.isPlayer) {
      Sound.play(n >= 2 ? 'perfect' : 'driftBoost', n);
      UI.toast(n === 1 ? 'TRICK BOOST' : n === 2 ? 'DOUBLE TRICK BOOST' : 'TRIPLE TRICK BOOST', 'good');
      Game.rig.punch = Math.max(Game.rig.punch, 0.5 + n * 0.15);
      Music.event('boost');
      if (Story.stats) Story.stats.tricks = (Story.stats.tricks || 0) + n;
    }
  },
  trickFail(r) {
    react(r, 'hit', { force: true, cool: 1 });
    sayFace(r, 'shock', 1, 0.8);
    if (r.isPlayer) {
      UI.center('SLOPPY LANDING', 'small bad');
      Sound.play('land', 1);
      Game.rig.addTrauma(0.4);
    }
  },
  land(r, impact) {
    const v = visOf(r);
    v.squash = Math.min(1, impact / 10);
    for (const w of v.wheels) w.suspV -= impact * 0.06;
    if (impact > 4) react(r, 'land', { cool: 0.6 });
    const p = v.root.position;
    if (nearCam(p.x, p.y, p.z, 80)) {
      for (let i = 0; i < 12; i++) Game.fx.spawn(p.x + rnd2() * 2, p.y + 0.2, p.z + rnd2() * 2, rnd2() * 6, Math.random() * 1.5, rnd2() * 6, 1.1, 1.0, Game.world.theme.dirt, 0.5, 0, 2, 2.2);
      if (impact > 6) for (let i = 0; i < 10; i++) Game.fxA.spawn(p.x + rnd2(), p.y + 0.1, p.z + rnd2(), rnd2() * 9, Math.random() * 2, rnd2() * 9, 0.25, 0.14, 0xffc25a, 1, 12, 1, 0, 3);
    }
    if (r.isPlayer) {
      Sound.play('land', clamp(impact / 12, 0.4, 1));
      Game.rig.addTrauma(Math.min(0.4, impact * 0.03));
    }
  },
  splash(r, impact) {
    const v = visOf(r);
    v.squash = Math.min(1, impact / 12);
    const p = v.root.position;
    if (impact > 1.5 && nearCam(p.x, p.y, p.z, 100)) {
      const n = Math.min(40, 10 + impact * 3);
      for (let i = 0; i < n; i++) {
        const a = Math.random() * TAU;
        const sp = 2 + Math.random() * 5;
        Game.fx.spawn(p.x + Math.cos(a) * 1.2, Game.race.track.waterY + 0.2, p.z + Math.sin(a) * 1.2, Math.cos(a) * sp, 4 + Math.random() * impact * 0.7, Math.sin(a) * sp, 0.9, 0.4 + Math.random() * 0.3, Math.random() < 0.3 ? 0xd8fbff : 0xffffff, 0.9, 12, 0.6, 0.9);
      }
    }
    if (r.isPlayer && impact > 1.5) {
      Sound.play('splash', clamp(impact / 10, 0.5, 1));
      Game.rig.addTrauma(Math.min(0.4, impact * 0.03));
    }
  },
  transform(r, form) {
    const p = visOf(r).root.position;
    if (nearCam(p.x, p.y, p.z, 70)) for (let i = 0; i < 14; i++) Game.fx.spawn(p.x + rnd2() * 2, p.y + 0.8, p.z + rnd2() * 2, rnd2() * 3, Math.random() * 2, rnd2() * 3, 0.7, 0.7, 0xffffff, 0.6, -0.3, 1.5, 1.6);
    if (r.isPlayer) {
      Sound.play(form === 1 ? 'wings' : 'transform');
      if (form === 2) UI.toast('BOAT: SLALOM THE GATES', 'good');
      else if (form === 0) UI.toast('BACK ON WHEELS', '');
    }
  },
  respawn(r) {
    if (r.isPlayer) {
      Sound.play('respawn');
      UI.toast('BACK ON TRACK', '');
      Game.snapCam = true;
    }
  },
  driftStart(r) {
    if (r.isPlayer) Sound.play('drift');
  },
  driftLevel(r, lvl) {
    if (lvl < 1) return;
    if (r.isPlayer) Sound.play('driftLevel', lvl);
    if (lvl === 3) sayFace(r, r.def.species === 'cat' ? 'smug' : r.def.species === 'frog' ? 'smug' : 'grin', 0.8, 0.8);
    const v = visOf(r);
    for (const w of v.wheels) {
      if (w.front) continue;
      v.chassis.localToWorld(_lw.set(w.base.x, 0.05, w.base.z + 0.3));
      for (let i = 0; i < 8; i++) Game.fxA.spawn(_lw.x, _lw.y, _lw.z, rnd2() * 5, 1 + Math.random() * 3, rnd2() * 5, 0.35, 0.22, DRIFT_COL[lvl], 1, 10, 1, 0, 3);
    }
  },
  driftBoost(r, lvl) {
    if (lvl >= 3 && Math.random() < (r.isPlayer ? 0.6 : 0.3)) react(r, 'cheer', { cool: 4 });
    if (r.isPlayer) {
      Sound.play('driftBoost', lvl);
      Game.rig.punch = Math.max(Game.rig.punch, 0.35 + lvl * 0.2);
      if (lvl >= 3) UI.toast('ULTRA DRIFT BOOST', 'good');
      Music.event('boost');
    }
  },
  overtake(a, b) {
    if (a.finished) return;
    if (a.isPlayer) Voice.bark(a.def.id, 'overtake');
    else if (b && b.isPlayer) Voice.bark(a.def.id, BARKS[a.def.id] && BARKS[a.def.id].overtake ? 'overtake' : 'none');
    const P = PERSONA[a.def.species];
    if (Math.random() < (P ? P.taunt : 0.7)) react(a, 'taunt_overtake', { cool: 6 });
    if (a.isPlayer) {
      Sound.play('pass');
      if (Game.phase === 'race') HUD.portraitPop(b, 'sad');
    }
  },
  overtaken(b, a) {
    if (b.finished) return;
    react(b, 'overtaken', { cool: 5 });
    if (b.isPlayer && Game.phase === 'race') HUD.portraitPop(a, a.def.species === 'cat' ? 'smug' : 'grin');
  },
  nearMiss(r) {
    if (r.isPlayer) {
      UI.toast('NEAR MISS +CHARGE', 'good');
      Sound.play('whoosh');
    }
  },
  charge(r, why) {
    if (r.isPlayer) HUD.chargeTick(why);
  },
  abilityReady(r) {
    if (r.isPlayer) {
      Sound.play('ready');
      HUD.abilityReady();
    }
  },
  ability(r, id) {
    if (r.isPlayer) Voice.bark(r.def.id, 'ability');
    if (Net.on && Game.netCfg && !r.remote) Net.event('ab', { nid: r.nid });
    const v = visOf(r);
    react(r, 'ability', { force: true });
    const ab = ABILITIES[id];
    const p = v.root.position;
    if (nearCam(p.x, p.y, p.z, 100)) {
      for (let i = 0; i < 26; i++) {
        const a = Math.random() * TAU;
        Game.fxA.spawn(p.x, p.y + 0.9, p.z, Math.cos(a) * 7, rnd2() * 4, Math.sin(a) * 7, 0.4, 0.3, ab.color, 1, 0, 2, 0, 3);
      }
    }
    if (r.isPlayer) {
      Sound.play('ability_' + id);
      Game.rig.punch = 1;
      Post.fx.flash = 0.25;
      const c = new THREE.Color(ab.color);
