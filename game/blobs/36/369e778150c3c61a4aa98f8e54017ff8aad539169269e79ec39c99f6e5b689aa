    port.classList.remove('pick');
    port.style.backgroundImage = Portraits.css(d.id, 'idle');
    card.style.setProperty('--accent', acc);
    const show = kartStats(d, Save.build(idx), Save.data.up).show;
    const st = $('sel-stats');
    st.innerHTML = '';
    for (const k of STAT_KEYS) {
      const row = el('div', 'stat');
      const dd = el('dd');
      for (let i = 1; i <= 10; i++) {
        const pip = el('i');
        if (i <= show[k]) pip.className = 'on';
        dd.appendChild(pip);
      }
      row.append(el('dt', '', STAT_LABEL[k]), dd);
      st.appendChild(row);
