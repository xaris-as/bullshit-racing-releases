// lengthen a plan (not the final run-off and not the jump gaps) so a race lasts ~80 s like the originals
function stretch(plan, k) {
  return plan.map((p, i) => (i === plan.length - 1 || p[3] === 'G' ? p : [Math.round(p[0] * k), ...p.slice(1)]));
}
function mirrorPlan(plan) {
  return plan.map((p) => [p[0], -p[1], p[2], ...p.slice(3)]);
}
function variantOf(id, over) {
  const b = TRACKS.find((t) => t.id === id);
  const t = JSON.parse(JSON.stringify(b));
  t.plan = mirrorPlan(b.plan);
  t.heading = (b.heading || 0) + 180;
  t.variantOf = id;
  return Object.assign(t, over);
}

