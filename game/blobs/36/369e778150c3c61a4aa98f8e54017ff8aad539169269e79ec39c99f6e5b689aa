      if (pv[k] !== cur[k]) {
        const dl = el('span', 'delta ' + (pv[k] > cur[k] ? 'up' : 'down'));
        dl.style.left = Math.min(cur[k], pv[k]) * 10 + '%';
        dl.style.width = Math.abs(pv[k] - cur[k]) * 10 + '%';
        trk.appendChild(dl);
      }
      row.append(el('span', '', STAT_LABEL[k]), trk, el('b', '', String(pv[k])));
      box.appendChild(row);
    }
  },
  renderParts(body) {
    const r = this.ctx.racer;
    const b = this.ctx.build();
    for (const cat of PART_CATS) {
      const sec = el('div', 'gsec');
      const h = el('h3', '', CAT_LABEL[cat]);
      const fits = partFits(b, cat);
      h.appendChild(el('small', '', fits ? partOf(cat, b[cat]).name : 'Not on bikes'));
      sec.appendChild(h);
      if (!fits) {
        body.appendChild(sec);
        continue;
      }
      const grid = el('div', 'opts');
      for (const p of PARTS[cat]) {
        const btn = el('button', 'opt');
        const usable = Save.canUse(r, cat, p.id);
        const equipped = b[cat] === p.id;
        const trying = this.trying && this.trying.cat === cat && this.trying.id === p.id;
        btn.setAttribute('aria-pressed', equipped && !this.trying ? 'true' : equipped && this.trying && this.trying.cat !== cat ? 'true' : 'false');
        if (trying) btn.classList.add('trying');
        if (!usable) btn.classList.add('locked');
        btn.appendChild(el('span', 'on', p.name));
        const os = el('span', 'os');
        if (equipped) os.textContent = 'Equipped';
        else if (trying) os.textContent = 'Trying on';
        else if (usable) os.textContent = Save.data.owned[cat].includes(p.id) ? 'Owned' : 'Signature';
        else {
          os.appendChild(el('span', 'coin-ico'));
          os.appendChild(document.createTextNode(String(p.cost)));
        }
        btn.appendChild(os);
        const desc = el('span', 'os', p.desc);
        desc.style.fontWeight = '500';
        btn.appendChild(desc);
        btn.addEventListener('click', () => {
          if (usable) {
            this.trying = null;
            if (!equipped) this.ctx.onEquip(cat, p.id);
            else Sound.play('click');
          } else {
            Sound.play('click');
            this.trying = trying ? null : { cat, id: p.id };
          }
          this.render();
        });
        grid.appendChild(btn);
      }
      sec.appendChild(grid);
      body.appendChild(sec);
    }
    const reset = el('button', 'chipbtn', isBike(RACERS[this.ctx.racer].build) ? 'Back to signature bike' : 'Back to signature kart');
