function buildRamps(track, list, tex, Q) {
  const out = { pos: [], nor: [], uv: [], idx: [] };
  const push = (p, nrm, u, v) => {
    out.pos.push(p[0], p[1], p[2]);
    out.nor.push(nrm[0], nrm[1], nrm[2]);
    out.uv.push(u, v);
  };
  const tmp = {};
  for (const r of list) {
    const segs = 4;
    const dl = r.d - r.hw;
    const dr = r.d + r.hw;
    const rows = [];
    for (let j = 0; j <= segs; j++) {
      const s = lerp(r.s0, r.s1 - 0.01, j / segs);
      const L = track.toWorld(s, dl, tmp);
      const Lx = L.x;
      const Lz = L.z;
      const Rr = track.toWorld(s, dr, tmp);
      const yl = track.baseHeight(s, dl);
      const yr = track.baseHeight(s, dr);
      const off = (r.h * (s - r.s0)) / (r.s1 - r.s0);
      const bot = r.kind === 'water' ? -1.2 : -0.1;
      rows.push({ L: [Lx, yl + off + 0.03, Lz], R: [Rr.x, yr + off + 0.03, Rr.z], Lb: [Lx, yl + bot, Lz], Rb: [Rr.x, yr + bot, Rr.z], v: j / segs });
    }
    const psi = track.psiAt(r.s1);
    const fx = Math.sin(psi);
    const fz = -Math.cos(psi);
    const rx = Math.cos(psi);
    const rz = Math.sin(psi);
    const slope = r.h / (r.s1 - r.s0);
    const ln = Math.hypot(1, slope);
    const top = [(-fx * slope) / ln, 1 / ln, (-fz * slope) / ln];
    let base = out.pos.length / 3;
    for (const row of rows) {
      push(row.L, top, 0, row.v * 1.2);
      push(row.R, top, (r.hw * 2) / 4, row.v * 1.2);
    }
    for (let j = 0; j < segs; j++) {
      const a = base + j * 2;
      out.idx.push(a, a + 1, a + 2, a + 1, a + 3, a + 2);
    }
    for (const side of [0, 1]) {
      base = out.pos.length / 3;
      const nrm = side === 0 ? [-rx, 0, -rz] : [rx, 0, rz];
      for (const row of rows) {
        push(side === 0 ? row.L : row.R, nrm, row.v, 1);
        push(side === 0 ? row.Lb : row.Rb, nrm, row.v, 0);
      }
      for (let j = 0; j < segs; j++) {
        const a = base + j * 2;
        if (side === 0) out.idx.push(a, a + 2, a + 1, a + 1, a + 2, a + 3);
        else out.idx.push(a, a + 1, a + 2, a + 1, a + 3, a + 2);
      }
    }
    const last = rows[rows.length - 1];
    base = out.pos.length / 3;
    const nb = [fx, 0, fz];
    push(last.L, nb, 0, 1);
    push(last.R, nb, 1, 1);
    push(last.Lb, nb, 0, 0);
    push(last.Rb, nb, 1, 0);
    out.idx.push(base, base + 2, base + 1, base + 1, base + 2, base + 3);
  }
  const mat = new THREE.MeshStandardMaterial({ map: tex, side: THREE.DoubleSide, roughness: 0.6 });
  const m = new THREE.Mesh(geoFromOut(out), mat);
  m.castShadow = Q.shadows > 0;
  m.receiveShadow = Q.shadows > 0;
  return m;
}

function checkerTexture(rows, cols, a = '#ffffff', b = '#1b1b24') {
  return canvasTex(cols * 16, rows * 16, (g) => {
    for (let y = 0; y < rows; y++)
