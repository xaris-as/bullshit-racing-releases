      bp.type = 'bandpass';
      bp.frequency.value = F[k];
      bp.Q.value = 9 - k * 2;
      const kg = c.createGain();
      kg.gain.value = [1, 0.6, 0.3][k];
      o.connect(bp);
      n.connect(ng);
      ng.connect(bp);
      bp.connect(kg);
      kg.connect(g);
    }
    g.connect(out);
    o.start(t);
    n.start(t, Math.random());
    o.stop(t + 0.3);
    n.stop(t + 0.3);
  },
  play(name, k = 1) {
    if (!this.ctx || !this.sfxOn) return;
