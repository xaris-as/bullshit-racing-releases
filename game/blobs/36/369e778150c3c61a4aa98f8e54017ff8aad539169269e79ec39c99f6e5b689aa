const STAT_KEYS = ['speed', 'accel', 'handling', 'weight', 'drift'];
function kartStats(racerDef, build, up) {
  const s = Object.assign({}, racerDef.st);
  let offroad = 0;
  let turbo = 0;
  let trick = 0;
  for (const cat of PART_CATS) {
    if (!partFits(build, cat)) continue;
    const p = partOf(cat, build[cat]);
    for (const k in p.mod) s[k] = (s[k] || 0) + p.mod[k];
    offroad += p.offroad || 0;
    turbo += p.turbo || 0;
    trick += p.trick || 0;
  }
  for (const k of STAT_KEYS) s[k] = clamp(s[k], 0, 10);
  const upg = up || { engine: 0, grip: 0, turbo: 0 };
  return {
    show: s,
    vTop: (26.6 + s.speed * 0.42) * (1 + 0.016 * upg.engine),
    accel: 8.6 + s.accel * 0.85,
    handling: (1.28 + s.handling * 0.065) * (1 + 0.045 * upg.grip),
    grip: 0.9 + s.handling * 0.025,
    mass: 0.8 + s.weight * 0.07,
    driftRate: 0.8 + s.drift * 0.06,
    turboMul: (1 + turbo) * (1 + 0.08 * upg.turbo),
    offroad: clamp(offroad, 0, 0.8),
    bike: isBike(build),
    trick,
  };
}

