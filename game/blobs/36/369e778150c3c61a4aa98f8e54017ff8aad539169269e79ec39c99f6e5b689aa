// ---------- detail texture for terrain ----------
let DETAIL_TEX = null;
function detailTexture() {
  if (DETAIL_TEX) return DETAIL_TEX;
  const N = 256;
  const rnd = mulberry32(31);
  const noise = makeNoise(77);
  DETAIL_TEX = canvasTex(
    N,
    N,
    (g) => {
      const img = g.createImageData(N, N);
      for (let y = 0; y < N; y++) {
        for (let x = 0; x < N; x++) {
          const u = x / N;
          const v = y / N;
          // tileable noise via torus mapping
          const a = u * TAU;
          const b = v * TAU;
          const n1 = noise.n2(Math.cos(a) * 2 + 9, Math.sin(a) * 2 + Math.cos(b) * 2) * 0.5 + noise.n2(Math.sin(b) * 3 + 4, Math.cos(a) * 3 - Math.sin(b)) * 0.5;
          const k = 0.86 + n1 * 0.08 + (rnd() - 0.5) * 0.1;
          const vv = Math.round(clamp(k, 0.62, 1) * 255);
          const i = (y * N + x) * 4;
          img.data[i] = vv;
          img.data[i + 1] = vv;
          img.data[i + 2] = vv;
          img.data[i + 3] = 255;
        }
      }
      g.putImageData(img, 0, 0);
    },
    { repeat: true, linear: true }
  );
  return DETAIL_TEX;
}

// ---------- Terrain heightfield (mode-aware carving) ----------
function buildTerrain(track, theme, Q, carves) {
  const { X, Z, H, PSI, B, M, n } = track;
  let minX = Infinity;
  let maxX = -Infinity;
  let minZ = Infinity;
  let maxZ = -Infinity;
  for (let i = 0; i < n; i++) {
    if (X[i] < minX) minX = X[i];
    if (X[i] > maxX) maxX = X[i];
    if (Z[i] < minZ) minZ = Z[i];
    if (Z[i] > maxZ) maxZ = Z[i];
  }
  const MG = 430;
  minX -= MG;
  maxX += MG;
  minZ -= MG;
  maxZ += MG;
  const area = (maxX - minX) * (maxZ - minZ);
  const cell = Math.max(5, Math.sqrt(area / Q.terrainCells));
  const nx = Math.ceil((maxX - minX) / cell) + 1;
  const nz = Math.ceil((maxZ - minZ) / cell) + 1;
  const N = nx * nz;
  const minD = new Float32Array(N).fill(1e9);
  const nearH = new Float32Array(N);
  const nearS = new Float32Array(N);
  const nearM = new Uint8Array(N);
  const wsum = new Float32Array(N);
  const hsum = new Float32Array(N);
  const carved = new Uint8Array(N);
  const R = 170;
  const R2 = R * R;
  const Rc = Math.ceil(R / cell);
  const wy = track.waterY;
  const endA = track.finishS - 520;
  const endB = track.finishS - 120;
  for (let i = 0; i < n; i += 2) {
    const cx = X[i];
    const cz = Z[i];
    const m = M[i];
    const ch = m === M_AIR ? wy - 8 : m === M_WATER ? wy - 3 : H[i];
    const riseK = m === M_AIR ? 0 : m === M_WATER ? 0.3 : 1;
    const rx = Math.cos(PSI[i]);
    const rz = Math.sin(PSI[i]);
    const sb = Math.sin(B[i]);
    const s = i * STEP;
    const vf = (1 - 0.85 * smoothstep(endA, endB, s)) * riseK;
    const gx = Math.round((cx - minX) / cell);
    const gz = Math.round((cz - minZ) / cell);
    const x0 = Math.max(0, gx - Rc);
    const x1 = Math.min(nx - 1, gx + Rc);
    const z0 = Math.max(0, gz - Rc);
    const z1 = Math.min(nz - 1, gz + Rc);
    for (let jz = z0; jz <= z1; jz++) {
      const dz = minZ + jz * cell - cz;
      const dz2 = dz * dz;
      if (dz2 > R2) continue;
      for (let jx = x0; jx <= x1; jx++) {
        const dx = minX + jx * cell - cx;
        const d2 = dx * dx + dz2;
        if (d2 > R2) continue;
        const k = jz * nx + jx;
        const dist = Math.sqrt(d2);
        if (dist < minD[k]) {
          minD[k] = dist;
          nearS[k] = s;
          nearM[k] = m;
          const l = dx * rx + dz * rz;
          nearH[k] = H[i] - clamp(l, -WALL_HW, WALL_HW) * sb;
        }
        const w = 1 / ((d2 + 300) * (d2 + 300));
        const e = dist - 14;
        const rise = e <= 0 ? 0 : e * 0.26 + e * e * 0.0008;
        wsum[k] += w;
        hsum[k] += w * (ch + rise * vf);
      }
    }
  }
  const hF = new Float32Array(N);
  const has = new Uint8Array(N);
  const queue = new Int32Array(N);
  let qh = 0;
  let qt = 0;
  for (let k = 0; k < N; k++) {
    if (wsum[k] <= 0) continue;
    let h = hsum[k] / wsum[k];
    const dm = minD[k];
    const m = nearM[k];
    const sN = nearS[k];
    if (m === M_ROAD || m === M_GAP) {
      const road = nearH[k] - 0.55;
      if (dm < 40) h = lerp(road, h, smoothstep(12.5, 30, dm));
      const startF = 1 - smoothstep(150, 380, sN);
      if (startF > 0 && dm > 14) h = lerp(h, road - (dm - 14) * 0.3, startF * smoothstep(14, 40, dm));
      const endF = smoothstep(track.finishS - 480, track.finishS - 90, sN);
      if (endF > 0) h = lerp(h, Math.min(h, road - Math.max(0, dm - 16) * 0.16), endF);
    } else if (m === M_WATER) {
      const t = dm < WATER_HW + 3 ? wy - 3.4 : lerp(wy - 3.4, wy + 1.1, smoothstep(WATER_HW + 3, WATER_HW + 34, dm));
      h = lerp(t, Math.max(h, wy + 1.1), smoothstep(45, 120, dm));
      carved[k] = dm < WATER_HW + 26 ? 1 : 0;
    } else if (m === M_AIR) {
      h = lerp(wy - 7, Math.max(h, wy + 2), smoothstep(85, 160, dm));
      carved[k] = dm < 120 ? 1 : 0;
    }
    hF[k] = h;
    has[k] = 1;
    queue[qt++] = k;
  }
  while (qh < qt) {
    const k = queue[qh++];
    const jx = k % nx;
    const jz = (k / nx) | 0;
    const hv = hF[k] + cell * 0.04;
    if (jx > 0 && !has[k - 1]) {
      has[k - 1] = 1;
      hF[k - 1] = hv;
      queue[qt++] = k - 1;
    }
    if (jx < nx - 1 && !has[k + 1]) {
      has[k + 1] = 1;
      hF[k + 1] = hv;
      queue[qt++] = k + 1;
    }
    if (jz > 0 && !has[k - nx]) {
      has[k - nx] = 1;
      hF[k - nx] = hv;
      queue[qt++] = k - nx;
    }
    if (jz < nz - 1 && !has[k + nx]) {
      has[k + nx] = 1;
      hF[k + nx] = hv;
      queue[qt++] = k + nx;
    }
  }
  const noise = makeNoise(track.def.seed * 31 + 7);
  const pos = new Float32Array(N * 3);
  const uv = new Float32Array(N * 2);
  const hh = new Float32Array(N);
  for (let jz = 0; jz < nz; jz++) {
    for (let jx = 0; jx < nx; jx++) {
      const k = jz * nx + jx;
      const wx = minX + jx * cell;
      const wz = minZ + jz * cell;
      const dm = minD[k];
      const m = nearM[k];
      let sea = 0;
      if (m === M_AIR) sea = 1 - smoothstep(95, 165, dm);
      else if (m === M_WATER) sea = 1 - smoothstep(WATER_HW + 18, WATER_HW + 60, dm);
      let h = hF[k];
      h += (noise.fbm(wx * 0.0065, wz * 0.0065, 4) * 26 * smoothstep(18, 90, dm) + noise.n2(wx * 0.045, wz * 0.045) * 1.6 * smoothstep(14, 40, dm)) * (1 - sea);
      h += noise.n2(wx * 0.03, wz * 0.03) * 1.2 * sea;
      // gorges / ravines across the road
      for (const cv of carves) {
        if (Math.abs(nearS[k] - cv.s) > 160 && dm < 40) continue;
        const ax = wx - cv.x;
        const az = wz - cv.z;
        const al = Math.abs(ax * cv.tx + az * cv.tz);
        const lt = Math.abs(ax * cv.rx + az * cv.rz);
        const fa = 1 - smoothstep(cv.half - 2, cv.half + 9, al);
        const fl = 1 - smoothstep(cv.lat * 0.65, cv.lat, lt);
        const f = fa * fl;
        if (f <= 0) continue;
        const floor = cv.floor + (al / Math.max(1, cv.half)) * (al / Math.max(1, cv.half)) * 3 + noise.n2(wx * 0.08, wz * 0.08) * 1.2;
        if (floor < h) {
          h = lerp(h, floor, f);
          if (f > 0.3) carved[k] = 1;
        }
      }
      const edge = Math.min(jx, nx - 1 - jx, jz, nz - 1 - jz) * cell;
      h = lerp(wy - 18, h, smoothstep(0, 260, edge));
      hh[k] = h;
      pos[k * 3] = wx;
      pos[k * 3 + 1] = h;
      pos[k * 3 + 2] = wz;
      uv[k * 2] = wx / 7;
      uv[k * 2 + 1] = wz / 7;
    }
  }
  const idx = new Uint32Array((nx - 1) * (nz - 1) * 6);
  let q = 0;
  for (let jz = 0; jz < nz - 1; jz++) {
    for (let jx = 0; jx < nx - 1; jx++) {
      const a = jz * nx + jx;
      const b = a + 1;
      const c = a + nx;
      const d = c + 1;
      idx[q++] = a;
      idx[q++] = c;
      idx[q++] = b;
      idx[q++] = b;
      idx[q++] = c;
      idx[q++] = d;
    }
  }
  const geo = new THREE.BufferGeometry();
  geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
  geo.setAttribute('uv', new THREE.BufferAttribute(uv, 2));
  geo.setIndex(new THREE.BufferAttribute(idx, 1));
  geo.computeVertexNormals();
  const nor = geo.attributes.normal.array;
  const col = new Float32Array(N * 3);
  const grass = theme.grass.map((g) => new THREE.Color(g));
  const rock = new THREE.Color(theme.rock);
  const dirt = new THREE.Color(theme.dirt);
  const sand = new THREE.Color(theme.sand);
  const deep = new THREE.Color(theme.waterDeep).multiplyScalar(0.55);
  const c = new THREE.Color();
  const c2 = new THREE.Color();
  for (let k = 0; k < N; k++) {
    const wx = pos[k * 3];
    const y = pos[k * 3 + 1];
    const wz = pos[k * 3 + 2];
    const ny = nor[k * 3 + 1];
    const t = noise.n2(wx * 0.018, wz * 0.018) * 0.5 + 0.5;
    const t2 = noise.n2(wx * 0.07 + 40, wz * 0.07) * 0.5 + 0.5;
    c.copy(grass[0]).lerp(grass[1], t);
    c.lerp(grass[2], t2 * 0.45);
    if (theme.rockStrata) {
      const band = Math.sin(y * 0.42) * 0.5 + 0.5;
      c2.copy(rock).lerp(dirt, band * 0.6);
      c.lerp(c2, smoothstep(0.9, 0.7, ny));
    } else c.lerp(rock, smoothstep(0.82, 0.62, ny));
    const dm = minD[k];
    if (dm < 18 && (nearM[k] === M_ROAD || nearM[k] === M_GAP)) c.lerp(dirt, (1 - smoothstep(12.5, 18, dm)) * 0.7);
    if (y < wy + 1.8) c.lerp(sand, smoothstep(wy + 1.8, wy + 0.5, y));
    if (y < wy - 0.6) c.lerp(deep, smoothstep(wy - 0.6, wy - 7, y));
    const kb = Q.splat ? 1.02 : 1.14;
    col[k * 3] = c.r * kb;
    col[k * 3 + 1] = c.g * kb;
    col[k * 3 + 2] = c.b * kb;
  }
  geo.setAttribute('color', new THREE.BufferAttribute(col, 3));
  geo.computeBoundingSphere();
  const mat = Q.splat ? splatTerrainMaterial(theme) : new THREE.MeshStandardMaterial({ vertexColors: true, map: detailTexture(), roughness: 0.96, metalness: 0 });
  const mesh = new THREE.Mesh(geo, mat);
  mesh.receiveShadow = Q.shadows > 0;
  const T = {
    mesh, nx, nz, cell, minX, minZ, minD, nearS, nearM, carved, h: hh, nor,
    idx(x, z) {
      const jx = clamp(Math.round((x - minX) / cell), 0, nx - 1);
      const jz = clamp(Math.round((z - minZ) / cell), 0, nz - 1);
      return jz * nx + jx;
    },
    heightAt(x, z) {
      const fx = clamp((x - minX) / cell, 0, nx - 1.001);
      const fz = clamp((z - minZ) / cell, 0, nz - 1.001);
      const ix = fx | 0;
      const iz = fz | 0;
      const tx = fx - ix;
      const tz = fz - iz;
      const k = iz * nx + ix;
      const a = hh[k] + (hh[k + 1] - hh[k]) * tx;
      const b = hh[k + nx] + (hh[k + nx + 1] - hh[k + nx]) * tx;
      return a + (b - a) * tz;
    },
  };
  return T;
}

// ---------- Water ----------
function makeWaterMaterial(theme, Q, U) {
  if (theme.ice) {
    return new THREE.MeshStandardMaterial({ color: theme.water, roughness: 0.12, metalness: 0.05, envMapIntensity: 1.2 });
  }
  if (theme.lava) return new THREE.MeshStandardMaterial({ color: 0x3a0a04, emissive: theme.water, emissiveIntensity: 1.6, roughness: 0.8 });
  const fancy = Q.water === 'fancy';
  const m = new THREE.MeshStandardMaterial({ color: theme.water, roughness: 0.05, metalness: 0, transparent: fancy, opacity: 0.9, envMapIntensity: 1.25 });
  m.onBeforeCompile = (sh) => {
    sh.uniforms.uTime = U.uTime;
    sh.uniforms.uDeep = { value: new THREE.Color(theme.waterDeep) };
    sh.vertexShader = sh.vertexShader
      .replace('#include <common>', '#include <common>\nvarying vec3 vWPos;')
      .replace('#include <project_vertex>', '#include <project_vertex>\nvWPos = (modelMatrix * vec4(transformed, 1.0)).xyz;');
    sh.fragmentShader = sh.fragmentShader
      .replace('#include <common>', '#include <common>\nvarying vec3 vWPos;\nuniform float uTime;\nuniform vec3 uDeep;')
      .replace(
        '#include <normal_fragment_maps>',
        `#include <normal_fragment_maps>
        {
          vec2 p = vWPos.xz; float t = uTime;
          float gx = cos(p.x * 0.21 + t * 1.3) * 0.21 + cos(p.x * 0.53 + p.y * 0.37 + t * 1.9) * 0.53 * 0.45 + cos(dot(p, vec2(0.9, 0.7)) - t * 2.6) * 0.9 * 0.16 * 0.9;
          float gz = cos(p.y * 0.25 + t * 1.1) * 0.25 + cos(p.x * 0.53 + p.y * 0.37 + t * 1.9) * 0.37 * 0.45 + cos(dot(p, vec2(0.9, 0.7)) - t * 2.6) * 0.7 * 0.16 * 0.9;
          gx += sin(p.x * 1.7 - p.y * 1.3 + t * 3.1) * 0.05; gz += sin(p.y * 1.9 + p.x * 0.8 - t * 2.7) * 0.05;
          vec3 wn = normalize(vec3(-gx * 0.55, 1.0, -gz * 0.55));
          normal = normalize((viewMatrix * vec4(wn, 0.0)).xyz);
          float fr = pow(1.0 - clamp(abs(dot(normalize(vViewPosition), normal)), 0.0, 1.0), 3.0);
          diffuseColor.rgb = mix(diffuseColor.rgb, uDeep, 0.35 * (1.0 - fr));
          diffuseColor.a = mix(0.74, 0.97, fr);
        }`
      );
  };
  m.customProgramCacheKey = () => 'dd-water-' + (fancy ? 1 : 0);
  return m;
}

// ---------- Road ----------
function roadTexture(theme, aniso) {
  return canvasTex(
    512,
    512,
    (g) => {
      const ppm = 512 / (2 * WALL_HW);
      const X = (m) => (m + WALL_HW) * ppm;
      const rnd = mulberry32(5);
      g.fillStyle = theme.shoulder;
      g.fillRect(0, 0, 512, 512);
      for (let i = 0; i < 900; i++) {
        g.fillStyle = theme.shoulderSpeck;
        const x = rnd() < 0.5 ? rnd() * X(-ROAD_HW - CURB_W) : X(ROAD_HW + CURB_W) + rnd() * (512 - X(ROAD_HW + CURB_W));
        g.fillRect(x, rnd() * 512, 3, 3);
      }
      g.fillStyle = theme.asphalt;
      g.fillRect(X(-ROAD_HW), 0, X(ROAD_HW) - X(-ROAD_HW), 512);
      for (let i = 0; i < 3200; i++) {
        g.fillStyle = rnd() < 0.5 ? theme.speck : 'rgba(0,0,0,0.12)';
        g.fillRect(X(-ROAD_HW) + rnd() * (X(ROAD_HW) - X(-ROAD_HW)), rnd() * 512, 2, 2);
      }
      g.fillStyle = 'rgba(0,0,0,0.08)';
      for (const m of [-4.6, -2.2, 2.2, 4.6]) g.fillRect(X(m) - 10, 0, 20, 512);
      for (let v = 0; v < 512; v += 64) {
        g.fillStyle = (v / 64) % 2 ? theme.curbA : theme.curbB;
        g.fillRect(X(-ROAD_HW - CURB_W), v, CURB_W * ppm, 64);
        g.fillRect(X(ROAD_HW), v, CURB_W * ppm, 64);
      }
      g.fillStyle = theme.line;
      g.fillRect(X(-ROAD_HW + 0.3), 0, 0.24 * ppm, 512);
      g.fillRect(X(ROAD_HW - 0.54), 0, 0.24 * ppm, 512);
      g.fillStyle = theme.center;
      g.fillRect(X(-0.13), 40, 0.26 * ppm, 128);
      g.fillRect(X(-0.13), 296, 0.26 * ppm, 128);
    },
    { repeat: true, wrapS: THREE.ClampToEdgeWrapping, aniso }
  );
}

function roadRuns(track) {
  const runs = [];
  let a = -1;
  for (let i = 0; i < track.n; i++) {
    const on = track.M[i] === M_ROAD;
    if (on && a < 0) a = i;
    if ((!on || i === track.n - 1) && a >= 0) {
      const b = on ? i : i - 1;
      if (b - a >= 1) runs.push([a, b]);
      a = -1;
    }
  }
  return runs;
}

function buildRoad(track, theme, aniso, runs, Q) {
  let cnt = 0;
  for (const [a, b] of runs) cnt += b - a + 1;
  const pos = new Float32Array(cnt * 2 * 3);
  const nor = new Float32Array(cnt * 2 * 3);
  const uv = new Float32Array(cnt * 2 * 2);
  const idx = [];
  let v = 0;
  for (const [a, b] of runs) {
    const base = v;
    for (let i = a; i <= b; i++) {
      const cx = track.X[i];
      const cz = track.Z[i];
      const cy = track.H[i];
      const rx = Math.cos(track.PSI[i]);
      const rz = Math.sin(track.PSI[i]);
      const bk = track.B[i];
      const cb = Math.cos(bk);
      const sb = Math.sin(bk);
      for (let k = 0; k < 2; k++) {
        const d = k === 0 ? -WALL_HW : WALL_HW;
        const o = v * 3;
        pos[o] = cx + rx * d * cb;
        pos[o + 1] = cy - d * sb + 0.02;
        pos[o + 2] = cz + rz * d * cb;
        nor[o] = rx * sb;
        nor[o + 1] = cb;
        nor[o + 2] = rz * sb;
        uv[v * 2] = k;
        uv[v * 2 + 1] = (i * STEP) / 16;
        v++;
      }
    }
    for (let j = 0; j < b - a; j++) {
      const p = base + j * 2;
      idx.push(p, p + 1, p + 2, p + 1, p + 3, p + 2);
    }
  }
  const geo = new THREE.BufferGeometry();
  geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
  geo.setAttribute('normal', new THREE.BufferAttribute(nor, 3));
  geo.setAttribute('uv', new THREE.BufferAttribute(uv, 2));
  geo.setIndex(idx);
  geo.computeBoundingSphere();
  const tx = roadTextures(theme, aniso, Q);
  const wet = theme.night || theme.storm || theme.wet;
  const mat = new THREE.MeshStandardMaterial({ map: tx.map, roughness: theme.wet ? 0.32 : wet ? 0.5 : 0.86, metalness: theme.wet ? 0.12 : wet ? 0.08 : 0, polygonOffset: true, polygonOffsetFactor: -1, polygonOffsetUnits: -2 });
  if (tx.normal) {
    mat.normalMap = tx.normal;
    mat.normalScale.set(0.6, 0.6);
  }
  const m = new THREE.Mesh(geo, mat);
  m.receiveShadow = Q.shadows > 0;
  return m;
}

function barrierTexture(theme) {
  return canvasTex(
    512,
    128,
    (g) => {
      const rnd = mulberry32(21);
      g.fillStyle = theme.barrierA;
      g.fillRect(0, 0, 512, 128);
      for (let i = 0; i < 2600; i++) {
        g.fillStyle = rnd() < 0.5 ? 'rgba(0,0,0,0.08)' : 'rgba(255,255,255,0.06)';
        g.fillRect(rnd() * 512, rnd() * 128, 2 + rnd() * 3, 2);
      }
      // joints between segments
      g.fillStyle = 'rgba(0,0,0,0.45)';
      for (let x = 0; x < 512; x += 128) g.fillRect(x, 0, 3, 128);
      // hazard chevrons on every other panel
      g.save();
      g.beginPath();
      g.rect(128, 20, 128, 56);
      g.rect(384, 20, 128, 56);
      g.clip();
      g.fillStyle = theme.barrierB;
      g.fillRect(0, 20, 512, 56);
      g.fillStyle = '#0b0b0e';
      for (let k = -4; k < 24; k++) {
        g.beginPath();
        g.moveTo(k * 28, 76);
        g.lineTo(k * 28 + 14, 76);
        g.lineTo(k * 28 + 44, 20);
        g.lineTo(k * 28 + 30, 20);
        g.fill();
      }
      g.restore();
      // tyre scuffs and rust streaks
      for (let i = 0; i < 30; i++) {
        g.fillStyle = 'rgba(10,10,12,' + (0.15 + rnd() * 0.35) + ')';
        g.fillRect(rnd() * 512, 78 + rnd() * 30, 20 + rnd() * 60, 3 + rnd() * 6);
      }
      g.fillStyle = 'rgba(120,60,20,0.25)';
      for (let i = 0; i < 14; i++) g.fillRect(rnd() * 512, 76, 3, 20 + rnd() * 40);
      g.fillStyle = 'rgba(0,0,0,0.35)';
      g.fillRect(0, 108, 512, 20);
    },
    { repeat: true }
  );
}

function buildBarriers(track, theme, runs, Q) {
  const H0 = -0.25;
  const H1 = 1.0;
  const TH = 0.35;
  const P = [];
  const Nn = [];
  const U = [];
  const idx = [];
  for (const [a, b] of runs) {
    for (let side = 0; side < 2; side++) {
      const sg = side === 0 ? -1 : 1;
      const base = P.length / 3;
      for (let i = a; i <= b; i++) {
        const cx = track.X[i];
        const cz = track.Z[i];
        const cy = track.H[i];
        const rx = Math.cos(track.PSI[i]);
        const rz = Math.sin(track.PSI[i]);
        const bk = track.B[i];
        const cb = Math.cos(bk);
        const sb = Math.sin(bk);
        const dIn = sg * WALL_HW;
        const dOut = sg * (WALL_HW + TH);
        const yIn = cy - dIn * sb;
        const u = (i * STEP) / 16;
        const ix = cx + rx * dIn * cb;
        const iz = cz + rz * dIn * cb;
        const ox = cx + rx * dOut * cb;
        const oz = cz + rz * dOut * cb;
        const jx = cx + rx * (dIn - sg * 0.18) * cb;
        const jz = cz + rz * (dIn - sg * 0.18) * cb;
        const verts = [
          [jx, yIn + H0, jz, -sg * rx * 0.8, 0.6, -sg * rz * 0.8, 0],
          [ix, yIn + 0.32, iz, -sg * rx * 0.8, 0.6, -sg * rz * 0.8, 0.3],
          [ix, yIn + 0.32, iz, -sg * rx, 0.12, -sg * rz, 0.3],
          [ix, yIn + H1, iz, -sg * rx, 0.12, -sg * rz, 0.9],
          [ix, yIn + H1, iz, 0, 1, 0, 0.95],
          [ox, yIn + H1, oz, 0, 1, 0, 0.95],
          [ox, yIn + H1, oz, sg * rx, 0, sg * rz, 0.9],
          [ox, yIn + H0 - 1.2, oz, sg * rx, 0, sg * rz, 0],
        ];
        for (const vv of verts) {
          P.push(vv[0], vv[1], vv[2]);
          Nn.push(vv[3], vv[4], vv[5]);
          U.push(u, vv[6]);
        }
      }
      for (let j = 0; j < b - a; j++) {
        for (const [k0, k1] of [[0, 1], [2, 3], [4, 5], [6, 7]]) {
          const p0 = base + j * 8 + k0;
          const p1 = base + j * 8 + k1;
          const p2 = base + (j + 1) * 8 + k0;
          const p3 = base + (j + 1) * 8 + k1;
          idx.push(p0, p1, p2, p1, p3, p2);
        }
      }
    }
  }
  const geo = new THREE.BufferGeometry();
  geo.setAttribute('position', new THREE.Float32BufferAttribute(P, 3));
  geo.setAttribute('normal', new THREE.Float32BufferAttribute(Nn, 3));
  geo.setAttribute('uv', new THREE.Float32BufferAttribute(U, 2));
  geo.setIndex(idx);
  geo.computeBoundingSphere();
  const mat = new THREE.MeshStandardMaterial({ map: barrierTexture(theme), side: THREE.DoubleSide, roughness: 0.88 });
  const m = new THREE.Mesh(geo, mat);
  m.receiveShadow = Q.shadows > 0;
  m.castShadow = Q.shadows > 0;
  return m;
}

// A quad strip glued to the racing surface (pads, lines, ice)
function surfaceQuad(track, s0, s1, d0, d1, lift, segs, out, uvRot = false) {
  const base = out.pos.length / 3;
  const tmp = {};
  for (let j = 0; j <= segs; j++) {
    const s = lerp(s0, s1, j / segs);
    for (let k = 0; k < 2; k++) {
      const d = k === 0 ? d0 : d1;
      const p = track.toWorld(s, d, tmp);
      const y = track.baseHeight(s, d) + lift;
      out.pos.push(p.x, y, p.z);
      const b = track.bankAt(s);
      const psi = track.psiAt(s);
      out.nor.push(Math.cos(psi) * Math.sin(b), Math.cos(b), Math.sin(psi) * Math.sin(b));
      if (uvRot) out.uv.push(j / segs, k);
      else out.uv.push(k, j / segs);
    }
  }
  for (let j = 0; j < segs; j++) {
    const a = base + j * 2;
    out.idx.push(a, a + 1, a + 2, a + 1, a + 3, a + 2);
  }
}
function geoFromOut(out) {
  const g = new THREE.BufferGeometry();
  g.setAttribute('position', new THREE.Float32BufferAttribute(out.pos, 3));
  g.setAttribute('normal', new THREE.Float32BufferAttribute(out.nor, 3));
  g.setAttribute('uv', new THREE.Float32BufferAttribute(out.uv, 2));
  g.setIndex(out.idx);
  g.computeBoundingSphere();
  return g;
}

function padTexture() {
