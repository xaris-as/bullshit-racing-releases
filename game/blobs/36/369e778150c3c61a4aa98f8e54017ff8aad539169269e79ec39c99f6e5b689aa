  // ---- optional soundtrack files ----
  loadOst() {
    try {
      fetch('ost/ost.json', { cache: 'no-cache' })
        .then((r) => (r.ok ? r.json() : null))
        .then((j) => {
          if (!j || typeof j !== 'object' || !j.tracks || typeof j.tracks !== 'object') return;
          const map = {};
          for (const k of Object.keys(j.tracks)) if (typeof j.tracks[k] === 'string' && j.tracks[k]) map[k] = j.tracks[k];
          if (Object.keys(map).length) this.ostMap = map;
          if (Number.isFinite(j.volume)) this.ostVol = clamp(j.volume, 0, 2);
        })
        .catch(() => {});
    } catch (e) {}
  },
  attachOst() {
    if (!this.ctx || this.ostSrc || !this.ostEl) return;
    try {
      this.ostSrc = this.ctx.createMediaElementSource(this.ostEl);
      this.ostSrc.connect(this.music);
    } catch (e) {
      this.ostSrc = null;
    }
  },
  playOst(style) {
    const url = this.ostMap && this.ostMap[style];
    if (!url || this.ostFailed.has(style)) return false;
    if (!this.ostEl) {
      this.ostEl = new Audio();
      this.ostEl.loop = true;
      this.ostEl.preload = 'auto';
      this.attachOst();
    }
    const el2 = this.ostEl;
    this.ostStyle = style;
    el2.onerror = () => {
      this.ostFailed.add(style);
      if (this.ostStyle === style) {
        this.ostStyle = null;
        this.startMusic(style);
      }
    };
    if (!el2.src || !el2.src.endsWith(url)) el2.src = url;
    el2.currentTime = 0;
    if (this.music) this.music.gain.setTargetAtTime(this.musicOn ? 0.5 * this.ostVol : 0, this.ctx.currentTime, 0.05);
    const p = el2.play();
    if (p && p.catch) p.catch(() => {});
    return true;
  },

  // ---- synth music ----
  startMusic(style) {
    if (!this.ctx) return;
    const st = MUSIC[style] ? style : 'menu';
    if ((this.seq && this.seq.style === st) || this.ostStyle === st) return;
    this.stopMusic();
    if (this.playOst(st)) return;
    const S = MUSIC[st];
    this.seq = { style: st, step: 0, next: this.ctx.currentTime + 0.12, sec: 'intro', secBar: 0, bars: S.intro || 4, plan: [], bpm: S.bpm, mode: 'house', fill: 0, queued: null };
    this.sweep.frequency.cancelScheduledValues(this.ctx.currentTime);
    this.sweep.frequency.setValueAtTime(18000, this.ctx.currentTime);
    if (this.music) this.music.gain.setTargetAtTime(this.musicOn ? 0.5 : 0, this.ctx.currentTime, 0.05);
    this.timer = setInterval(() => this.schedule(), 40);
  },
  stopMusic() {
    if (this.timer) clearInterval(this.timer);
    this.timer = 0;
    this.seq = null;
    if (this.ostEl && this.ostStyle) {
      try {
        this.ostEl.pause();
      } catch (e) {}
    }
    this.ostStyle = null;
  },
  // arrangement: intro -> groove -> build -> drop -> break -> build -> drop -> groove ... ; race events can queue sections
  nextSection() {
    const s = this.seq;
    const S = MUSIC[s.style];
    const order = { intro: 'groove', groove: 'build', build: 'drop', drop: 'break', break: 'build2', build2: 'drop2', drop2: 'groove', dnb: 'drop2', final: 'final' };
    let n = s.queued || order[s.sec] || 'groove';
    s.queued = null;
    if (s.style === 'menu' && (n === 'build' || n === 'build2')) n = 'groove';
    s.sec = n;
    s.secBar = 0;
    s.bars = { groove: 16, build: 4, build2: 4, drop: 16, drop2: 16, break: 8, dnb: 16, final: 999 }[n] || 8;
    const dnbDrop = S.drop === 'dnb' && (n === 'drop2' || n === 'dnb' || (n === 'final' && s.half2));
    s.mode = dnbDrop ? 'dnb' : 'house';
    s.bpm = dnbDrop ? S.dnbBpm || 172 : S.bpm;
    if (n === 'drop' || n === 'drop2' || n === 'dnb' || n === 'final') this.impact(s.next);
  },
  queue(sec) {
    if (!this.seq) return;
    const s = this.seq;
    if (s.sec === sec) return;
    if (sec === 'final' && (s.sec === 'drop' || s.sec === 'drop2' || s.sec === 'dnb')) {
      s.sec = 'final';
      s.bars = 999;
      return;
    }
    s.queued = sec;
    // short build so it lands soon
    if (sec === 'final' || sec === 'dnb') {
      s.sec = 'build';
      s.secBar = 0;
      s.bars = 2;
      s.mode = 'house';
      s.bpm = MUSIC[s.style].bpm;
    } else s.bars = Math.min(s.bars, s.secBar + 1);
  },
  openFilter(dur = 1.5) {
    if (!this.ctx) return;
    const t = this.ctx.currentTime;
    const f = this.sweep.frequency;
    f.cancelScheduledValues(t);
    f.setValueAtTime(Math.min(18000, f.value), t);
    f.linearRampToValueAtTime(18000, t + 0.05);
    this.boostT = t + dur;
  },
  impact(t) {
    const c = this.ctx;
    const o = c.createOscillator();
    o.frequency.setValueAtTime(110, t);
    o.frequency.exponentialRampToValueAtTime(30, t + 0.6);
    const g = c.createGain();
    g.gain.setValueAtTime(0.5, t);
    g.gain.exponentialRampToValueAtTime(0.0001, t + 0.8);
    o.connect(g);
    g.connect(this.drums);
    o.start(t);
    o.stop(t + 0.85);
    const s = c.createBufferSource();
    s.buffer = this.noise;
    const f = c.createBiquadFilter();
    f.type = 'lowpass';
    f.frequency.setValueAtTime(5000, t);
    f.frequency.exponentialRampToValueAtTime(200, t + 0.9);
    const g2 = c.createGain();
    g2.gain.setValueAtTime(0.25, t);
    g2.gain.exponentialRampToValueAtTime(0.0001, t + 1.0);
    s.connect(f);
    f.connect(g2);
    g2.connect(this.drums);
    s.start(t);
    s.stop(t + 1.05);
  },
  schedule() {
    const c = this.ctx;
    const s = this.seq;
    if (!c || !s || c.state !== 'running') return;
    if (s.next < c.currentTime - 0.25) s.next = c.currentTime + 0.05;
    let guard = 0;
    while (s.next < c.currentTime + 0.2 && guard++ < 32) {
      const sd = 60 / s.bpm / 4;
      const i = s.step % 16;
      if (i === 0 && s.step > 0) {
        s.secBar++;
        if (s.secBar >= s.bars) this.nextSection();
      }
      const swing = s.mode === 'house' && s.step % 2 === 1 ? sd * 0.08 : 0;
      this.playStep(MUSIC[s.style], s, i, s.next + swing, sd);
      s.next += sd;
      s.step++;
    }
    // filter: breakdowns/intros closed, builds sweep open, boost opens fully
    const t = c.currentTime;
    if (!(this.boostT && t < this.boostT)) {
      const sec = s.sec;
      let cut = 18000;
      if (sec === 'intro') cut = 600 + (s.secBar / Math.max(1, s.bars)) * 3000;
      else if (sec === 'break') cut = 1400;
      else if (sec === 'build' || sec === 'build2') cut = 800 + (s.secBar / Math.max(1, s.bars)) * 9000;
      this.sweep.frequency.setTargetAtTime(cut, t, 0.3);
    }
  },
  voice(midi, t, dur, type, vol, opts = {}) {
    const c = this.ctx;
    const o = c.createOscillator();
    o.type = type;
    o.frequency.setValueAtTime(440 * Math.pow(2, (midi - 69) / 12), t);
    if (opts.detune) o.detune.setValueAtTime(opts.detune, t);
    if (opts.slide) o.frequency.exponentialRampToValueAtTime(440 * Math.pow(2, (midi + opts.slide - 69) / 12), t + dur * 0.6);
    const g = c.createGain();
    const a = opts.attack ?? 0.006;
    g.gain.setValueAtTime(0.0001, t);
    g.gain.exponentialRampToValueAtTime(vol, t + a);
    if (opts.decay) g.gain.setTargetAtTime(vol * (opts.sustain ?? 0.3), t + a, opts.decay);
    g.gain.setTargetAtTime(0.0001, t + dur, opts.release ?? 0.05);
    o.connect(g);
    let out = g;
    if (opts.cutoff) {
      const f = c.createBiquadFilter();
      f.type = opts.ftype || 'lowpass';
      f.frequency.setValueAtTime(opts.cutoff, t);
      if (opts.fenv) f.frequency.exponentialRampToValueAtTime(Math.max(60, opts.cutoff * opts.fenv), t + Math.min(dur, opts.fdur || dur));
      f.Q.value = opts.q ?? 0.8;
      g.connect(f);
      out = f;
    }
    out.connect(opts.dest || this.duck);
    o.start(t);
    o.stop(t + dur + 0.6);
  },
  drum(kind, t, vel = 1) {
    const c = this.ctx;
    if (kind === 'kick' || kind === 'hardkick') {
      const o = c.createOscillator();
      o.frequency.setValueAtTime(kind === 'hardkick' ? 220 : 160, t);
      o.frequency.exponentialRampToValueAtTime(kind === 'hardkick' ? 52 : 44, t + 0.11);
      const g = c.createGain();
      g.gain.setValueAtTime(0.5 * vel, t);
      g.gain.exponentialRampToValueAtTime(0.0001, t + (kind === 'hardkick' ? 0.42 : 0.28));
      o.connect(g);
      if (kind === 'hardkick') g.connect(this.bassBus.in);
      else g.connect(this.drums);
      o.start(t);
      o.stop(t + 0.45);
      const dg = this.duck.gain;
      dg.cancelScheduledValues(t);
      dg.setValueAtTime(0.28, t);
      dg.linearRampToValueAtTime(1, t + 0.2);
      return;
    }
    const s = c.createBufferSource();
    s.buffer = this.noise;
    const f = c.createBiquadFilter();
    const g = c.createGain();
    let v = 0.03;
    let d = 0.04;
    if (kind === 'clap' || kind === 'snare' || kind === 'ghost') {
      f.type = 'bandpass';
      f.frequency.value = kind === 'clap' ? 1500 : 1900;
      f.Q.value = kind === 'clap' ? 1.2 : 0.7;
      v = kind === 'ghost' ? 0.06 : kind === 'snare' ? 0.26 : 0.2;
      d = kind === 'snare' ? 0.18 : kind === 'ghost' ? 0.06 : 0.16;
      g.gain.setValueAtTime(0.0001, t);
      if (kind === 'clap') {
        for (let k = 0; k < 3; k++) {
          g.gain.setValueAtTime(v * vel, t + k * 0.011);
          g.gain.exponentialRampToValueAtTime(v * 0.25 * vel, t + k * 0.011 + 0.009);
        }
        g.gain.setValueAtTime(v * vel, t + 0.034);
      } else g.gain.setValueAtTime(v * vel, t);
      g.gain.exponentialRampToValueAtTime(0.0001, t + d);
      if (kind === 'snare') {
        const o = c.createOscillator();
        o.frequency.setValueAtTime(240, t);
        o.frequency.exponentialRampToValueAtTime(160, t + 0.08);
        const og = c.createGain();
        og.gain.setValueAtTime(0.14 * vel, t);
        og.gain.exponentialRampToValueAtTime(0.0001, t + 0.1);
        o.connect(og);
        og.connect(this.drums);
        o.start(t);
        o.stop(t + 0.12);
      }
    } else if (kind === 'metal') {
      // industrial hit: FM-ish metallic ping
      const o = c.createOscillator();
      const m = c.createOscillator();
      const mg = c.createGain();
      o.frequency.value = 520;
      m.frequency.value = 1350;
      mg.gain.value = 900;
      m.connect(mg);
      mg.connect(o.frequency);
      const og = c.createGain();
      og.gain.setValueAtTime(0.06 * vel, t);
      og.gain.exponentialRampToValueAtTime(0.0001, t + 0.18);
      o.connect(og);
      og.connect(this.drums);
      o.start(t);
      m.start(t);
      o.stop(t + 0.2);
      m.stop(t + 0.2);
      return;
    } else {
      f.type = kind === 'shaker' ? 'bandpass' : 'highpass';
      f.frequency.value = kind === 'shaker' ? 6000 : kind === 'ohat' ? 7500 : 9000;
      v = kind === 'ohat' ? 0.06 : kind === 'shaker' ? 0.028 : 0.03;
      d = kind === 'ohat' ? 0.14 : kind === 'shaker' ? 0.05 : 0.035;
      g.gain.setValueAtTime(v * vel, t);
      g.gain.exponentialRampToValueAtTime(0.0001, t + d);
    }
    s.connect(f);
    f.connect(g);
    g.connect(this.drums);
    s.start(t, Math.random() * 0.8);
    s.stop(t + d + 0.03);
  },
  riser(t, dur) {
    const c = this.ctx;
    const s = c.createBufferSource();
    s.buffer = this.noise;
    s.loop = true;
    const f = c.createBiquadFilter();
    f.type = 'bandpass';
    f.Q.value = 3;
    f.frequency.setValueAtTime(400, t);
    f.frequency.exponentialRampToValueAtTime(7000, t + dur);
    const g = c.createGain();
    g.gain.setValueAtTime(0.0001, t);
    g.gain.exponentialRampToValueAtTime(0.12, t + dur);
    g.gain.exponentialRampToValueAtTime(0.0001, t + dur + 0.05);
    s.connect(f);
    f.connect(g);
    g.connect(this.pre);
    s.start(t);
    s.stop(t + dur + 0.1);
  },
  playStep(S, s, i, t, sd) {
    const bars = S.prog.length;
    const barAbs = Math.floor(s.step / 16);
    const bar = barAbs % bars;
    const [off, q] = S.prog[bar];
    const root = S.root + off;
    const ch = CHORDS[q] || CHORDS.M7;
    const sec = s.sec;
    const intro = sec === 'intro';
    const brk = sec === 'break';
    const build = sec === 'build' || sec === 'build2';
    const drop = sec === 'drop' || sec === 'drop2' || sec === 'final' || sec === 'dnb';
    const groove = sec === 'groove';
    const dnb = s.mode === 'dnb';
    const lastBarOfSec = s.secBar === s.bars - 1;
    // ---------------- drums
    if (dnb) {
      const pat = DNB[(barAbs >> 1) % DNB.length];
      const c2 = pat[i];
      if (c2 === 'k') this.drum('kick', t, 1.1);
      if (c2 === 's') this.drum('snare', t, 1.1);
      if (c2 === 'g') this.drum('ghost', t);
      if (i % 2 === 0) this.drum('hat', t, 0.8);
      if (i % 4 === 2) this.drum('shaker', t, 1.2);
    } else {
      const fourFloor = !brk && !(build && lastBarOfSec) && !(intro && s.secBar < 2 && S !== MUSIC.menu);
      if (fourFloor && i % 4 === 0) this.drum(S.drop === 'hard' && drop ? 'hardkick' : 'kick', t);
      if ((groove || drop) && (i === 4 || i === 12)) this.drum('clap', t);
      if (!brk && i % 4 === 2) this.drum('ohat', t);
      if ((groove || drop) && i % 2 === 1) this.drum('hat', t, 0.7);
      if (S.keys === 'tech' && !brk && !intro) this.drum('shaker', t, i % 4 === 3 ? 1.3 : 0.7);
      if (S.industrial && !brk && (i === 3 || i === 11 || (i === 14 && bar % 2))) this.drum('metal', t, drop ? 1.3 : 0.8);
      // big-beat / breakbeat layer: drops always, grooves on fill bars
      const fillBar = groove && s.secBar % 4 === 3;
      if ((drop && S.drop !== 'hard') || fillBar) {
        const pat = BREAKS[barAbs % BREAKS.length];
        const c2 = pat[i];
        if (c2 === 's') this.drum('snare', t, drop ? 1 : 0.8);
        if (c2 === 'g') this.drum('ghost', t);
        if (c2 === 'k' && i % 4 !== 0) this.drum('kick', t, 0.7);
      }
      if (S.drop === 'hard' && drop && i % 4 === 2) this.voice(root - 12, t, sd * 1.4, 'sawtooth', 0.09, { dest: this.bassBus.in, cutoff: 900, q: 2 });
    }
    // build: accelerating snare roll + riser
    if (build) {
      const n = s.secBar * 16 + i;
      const total = s.bars * 16;
      const every = n > total * 0.75 ? 1 : n > total * 0.5 ? 2 : 4;
      if (i % every === 0) this.drum('snare', t, 0.25 + (n / total) * 0.7);
      if (s.secBar === 0 && i === 0) this.riser(t, (s.bars * 16 * sd) * 0.98);
    }
    // ---------------- bass
    if (!brk && !intro) {
      if (dnb) {
        // reese: detuned saws through the distortion bus, long notes
        if (i === 0 || i === 10) {
          for (const dt of [-14, 13]) this.voice(root - 24, t, sd * (i === 0 ? 9.5 : 5.5), 'sawtooth', 0.11, { dest: this.bassBus.in, detune: dt, cutoff: 700, fenv: 1.6, q: 3 });
        }
      } else if (drop && (S.drop === 'bigbeat' || S.drop === 'heavy')) {
        if (i % 2 === 0) this.voice(root - 24 + (i % 8 === 6 ? 12 : 0), t, sd * 1.5, 'sawtooth', 0.1, { dest: this.bassBus.in, cutoff: 600 + (i % 4) * 150, q: 4 });
      } else if (S.bass === 'rolling') {
        if (i % 4 !== 0) this.voice(root - 24 + (i % 4 === 3 ? 12 : 0), t, sd * 0.8, 'sawtooth', 0.1, { cutoff: 420 + (i % 4) * 90, fenv: 0.5, q: 4, dest: drop ? this.bassBus.in : undefined });
      } else if (S.bass === 'octave') {
        if (i % 2 === 0) this.voice(root - 24 + (i % 4 === 2 ? 12 : 0), t, sd * 1.6, 'square', 0.08, { cutoff: 520, q: 2 });
      } else {
        const bp = { 2: 0, 6: 0, 10: 7, 14: 12 };
        if (bp[i] !== undefined) this.voice(root - 24 + bp[i], t, sd * 1.7, S.bass === 'sub' ? 'sine' : 'triangle', 0.2, { decay: 0.18, sustain: 0.5 });
      }
    }
    // ---------------- acid line (303-style: resonant envelope, accents, slides)
    if ((S.acid || S.drop === 'acid') && (drop || (groove && s.secBar >= 8))) {
      for (const [st, nt, acc] of ACID) {
        if (st !== i) continue;
        this.voice(root - 12 + nt, t, sd * 0.9, 'sawtooth', acc ? 0.09 : 0.06, { dest: this.acidBus.in, cutoff: acc ? 2600 : 1200, fenv: 0.15, fdur: sd * 0.8, q: 14, slide: nt === 12 ? -12 : 0 });
      }
    }
    // ---------------- power-chord guitar stabs on drops (+ feedback swell in the menu)
    if (S.guitar && drop && !dnb && (i === 0 || i === 3 || i === 6 || (bar % 2 && i === 10))) {
      for (const n of CHORDS.pw) for (const dt of [-12, 9]) this.voice(root - 12 + n, t, sd * 1.6, 'sawtooth', 0.05, { dest: this.gtrBus.in, detune: dt, decay: 0.1, sustain: 0.4 });
    }
    if (S.guitar && dnb && i === 0 && bar % 2 === 0) for (const n of CHORDS.pw) this.voice(root - 12 + n, t, sd * 14, 'sawtooth', 0.035, { dest: this.gtrBus.in, detune: n * 3 - 6, attack: 0.05, release: 0.3 });
    if (S.feedback && i === 0 && bar % 2 === 0) this.voice(root + 19, t, sd * 30, 'sawtooth', 0.02, { dest: this.gtrBus.in, attack: 1.2, release: 0.8, slide: 0.3 });
    // ---------------- chords / keys
    const k = S.keys;
    if (k === 'piano') {
      const pat = bar % 2 ? PIANO_STEPS_B : PIANO_STEPS;
      if (pat.includes(i) && !intro) {
        for (const n of ch) {
          this.voice(root + n, t, sd * 2.2, 'triangle', 0.042, { decay: 0.12, sustain: 0.25, release: 0.12 });
          this.voice(root + n + 12, t, sd * 1.2, 'square', 0.011, { decay: 0.06, sustain: 0.1, cutoff: 3200 });
        }
      }
      if (brk && i === 0) for (const n of ch) this.voice(root + n, t, sd * 15, 'triangle', 0.05, { attack: 0.02, decay: 0.8, sustain: 0.4, release: 0.4 });
    } else if (k === 'deep') {
      if (i === 0) for (const n of ch) this.voice(root + n - 12, t, sd * 15.5, 'sawtooth', 0.018, { attack: 0.25, cutoff: 1100, release: 0.4, detune: n % 2 ? 7 : -7 });
      if (!intro && (i === 6 || i === 14 || (bar % 2 && i === 11))) for (const n of ch) this.voice(root + n, t, sd * 1.2, 'square', 0.018, { decay: 0.05, sustain: 0.2, cutoff: 1800, q: 1.5 });
    } else if (k === 'french' || k === 'filter') {
      if (!dnb && (i % 2 === 0 || (bar % 2 && i % 4 === 3))) for (const n of ch) this.voice(root + n, t, sd * 0.9, 'sawtooth', 0.015, { cutoff: brk ? 900 : 2000 + 1200 * Math.sin((s.step / 64) * Math.PI), q: 5, detune: n % 2 ? 9 : -9 });
      if (dnb && i === 0) for (const n of ch) this.voice(root + n, t, sd * 15, 'sawtooth', 0.016, { attack: 0.1, cutoff: 2400, release: 0.4, detune: n % 2 ? 10 : -10 });
    } else if (k === 'tech') {
      if (i === 10 || (bar === 3 && i === 13)) for (const n of ch) this.voice(root + n, t, sd * 0.7, 'sawtooth', 0.02, { cutoff: 1500, fenv: 0.3, q: 6 });
    } else if (k === 'stab') {
      if ((i === 0 || i === 7) && !intro) for (const n of ch) this.voice(root + n, t, sd * 2, 'sawtooth', 0.02, { cutoff: 900, q: 4, decay: 0.2, sustain: 0.3 });
    }
    // ---------------- lead hook (breakdowns, drops on melodic styles)
    if (S.lead && (brk || (drop && S.lead > 0.5) || (dnb && S.lead > 0.5))) {
      const motif = MOTIFS[barAbs % 4];
      const tones = [0, ch[1], ch[2], 12, 12 + ch[1]];
      for (const [ms, ti, ln] of motif) {
        if (ms === i) {
          this.voice(root + 12 + tones[ti], t, sd * ln, 'sawtooth', 0.026, { cutoff: 3200, q: 1, attack: 0.01 });
          this.voice(root + 24 + tones[ti], t, sd * ln, 'square', 0.01, { cutoff: 4200, detune: 6 });
        }
      }
    }
    // ---------------- vocal stabs at drop downbeats / every 2 bars in drops
    if (drop && i === 0 && s.secBar % 2 === 0) this.vox(['a', 'e', 'o'][(barAbs >> 1) % 3], t - this.ctx.currentTime, 0.14, 150);
  },
};

// race -> music bridge
const Music = {
  final: false,
  glide: false,
  half: false,
  event(name) {
    const S = Sound;
    if (!S.seq) return;
    switch (name) {
      case 'go':
        S.impact(S.ctx.currentTime + 0.02);
        if (S.seq.sec === 'intro') S.queue('groove');
        this.final = false;
        this.glide = false;
        this.half = false;
        break;
      case 'final':
        this.final = true;
        S.queue('final');
        break;
      case 'glide':
        this.glide = true;
        S.queue(MUSIC[S.seq.style].drop === 'dnb' ? 'dnb' : 'break');
        break;
      case 'glideEnd':
        if (this.glide) {
          this.glide = false;
          if (!this.final) S.queue('drop');
        }
        break;
      case 'boost':
        S.openFilter(1.2);
        break;
      case 'ability':
        S.openFilter(2);
        S.vox('e', 0, 0.16, 190);
        break;
      case 'finish':
        S.queue('break');
        break;
    }
  },
  tick(race, P, phase) {
    const S = Sound;
    if (!S.seq || phase !== 'race') return;
    const st = MUSIC[S.seq.style];
    // canyon: second half of the race switches to the reese DnB drop
    if (st.half2 && !this.half && P.s > race.track.finishS * 0.5) {
      this.half = true;
      S.seq.half2 = true;
      S.queue('dnb');
    }
  },
};

// ============================================================
// Track v2: centreline + per-sample surface mode (road / water / air / gap)
// psi=0 faces -Z; forward T=(sin psi,0,-cos psi); right R=(cos psi,0,sin psi).
// kappa>0 turns right; d>0 is right of centre; bank b>0 lowers the right side.
// H holds the road surface (road/gap), the water level (water) or the flight altitude (air).
// ============================================================
const MODE_CH = { R: M_ROAD, W: M_WATER, A: M_AIR, G: M_GAP };

class Track {
  constructor(def) {
    this.def = def;
    this.grip = def.grip ?? 1;
    const plan = def.plan;
    let total = 0;
    for (const p of plan) total += p[0];
    const n = Math.floor(total / STEP) + 1;
    this.n = n;
    this.length = (n - 1) * STEP;
    const kRaw = new Float32Array(n);
    const gRaw = new Float32Array(n);
    const M = new Uint8Array(n);
    this.segS = [];
    this.segE = [];
    this.segMode = [];
    let acc = 0;
    let idx = 0;
    for (const seg of plan) {
      const [len, turn, grade] = seg;
      const mode = MODE_CH[seg[3] || 'R'];
      const k = (turn * DEG) / len;
      this.segS.push(acc);
      acc += len;
      this.segE.push(acc);
      this.segMode.push(mode);
      const end = Math.min(n, Math.round(acc / STEP));
      for (; idx < end; idx++) {
        kRaw[idx] = k;
        gRaw[idx] = grade / 100;
        M[idx] = mode;
      }
    }
    for (; idx < n; idx++) M[idx] = M_ROAD;
    this.M = M;
    const K = boxSmooth(kRaw, Math.round(16 / STEP), 2);
    const Gs = boxSmooth(gRaw, Math.round(28 / STEP), 2);
    // ---- heights
    const H = new Float64Array(n);
    let h = 0;
    let wl = null;
    let i = 0;
    while (i < n) {
      const m = M[i];
      if (m === M_AIR) {
        let j = i;
        while (j < n && M[j] === M_AIR) j++;
        const a0 = (i > 0 ? H[i - 1] : 0) + 1.4;
        const nextMode = j < n ? M[j] : M_ROAD;
        let base = a0;
        const nat = new Float64Array(j - i);
        for (let q = i; q < j; q++) {
          base += gRaw[q] * STEP;
          nat[q - i] = base;
        }
        let a1 = nat[nat.length - 1];
        let target = a1;
        if (nextMode === M_WATER) {
          if (wl === null) wl = a1 - 2.2;
          target = wl + 2.2;
        }
        const corr = target - a1;
        const L = j - i;
        for (let q = i; q < j; q++) {
          const t = (q - i + 1) / L;
          H[q] = nat[q - i] + corr * t + Math.sin(Math.PI * t) * 7 * (1 - t * 0.3);
        }
        h = nextMode === M_WATER ? wl : target - 2.0;
        i = j;
        continue;
      }
      if (m === M_WATER) {
        if (wl === null) wl = h;
        h = wl;
        H[i] = wl;
        i++;
        continue;
      }
      if (i > 0) h += (Gs[i - 1] + Gs[i]) * 0.5 * STEP;
      H[i] = h;
      i++;
    }
    // ---- grades from heights (C1-consistent with Hermite interpolation)
    const G = new Float32Array(n);
    for (let q = 0; q < n; q++) {
      if (M[q] === M_WATER) {
        G[q] = 0;
        continue;
      }
      const a = Math.max(0, q - 1);
      const b = Math.min(n - 1, q + 1);
      G[q] = (H[b] - H[a]) / ((b - a) * STEP);
    }
    // ---- planform
    const X = new Float64Array(n);
    const Z = new Float64Array(n);
    const PSI = new Float64Array(n);
    PSI[0] = (def.heading ?? 0) * DEG;
    for (let q = 1; q < n; q++) {
      PSI[q] = PSI[q - 1] + (K[q - 1] + K[q]) * 0.5 * STEP;
      const pm = (PSI[q - 1] + PSI[q]) * 0.5;
      X[q] = X[q - 1] + Math.sin(pm) * STEP;
      Z[q] = Z[q - 1] - Math.cos(pm) * STEP;
    }
    const Braw = new Float32Array(n);
    for (let q = 0; q < n; q++) Braw[q] = M[q] === M_ROAD || M[q] === M_GAP ? clamp(K[q] * 7.5, -0.15, 0.15) : 0;
    const B = boxSmooth(Braw, 6, 1);
    this.X = X;
    this.Z = Z;
    this.H = H;
    this.PSI = PSI;
    this.K = K;
    this.G = G;
    this.B = B;
    this.finishS = this.length - plan[plan.length - 1][0];
    this.startS = START_S;
    const off = FINISH_Y - this.heightAt(this.finishS);
    for (let q = 0; q < n; q++) H[q] += off;
    this.hasWater = wl !== null;
    this.hasAir = M.includes(M_AIR);
    this.waterY = wl !== null ? wl + off : FINISH_Y - 2.6;
    this.topY = this.heightAt(0);
    this.drop = this.topY - FINISH_Y;
    this.raceLength = this.finishS - START_S;
    this._tmp = {};
    this.ramps = [];
    this.pads = [];
    this.orbs = [];
    this.coins = [];
    this.crates = [];
    this.booms = [];
    this.tapes = [];
    this.rings = [];
    this.obstacles = [];
    this.tumble = [];
    this.iceZones = [];
    this.gates = [];
    this.thermals = [];
    this.cables = [];
    this.buckets = [];
    this.placeFeatures();
    this.buildLine();
  }

  // ideal racing line (lateral offset per sample): late apex on the inside of corners, smoothed
  buildLine() {
    const n = this.n;
    const raw = new Float32Array(n);
    for (let i = 0; i < n; i++) {
      let k = 0;
      let c = 0;
      for (let j = 2; j <= 18; j += 2) {
        const q = Math.min(n - 1, i + j);
        k += this.K[q] * (1 - j / 22);
        c += 1 - j / 22;
      }
      const m = this.M[i];
      const lim = m === M_WATER ? WATER_HW - 3 : m === M_AIR ? AIR_HW - 3 : ROAD_HW - 1.6;
      raw[i] = clamp((k / c) * 260, -1, 1) * lim;
    }
    this.LINE = boxSmooth(raw, 6, 2);
  }
  lineAt(s) {
    const f = this._f(s);
    const i = f | 0;
    return this.LINE[i] + (this.LINE[i + 1] - this.LINE[i]) * (f - i);
  }

  _f(s) {
    let f = s / STEP;
    if (f < 0) f = 0;
    const m = this.n - 1.000001;
    if (f > m) f = m;
    return f;
  }
  modeAt(s) {
    const i = Math.round(clamp(s, 0, this.length) / STEP);
    return this.M[i];
  }
  segAt(seg, t) {
    return this.segS[seg] + (this.segE[seg] - this.segS[seg]) * t;
  }
  heightAt(s) {
    const f = this._f(s);
    const i = f | 0;
    const t = f - i;
    const h0 = this.H[i];
    const h1 = this.H[i + 1];
    const m0 = this.G[i] * STEP;
    const m1 = this.G[i + 1] * STEP;
    const t2 = t * t;
    const t3 = t2 * t;
    return (2 * t3 - 3 * t2 + 1) * h0 + (t3 - 2 * t2 + t) * m0 + (-2 * t3 + 3 * t2) * h1 + (t3 - t2) * m1;
  }
  gradeAt(s) {
    const f = this._f(s);
    const i = f | 0;
    const t = f - i;
    return this.G[i] + (this.G[i + 1] - this.G[i]) * t;
  }
  kappaAt(s) {
    const f = this._f(s);
    const i = f | 0;
    const t = f - i;
    return this.K[i] + (this.K[i + 1] - this.K[i]) * t;
  }
  bankAt(s) {
    const f = this._f(s);
    const i = f | 0;
    const t = f - i;
    return this.B[i] + (this.B[i + 1] - this.B[i]) * t;
  }
  psiAt(s) {
    const f = this._f(s);
    const i = f | 0;
    const t = f - i;
    return this.PSI[i] + (this.PSI[i + 1] - this.PSI[i]) * t;
  }
  rampOffset(s, d) {
    const R = this.ramps;
    for (let k = 0; k < R.length; k++) {
      const r = R[k];
      if (s >= r.s0 && s < r.s1 && d >= r.d - r.hw && d <= r.d + r.hw) return (r.h * (s - r.s0)) / (r.s1 - r.s0);
    }
    return 0;
  }
  // the ramp under (s, d), or null
  rampAt(s, d) {
    const R = this.ramps;
    for (let k = 0; k < R.length; k++) {
      const r = R[k];
      if (s >= r.s0 && s < r.s1 && d >= r.d - r.hw && d <= r.d + r.hw) return r;
    }
    return null;
  }
  // a ramp whose lip (s1) lies within `back` m behind s: what a racer just took off from
  rampLipNear(s, d, back = 2.5) {
    const R = this.ramps;
    for (let k = 0; k < R.length; k++) {
      const r = R[k];
      if (s >= r.s1 - 1.0 && s <= r.s1 + back && d >= r.d - r.hw - 0.6 && d <= r.d + r.hw + 0.6) return r;
    }
    return null;
  }
  rampSlope(s, d) {
    const R = this.ramps;
    for (let k = 0; k < R.length; k++) {
      const r = R[k];
      if (s >= r.s0 && s < r.s1 && d >= r.d - r.hw && d <= r.d + r.hw) return r.h / (r.s1 - r.s0);
    }
    return 0;
  }
  // road surface (ignoring mode)
  baseHeight(s, d) {
    return this.heightAt(s) - d * Math.sin(this.bankAt(s));
  }
  // physical ground for the current mode (water waves are added by the sim)
  groundHeight(s, d) {
    const m = this.modeAt(s);
    if (m === M_WATER) return this.waterY + this.rampOffset(s, d);
    if (m === M_GAP) return this.heightAt(s) - 40;
    if (m === M_AIR) return -1e6;
    return this.heightAt(s) - d * Math.sin(this.bankAt(s)) + this.rampOffset(s, d);
  }
  groundVel(s, d, sdot, ddot) {
    const m = this.modeAt(s);
    if (m === M_WATER) return this.rampSlope(s, d) * sdot;
    return (this.gradeAt(s) + this.rampSlope(s, d)) * sdot - Math.sin(this.bankAt(s)) * ddot;
  }
  wallAt(s) {
    const m = this.modeAt(s);
    return m === M_WATER ? WATER_HW : m === M_AIR ? AIR_HW : WALL_HW;
  }
  gripAt(s) {
    for (const z of this.iceZones) if (s >= z.s0 && s <= z.s1) return 0.55;
    return 1;
  }
  frameInto(s, o) {
    const f = this._f(s);
    const i = f | 0;
    const t = f - i;
    o.x = this.X[i] + (this.X[i + 1] - this.X[i]) * t;
    o.z = this.Z[i] + (this.Z[i + 1] - this.Z[i]) * t;
    o.y = this.heightAt(s);
    o.psi = this.PSI[i] + (this.PSI[i + 1] - this.PSI[i]) * t;
    o.kappa = this.K[i] + (this.K[i + 1] - this.K[i]) * t;
    o.grade = this.G[i] + (this.G[i + 1] - this.G[i]) * t;
    o.bank = this.B[i] + (this.B[i + 1] - this.B[i]) * t;
    o.tx = Math.sin(o.psi);
    o.tz = -Math.cos(o.psi);
    o.rx = Math.cos(o.psi);
    o.rz = Math.sin(o.psi);
    return o;
  }
  toWorld(s, d, out) {
    const o = this.frameInto(s, this._tmp);
    const cb = Math.cos(o.bank);
    out.x = o.x + o.rx * d * cb;
    out.z = o.z + o.rz * d * cb;
    return out;
  }
  // reference height of the racing surface at (s, d): road ground / water level / flight altitude
  surfaceY(s, d) {
    const m = this.modeAt(s);
    if (m === M_AIR) return this.heightAt(s);
    if (m === M_WATER) return this.waterY;
    return this.baseHeight(s, d);
  }
  // first safe (road or water) position at or after s
  safeAfter(s) {
    let x = Math.max(0, s);
    while (x < this.length - 20) {
      const m = this.modeAt(x);
      if (m === M_ROAD || m === M_WATER) {
        let ok = true;
        for (let k = 2; k <= 14; k += 4) if (this.modeAt(x + k) === M_GAP || this.modeAt(x + k) === M_AIR) ok = false;
        if (ok) return x + 4;
      }
      x += 2;
    }
    return Math.min(s, this.length - 30);
  }

  placeFeatures() {
    const def = this.def;
    const rng = mulberry32(def.seed * 7919 + 13);
    const L = this.finishS;
    const occ = [];
    const isFree = (a, b) => {
      for (const o of occ) if (b > o[0] && a < o[1]) return false;
      return true;
    };
    const occupy = (a, b) => occ.push([a, b]);
    const modeRange = (a, b) => {
      const m = this.modeAt(a);
      for (let x = a; x <= b; x += 4) if (this.modeAt(x) !== m) return -1;
      return m;
    };
    const sOf = (o) => (o.seg !== undefined ? this.segAt(o.seg, o.t ?? 0.5) : o.at * L);
    occupy(0, START_S + 70);
    occupy(L - 30, this.length);
    // mode transitions are kept clear
    for (let k = 1; k < this.segS.length; k++) {
      if (this.segMode[k] !== this.segMode[k - 1]) occupy(this.segS[k] - 40, this.segS[k] + 45);
    }
    // ---- ramps: authored, gap launchers, glider kickers, water ramps
    const addRamp = (s0, len, h, d, hw, kind) => {
      this.ramps.push({ s0, s1: s0 + len, h, d, hw, len, kind });
      occupy(s0 - 35, s0 + len + 50);
    };
    for (const rd of def.ramps || []) addRamp(Math.round(sOf(rd)), rd.len ?? 8, rd.h ?? 2, rd.d ?? 0, rd.hw ?? ROAD_HW - 0.2, 'road');
    for (let k = 1; k < this.segS.length; k++) {
      const m = this.segMode[k];
      const prev = this.segMode[k - 1];
      if (m === M_GAP && prev === M_ROAD) addRamp(this.segS[k] - 9, 9, 2.6, 0, WALL_HW - 0.8, 'gap');
      if (m === M_AIR && prev === M_ROAD) addRamp(this.segS[k] - 9, 9, 1.8, 0, WALL_HW - 0.8, 'kick');
    }
    for (const rd of def.wramps || []) addRamp(Math.round(sOf(rd)), rd.len ?? 9, rd.h ?? 1.8, rd.d ?? 0, rd.hw ?? 5, 'water');
    this.ramps.sort((a, b) => a.s0 - b.s0);
    for (const rp of this.ramps) if (rp.kind !== 'kick') this.addJumpCoins(rp);

    // ---- ice zones
    for (const z of (def.set && def.set.ice) || []) this.iceZones.push({ s0: this.segAt(z.seg, z.t0), s1: this.segAt(z.seg, z.t1) });

    // ---- item orb rows (any mode) - only with the legacy item mode
    const gap = def.itemGap ?? 280;
    let orbId = 0;
    for (let s = START_S + 190; ITEMS_ON && s < L - 100; s += gap) {
      let best = -1;
      for (let k = 0; k <= 14 && best < 0; k++) {
        for (const sg of [1, -1]) {
          const c = s + sg * k * 5;
          if (c < L - 60 && isFree(c - 14, c + 14) && modeRange(c - 6, c + 6) >= 0) {
            best = c;
            break;
          }
        }
      }
      if (best < 0) continue;
      occupy(best - 14, best + 14);
      const m = this.modeAt(best);
      const ds = m === M_AIR ? [-6, -2, 2, 6] : [-5.4, -1.8, 1.8, 5.4];
      for (const d of ds) {
        const y = m === M_AIR ? this.heightAt(best) + 0.6 : this.surfaceY(best, d) + 1.25;
        this.orbs.push({ type: 'orb', id: orbId++, s: best, d, y, active: true, t: 0 });
      }
    }

    // ---- boost pads (road), jet rings (water), sky rings (air)
    let padId = 0;
    for (let s = START_S + 120; s < L - 70; s += 120 + rng() * 80) {
      if (!isFree(s - 10, s + 10)) continue;
      const m = modeRange(s - 10, s + 10);
      if (m === M_ROAD) {
        let kmax = 0;
        for (let x = s - 12; x <= s + 12; x += 4) kmax = Math.max(kmax, Math.abs(this.kappaAt(x)));
        if (kmax > 1 / 130 || rng() < 0.25) continue;
        const ds = rng() < 0.35 ? [-3.6, 3.6] : [clamp((rng() * 2 - 1) * 4.6, -4.6, 4.6)];
        for (const d of ds) this.pads.push({ type: 'pad', kind: 'pad', id: padId++, s, d, len: 6, w: 3.2 });
        occupy(s - 12, s + 12);
      } else if (m === M_WATER) {
        const d = (rng() * 2 - 1) * 7;
        this.pads.push({ type: 'pad', kind: 'jet', id: padId++, s, d, len: 4.5, w: 4.2 });
        occupy(s - 10, s + 10);
      }
    }
    // glide sections: a ring line that branches into a HIGH route (thermals lift you there, dive later for speed)
    // and a LOW route (skims the sea between the stacks, under the cables); cables + gondolas to weave through
    const glide = def.glide || {};
    const airRuns = [];
    for (let k = 0; k < this.segS.length; k++) {
      if (this.segMode[k] !== M_AIR) continue;
      const last = airRuns[airRuns.length - 1];
      if (last && Math.abs(last[1] - this.segS[k]) < 1) last[1] = this.segE[k];
      else airRuns.push([this.segS[k], this.segE[k]]);
    }
    this.airRuns = airRuns;
    for (const [a0, a1] of airRuns) {
      const s0 = a0 + 45;
      const s1 = a1 - 35;
      let ph = rng() * TAU;
      let branch = 0;
      for (let s = s0; s < s1; s += 56) {
        ph += 1.0 + rng() * 0.6;
        const base = this.heightAt(s) + 0.6;
        const floorY = this.waterY + 3.2;
        branch++;
        if (branch % 3 === 0 && s < s1 - 60) {
          // fork: high ring (thermal underneath) on one side, low ring on the other
          const sideH = branch % 2 ? 1 : -1;
          this.rings.push({ type: 'ring', id: this.rings.length, s, d: sideH * 5.5, y: base + 5.5, r: 3.3, last: -1, route: 'high' });
          this.rings.push({ type: 'ring', id: this.rings.length, s, d: -sideH * 5.5, y: Math.max(floorY, base - 4.5), r: 3.3, last: -1, route: 'low' });
          this.thermals.push({ s: s - 24, d: sideH * 5.5, r: 5.5, y0: base - 8, y1: base + 8, lift: 9.0, ph: rng() * TAU });
        } else {
          const d = Math.sin(ph) * 6.5;
          const yOff = Math.cos(ph * 0.7) * 2.2;
          this.rings.push({ type: 'ring', id: this.rings.length, s, d, y: Math.max(floorY, base + yOff), r: 3.2, last: -1, route: 'main' });
        }
      }
      const nc = glide.cables ?? 0;
      for (let c = 0; c < nc; c++) {
        const s = s0 + ((c + 0.6) / (nc + 0.4)) * (s1 - s0);
        if (this.rings.some((r) => Math.abs(r.s - s) < 16)) continue;
        const y = this.heightAt(s) + 0.6 + (c % 2 ? 2.6 : -1.6);
        this.cables.push({ s, y, ph: rng() * TAU, w: 0.35 + rng() * 0.2, gond: !!glide.gondolas && c % 2 === 0 });
      }
      for (let s = s0 + 60; s < s1 - 40 && this.thermals.length < (glide.thermals ?? 0); s += 150) {
        if (this.thermals.some((t) => Math.abs(t.s - s) < 60)) continue;
        this.thermals.push({ s, d: (rng() < 0.5 ? -1 : 1) * (3 + rng() * 5), r: 5, y0: this.heightAt(s) - 8, y1: this.heightAt(s) + 8, lift: 8.0, ph: rng() * TAU });
      }
    }
    // water: slalom buoy gates (pass between the pair for a boost + ability charge)
    // placed over each contiguous water run (a lagoon is several short plan segments)
    let gi = 0;
    const nG = def.gates ?? 0;
    for (let k = 0; k < this.segS.length && gi < nG; k++) {
      if (this.segMode[k] !== M_WATER || (k > 0 && this.segMode[k - 1] === M_WATER)) continue;
      let e = k;
      while (e + 1 < this.segS.length && this.segMode[e + 1] === M_WATER) e++;
      const s1 = this.segE[e] - 40;
      for (let s = this.segS[k] + 50; s < s1 && gi < nG; ) {
        if (!isFree(s - 8, s + 8)) {
          s += 10;
          continue;
        }
        const d = (gi % 2 ? 1 : -1) * (4.2 + rng() * 2.4);
        this.gates.push({ type: 'gate', id: this.gates.length, s, d, w: 2.7, last: -1 });
        occupy(s - 8, s + 8);
        gi++;
        s += 64 + rng() * 30;
      }
    }

    // ---- obstacles: corals/rocks in water, floating rocks in air
    for (let k = 0; k < this.segS.length; k++) {
      const m = this.segMode[k];
      if (m !== M_WATER && m !== M_AIR) continue;
      for (let s = this.segS[k] + 60; s < this.segE[k] - 40; s += 70 + rng() * 50) {
        if (!isFree(s - 6, s + 6)) continue;
        const d = (rng() < 0.5 ? -1 : 1) * (2.5 + rng() * 7);
        const r = m === M_WATER ? 1.6 + rng() * 0.8 : 2.0 + rng() * 0.8;
        const y = m === M_WATER ? this.waterY : this.heightAt(s) + 0.6;
        if (m === M_AIR && this.rings.some((rg) => Math.abs(rg.s - s) < 14 && Math.abs(rg.d - d) < 6.5)) continue;
        if (m === M_WATER && this.gates.some((g) => Math.abs(g.s - s) < 12)) continue;
        if (m === M_AIR && rng() < 0.6) {
          // sea stack column: from the sea up past the ring line (weave around it)
          const top = this.heightAt(s) + 4 + rng() * 6;
          this.obstacles.push({ type: 'obs', kind: 'stack', id: this.obstacles.length, s, d, r: 2.6 + rng() * 1.2, y: (this.waterY + top) / 2, y0: this.waterY - 2, y1: top });
          continue;
        }
        this.obstacles.push({ type: 'obs', kind: m === M_WATER ? 'reef' : 'skyrock', id: this.obstacles.length, s, d, r, y });
      }
    }
    // ---- tumbleweeds (dynamic)
    for (const f of (def.set && def.set.tumbleweeds) || []) {
      const s = f * L;
      this.tumble.push({ s, d: 0, ph: rng() * TAU, w: 0.55 + rng() * 0.25, amp: 9, r: 0.8, roll: 0 });
    }

    // ---- crate walls (road only, always leave a gap)
    const nCr = def.crates ?? 4;
    for (let k = 0; k < nCr; k++) {
      const target = START_S + 260 + ((k + 0.5) / nCr) * (L - START_S - 420);
      let at = -1;
      for (let j = 0; j <= 20 && at < 0; j++) {
        for (const sg of [1, -1]) {
          const c = target + sg * j * 6;
          if (isFree(c - 9, c + 9) && modeRange(c - 9, c + 9) === M_ROAD) {
            at = c;
            break;
          }
        }
      }
      if (at < 0) continue;
      occupy(at - 9, at + 9);
      const slots = [-6, -2, 2, 6];
      const gapIdx = Math.floor(rng() * 4);
      for (let q = 0; q < 4; q++) {
        if (q === gapIdx) continue;
        const d = slots[q];
        this.crates.push({ type: 'crate', id: this.crates.length, s: at, d, y: this.groundHeight(at, d), alive: true });
      }
    }

    // ---- coin lines (all modes)
    for (let s = START_S + 80; s < L - 40; s += 42) {
      if (!isFree(s - 2, s + 22)) continue;
      const m = modeRange(s, s + 20);
      if (m < 0 || m === M_GAP) continue;
      if (rng() < 0.3) continue;
      const d0 = (rng() * 2 - 1) * 5;
      const amp = rng() < 0.45 ? 0 : (rng() * 2 - 1) * 3.2;
      for (let j = 0; j < 6; j++) {
        const cs = s + j * 3.6;
        const cd = clamp(d0 + amp * Math.sin((j / 5) * Math.PI), -6.6, 6.6);
        const y = m === M_AIR ? this.heightAt(cs) + 0.6 : this.surfaceY(cs, cd) + 0.95;
        this.coins.push({ type: 'coin', id: this.coins.length, s: cs, d: cd, y, taken: false });
      }
      occupy(s - 2, s + 22);
    }

    // ---- chaos: explosive barrel clusters on roads and floating in lagoons (pure data, the sim detonates them)
    const nBoom = def.booms ?? Math.round(3 + (def.diff || 1) * 1.6);
    for (let k = 0; k < nBoom; k++) {
      const target = START_S + 170 + ((k + 0.3 + rng() * 0.4) / nBoom) * (L - START_S - 380);
      let at = -1;
      for (let j = 0; j <= 16 && at < 0; j++) {
        for (const sg of [1, -1]) {
          const c = target + sg * j * 5;
          const m = modeRange(c - 6, c + 6);
          if (isFree(c - 6, c + 6) && (m === M_ROAD || m === M_WATER)) {
            at = c;
            break;
          }
        }
      }
      if (at < 0) continue;
      occupy(at - 6, at + 6);
      const n = 1 + Math.floor(rng() * 3);
      const d0 = (rng() < 0.5 ? -1 : 1) * (1.2 + rng() * 4.6);
      for (let q = 0; q < n; q++) {
        const bs = at + (q - (n - 1) / 2) * 2.3;
        const bd = clamp(d0 + (rng() * 2 - 1) * 1.3, -6.8, 6.8);
        const water = modeRange(bs - 1, bs + 1) === M_WATER;
        this.booms.push({ type: 'boom', id: this.booms.length, s: bs, d: bd, y: this.groundHeight(bs, bd), r: 1.05, water, alive: true, t: 0, fuse: -1, by: null });
      }
    }

    // ---- one hidden "Bull Tape" (story collectible) hugging the road edge somewhere in the second half
    for (let j = 0; j < 80; j++) {
      const ts = START_S + (j < 40 ? 0.45 + rng() * 0.4 : 0.12 + rng() * 0.8) * (L - START_S - 200);
      const tm = modeRange(ts - 3, ts + 3);
      if (!isFree(ts - 3, ts + 3) || !(tm === M_ROAD || (j >= 40 && tm === M_WATER))) continue;
      const td = (rng() < 0.5 ? -1 : 1) * (ROAD_HW - 0.9);
      this.tapes.push({ type: 'tape', id: 0, s: ts, d: td, y: this.groundHeight(ts, td) + 0.9, taken: false });
      occupy(ts - 3, ts + 3);
      break;
    }

    const nb = Math.ceil(this.length / BUCKET) + 1;
    this.buckets = Array.from({ length: nb }, () => []);
    const add = (o) => this.buckets[clamp(Math.floor(o.s / BUCKET), 0, nb - 1)].push(o);
    this.pads.forEach(add);
    this.gates.forEach(add);
    this.orbs.forEach(add);
    this.coins.forEach(add);
    this.crates.forEach(add);
    this.booms.forEach(add);
    this.tapes.forEach(add);
    this.rings.forEach(add);
    this.obstacles.forEach(add);
  }

  addJumpCoins(rp) {
    const v = 31;
    const d = rp.d;
    let s = rp.s1;
    let y = this.groundHeight(rp.s1 - 0.01, d);
    let vy = v * (rp.h / rp.len + this.gradeAt(rp.s1));
    const dt = 1 / 60;
    let t = 0;
    let next = 0.11;
    let placed = 0;
    for (let it = 0; it < 400 && placed < 6; it++) {
      vy -= GV * dt;
      y += vy * dt;
      s += v * dt;
      t += dt;
      const g = this.modeAt(s) === M_WATER ? this.waterY : this.baseHeight(s, d);
      if (y <= g + 0.9) break;
      if (t >= next) {
        this.coins.push({ type: 'coin', id: this.coins.length, s, d, y: y + 0.7, taken: false });
        placed++;
        next += 0.11;
      }
    }
  }

  resetFeatures() {
    for (const o of this.orbs) {
      o.active = true;
      o.t = 0;
    }
    for (const c of this.coins) c.taken = false;
    for (const c of this.crates) c.alive = true;
    for (const tp of this.tapes) tp.taken = false;
    for (const b of this.booms) {
      b.alive = true;
      b.fuse = -1;
      b.t = 0;
    }
    for (const r of this.rings) r.last = -1;
    for (const g of this.gates) g.last = -1;
  }
}

// ============================================================
// Models: GLB asset library (Blender-built), skinned characters + clips, kart assembly from parts,
// material classes (paint / metal / rubber / carbon / glow from vertex-colour alpha), paint shader with
// wear, sponsor-sticker decals, shared textures and small procedural helpers
// ============================================================
const _m4 = new THREE.Matrix4();
const _m4b = new THREE.Matrix4();
const _q = new THREE.Quaternion();
const _e = new THREE.Euler();
const _v1 = new THREE.Vector3();
const _v2 = new THREE.Vector3();
const _UP = new THREE.Vector3(0, 1, 0);
const _col = new THREE.Color();

function hexCss(h) {
  return '#' + (h >>> 0).toString(16).padStart(6, '0').slice(-6);
}

const GEO = {
  sphere: new THREE.SphereGeometry(1, 20, 14),
  sphereLo: new THREE.SphereGeometry(1, 10, 8),
  box: new THREE.BoxGeometry(1, 1, 1),
  cyl: new THREE.CylinderGeometry(1, 1, 1, 16),
  cylLo: new THREE.CylinderGeometry(1, 1, 1, 8),
  ico1: new THREE.IcosahedronGeometry(1, 1),
  ico2: new THREE.IcosahedronGeometry(1, 2),
  plane: new THREE.PlaneGeometry(1, 1),
};

// part(geometry, color, position, rotation(euler xyz), scale) for small merged procedural meshes
function part(geo, color, x, y, z, rx = 0, ry = 0, rz = 0, sx = 1, sy = sx, sz = sx) {
  _e.set(rx, ry, rz);
  _q.setFromEuler(_e);
  return { geo, color, m: new THREE.Matrix4().compose(_v1.set(x, y, z), _q, _v2.set(sx, sy, sz)) };
}
function mergeParts(parts) {
  let total = 0;
  const prepared = [];
  for (const p of parts) {
    const g = p.geo.index ? p.geo.toNonIndexed() : p.geo.clone();
    g.applyMatrix4(p.m);
    prepared.push([g, p.color]);
    total += g.attributes.position.count;
  }
  const pos = new Float32Array(total * 3);
  const nor = new Float32Array(total * 3);
  const col = new Float32Array(total * 3);
  let o = 0;
  for (const [g, c] of prepared) {
    const cnt = g.attributes.position.count;
    pos.set(g.attributes.position.array, o * 3);
    nor.set(g.attributes.normal.array, o * 3);
    _col.set(c);
    for (let i = 0; i < cnt; i++) {
      col[(o + i) * 3] = _col.r;
      col[(o + i) * 3 + 1] = _col.g;
      col[(o + i) * 3 + 2] = _col.b;
    }
    o += cnt;
    g.dispose();
  }
  const out = new THREE.BufferGeometry();
  out.setAttribute('position', new THREE.BufferAttribute(pos, 3));
  out.setAttribute('normal', new THREE.BufferAttribute(nor, 3));
  out.setAttribute('color', new THREE.BufferAttribute(col, 3));
  out.computeBoundingSphere();
  return out;
}

// ---------- material classes: vertex-colour alpha from the Blender pipeline ----------
// 1 paint/plastic, 0.75 metal, 0.5 rubber/matte, 0.25 carbon weave, 0 glow (emissive, feeds the bloom)
const CLASS_GLSL_V = `
attribute float mclass;
varying float vMc;
varying vec3 vObjC;`;
const CLASS_GLSL_F = `
varying float vMc;
varying vec3 vObjC;
uniform float uGlow;`;
function classedMaterial(opts, key) {
  const o = Object.assign({ vertexColors: true }, opts);
  const glow = o.glow ?? 2.6;
  delete o.glow;
  const m = new THREE.MeshStandardMaterial(o);
  const u = { uGlow: { value: glow } };
  m.userData.u = u;
  m.onBeforeCompile = (sh) => {
    Object.assign(sh.uniforms, u);
    sh.vertexShader = sh.vertexShader
      .replace('#include <common>', '#include <common>\n' + CLASS_GLSL_V)
      .replace('#include <begin_vertex>', '#include <begin_vertex>\nvMc = mclass; vObjC = position;');
    sh.fragmentShader = sh.fragmentShader
      .replace('#include <common>', '#include <common>\n' + CLASS_GLSL_F + MX_NOISE)
      .replace(
        '#include <metalnessmap_fragment>',
        `#include <metalnessmap_fragment>
        if (vMc < 0.125) { /* glow */ }
        else if (vMc < 0.375) { float wv = step(0.5, fract((vObjC.x + vObjC.z) * 22.0)) * step(0.5, fract((vObjC.x - vObjC.z) * 22.0 + 0.25));
          diffuseColor.rgb *= 0.78 + 0.3 * wv; roughnessFactor = 0.32; metalnessFactor = 0.25; }
        else if (vMc < 0.625) { roughnessFactor = 0.93; metalnessFactor = 0.0; }
        else if (vMc < 0.875) { float brs = mxNoise(vObjC * vec3(5.0, 5.0, 380.0)); roughnessFactor = 0.18 + 0.22 * brs; metalnessFactor = 0.92; }`
      )
      .replace('#include <emissivemap_fragment>', '#include <emissivemap_fragment>\nif (vMc < 0.125) totalEmissiveRadiance += diffuseColor.rgb * uGlow;')
      .replace('#include <lights_fragment_end>', '#include <lights_fragment_end>\nif (vMc > 0.375 && vMc < 0.625) { reflectedLight.indirectSpecular *= 0.35; reflectedLight.directSpecular *= 0.5; }');
  };
  m.customProgramCacheKey = () => 'dd-class2-' + key;
  return m;
}

const MAT = {
  vc: new THREE.MeshStandardMaterial({ vertexColors: true, roughness: 0.75 }),
  kart: classedMaterial({ roughness: 0.55, metalness: 0.08, glow: 3.2 }, 'kart'),
  // v4 runtime world props (towers, neon, chimneys, statue): same classes, gentler glow so city windows do not bloom out
  propx: classedMaterial({ roughness: 0.62, metalness: 0.05, glow: 0.55 }, 'propx'),
  fur: classedMaterial({ roughness: 0.86, metalness: 0, glow: 1.6 }, 'char'),
  prop: new THREE.MeshStandardMaterial({ vertexColors: true, roughness: 0.86 }),
};
const SHARED_MATS = new Set(Object.values(MAT));

// ---------- Shared textures ----------
function canvasTex(w, h, draw, opts = {}) {
  const c = document.createElement('canvas');
  c.width = w;
  c.height = h;
  const g = c.getContext('2d');
  draw(g, w, h);
  const t = new THREE.CanvasTexture(c);
  t.colorSpace = opts.linear ? THREE.NoColorSpace : THREE.SRGBColorSpace;
  if (opts.repeat) {
    t.wrapS = opts.wrapS ?? THREE.RepeatWrapping;
    t.wrapT = THREE.RepeatWrapping;
  }
  if (opts.aniso) t.anisotropy = opts.aniso;
  return t;
}

let BLOB_TEX = null;
function blobTexture() {
  if (BLOB_TEX) return BLOB_TEX;
  BLOB_TEX = canvasTex(64, 64, (g) => {
    const gr = g.createRadialGradient(32, 32, 2, 32, 32, 31);
    gr.addColorStop(0, 'rgba(0,0,0,0.7)');
    gr.addColorStop(0.55, 'rgba(0,0,0,0.38)');
    gr.addColorStop(1, 'rgba(0,0,0,0)');
    g.fillStyle = gr;
    g.fillRect(0, 0, 64, 64);
  });
  return BLOB_TEX;
}

let GLOW_TEX = null;
function glowTexture() {
  if (GLOW_TEX) return GLOW_TEX;
  GLOW_TEX = canvasTex(128, 128, (g) => {
    const gr = g.createRadialGradient(64, 64, 0, 64, 64, 64);
    gr.addColorStop(0, 'rgba(255,255,255,1)');
    gr.addColorStop(0.22, 'rgba(255,250,230,0.8)');
    gr.addColorStop(0.55, 'rgba(255,240,200,0.16)');
    gr.addColorStop(1, 'rgba(255,240,200,0)');
    g.fillStyle = gr;
    g.fillRect(0, 0, 128, 128);
  });
  return GLOW_TEX;
}
const SHARED_TEX = () => [BLOB_TEX, GLOW_TEX, STICKER_TEX];

// Rim-glow shell shader (ram plate, decoy ghost, auras). Linear colours.
function rimMaterial(color, strength = 1) {
  const c = new THREE.Color(color);
  return new THREE.ShaderMaterial({
    uniforms: { uColor: { value: new THREE.Vector3(c.r, c.g, c.b) }, uAlpha: { value: strength } },
    vertexShader: `
      varying vec3 vN; varying vec3 vV;
      #include <common>
      #include <skinning_pars_vertex>
      void main(){
        vec3 transformed = position;
        #ifdef USE_INSTANCING
          vec4 mv = modelViewMatrix * instanceMatrix * vec4(transformed,1.0);
          vN = normalize(normalMatrix * mat3(instanceMatrix) * normal);
        #else
          vec4 mv = modelViewMatrix * vec4(transformed,1.0);
          vN = normalize(normalMatrix * normal);
        #endif
        vV = normalize(-mv.xyz);
        gl_Position = projectionMatrix * mv;
      }`,
    fragmentShader: `
      uniform vec3 uColor; uniform float uAlpha;
      varying vec3 vN; varying vec3 vV;
      void main(){
        float f = 1.0 - abs(dot(normalize(vN), normalize(vV)));
        float a = (0.1 + pow(f, 2.2) * 0.95) * uAlpha;
        gl_FragColor = vec4(uColor * (0.8 + f * 1.4), a);
        #include <tonemapping_fragment>
        #include <colorspace_fragment>
      }`,
    transparent: true,
    depthWrite: false,
    blending: THREE.AdditiveBlending,
  });
}

function roundRect(g, x, y, w, h, r) {
  g.beginPath();
  g.moveTo(x + r, y);
  g.arcTo(x + w, y, x + w, y + h, r);
  g.arcTo(x + w, y + h, x, y + h, r);
  g.arcTo(x, y + h, x, y, r);
  g.arcTo(x, y, x + w, y, r);
  g.closePath();
}
